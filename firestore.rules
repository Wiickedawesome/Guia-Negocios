rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to landingPages and blogs
    match /landingPages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blogs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /seoSchemas/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public contact form submissions
    match /contacts/{document} {
      allow create: if true;
    }
    match /mail/{document} {
      // Only allow sending emails to the official business address
      allow create: if request.resource.data.to == 'info@guianegocios.net';
    }
    
    // Default rule
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
