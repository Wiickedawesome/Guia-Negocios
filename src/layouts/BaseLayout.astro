---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';
import AeoInjector from '../components/AeoInjector.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  altPath?: string;
  // Set on the 404 page. Firebase serves dist/404.html both for real 404s and
  // for the literal /404/ URL, and the latter is a 200 response, so the page
  // has to opt out of indexing explicitly.
  noindex?: boolean;
  // Set by AdminLayout. GA4 and the Meta Pixel used to load on every page,
  // including the whole admin suite, so browsing the dashboard was reported to
  // Google and Meta as public site traffic. Admin pages must not be tracked.
  noTracking?: boolean;
}

const { title, description, ogImage, altPath, noindex = false, noTracking = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// OG image: use page-specific if provided, otherwise default branded share image.
// Social platforms require ~1200x630 (1.91:1); force-fit Unsplash/Pexels URLs
// to that crop so cards never render letterboxed or randomly cropped.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;

const toSocialCrop = (url: string): string => {
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes('images.unsplash.com')) {
      parsed.searchParams.set('auto', 'format');
      parsed.searchParams.set('fit', 'crop');
      parsed.searchParams.set('w', OG_WIDTH.toString());
      parsed.searchParams.set('h', OG_HEIGHT.toString());
      parsed.searchParams.set('q', '80');
      return parsed.toString();
    }
    if (parsed.hostname.includes('images.pexels.com')) {
      parsed.searchParams.set('auto', 'compress');
      parsed.searchParams.set('cs', 'tinysrgb');
      parsed.searchParams.set('w', OG_WIDTH.toString());
      parsed.searchParams.set('h', OG_HEIGHT.toString());
      parsed.searchParams.set('fit', 'crop');
      return parsed.toString();
    }
    return url;
  } catch {
    return url;
  }
};

const resolvedOgImage = ogImage
  ? toSocialCrop(ogImage.startsWith('http') ? ogImage : `https://guianegocios.net${ogImage}`)
  : 'https://guianegocios.net/images/og-default.png';

// Bilingual meta tags for hreflang
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const toggleLang = isEnglish ? 'es' : 'en';
// Use explicit altPath for pages with translated slugs (e.g. blog posts)
const alternatePath = altPath || (
  isEnglish
    ? (currentPath === '/en' || currentPath === '/en/' ? '/' : currentPath.replace('/en', '/es'))
    : (currentPath === '/' || currentPath === '/es' || currentPath === '/es/' ? '/en/' : currentPath.replace('/es', '/en'))
);

// Helper to format clean absolute URLs with trailing slash matching canonical indexing
const toAbsoluteUrl = (path: string) => {
  if (!path || path === '/' || path === '/es' || path === '/es/') return 'https://guianegocios.net/';
  const normalized = path.startsWith('/') ? path : `/${path}`;
  const withTrailingSlash = normalized.endsWith('/') ? normalized : `${normalized}/`;
  return `https://guianegocios.net${withTrailingSlash}`;
};

const canonicalUrl = toAbsoluteUrl(currentPath);
const enUrl = toAbsoluteUrl(isEnglish ? currentPath : alternatePath);
const esUrl = toAbsoluteUrl(!isEnglish ? currentPath : alternatePath);
const xDefaultUrl = esUrl; // Contextual default primary language (Spanish version of this content)

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="viewport" content="width=device-width" />
    <meta name="facebook-domain-verification" content="ecfskyr5gn59dcfe0wxa9b9szyp7vm" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Google Analytics - gated by consent (Consent Mode v2). Everything
         defaults to denied and only flips to granted when the visitor accepts,
         so no analytics or ad cookies are written before a choice is made.
         Skipped entirely on admin pages. -->
    {!noTracking && (
      <Fragment>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          // Must be set before the config call so the default covers the first
          // page view. wait_for_update lets an "accept" click land in time.
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500
          });
          gtag('js', new Date());
          gtag('config', 'G-4E8GG9X33H');
        </script>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-4E8GG9X33H"></script>
      </Fragment>
    )}
    <!-- Canonical & SEO i18n -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GUIA NEGOCIOS" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />

    <!-- Schema.org Graph: WebSite, Organization/LocalBusiness, SiteNavigationElement, and Breadcrumbs -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://guianegocios.net/#website",
          "url": "https://guianegocios.net/",
          "name": "GUIA NEGOCIOS",
          "alternateName": ["Guia Negocios Knoxville", "Guia de Negocios LLC", "Guia Negocios", "Guia de Negocios"],
          "inLanguage": ["es-US", "en-US"],
          "publisher": {
            "@id": "https://guianegocios.net/#business"
          }
        },
        {
          "@type": ["LocalBusiness", "ProfessionalService", "ConsultingService"],
          "@id": "https://guianegocios.net/#business",
          "name": "GUIA NEGOCIOS",
          "legalName": "Guia de Negocios LLC",
          "alternateName": ["Guia Negocios Knoxville", "Guia de Negocios"],
          "slogan": isEnglish ? "Bilingual Business Consulting in Knoxville, TN" : "Consultoría de Negocios Bilingüe en Knoxville, TN",
          "image": "https://guianegocios.net/images/GuiaNegociosLOGO.png",
          "logo": "https://guianegocios.net/images/GuiaNegociosLOGO.png",
          "url": "https://guianegocios.net/",
          "telephone": "+1-865-202-7112",
          "email": "info@guianegocios.net",
          "currenciesAccepted": "USD",
          "paymentAccepted": "Cash, Credit Card, Debit Card, Check, Bank Transfer",
          "knowsAbout": [
            "Tennessee LLC Registration",
            "EIN Setup & Business Licensing",
            "Bilingual Bookkeeping & Accounting Systems",
            "Small Business Consulting",
            "Professional Website Design",
            "Brand Identity & Marketing",
            "Virtual Assistant & Operations Support"
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Knoxville",
            "addressRegion": "TN",
            "addressCountry": "US"
          },
          "areaServed": [
            {
              "@type": "City",
              "name": "Knoxville"
            },
            {
              "@type": "City",
              "name": "Nashville"
            },
            {
              "@type": "City",
              "name": "Chattanooga"
            },
            {
              "@type": "AdministrativeArea",
              "name": "Knox County"
            },
            {
              "@type": "AdministrativeArea",
              "name": "East Tennessee"
            },
            {
              "@type": "State",
              "name": "Tennessee"
            },
            {
              "@type": "AdministrativeArea",
              "name": "Southeastern United States"
            },
            {
              "@type": "Country",
              "name": "United States"
            }
          ],
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday"
            ],
            "opens": "09:00",
            "closes": "17:00"
          },
          "description": description,
          "sameAs": [
            "https://www.facebook.com/guianegocios/",
            "https://www.instagram.com/guianegociosknox/",
            "https://www.linkedin.com/company/guia-negocios",
            "https://www.yelp.com/biz/guia-negocios-knoxville",
            "https://www.mapquest.com/us/tennessee/guia-negocios-821042432",
            "https://maps.app.goo.gl/zGC23QYyuPLN4kdd6"
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Bilingual Business Launch & Consulting Services",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Tennessee LLC Registration & Business Licensing",
                  "description": "Comprehensive LLC formation, state filing, EIN setup, and local operating permits."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Bilingual Bookkeeping & Accounting Setup",
                  "description": "Small business bookkeeping, chart of accounts, and financial systems in English & Spanish."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Complete Business Launch Bundle",
                  "description": "Turnkey business setup from legal formation to custom website, branding, and operations."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "CreedaVA Bilingual Virtual Assistant & Operations",
                  "description": "Dedicated Spanish/English bilingual operational support, admin management, and customer onboarding."
                }
              }
            ]
          }
        },
        {
          "@type": "ItemList",
          "@id": "https://guianegocios.net/#site-navigation",
          "name": isEnglish ? "Main Navigation" : "Navegación Principal",
          "itemListElement": [
            {
              "@type": "SiteNavigationElement",
              "position": 1,
              "name": isEnglish ? "Services & Business Packages" : "Servicios y Paquetes de Negocios",
              "description": isEnglish ? "LLC formation, business licensing, web design, and bilingual virtual assistant services in Knoxville." : "Registro de LLC, licencias comerciales, diseño web y asistentes virtuales bilingües en Knoxville.",
              "url": `https://guianegocios.net/${lang}/services/`
            },
            {
              "@type": "SiteNavigationElement",
              "position": 2,
              "name": isEnglish ? "About Us" : "Sobre Nosotros",
              "description": isEnglish ? "Learn about GUIA NEGOCIOS' mission, story, and business consulting process in East Tennessee." : "Conozca la misión, historia y metodología de consultoría empresarial de GUIA NEGOCIOS en el Este de Tennessee.",
              "url": `https://guianegocios.net/${lang}/about/`
            },
            {
              "@type": "SiteNavigationElement",
              "position": 3,
              "name": isEnglish ? "Contact & Consultation" : "Contacto y Asesoría",
              "description": isEnglish ? "Schedule a consultation or contact our bilingual team in Knoxville, TN." : "Programe una consulta o comuníquese con nuestro equipo bilingüe en Knoxville, TN.",
              "url": `https://guianegocios.net/${lang}/contact/`
            },
            {
              "@type": "SiteNavigationElement",
              "position": 4,
              "name": isEnglish ? "Frequently Asked Questions (FAQ)" : "Preguntas Frecuentes (FAQ)",
              "description": isEnglish ? "Common questions about LLC registration, EIN, bookkeeping, and starting a business in Tennessee." : "Preguntas frecuentes sobre apertura de LLC, trámites de EIN, contabilidad y licencias en Tennessee.",
              "url": `https://guianegocios.net/${lang}/faq/`
            },
            {
              "@type": "SiteNavigationElement",
              "position": 5,
              "name": isEnglish ? "Blog & Resources" : "Blog y Recursos para Emprendedores",
              "description": isEnglish ? "Practical guides, small business tips, and legal insights for East Tennessee business owners." : "Guías prácticas, consejos para pequeños negocios y normativas comerciales en el Este de Tennessee.",
              "url": `https://guianegocios.net/${lang}/blog/`
            },
            {
              "@type": "SiteNavigationElement",
              "position": 6,
              "name": isEnglish ? "Complete Business Launch Bundle" : "Paquete Completo de Lanzamiento",
              "description": isEnglish ? "Turnkey end-to-end business setup from LLC formation to website, branding, and operations." : "Configuración integral de negocio desde LLC hasta sitio web, marca y sistemas operativos.",
              "url": isEnglish ? "https://guianegocios.net/en/services/complete-launch-bundle/" : "https://guianegocios.net/es/services/paquete-lanzamiento-completo/"
            }
          ]
        },
        ...(currentPath !== `/${lang}` && currentPath !== `/${lang}/` && currentPath !== '/' && currentPath !== '' ? [
          {
            "@type": "BreadcrumbList",
            "@id": `https://guianegocios.net${currentPath}#breadcrumb`,
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": isEnglish ? "Home" : "Inicio",
                "item": isEnglish ? "https://guianegocios.net/en/" : "https://guianegocios.net/"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": title.split('|')[0].trim(),
                "item": canonicalUrl
              }
            ]
          }
        ] : [])
      ]
    })} />
    <AeoInjector />
  </head>
  <body class="bg-slate-50 text-slate-900 font-body antialiased flex flex-col min-h-screen">
    <!-- Keyboard users need a way past the nav. Visible only when focused. -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
      {lang === 'en' ? 'Skip to main content' : 'Saltar al contenido principal'}
    </a>
    <slot name="header" />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <slot name="footer" />

    <!-- Consent banner + controller. Analytics stays in the default "denied"
         state until this is answered, and the Meta Pixel is never requested
         before then. Not rendered on admin pages. -->
    {!noTracking && (
      <Fragment>
        <div id="consent-banner" role="region" aria-labelledby="consent-title" style="display:none" class="fixed bottom-4 left-4 right-4 z-[60] rounded-2xl border border-slate-200 bg-white p-5 shadow-2xl sm:left-auto sm:right-6 sm:max-w-sm">
          <h2 id="consent-title" class="text-sm font-bold text-slate-900"></h2>
          <p id="consent-body" class="mt-2 text-xs leading-relaxed text-slate-600"></p>
          <div class="mt-4 flex gap-2">
            <button id="consent-accept" type="button" class="flex-1 cursor-pointer rounded-lg px-3 py-2 text-xs font-bold text-white transition-opacity hover:opacity-90" style="background-color:#1B4E2B"></button>
            <button id="consent-reject" type="button" class="flex-1 cursor-pointer rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-50"></button>
          </div>
        </div>

        <script is:inline>
          (function () {
            var STORAGE_KEY = 'gn_consent_v1';
            var PIXEL_ID = '822562974211520';
            var isEnglish = window.location.pathname.indexOf('/en') === 0;

            var COPY = {
              title: isEnglish ? 'Cookies and measurement' : 'Cookies y medición',
              body: isEnglish
                ? 'We use cookies to measure how this site is used so we can improve it. You can accept or reject measurement — the site works either way.'
                : 'Usamos cookies para medir cómo se usa este sitio y así mejorarlo. Puedes aceptar o rechazar la medición — el sitio funciona igual en ambos casos.',
              accept: isEnglish ? 'Accept' : 'Aceptar',
              reject: isEnglish ? 'Reject' : 'Rechazar'
            };

            function readChoice() {
              try { return window.localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
            }

            function saveChoice(value) {
              try { window.localStorage.setItem(STORAGE_KEY, value); } catch (e) { /* storage unavailable */ }
            }

            // Loaded only after consent: unlike gtag, the Meta Pixel has no
            // cookieless mode, so requesting it before a choice would already
            // set advertising cookies.
            function loadMetaPixel() {
              if (window.fbq) return;
              !function (f, b, e, v, n, t, s) {
                if (f.fbq) return; n = f.fbq = function () {
                  n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
                };
                if (!f._fbq) f._fbq = n;
                n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
                t = b.createElement(e); t.async = !0; t.src = v;
                s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
              }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
              window.fbq('init', PIXEL_ID);
              window.fbq('track', 'PageView');
            }

            function applyConsent(granted) {
              if (typeof window.gtag === 'function') {
                window.gtag('consent', 'update', {
                  ad_storage: granted ? 'granted' : 'denied',
                  ad_user_data: granted ? 'granted' : 'denied',
                  ad_personalization: granted ? 'granted' : 'denied',
                  analytics_storage: granted ? 'granted' : 'denied'
                });
              }
              if (granted) loadMetaPixel();
            }

            function closeBanner() {
              var banner = document.getElementById('consent-banner');
              if (banner) banner.style.display = 'none';
            }

            function decide(granted) {
              saveChoice(granted ? 'granted' : 'denied');
              applyConsent(granted);
              closeBanner();
            }

            var stored = readChoice();

            if (stored === 'granted') {
              applyConsent(true);
            } else if (stored === 'denied') {
              applyConsent(false);
            } else {
              var title = document.getElementById('consent-title');
              var body = document.getElementById('consent-body');
              var accept = document.getElementById('consent-accept');
              var reject = document.getElementById('consent-reject');
              if (title) title.textContent = COPY.title;
              if (body) body.textContent = COPY.body;
              if (accept) {
                accept.textContent = COPY.accept;
                accept.addEventListener('click', function () { decide(true); });
              }
              if (reject) {
                reject.textContent = COPY.reject;
                reject.addEventListener('click', function () { decide(false); });
              }
              var banner = document.getElementById('consent-banner');
              if (banner) banner.style.display = 'block';
            }
          })();
        </script>
      </Fragment>
    )}
  </body>
</html>
