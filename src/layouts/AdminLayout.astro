---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  activePath?: string;
}

const { title, description = 'Admin Dashboard', activePath = Astro.url.pathname } = Astro.props;

const navItems = [
  { path: '/admin/dashboard', label: 'Overview', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>' },
  { path: '/admin/analytics', label: 'Analytics', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" /></svg>' },
  { path: '/admin/keywords', label: 'Keywords', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>' },
  { path: '/admin/seo-agent', label: 'SEO Agent', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>' },
  { path: '/admin/backlinks', label: 'Backlinks', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>' },
  { path: '/admin/blog', label: 'Blog Manager', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>' },
  { path: '/admin/landing-pages', label: 'Landing Pages', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6z" /></svg>' },
  { path: '/admin/reports', label: 'Reports', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>' },
  { path: '/admin/settings', label: 'Settings', icon: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>' },
];
---

<BaseLayout title={title} description={description} noTracking>
  <script is:inline>
    if (localStorage.getItem('adminDarkMode') === 'true' || (!('adminDarkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <div id="admin-app-root" class="flex h-screen bg-slate-50 overflow-hidden font-sans opacity-0 transition-opacity duration-300">
    
    <!-- Mobile Overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" aria-hidden="true"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-50 w-64 bg-brand-dark text-white flex flex-col flex-shrink-0 transform -translate-x-full lg:translate-x-0 transition-transform duration-200">
      <div class="p-6 border-b border-white/10 flex items-center justify-between">
        <a href="/admin/dashboard" class="flex items-center gap-2">
          <img src="/images/logo-bw.webp" alt="Guia Admin" class="h-16 w-auto brightness-200 contrast-125" />
          <span class="text-xl font-bold font-heading tracking-tight">Admin</span>
        </a>
        <button id="sidebar-close" class="lg:hidden p-1 text-slate-400 hover:text-white rounded">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      
      <div class="flex-1 overflow-y-auto py-6 px-4">
        <nav class="space-y-1">
          {navItems.map((item) => {
            const isActive = activePath.startsWith(item.path);
            return (
              <a 
                href={item.path} 
                class={`flex items-center gap-3 px-4 py-2.5 rounded-lg transition-colors duration-200 ${
                  isActive 
                    ? 'bg-brand-primary text-white font-medium shadow-md shadow-brand-primary/20' 
                    : 'text-slate-300 hover:bg-white/5 hover:text-white'
                }`}
              >
                <div class="flex-shrink-0 flex items-center justify-center w-5 h-5" set:html={item.icon} />
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
      
      <div class="p-4 border-t border-white/10">
        <div class="flex items-center gap-3 px-4 py-2 text-slate-300">
          <div class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-sm font-bold">
            <span id="user-initial">A</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate" id="user-display-name">Admin User</p>
            <p class="text-xs text-slate-400 truncate" id="user-email-display">Loading...</p>
          </div>
        </div>
        
        <button id="btn-sign-out" class="mt-4 flex items-center justify-center gap-2 w-full px-4 py-2 text-sm text-slate-400 hover:text-white hover:bg-red-500/20 rounded-lg transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sign Out
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <!-- Header -->
      <header class="bg-white border-b border-slate-200 flex-shrink-0 h-16 flex items-center justify-between px-4 sm:px-8">
        <div class="flex items-center gap-4">
          <!-- Mobile hamburger -->
          <button id="sidebar-open" class="lg:hidden p-2 text-slate-500 hover:text-brand-dark rounded-lg hover:bg-slate-100 transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <!-- Search -->
          <div class="relative hidden sm:block">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
            </div>
            <input type="text" placeholder="Search..." class="block w-64 pl-10 pr-3 py-2 border border-slate-200 rounded-lg text-sm placeholder-slate-400 focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary bg-slate-50" />
          </div>
        </div>
        
        <div class="flex items-center gap-4">
          <button id="notif-btn" class="p-2 text-slate-400 hover:text-brand-dark rounded-full hover:bg-slate-100 transition-colors relative">
            <span id="notif-dot" class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </button>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 overflow-y-auto bg-slate-50 p-4 sm:p-8">
        <slot />
      </main>
    </div>
  </div>

  <!-- Admin utils -->
  <script src="../scripts/admin-utils.js"></script>
  
  <script>
    // Mobile sidebar logic
    const sidebar = document.getElementById('sidebar');
    const sidebarOpen = document.getElementById('sidebar-open');
    const sidebarClose = document.getElementById('sidebar-close');
    const sidebarOverlay = document.getElementById('sidebar-overlay');

    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      sidebarOverlay?.classList.add('hidden');
    }

    sidebarOpen?.addEventListener('click', () => {
      sidebar?.classList.remove('-translate-x-full');
      sidebarOverlay?.classList.remove('hidden');
    });

    sidebarClose?.addEventListener('click', closeSidebar);
    sidebarOverlay?.addEventListener('click', closeSidebar);
  </script>
  <script>
    import { auth } from '../lib/firebase';
    import { onAuthStateChanged, signOut } from 'firebase/auth';

    function isAuthorizedEmail(email: string | null | undefined): boolean {
      if (!email) return false;
      return email.toLowerCase().endsWith('@guianegocios.net');
    }

    // Route Protection
    onAuthStateChanged(auth, async (user) => {
      if (!user || !isAuthorizedEmail(user.email)) {
        if (user && !isAuthorizedEmail(user.email)) {
          await signOut(auth);
        }
        // If no user or unauthorized email domain, redirect to the login page immediately
        window.location.replace('/admin/login');
      } else {
        // Show the admin UI now that user is verified
        const appRoot = document.getElementById('admin-app-root');
        if (appRoot) appRoot.classList.remove('opacity-0');
        
        // Update Sidebar UI with User Info
        const emailDisplay = document.getElementById('user-email-display');
        const nameDisplay = document.getElementById('user-display-name');
        const initialDisplay = document.getElementById('user-initial');
        
        if (emailDisplay) emailDisplay.textContent = user.email;
        if (nameDisplay) nameDisplay.textContent = user.displayName || 'Admin User';
        
        if (initialDisplay && user.email) {
          initialDisplay.textContent = (user.displayName || user.email).charAt(0).toUpperCase();
        }
      }
    });

    // Sign Out Handler
    document.getElementById('btn-sign-out')?.addEventListener('click', async () => {
      try {
        await signOut(auth);
        // onAuthStateChanged will automatically redirect to login
      } catch (error) {
        console.error('Error signing out: ', error);
      }
    });

    // Notification bell
    document.getElementById('notif-btn')?.addEventListener('click', () => {
      // @ts-ignore
      if (typeof window.openAdminNotificationsModal === 'function') {
        // @ts-ignore
        window.openAdminNotificationsModal();
      }
    });
  </script>
  <script>
    import { db } from '../lib/firebase';
    import { collection, query, orderBy, limit, onSnapshot, doc, updateDoc, writeBatch, getDocs } from 'firebase/firestore';
    import { escapeHtml } from '../utils/escape-html';

    let currentNotifications: Array<{
      id: string;
      title: string;
      message: string;
      type: string;
      read: boolean;
      createdAt: any;
      link?: string;
    }> = [];

    function formatTimeAgo(timestamp: any): string {
      if (!timestamp) return 'Recently';
      const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);
      if (isNaN(date.getTime())) return 'Recently';
      
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / (1000 * 60));
      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

      if (diffMins < 1) return 'Just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays === 1) return 'Yesterday';
      if (diffDays < 7) return `${diffDays}d ago`;
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function getTypeIcon(type: string): string {
      switch (type) {
        case 'contact':
          return `<div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>`;
        case 'seo':
          return `<div class="w-8 h-8 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>`;
        case 'blog':
          return `<div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          </div>`;
        default:
          return `<div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
          </div>`;
      }
    }

    function initNotificationsListener() {
      try {
        const notifQuery = query(
          collection(db, 'notifications'),
          orderBy('createdAt', 'desc'),
          limit(20)
        );

        onSnapshot(notifQuery, (snapshot) => {
          currentNotifications = snapshot.docs.map((docSnap) => ({
            id: docSnap.id,
            ...(docSnap.data() as any),
          }));

          const unreadCount = currentNotifications.filter((n) => !n.read).length;
          const notifDot = document.getElementById('notif-dot');
          if (notifDot) {
            if (unreadCount > 0) {
              notifDot.classList.remove('hidden');
            } else {
              notifDot.classList.add('hidden');
            }
          }
        }, async (error) => {
          console.warn('Notifications snapshot fallback, checking contacts directly:', error);
          // Fallback: check recent contacts if notifications collection requires indexing
          try {
            const contactsQuery = query(collection(db, 'contacts'), orderBy('createdAt', 'desc'), limit(5));
            const contactsSnap = await getDocs(contactsQuery);
            currentNotifications = contactsSnap.docs.map(d => {
              const c = d.data();
              return {
                id: d.id,
                title: 'Contact Inquiry',
                message: `${c.name || 'Visitor'} requested ${c.subject || 'consultation'}.`,
                type: 'contact',
                read: false,
                createdAt: c.createdAt,
                link: '/admin/dashboard'
              };
            });
            const notifDot = document.getElementById('notif-dot');
            if (notifDot) {
              if (currentNotifications.length > 0) notifDot.classList.remove('hidden');
              else notifDot.classList.add('hidden');
            }
          } catch (e) {
            console.error('Error fetching fallback notifications:', e);
          }
        });
      } catch (err) {
        console.error('Failed to init notifications listener:', err);
      }
    }

    // Attach to window so header button can open it
    // @ts-ignore
    window.openAdminNotificationsModal = function () {
      if (!currentNotifications || currentNotifications.length === 0) {
        // @ts-ignore
        window.showModal(
          'Notifications',
          `<div class="py-10 text-center">
            <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
            </div>
            <h4 class="font-bold text-slate-800 text-sm">All Caught Up!</h4>
            <p class="text-xs text-slate-400 mt-1">There are no notifications at this time.</p>
          </div>`
        );
        return;
      }

      const unreadCount = currentNotifications.filter((n) => !n.read).length;

      // Notification documents can be created by anonymous visitors (the
      // contact form), so every field is untrusted text. escapeHtml keeps the
      // values inert in the modal's HTML and attribute contexts.
      const itemsHtml = currentNotifications
        .map((n) => {
          const icon = getTypeIcon(n.type);
          const timeAgo = formatTimeAgo(n.createdAt);
          const isUnread = !n.read;
          const bgClass = isUnread ? 'bg-blue-50/50' : 'hover:bg-slate-50';
          const unreadDot = isUnread
            ? '<span class="w-2 h-2 rounded-full bg-brand-primary flex-shrink-0"></span>'
            : '';

          return `
          <div class="p-3.5 rounded-xl flex items-start gap-3 transition-colors ${bgClass} ${n.link ? 'cursor-pointer' : ''}" data-notif-id="${escapeHtml(n.id)}" data-notif-link="${escapeHtml(n.link || '')}">
            ${icon}
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <p class="text-sm font-semibold text-slate-900 truncate">${escapeHtml(n.title)}</p>
                <span class="text-xs text-slate-400 whitespace-nowrap">${timeAgo}</span>
              </div>
              <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">${escapeHtml(n.message)}</p>
            </div>
            ${unreadDot}
          </div>
        `;
        })
        .join('');

      const footerHtml = `
        <div class="flex items-center justify-between w-full">
          <span class="text-xs text-slate-500">${unreadCount > 0 ? `${unreadCount} unread` : 'All read'}</span>
          ${
            unreadCount > 0
              ? '<button id="btn-mark-all-read" class="text-xs font-semibold text-brand-primary hover:underline cursor-pointer">Mark all as read</button>'
              : ''
          }
        </div>
      `;

      // @ts-ignore
      const modal = window.showModal(
        'Notifications',
        `<div class="space-y-2 max-h-[380px] overflow-y-auto pr-1">${itemsHtml}</div>`,
        { footer: footerHtml }
      );

      // Handle click on notification items
      modal.overlay.querySelectorAll('[data-notif-id]').forEach((el: any) => {
        el.addEventListener('click', async () => {
          const id = el.dataset.notifId;
          const link = el.dataset.notifLink;
          try {
            if (id) {
              await updateDoc(doc(db, 'notifications', id), { read: true });
            }
          } catch (e) {
            console.error('Error marking read:', e);
          }
          // Stored links are untrusted: only same-origin paths may navigate,
          // so a crafted value like "javascript:..." can never execute here.
          if (link && link.startsWith('/')) {
            modal.close();
            window.location.href = link;
          }
        });
      });

      // Handle "Mark all as read"
      modal.overlay.querySelector('#btn-mark-all-read')?.addEventListener('click', async () => {
        try {
          const batch = writeBatch(db);
          currentNotifications.filter((n) => !n.read).forEach((n) => {
            batch.update(doc(db, 'notifications', n.id), { read: true });
          });
          await batch.commit();
          // @ts-ignore
          window.showToast('All notifications marked as read', 'success');
          modal.close();
        } catch (e) {
          console.error('Error marking all as read:', e);
          modal.close();
        }
      });
    };

    // Initialize listener when authenticated
    initNotificationsListener();
  </script>
</BaseLayout>
