---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout title="Blog | Guia Negocios" description="Articles and guides for Hispanic entrepreneurs and business owners in the USA." noindex>
  <Header slot="header" />

  <!-- Dynamic Post Container (Loaded via Client-side JS from Firestore) -->
  <article class="bg-slate-50 min-h-screen">
    <!-- Loading State -->
    <div id="blog-loading-state" class="min-h-[60vh] flex flex-col items-center justify-center p-8 text-center">
      <div class="w-12 h-12 border-4 border-brand-primary/20 border-t-brand-primary rounded-full animate-spin mb-4"></div>
      <p class="text-slate-600 font-medium text-lg">Loading article...</p>
    </div>

    <!-- Error / Not Found State -->
    <div id="blog-not-found-state" class="hidden min-h-[60vh] flex flex-col items-center justify-center p-8 text-center max-w-lg mx-auto">
      <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-4 text-2xl font-bold">404</div>
      <h2 class="text-2xl font-bold text-slate-900 font-heading mb-2">Article Not Found</h2>
      <p class="text-slate-600 mb-6">The article you are looking for does not exist or has not been published yet.</p>
      <a href="/en/blog" class="px-6 py-2.5 bg-brand-primary text-white font-medium rounded-lg hover:bg-opacity-95 transition-colors">
        ← Back to Blog
      </a>
    </div>

    <!-- Live Post Content -->
    <div id="blog-live-content" class="hidden opacity-0 transition-opacity duration-300">
      
      <!-- 1. Hero Image Section -->
      <div class="relative w-full h-[400px] md:h-[500px] bg-slate-900 overflow-hidden">
        <img id="post-hero-img" src="" alt="" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-slate-900/60 mix-blend-multiply"></div>
        
        <div class="absolute inset-0 flex items-center justify-center pt-20">
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <div id="post-tags-container" class="flex flex-wrap items-center justify-center gap-2 mb-6"></div>
            <h1 id="post-title" class="text-3xl md:text-5xl lg:text-6xl font-heading text-white mb-6 leading-tight drop-shadow-md"></h1>
            
            <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-slate-200">
              <div class="flex items-center gap-3">
                <img id="post-author-avatar" src="/images/team-avatar.webp" alt="Author" class="w-10 h-10 rounded-full border-2 border-white/20 object-cover" />
                <span id="post-author-name" class="font-medium text-white">Guia Negocios Team</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <time id="post-date"></time>
              </div>
              <div class="flex items-center gap-2">
                <span id="post-readtime" class="px-2 py-1 bg-white/20 rounded-md text-white font-medium backdrop-blur-sm border border-white/10 uppercase text-xs">
                  7 MIN READ
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Main Content Area -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="flex flex-col lg:flex-row gap-8 xl:gap-12 relative">
          
          <!-- Left Sidebar: TOC -->
          <aside id="post-toc-sidebar" class="hidden lg:block lg:w-[220px] xl:w-[260px] shrink-0">
            <div class="sticky top-28 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
              <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4 pb-2 border-b border-slate-100">Table of Contents</h2>
              <ul id="post-toc-list" class="space-y-3"></ul>
            </div>
          </aside>

          <!-- Center: Article Body -->
          <div class="w-full lg:flex-1 min-w-0">
            <div class="bg-white p-6 md:p-10 lg:p-12 rounded-2xl border border-slate-200 shadow-sm">
              <div class="prose prose-slate prose-lg max-w-none prose-headings:font-heading prose-a:text-brand-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
                <div id="post-html-body" class="blog-content"></div>
              </div>

              <!-- Footer: Share & Toggle -->
              <footer class="mt-12 pt-8 border-t border-slate-200">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                  <a id="post-alt-link" href="#" class="inline-flex items-center gap-2 text-brand-primary font-medium hover:bg-brand-light px-4 py-2 rounded-lg transition-colors border border-brand-primary/20">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg"><path fill="#C60A1D" d="M32 5H4a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4z"/><path fill="#FFC400" d="M0 12h36v12H0z"/></svg>
                    <span>Leer en Español</span>
                  </a>
                  <a href="/en/blog" class="text-slate-500 hover:text-brand-dark font-medium transition-colors">
                    ← Back to Blog
                  </a>
                </div>
              </footer>
            </div>

            <!-- Related Articles (Bottom) -->
            <div id="related-articles-section" class="mt-20 pt-12 border-t border-slate-200">
              <h2 class="text-2xl font-bold text-slate-900 mb-8 font-heading text-center">Related Articles</h2>
              <div id="related-articles-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Dynamically rendered -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <Footer slot="footer" />

  <script>
    import { db } from '../../../lib/firebase';
    import { collection, query, where, getDocs, doc, getDoc } from 'firebase/firestore';
    import { markdownToHtml, processHtmlForBlog, formatDate, optimizeImageUrl } from '../../../utils/blog';

    const FALLBACK_RELATED_POSTS_EN = [
      {
        slug: 'importance-of-ein-number',
        title: 'EIN Guide: How to Get an EIN Without an SSN',
        featuredImage: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80',
        tags: ['EIN', 'IRS', 'Business']
      },
      {
        slug: 'how-to-start-llc-knoxville',
        title: 'How to Start an LLC in Knoxville, TN: Step-by-Step Guide',
        featuredImage: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80',
        tags: ['LLC', 'Tennessee', 'Knoxville']
      }
    ];

    async function loadDynamicPost() {
      const urlParams = new URLSearchParams(window.location.search);
      const docId = urlParams.get('id');
      let slug = urlParams.get('slug') || '';

      if (!slug && !docId) {
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        slug = pathParts[pathParts.length - 1];
        if (slug === 'view' && pathParts.length > 2) {
          slug = pathParts[pathParts.length - 2];
        }
      }

      if (!slug && !docId) {
        showNotFound();
        return;
      }

      try {
        let postData: any = null;

        if (docId) {
          const docSnap = await getDoc(doc(db, 'blogs', docId));
          if (docSnap.exists()) {
            postData = docSnap.data();
          }
        }

        if (!postData && slug) {
          const blogsRef = collection(db, 'blogs');
          const qEn = query(blogsRef, where('slugEn', '==', slug));
          const snapEn = await getDocs(qEn);
          if (!snapEn.empty) {
            postData = snapEn.docs[0].data();
          } else {
            const qEs = query(blogsRef, where('slugEs', '==', slug));
            const snapEs = await getDocs(qEs);
            if (!snapEs.empty) {
              postData = snapEs.docs[0].data();
            } else {
              const qGeneric = query(blogsRef, where('slug', '==', slug));
              const snapGeneric = await getDocs(qGeneric);
              if (!snapGeneric.empty) {
                postData = snapGeneric.docs[0].data();
              }
            }
          }
        }

        if (!postData) {
          showNotFound();
          return;
        }

        const title = postData.titleEn || postData.titleEs || 'Article';
        const content = postData.contentEn || postData.contentEs || '';
        const author = postData.author || 'Guia Negocios Team';
        const authorAvatar = postData.authorAvatar || '/images/team-avatar.webp';
        const featuredImage = postData.featuredImage || 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80';
        const date = postData.publishDate || (postData.createdAt ? postData.createdAt.split('T')[0] : '2026-08-10');
        const readTime = postData.readTime || 7;
        const tags = postData.keywords || [];
        const finalSlug = postData.slugEn || postData.slug || slug;
        const altSlug = postData.slugEs || postData.altSlug || finalSlug;

        // Clean up URL bar to canonical slug route immediately
        if (finalSlug && (window.location.search || window.location.pathname.includes('/view'))) {
          window.history.replaceState({}, '', `/en/blog/${finalSlug}`);
        }

        document.title = `${title} | Blog | Guia Negocios`;

        (document.getElementById('post-hero-img') as HTMLImageElement).src = optimizeImageUrl(featuredImage, { width: 1200, quality: 80 });
        (document.getElementById('post-hero-img') as HTMLImageElement).alt = title;
        document.getElementById('post-title')!.textContent = title;
        (document.getElementById('post-author-avatar') as HTMLImageElement).src = optimizeImageUrl(authorAvatar, { width: 80, height: 80, quality: 80 });
        document.getElementById('post-author-name')!.textContent = author;
        document.getElementById('post-date')!.textContent = formatDate(date, 'en');
        document.getElementById('post-readtime')!.textContent = `${readTime} MIN READ`;

        const tagsContainer = document.getElementById('post-tags-container')!;
        tagsContainer.innerHTML = tags.map((t: string) => `
          <span class="text-xs bg-brand-primary text-white px-3 py-1 rounded-full font-bold tracking-wide uppercase">
            ${t}
          </span>
        `).join('');

        const rawHtml = markdownToHtml(content);
        const { html: contentHtml, toc } = processHtmlForBlog(rawHtml);
        document.getElementById('post-html-body')!.innerHTML = contentHtml;

        const tocSidebar = document.getElementById('post-toc-sidebar')!;
        const tocList = document.getElementById('post-toc-list')!;
        tocList.innerHTML = '';
        if (toc.length > 0) {
          tocSidebar.classList.remove('hidden');
          toc.forEach(item => {
            const li = document.createElement('li');
            li.innerHTML = `
              <a href="#${item.id}" class="block text-sm text-slate-600 hover:text-brand-primary transition-colors ${item.level === 3 ? 'ml-4 text-xs' : ''}">
                ${item.text}
              </a>
            `;
            tocList.appendChild(li);
          });
        } else {
          tocSidebar.classList.add('hidden');
        }

        const altLink = document.getElementById('post-alt-link') as HTMLAnchorElement;
        if (altLink) {
          altLink.href = (docId || postData.id)
            ? `/es/blog/view?id=${docId || postData.id}&slug=${altSlug}`
            : `/es/blog/${altSlug}`;
        }

        await loadRelatedArticles(docId || '', slug);

        document.getElementById('blog-loading-state')?.classList.add('hidden');
        const liveContent = document.getElementById('blog-live-content')!;
        liveContent.classList.remove('hidden');
        setTimeout(() => liveContent.classList.remove('opacity-0'), 20);

      } catch (err) {
        console.error("Error loading dynamic post:", err);
        showNotFound();
      }
    }

    async function loadRelatedArticles(currentId?: string, currentSlug?: string) {
      const grid = document.getElementById('related-articles-grid');
      if (!grid) return;

      let relatedList: any[] = [];
      try {
        const blogsSnap = await getDocs(query(collection(db, 'blogs'), where('status', '==', 'Published')));
        blogsSnap.forEach(d => {
          if (d.id === currentId) return;
          const data = d.data();
          if (data.status !== 'Published') return;
          const slugEn = data.slugEn || data.slug || d.id;
          if (slugEn === currentSlug) return;
          if (!data.titleEn && !data.title) return;
          
          relatedList.push({
            id: d.id,
            slug: slugEn,
            title: data.titleEn || data.title || 'Business Article',
            featuredImage: data.featuredImage || (slugEn.includes('knoxville') ? 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80' : 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80'),
            tags: data.keywords || ['Business']
          });
        });
      } catch (e) {
        console.warn('Could not load related articles from Firestore:', e);
      }

      if (relatedList.length < 2) {
        for (const fb of FALLBACK_RELATED_POSTS_EN) {
          if (fb.slug !== currentSlug && !relatedList.some(r => r.slug === fb.slug)) {
            relatedList.push(fb);
            if (relatedList.length >= 2) break;
          }
        }
      }

      const displayPosts = relatedList.slice(0, 3);
      grid.innerHTML = displayPosts.map(rp => `
        <a href="/en/blog/view?id=${rp.id || ''}&slug=${rp.slug}" class="block group bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-video w-full overflow-hidden bg-slate-100">
            <img src="${optimizeImageUrl(rp.featuredImage, { width: 600, quality: 75 })}" alt="${rp.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" width="384" height="216" loading="lazy" decoding="async" />
          </div>
          <div class="p-6">
            <div class="text-xs font-semibold text-brand-primary mb-2 uppercase tracking-wider">${rp.tags?.[0] || 'Business'}</div>
            <h3 class="font-bold text-slate-900 group-hover:text-brand-primary transition-colors line-clamp-2">${rp.title}</h3>
          </div>
        </a>
      `).join('');
    }

    function showNotFound() {
      document.getElementById('blog-loading-state')?.classList.add('hidden');
      document.getElementById('blog-not-found-state')?.classList.remove('hidden');
    }

    document.addEventListener('DOMContentLoaded', loadDynamicPost);
  </script>
</BaseLayout>
