---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="Contact Us | Guia Negocios — Knoxville TN" description="Get in touch with Guia Negocios for bilingual business consulting, LLC setup, web design, and operational guidance in Knoxville, TN." ogImage="/images/og/og-contact.png">
  <Header slot="header" />
  
  <!-- SECTION 1: Contact Form & Direct Channels -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10">

        <!-- Statement -->
        <div class="order-1 lg:order-none lg:col-span-5 lg:col-start-1 lg:row-start-1">
          <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Get In Touch</span>
          <h1 class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-heading text-brand-dark font-semibold leading-[1.08] tracking-tight">
            Let's Build & Scale Your Business Together
          </h1>
          <p class="mt-6 text-slate-600 text-base leading-relaxed">
            Have questions about launching your LLC in Tennessee, building a website, setting up bookkeeping, or scheduling a consultation in Knoxville? We are here to guide you every step of the way.
          </p>
        </div>

        <!-- Form -->
        <div class="order-2 lg:order-none lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:row-span-2 lg:border-l lg:border-slate-200 lg:pl-10 lg:flex lg:flex-col">
          <h2 class="text-2xl sm:text-3xl font-heading text-brand-dark font-semibold">Send Us a Message</h2>
          <p class="mt-3 text-slate-600 text-sm">Fill out the form below and a consultant will respond within 1 business day.</p>

          <form id="contact-form" class="mt-8 space-y-5 lg:flex lg:flex-1 lg:flex-col">
              <!-- Honeypot: hidden from users and assistive tech. Bots fill every
                   field they find, so a value here means the submission is not
                   from a person and it is discarded without a write. -->
              <div class="hidden" aria-hidden="true">
                <label for="company-website">Website</label>
                <input type="text" id="company-website" name="company_website" tabindex="-1" autocomplete="off" />
              </div>
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1.5">Name *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  maxlength="200" 
                  required 
                  placeholder="Enter your full name" 
                  class="w-full px-4 py-3.5 bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:bg-white text-sm placeholder-slate-400"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1.5">Email *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  maxlength="320" 
                  required 
                  placeholder="Enter your email address" 
                  class="w-full px-4 py-3.5 bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:bg-white text-sm placeholder-slate-400"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1.5">Phone / WhatsApp</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  maxlength="40" 
                  placeholder="(865) 000-0000" 
                  class="w-full px-4 py-3.5 bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:bg-white text-sm placeholder-slate-400"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1.5">Service Needed</label>
                <select 
                  id="subject" 
                  name="subject" 
                  class="w-full px-4 py-3.5 bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:bg-white text-sm"
                >
                  <option value="general">General Business Inquiry</option>
                  <option value="tier1-4">Core Launch Services (Tiers 1–4)</option>
                  <!-- Tier numbers must match src/pages/en/services.astro, where tier5 is the
                       Complete Launch Bundle and tier6 is Operations & Growth. These two
                       options previously had their names swapped. -->
                  <option value="tier5">Complete Launch Bundle (Tier 5)</option>
                  <option value="tier6">Operations &amp; Growth Systems (Tier 6)</option>
                  <option value="notary">Notary Public / Translation Support</option>
                  <option value="custom">Request Custom Unlisted Service</option>
                </select>
              </div>

              <div class="lg:flex lg:flex-1 lg:flex-col">
                <label for="message" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1.5">Message *</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="4" 
                  maxlength="5000" 
                  required 
                  placeholder="Tell us about your business concept or questions..." 
                  class="w-full px-4 py-3.5 bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:bg-white text-sm placeholder-slate-400 lg:flex-1"
                ></textarea>
              </div>

              <div>
                <button 
                  type="submit" 
                  class="w-full bg-brand-dark hover:bg-slate-800 text-white font-bold py-4 px-8 rounded-full transition-colors text-base"
                >
                  Send Message
                </button>
              </div>

              <!-- Inline Toast Notification. role="status" so screen readers
                   announce the result without moving focus. -->
              <div id="contact-toast" role="status" aria-live="polite" class="hidden rounded-lg p-4 text-sm font-medium border"></div>
            </form>
        </div>

        <!-- Direct Channels -->
        <div class="order-3 lg:order-none lg:col-span-5 lg:col-start-1 lg:row-start-2">
          <div class="divide-y divide-slate-200 border-t border-slate-200">

            <div class="py-6">
              <div class="flex items-center gap-3 text-brand-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.47-5.187-3.833-6.657-6.657l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                <span class="text-[0.68rem] font-bold uppercase tracking-[0.22em]">Phone Support</span>
              </div>
              <p class="mt-3 text-slate-500 text-sm leading-relaxed">Call us directly during business hours for immediate guidance.</p>
              <a href="tel:8652027112" class="mt-2 inline-block text-lg font-bold text-brand-primary hover:underline">
                (865) 202-7112
              </a>
            </div>

            <div class="py-6">
              <div class="flex items-center gap-3 text-brand-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641l-.433 1.685a.75.75 0 00.916.916l1.685-.433c.601-.154 1.194.154 1.641.586A8.966 8.966 0 0012 20.25z" />
                </svg>
                <span class="text-[0.68rem] font-bold uppercase tracking-[0.22em]">WhatsApp Chat</span>
              </div>
              <p class="mt-3 text-slate-500 text-sm leading-relaxed">Send us a message for fast bilingual responses in English & Spanish.</p>
              <a href="https://wa.me/message/K7ATGJJHJLHXL1" target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-lg font-bold text-brand-primary hover:underline">
                Chat on WhatsApp ↗
              </a>
            </div>

            <div class="py-6">
              <div class="flex items-center gap-3 text-brand-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <span class="text-[0.68rem] font-bold uppercase tracking-[0.22em]">Email Advisory</span>
              </div>
              <p class="mt-3 text-slate-500 text-sm leading-relaxed">Send us business proposals, questions, or document requests.</p>
              <a href="mailto:info@guianegocios.net" class="mt-2 inline-block text-lg font-bold text-brand-primary hover:underline">
                info@guianegocios.net
              </a>
            </div>

          </div>
        </div>

      </div>

      <div class="mt-12 lg:mt-16 text-center">
        <a href={`/${lang}/faq`} class="inline-flex items-center gap-2 text-brand-primary font-medium hover:underline">
          Frequently Asked Questions (FAQ) <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Legal Disclaimer Banner -->
  <section class="py-12 bg-slate-100 border-t border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs text-slate-500 italic leading-relaxed">
        "Guia Negocios provides general business education and consulting support. We are not attorneys, accountants, or licensed financial advisors. For legal, tax, or financial advice, please consult a licensed professional."
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';
  import { db } from '../../lib/firebase';
  import { escapeHtml } from '../../utils/escape-html';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Basic validation and state change
      const originalText = submitBtn.innerText;
      submitBtn.innerText = 'Sending...';
      submitBtn.disabled = true;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // Honeypot: a real visitor never sees this field. Report the normal
      // success state but write nothing, so scripted submitters get no signal
      // that they were filtered.
      if (data.company_website) {
        form.reset();
        submitBtn.innerText = originalText;
        submitBtn.disabled = false;
        const toast = document.getElementById('contact-toast');
        if (toast) {
          toast.textContent = 'Message sent successfully! We will get back to you shortly.';
          toast.className = 'rounded-lg p-4 text-sm font-medium border bg-emerald-50 text-emerald-800 border-emerald-200';
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 5000);
        }
        return;
      }

      try {
        const name = data.name as string;
        const email = data.email as string;
        const phone = data.phone as string || '';
        const subject = data.subject as string || '';
        const message = data.message as string;

        // Save to contacts for internal record
        await addDoc(collection(db, 'contacts'), {
          name, email, phone, subject, message,
          createdAt: serverTimestamp()
        });

        // Add real notification for admin dashboard
        await addDoc(collection(db, 'notifications'), {
          title: 'New Contact Inquiry',
          message: `${name} (${email}) — ${subject || 'General Inquiry'}`,
          type: 'contact',
          read: false,
          link: '/admin/dashboard',
          createdAt: serverTimestamp()
        });

        // Write to mail collection to trigger email extension. Visitor input
        // is escaped for the HTML body because email clients render it as
        // markup.
        await addDoc(collection(db, 'mail'), {
          to: 'info@guianegocios.net',
          message: {
            subject: `New Lead from Guia Negocios: ${name} - ${subject}`,
            text: `Name: ${name}\nEmail: ${email}\nPhone: ${phone}\nService: ${subject}\n\nMessage:\n${message}`,
            html: `<p><strong>Name:</strong> ${escapeHtml(name)}</p><p><strong>Email:</strong> ${escapeHtml(email)}</p><p><strong>Phone:</strong> ${escapeHtml(phone)}</p><p><strong>Service:</strong> ${escapeHtml(subject)}</p><p><strong>Message:</strong><br/>${escapeHtml(message)}</p>`
          },
          createdAt: serverTimestamp()
        });
        
        // Show inline success toast
        const toast = document.getElementById('contact-toast');
        if (toast) {
          toast.className = 'rounded-lg p-4 text-sm font-medium border bg-emerald-50 text-emerald-800 border-emerald-200';
          toast.textContent = 'Message sent successfully! We will get back to you shortly.';
          toast.classList.remove('hidden');
          setTimeout(() => toast.classList.add('hidden'), 5000);
        }
        form.reset();
      } catch (error) {
        console.error("Error submitting form:", error);
        // Show inline error toast
        const toast = document.getElementById('contact-toast');
        if (toast) {
          toast.className = 'rounded-lg p-4 text-sm font-medium border bg-red-50 text-red-800 border-red-200';
          toast.textContent = 'There was an error sending your message. Please try again or use WhatsApp.';
          toast.classList.remove('hidden');
          // Must auto-dismiss like the success toast and the Spanish form,
          // otherwise an English visitor is left with a permanent red banner
          // and no way to clear it short of reloading the page.
          setTimeout(() => toast.classList.add('hidden'), 5000);
        }
      } finally {
        submitBtn.innerText = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>
