---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LegalDisclaimer from '../../../components/LegalDisclaimer.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title="Operations & Growth Systems Guide | Guia Negocios" description="A deep guide on how Guia Negocios steps into active businesses, identifies administrative bottlenecks, optimizes profit margins, and builds scalable systems." altPath="/es/services/operaciones-crecimiento">
  <Header slot="header" altPath="/es/services/operaciones-crecimiento" />
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Operations & Growth Systems Consulting",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Guia Negocios",
      "url": "https://guianegocios.net",
      "telephone": "+1-865-202-7112",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Knoxville",
        "addressRegion": "TN",
        "addressCountry": "US"
      }
    },
    "serviceType": "Small Business Operations & Financial Optimization",
    "areaServed": "Knoxville, Knox County, East Tennessee",
    "description": "Hands-on operational audit, workflow automation, financial reporting, and scalable business system design."
  })} />
  
  <!-- Service Package Hero Header -->
  <section class="py-16 lg:py-24 bg-brand-dark text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-wider text-slate-400">
        <a href={`/${lang}/services`} class="text-slate-300 hover:text-white transition-colors">← Back to All Services</a>
      </div>
      <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-accent">
        Tier 06 Advanced Package
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-semibold leading-[1.05] tracking-tight text-white">
        Operations & Growth Systems
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed font-sans">
        Structure your existing business, identify operational bottlenecks, streamline client intake, automate scheduling and invoicing, and maximize profit margins.
      </p>
      
      <div class="pt-6 flex flex-wrap items-center gap-6 text-sm text-slate-300 border-t border-slate-800/80">
        <div>
          <span class="text-xs uppercase tracking-wider text-slate-400 block">Implementation Scope</span>
          <span class="text-base font-bold text-white">Customized Per Business</span>
        </div>
        <div class="ml-auto">
          <a href={`/${lang}/contact`} class="inline-block bg-brand-accent text-brand-dark font-bold py-3.5 px-8 rounded-full hover:bg-yellow-300 transition-colors text-base">
            Book Operations Audit
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Article Content Body -->
  <article class="bg-white text-slate-800">

    <!-- Pull statement: full-bleed band -->
    <section class="bg-slate-50 border-b border-slate-200 py-16 lg:py-20">
      <div class="px-4 sm:px-6 lg:px-8 space-y-8">
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">The Hidden Cost of Unorganized Operations</p>
        <p class="max-w-none text-2xl sm:text-3xl lg:text-4xl xl:text-5xl 2xl:text-6xl font-heading font-semibold leading-[1.1] tracking-tight text-brand-dark">
          Many small business owners in Knoxville work 60+ hours a week not because they lack clients, but because their internal operations are chaotic. Missing job notes, delayed estimates, paper receipts, uncollected invoices, and constant phone interruptions eat away at your energy and profit. <strong>Operations & Growth Systems</strong> is our dedicated program to step inside your business, identify every friction point, and build a smooth, professional operation.
        </p>
      </div>
    </section>

    <!-- Numbered chapters -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">

      <!-- Chapter 1: The Operational Audit -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">STEP 01</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            1. Operational Audit & Gap Identification
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          We start by sitting down with the business owner to conduct a deep audit of your current workflow. We examine how a new lead reaches your business, how quotes are delivered, how work is scheduled, how invoices are sent, and how money moves into your bank account.
        </p>
        <div class="border-t border-slate-200 pt-6 space-y-3">
          <h3 class="font-bold text-brand-dark text-sm uppercase tracking-wider">Common Operational Gaps We Uncover:</h3>
          <ul class="space-y-2 text-sm text-slate-700">
            <li class="flex items-start gap-2"><span class="text-brand-primary font-bold">✕</span> Quotes sent via text messages with no formal contract or scope agreement</li>
            <li class="flex items-start gap-2"><span class="text-brand-primary font-bold">✕</span> Days lost playing phone tag instead of using instant online booking links</li>
            <li class="flex items-start gap-2"><span class="text-brand-primary font-bold">✕</span> Thousands of dollars in uncollected or late customer invoices</li>
            <li class="flex items-start gap-2"><span class="text-brand-primary font-bold">✕</span> Underpricing services due to uncalculated material costs and labor overhead</li>
          </ul>
        </div>
        </div>
      </section>

      <!-- Chapter 2: Margin & Pricing Strategy -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">STEP 02</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            2. Margin Improvement & Price Calibration
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          A busy business is not necessarily a profitable business. We perform a detailed margin analysis to recalculate your pricing structure, ensuring that every job covers direct costs, employee wages, overhead, and a healthy profit margin for the owner.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 border-t border-slate-200 pt-6">
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark">Labor & Overhead Calculation</h3>
            <p class="text-xs text-slate-600">Determining true hourly cost including fuel, insurance, software subscriptions, and equipment wear.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark">Price Increase Strategy</h3>
            <p class="text-xs text-slate-600">Guiding you through polite, professional price adjustment notices to existing clients without losing loyalty.</p>
          </div>
        </div>
        </div>
      </section>

      <!-- Chapter 3: Digital Software & Invoicing Setup -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">STEP 03</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            3. Digital Scheduling, Invoicing & Job Tracking Tools
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          We eliminate paper clutter by implementing modern, simple digital software (Jobber, QuickBooks, Square, or Calendly) tailored to your team's tech comfort level.
        </p>
        <div class="bg-brand-dark text-white p-8 lg:p-10 space-y-5">
          <h3 class="text-xl font-heading font-bold text-brand-accent">Software & Workflow Enhancements:</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-300">
            <div>• Automated customer appointment booking & SMS reminders</div>
            <div>• One-click digital estimate delivery with e-signatures</div>
            <div>• Card processing on site or via email invoice link</div>
            <div>• Job tracking status (Quoted, Scheduled, Completed, Invoiced)</div>
            <div>• Automated late invoice reminder sequences</div>
            <div>• Customer history & notes accessible on mobile devices</div>
          </div>
        </div>
        </div>
      </section>

      <!-- Chapter 4: Templates & Scripts -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">STEP 04</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            4. Bilingual Contract Templates & Communication Scripts
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          Professional communication sets commercial businesses apart. We equip your team with a complete set of bilingual contract templates, work order approvals, change order forms, and customer service scripts.
        </p>
        <div class="border-t border-slate-200 pt-6 space-y-3">
          <h3 class="font-bold text-brand-dark text-sm uppercase tracking-wider">Operational Templates Vault:</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-700">
            <div>• Service Agreement & Scope Contract</div>
            <div>• Change Order Approval Form</div>
            <div>• Phone Screening & Intake Script</div>
            <div>• Deposit & Payment Terms Sheet</div>
            <div>• Post-Service Review Request Texts</div>
            <div>• Employee/Subcontractor Onboarding Guide</div>
          </div>
        </div>
        </div>
      </section>

      <!-- Chapter 5: Staff Training & CreedaVA Delegation -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">STEP 05</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            5. Team Training & Delegation to CreedaVA
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          Systems don't work unless your team uses them. We conduct 1-on-1 walkthrough training sessions with the owner and staff to ensure everyone is comfortable using the new tools.
        </p>
        <div class="border-t border-slate-200 pt-6 space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brand-primary">Delegation Ready</span>
            <h3 class="text-xl font-heading font-bold text-brand-primary">Preparing Your Business for Virtual Assistance</h3>
          </div>
          <p class="text-slate-600 text-sm leading-relaxed">
            Once your intake, scheduling, and invoicing workflows are documented into simple Standard Operating Procedures (SOPs), you can easily hand off administrative tasks to a dedicated bilingual Virtual Assistant through <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="text-brand-primary font-bold hover:underline">CreedaVA (creedava.com)</a>.
          </p>
        </div>
        </div>
      </section>
    </div>

    <!-- Full-bleed CTA band -->
    <section class="bg-brand-dark text-white py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-x-12 items-center px-4 sm:px-6 lg:px-8">
        <div class="lg:col-span-8 space-y-6">
          <div class="w-16 h-16 border border-white/25 text-brand-accent text-lg font-bold tracking-widest flex items-center justify-center">
            GN
          </div>
          <div class="space-y-3">
            <h3 class="text-2xl lg:text-4xl font-heading font-semibold leading-[1.15] tracking-tight text-white">Ready to Bring Order & Profitability to Your Business?</h3>
            <p class="max-w-2xl text-base text-slate-300 leading-relaxed">Let’s review your current administrative challenges and build a custom operations plan. Book a 1-on-1 operational audit call with our team.</p>
          </div>
        </div>
        <div class="lg:col-span-4 flex flex-wrap gap-4 lg:justify-end">

            <a href={`/${lang}/contact`} class="inline-block bg-brand-primary text-white font-bold py-3.5 px-8 rounded-full hover:bg-opacity-90 transition-colors text-base">
              Schedule Your Operations Audit
            </a>
        </div>
      </div>
    </section>

  </article>

  <LegalDisclaimer />

  <Footer slot="footer" />
</BaseLayout>
