---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LegalDisclaimer from '../../../components/LegalDisclaimer.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title="CreedaVA Ongoing Support Guide | Guia Negocios" description="A deep guide on how CreedaVA provides dedicated bilingual virtual assistants to handle customer service, inbox triage, CRM, and admin tasks after launching." altPath="/es/services/apoyo-creedava">
  <Header slot="header" altPath="/es/services/apoyo-creedava" />
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "CreedaVA Ongoing Bilingual Virtual Assistant Support",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Guia Negocios",
      "url": "https://guianegocios.net",
      "telephone": "+1-865-202-7112",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Knoxville",
        "addressRegion": "TN",
        "addressCountry": "US"
      }
    },
    "serviceType": "Bilingual Operational & Admin Virtual Assistant",
    "areaServed": "Knoxville, Knox County, East Tennessee",
    "description": "Dedicated bilingual virtual assistant services for customer service, inbox triage, invoicing, and CRM management."
  })} />
  
  <!-- Service Package Hero Header -->
  <section class="py-16 lg:py-24 bg-brand-dark text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-wider text-slate-400">
        <a href={`/${lang}/services`} class="text-slate-300 hover:text-white transition-colors">← Back to All Services</a>
      </div>
      <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-accent">
        Official Partnership Tier 07
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-semibold leading-[1.05] tracking-tight text-white">
        Ongoing Support with CreedaVA
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed font-sans">
        Delegate daily customer support, email management, CRM updates, and administrative logistics to dedicated, professionally bilingual Virtual Assistants through our official partner <strong class="text-white">CreedaVA</strong>.
      </p>
      
      <div class="pt-6 flex flex-wrap items-center gap-6 text-sm text-slate-300 border-t border-slate-800/80">
        <div>
          <span class="text-xs uppercase tracking-wider text-slate-400 block">Official Portal</span>
          <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="text-base font-bold text-white hover:underline">creedava.com ↗</a>
        </div>
        <div class="ml-auto">
          <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="inline-block bg-brand-accent text-brand-dark font-extrabold py-3.5 px-8 rounded-full hover:bg-yellow-300 transition-colors text-base">
            Visit CreedaVA.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Article Content Body -->
  <article class="bg-white text-slate-800">

    <!-- Pull statement: full-bleed band -->
    <section class="bg-slate-50 border-b border-slate-200 py-16 lg:py-20">
      <div class="px-4 sm:px-6 lg:px-8 space-y-8">
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">The Delegation Advantage for Business Owners</p>
        <p class="max-w-none text-2xl sm:text-3xl lg:text-4xl xl:text-5xl 2xl:text-6xl font-heading font-semibold leading-[1.1] tracking-tight text-brand-dark">
          As a business owner, your highest-value hours should be spent serving clients, closing major quotes, and leading team growth—not replying to routine emails, answering phone inquiries, or chasing unpaid invoices. Through our official partnership with <strong>CreedaVA</strong>, you gain a dedicated, professionally bilingual (English & Spanish) Virtual Assistant who manages your daily operational tasks with enterprise reliability.
        </p>
      </div>
    </section>

    <!-- Numbered chapters -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">

      <!-- Section 1: The Transition from Launch to Operations -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Part 01</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            1. The Seamless Hand-Off: From Launch to Daily Operations
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          When you launch your business through Guia Negocios, your operating systems, customer intake forms, and invoice templates are already set up and documented. CreedaVA steps into these pre-configured systems on day one, meaning zero lost time or training friction.
        </p>
        </div>
      </section>

      <!-- Section 2: What CreedaVA VAs Handle Daily -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Part 02</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            2. Daily Responsibilities Handled by Your Dedicated VA
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          CreedaVA VAs act as an extension of your business. Here is a look at the daily administrative tasks delegated to your Virtual Assistant:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 border-t border-slate-200 pt-6">
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Inbox & Customer Phone Triage</h3>
            <p class="text-sm text-slate-600">Screening business phone calls, managing customer emails, replying to WhatsApp Business messages, and qualifying new lead inquiries in English and Spanish.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Calendar & Dispatch Coordination</h3>
            <p class="text-sm text-slate-600">Booking customer consultations, scheduling service visits, managing technician calendars, and sending automated appointment confirmation texts.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">CRM & Customer Data Management</h3>
            <p class="text-sm text-slate-600">Entering new contacts, updating customer job history, tracking quote statuses, and ensuring accurate client records in your CRM software.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Invoicing & Payment Follow-Ups</h3>
            <p class="text-sm text-slate-600">Sending digital invoices immediately after job completion, processing card payments, and sending courteous follow-ups for overdue accounts.</p>
          </div>
        </div>
        </div>
      </section>

      <!-- Section 3: Why Bilingual Support Matters -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Part 03</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            3. The Power of Professionally Bilingual VAs (English & Spanish)
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          Serving East Tennessee’s growing market requires flawless communication across English-speaking commercial clients and Spanish-speaking homeowners, suppliers, or crew members. CreedaVA Virtual Assistants are fluent in both languages, ensuring professional customer representation across all channels.
        </p>
        </div>
      </section>

      <!-- Section 4: Direct Link & Partnership Card -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Parte 04</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl">
          <div class="bg-brand-dark text-white p-8 lg:p-10 space-y-5"><div class="flex items-center justify-between flex-wrap gap-4">
            <span class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brand-primary">Official Partner Website</span>
            <span class="text-xs text-emerald-200">creedava.com</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-heading font-bold">
            Explore All CreedaVA Virtual Assistant Retainers
          </h3>
          <p class="text-emerald-100 text-sm leading-relaxed max-w-2xl">
            Retainer rates depend on dedicated hours, SLA response times, and specialized task requirements. Visit the official CreedaVA website for detailed service packages, client testimonials, and direct onboarding.
          </p>
          <div>
            <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-emerald-400 text-[#005148] font-extrabold py-3.5 px-8 rounded-full hover:bg-emerald-300 transition-colors text-base">
              Visit CreedaVA.com
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div></div>
        </div>
      </section>
    </div>

    <!-- Full-bleed CTA band -->
    <section class="bg-brand-dark text-white py-16 lg:py-20">
      <div class="px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row lg:items-center gap-8">
        <img src="/images/creedava-logo.svg" alt="CreedaVA" width="242" height="201" decoding="async" class="h-20 w-auto shrink-0 self-start lg:self-center bg-white p-2" />
        <div class="flex-1 space-y-3">
            <h3 class="text-2xl lg:text-4xl font-heading font-semibold leading-[1.15] tracking-tight text-white">Ready to Match with Your Dedicated Virtual Assistant?</h3>
            <p class="max-w-2xl text-base text-slate-300 leading-relaxed">Contact Guia Negocios or CreedaVA directly to discuss your administrative workload and find the perfect bilingual Virtual Assistant for your business.</p>
        </div>
        <div class="flex flex-wrap gap-4 lg:justify-end shrink-0">

            <a href={`/${lang}/contact`} class="inline-block bg-brand-primary text-white font-bold py-3.5 px-8 rounded-full hover:bg-opacity-90 transition-colors text-base">
              Book Consultation
            </a>
            <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="inline-block border border-white text-white font-bold py-3.5 px-8 rounded-full hover:bg-white/10 transition-colors text-base">
              CreedaVA.com
            </a>
        </div>
      </div>
    </section>

  </article>

  <LegalDisclaimer />

  <Footer slot="footer" />
</BaseLayout>
