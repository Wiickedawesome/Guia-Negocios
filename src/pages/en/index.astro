---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AnimatedLogoHero from '../../components/AnimatedLogoHero.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import favImage from '../../assets/images/GuiaNegociosFAV.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('site.metaTitle')} description={t('site.description')} ogImage="/images/og/og-home.png">
  <Header slot="header" />
  
  <!-- Onyx-Style Hero Section -->
  <section class="bg-brand-dark text-white py-24 lg:py-32 overflow-hidden relative">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-primary/20 via-brand-dark to-brand-dark opacity-80"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Hero Text -->
        <div class="space-y-8">
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-heading font-semibold leading-tight tracking-tight text-slate-50">
            {t('home.hero.title')}
          </h1>
          <p class="text-lg sm:text-xl text-slate-400 max-w-xl leading-relaxed">
            {t('home.hero.subtitle')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pt-4">
            <a href={`/${lang}/contact`} class="inline-flex justify-center items-center bg-brand-primary text-white font-medium py-4 px-8 rounded-full shadow-sm hover:bg-brand-primary/90 transition-all text-lg ring-1 ring-brand-primary/50 hover:ring-brand-primary">
              {t('home.hero.cta')}
            </a>
            <a href={`/${lang}/services`} class="inline-flex justify-center items-center bg-white/5 text-white font-medium py-4 px-8 rounded-full hover:bg-white/10 transition-all text-lg ring-1 ring-white/10 hover:ring-white/20">
              See Our Services
            </a>
          </div>
        </div>
        <!-- Hero Image/Illustration -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="w-full max-w-lg aspect-[4/5] relative z-10 flex flex-col items-center justify-center bg-transparent overflow-hidden">
            <AnimatedLogoHero />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do — Service Showcase (Onyx Grid) -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-sm font-medium tracking-wide mb-6">
            What We Do
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-semibold text-brand-dark leading-tight tracking-tight">
            Everything you need to launch, run &amp; grow your business
          </h2>
        </div>
        <div class="flex-shrink-0">
          <a href={`/${lang}/services`} class="inline-flex items-center justify-center bg-brand-dark text-white font-medium py-3 px-6 rounded-full hover:bg-slate-800 transition-colors text-base gap-2">
            Explore Services
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1: LLC & EIN Registration -->
        <div class="bg-white p-8 rounded-3xl flex flex-col space-y-6 border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-3">
              LLC &amp; EIN Registration
            </h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Tennessee LLC filing guidance, IRS EIN application support, operating agreement templates, and business bank account setup checklists.
            </p>
          </div>
        </div>

        <!-- Card 2: Business Plans & Strategy -->
        <div class="bg-white p-8 rounded-3xl flex flex-col space-y-6 border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-3">
              Business Plans &amp; Strategy
            </h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              One-page business plans, pricing strategy sessions, target audience definition, and 12-month growth roadmaps tailored to your industry.
            </p>
          </div>
        </div>

        <!-- Card 3: Bookkeeping Setup -->
        <div class="bg-white p-8 rounded-3xl flex flex-col space-y-6 border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-3">
              Bookkeeping Setup
            </h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Income and expense tracking, tax-ready categorization, digital invoicing configuration, and profit margin calibration for your trade.
            </p>
          </div>
        </div>

        <!-- Card 4: Branding & Marketing -->
        <div class="bg-white p-8 rounded-3xl flex flex-col space-y-6 border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-3">
              Branding &amp; Marketing
            </h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Logo guidance, brand kits, Google Business Profile optimization, social media setup, WhatsApp Business configuration, and Canva templates.
            </p>
          </div>
        </div>

        <!-- Card 5: Professional Websites -->
        <div class="bg-white p-8 rounded-3xl flex flex-col space-y-6 border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25A2.25 2.25 0 015.25 3h13.5A2.25 2.25 0 0121 5.25z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-3">
              Professional Websites
            </h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Custom multi-page websites with contact forms, WhatsApp integration, bilingual content, local SEO, and Google Search Console connection.
            </p>
          </div>
        </div>

        <!-- Card 6: Operations & Virtual Assistance -->
        <div class="bg-white p-8 rounded-3xl flex flex-col space-y-6 border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-3">
              Operations &amp; Virtual Assistance
            </h3>
            <p class="text-slate-500 leading-relaxed text-sm">
              Scheduling, invoicing, contract templates, client intake systems, and dedicated bilingual virtual assistant support through CreedaVA.
            </p>
          </div>
        </div>
      </div>


      <div class="text-center pt-12">
        <a href={`/${lang}/services`} class="inline-flex items-center justify-center bg-brand-dark text-white font-bold py-4 px-10 rounded-full hover:bg-slate-800 transition-colors text-lg gap-2">
          Explore All Services
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Metrics Bar -->
  <section class="py-12 bg-brand-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div class="space-y-2">
          <div class="text-4xl font-heading font-extrabold text-brand-accent">15+</div>
          <p class="text-slate-300 text-sm font-medium">Businesses Launched</p>
        </div>
        <div class="space-y-2">
          <div class="text-4xl font-heading font-extrabold text-brand-accent">100%</div>
          <p class="text-slate-300 text-sm font-medium">Bilingual Team</p>
        </div>
        <div class="space-y-2">
          <div class="text-4xl font-heading font-extrabold text-brand-accent">East TN</div>
          <p class="text-slate-300 text-sm font-medium">Knoxville &amp; Surrounding Areas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work Section (Onyx Timeline style) -->
  <section class="py-24 lg:py-32 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-16">
        <!-- Heading Column -->
        <div class="lg:w-1/3 space-y-6">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200/50 border border-slate-300/50 text-slate-700 text-sm font-medium tracking-wide">
            Our Process
          </span>
          <h2 class="text-3xl lg:text-5xl font-heading font-semibold text-brand-dark leading-tight">
            How we work
          </h2>
          <p class="text-lg text-slate-500 leading-relaxed">
            Our collaborative approach focuses on transparent, guided partnership to bring your business vision to life.
          </p>
          <div class="pt-4">
            <a href={`/${lang}/contact`} class="inline-flex items-center text-brand-dark font-semibold hover:text-brand-primary gap-2 text-lg group">
              Get in touch with us <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>

        <!-- Cards Grid Column -->
        <div class="lg:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Step 1 -->
          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6 hover:border-brand-primary/50 transition-colors">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-brand-dark font-bold text-lg ring-4 ring-slate-50">
              01
            </div>
            <div>
              <h3 class="text-2xl font-heading font-semibold text-brand-dark mb-2">Consultation</h3>
              <p class="text-slate-500 text-sm leading-relaxed">
                We learn about your goals, assess your situation, and define a clear roadmap for your business.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6 hover:border-brand-primary/50 transition-colors">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-brand-dark font-bold text-lg ring-4 ring-slate-50">
              02
            </div>
            <div>
              <h3 class="text-2xl font-heading font-semibold text-brand-dark mb-2">Planning</h3>
              <p class="text-slate-500 text-sm leading-relaxed">
                We outline your business structure, marketing approach, bookkeeping setup, and growth strategy step-by-step.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6 hover:border-brand-primary/50 transition-colors">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-brand-dark font-bold text-lg ring-4 ring-slate-50">
              03
            </div>
            <div>
              <h3 class="text-2xl font-heading font-semibold text-brand-dark mb-2">Setup</h3>
              <p class="text-slate-500 text-sm leading-relaxed">
                We help you with LLC/EIN registration, branding, and getting your operations up and running.
              </p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6 hover:border-brand-primary/50 transition-colors">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-brand-dark font-bold text-lg ring-4 ring-slate-50">
              04
            </div>
            <div>
              <h3 class="text-2xl font-heading font-semibold text-brand-dark mb-2">Growth</h3>
              <p class="text-slate-500 text-sm leading-relaxed">
                We support your marketing, online presence, and ongoing operations so your business thrives.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Testimonial Section -->
  <section class="py-20 lg:py-28 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-sm font-medium tracking-wide">
          Client Testimonials
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-semibold text-brand-dark leading-tight">
          What our clients say
        </h2>
        <p class="text-lg text-slate-500">
          Hear from entrepreneurs who have successfully launched and scaled their businesses with our guidance.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <!-- Review 1 -->
        <div class="bg-slate-50/70 border border-slate-200/80 rounded-3xl p-8 flex flex-col justify-between space-y-6 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1">
          <div class="space-y-4">
            <div class="flex items-center gap-1 text-amber-400">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed italic">
              "Guia Negocios guided us through every part of setting up our construction business — from LLC registration to our website and bookkeeping. Their bilingual support made the entire process clear and stress-free."
            </p>
          </div>
          <div class="flex items-center gap-3 pt-4 border-t border-slate-200/60">
            <div class="w-11 h-11 rounded-full bg-slate-200 border border-slate-300 flex items-center justify-center text-brand-dark font-bold text-sm">
              SM
            </div>
            <div>
              <h4 class="text-base font-heading text-brand-dark font-semibold">Sylvia M.</h4>
              <p class="text-xs text-slate-500 font-medium">Rocs Construction — Knoxville TN</p>
            </div>
          </div>
