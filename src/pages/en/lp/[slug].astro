---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAdminDb } from '../../../utils/admin-db';
import { db } from '../../../lib/firebase';
import { collection, getDocs, query, where } from 'firebase/firestore';

export async function getStaticPaths() {
  // Build runs in Node, where the client SDK cannot obtain an App Check token,
  // so the Admin SDK is preferred. The client SDK is the fallback for
  // environments that only supply an App Check debug token.
  let docs: any[];

  try {
    const adminDb = getAdminDb();
    if (adminDb) {
      const snapshot = await adminDb.collection('landingPages').where('lang', '==', 'en').get();
      docs = snapshot.docs;
    } else {
      const snapshot = await getDocs(query(collection(db, 'landingPages'), where('lang', '==', 'en')));
      docs = snapshot.docs;
    }
  } catch (err: any) {
    // A failed read must fail the build. Emitting only the empty fallback would
    // silently delete every landing page URL from the deployed site.
    throw new Error(`Could not load EN landing pages at build time: ${err?.message || err}`);
  }

  const pages = docs
    .map((doc: any) => doc.data())
    .filter((lp: any) => typeof lp?.slug === 'string' && lp.slug.trim().length > 0);

  if (pages.length === 0) {
    return [{ params: { slug: 'empty' }, props: { lp: null } }];
  }

  return pages.map((lp: any) => ({
    params: { slug: lp.slug },
    props: { lp },
  }));
}

const { slug } = Astro.params;
const { lp } = Astro.props;

if (!lp) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`${lp.title} | GUIA NEGOCIOS`} description={lp.metaDesc || ''} ogImage={lp.ogImage || ''}>
  <Header slot="header" />
  
  <main class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="landing-page-content max-w-6xl mx-auto space-y-6" set:html={lp.content} />
  </main>

  <Footer slot="footer" />
</BaseLayout>
