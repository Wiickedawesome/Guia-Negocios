---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import launchHeroImg from '../../assets/images/LaunchHERO-Resized.webp';
import favImg from '../../assets/images/GuiaNegociosFAV.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// FAQ data matching business consulting questions
const faqItems = [
  {
    number: "01",
    question: "What is included in the LLC & EIN setup assistance?",
    answer: "We guide you step-by-step through Tennessee LLC registration name availability, filing instructions, IRS EIN application support, an operating agreement template, and a business bank account checklist."
  },
  {
    number: "02",
    question: "How long does the business setup process take?",
    answer: "Starter services typically take 3–10 business days. Foundation packages take 1–3 weeks, Branding & Marketing 2–4 weeks, and Complete Launch Bundles take 4–10 weeks depending on client readiness."
  },
  {
    number: "03",
    question: "Do you offer full bilingual support in Spanish and English?",
    answer: "Yes! All of our consulting sessions, documentation, checklists, templates, and communication are fully bilingual in English and Spanish so you can make decisions comfortably."
  },
  {
    number: "04",
    question: "Can I start with one service and upgrade to a bundle later?",
    answer: "Absolutely. Many clients start with a single Starter Service or Foundation Package and move into Branding, Website Setup, or CreedaVA ongoing support as their business grows."
  },
  {
    number: "05",
    question: "How do payment terms work for packages?",
    answer: "Work begins after an initial discovery call, signed service agreement, and deposit. Projects generally require a 50% deposit with remaining milestones or final balance upon completion."
  }
];
---

<BaseLayout title={`${t('services.title')} | ${t('site.title')}`} description={t('services.metaDescription')} ogImage="/images/og/og-services.png">
  <Header slot="header" />
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  })} />
  
  <!-- Redesigned Image-Free Services Hero Section -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-brand-dark font-extrabold leading-tight">
        Bilingual Launch & Growth Packages
      </h1>
      <p class="text-slate-600 text-lg lg:text-xl leading-relaxed max-w-3xl mx-auto">
        Practical support in English and Spanish to take your business from concept to official launch, market visibility, and scalable operations.
      </p>
      
      <!-- Feature Highlights Bar -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs font-bold text-slate-700">
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl shadow-sm">
          <span class="text-brand-primary font-bold">✓</span> 100% Bilingual Support
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl shadow-sm">
          <span class="text-brand-primary font-bold">✓</span> Hands-On Execution
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl shadow-sm">
          <span class="text-brand-primary font-bold">✓</span> Knoxville TN Local Focus
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: Core Launch Packages (Figma 4-Card Layout & Expanded PDF Deliverables) -->
  <section class="py-20 bg-white">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading text-brand-dark leading-tight">
          {t('services.coreHeading')}
        </h2>
        <p class="text-slate-600 text-lg">
          Essential packages designed to register, structure, and launch your business with confidence.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8 items-stretch pt-4">
        
        <!-- Tier 1: Starter Services -->
        <div class="bg-white border border-slate-200/80 rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-600 text-xs font-semibold tracking-wide mb-3">Tier 01</span>
              <h3 class="text-2xl font-heading text-brand-dark font-bold leading-snug">{t('services.tier1.name')}</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier1.description')}</p>
            <ul class="space-y-4 text-sm text-slate-700 pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Business structure guidance (LLC vs. Sole Prop vs. S-Corp)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">TN LLC registration & IRS EIN application assistance</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Operating Agreement template & bank checklist</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Basic 1-page business plan & pricing snapshot</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Basic bookkeeping setup (income, expenses, taxes)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">+</span>
                <span class="text-slate-600 text-sm leading-relaxed font-medium">... and much more</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-dark hover:bg-slate-800 text-white font-semibold py-4 px-6 rounded-2xl transition-all text-base shadow-sm hover:shadow">
              Get Started
            </a>
          </div>
        </div>

        <!-- Tier 2: Foundation Package -->
        <div class="bg-white border border-slate-200/80 rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-600 text-xs font-semibold tracking-wide mb-3">Tier 02</span>
              <h3 class="text-2xl font-heading text-brand-dark font-bold leading-snug">{t('services.tier2.name')}</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier2.description')}</p>
            <ul class="space-y-4 text-sm text-slate-700 pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Business structure & entity setup roadmap</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Compliance checklist (licenses, annual reports, insurance)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Full bookkeeping setup (categories, taxes, owner draws)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">1-on-1 pricing strategy session</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">+</span>
                <span class="text-slate-600 text-sm leading-relaxed font-medium">... and much more</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-dark hover:bg-slate-800 text-white font-semibold py-4 px-6 rounded-2xl transition-all text-base shadow-sm hover:shadow">
              Get Started
            </a>
          </div>
        </div>

        <!-- Tier 3: Brand & Marketing Setup (FEATURED CARD) -->
        <div class="bg-brand-dark rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-2xl text-white relative border-2 border-brand-accent transform lg:-translate-y-3 lg:scale-[1.02] transition-all duration-300">
          <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-brand-accent text-brand-dark text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-md">
            Most Popular
          </span>
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-brand-accent text-xs font-semibold tracking-wide mb-3">Tier 03</span>
              <h3 class="text-2xl font-heading text-white font-bold leading-snug">{t('services.tier3.name')}</h3>
            </div>
            <p class="text-slate-200 text-sm leading-relaxed opacity-90">{t('services.tier3.description')}</p>
            <ul class="space-y-4 text-sm text-white pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Logo guidance, color palette & simple Brand Kit</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Facebook, Instagram & Google Business optimization</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">WhatsApp Business setup (catalog, greeting, quick replies)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Canva templates & starter content calendar</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">+</span>
                <span class="text-slate-100 text-sm leading-relaxed font-medium">... and much more</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-accent hover:bg-yellow-300 text-brand-dark font-bold py-4 px-6 rounded-2xl shadow-md text-base transition-all">
              Get Started
            </a>
          </div>
        </div>

        <!-- Tier 4: Website Setup -->
        <div class="bg-white border border-slate-200/80 rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-600 text-xs font-semibold tracking-wide mb-3">Tier 04</span>
              <h3 class="text-2xl font-heading text-brand-dark font-bold leading-snug">{t('services.tier4.name')}</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier4.description')}</p>
            <ul class="space-y-4 text-sm text-slate-700 pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Platform selection & digital strategy planning</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Professional multi-page custom website build</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Contact form, quote request & WhatsApp integration</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Local SEO & Google Search Console connection</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">+</span>
                <span class="text-slate-600 text-sm leading-relaxed font-medium">... and much more</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-dark hover:bg-slate-800 text-white font-semibold py-4 px-6 rounded-2xl transition-all text-base shadow-sm hover:shadow">
              Get Started
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SECTION 2: Advanced Growth & Launch Bundles (Onyx Content Cards Layout) -->
  <section class="py-20 lg:py-28 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading text-brand-dark leading-tight">
          {t('services.advancedHeading')}
        </h2>
        <p class="text-lg text-slate-600">
          Comprehensive implementation packages designed to scale your operations, launch your brand, and provide ongoing support.
        </p>
      </div>

      <!-- Onyx Main Featured Content Card (Tier 05 - Complete Business Launch Bundle) -->
      <div class="bg-white border border-slate-200 rounded-3xl p-8 lg:p-12 shadow-lg mb-12 hover:shadow-xl transition-all duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
          <div class="lg:col-span-6 overflow-hidden rounded-2xl bg-slate-200 border border-slate-200 relative lg:h-full min-h-[400px]">
            <Image src={launchHeroImg} alt="Complete Business Launch Bundle" widths={[400, 800, 1200]} sizes="(max-width: 1024px) 100vw, 50vw" class="w-full h-full object-cover lg:absolute lg:inset-0" loading="lazy" decoding="async" />
          </div>
          <div class="lg:col-span-6 space-y-6 self-center py-6">
            <div class="flex items-center gap-3">
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-700 text-xs font-bold tracking-wide">Tier 05</span>
              <div class="inline-flex items-center gap-1.5 bg-brand-accent/30 text-brand-dark px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-dark" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                {t('services.tier5.badge')}
              </div>
            </div>
            <h3 class="text-3xl sm:text-4xl font-heading text-brand-dark font-semibold leading-tight">
              {t('services.tier5.name')}
            </h3>
            <p class="text-slate-600 leading-relaxed text-base">
              {t('services.tier5.description')}
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-700 pt-2">
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> All Foundation Setup
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Brand & Marketing Kit
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Professional Website
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Operations & Invoicing
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Templates & Scripts
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Launch Coaching
              </li>

            </ul>
            <div class="pt-4">
              <a href={`/${lang}/services/complete-launch-bundle`} class="inline-block bg-brand-dark text-white font-semibold py-3.5 px-8 rounded-full hover:bg-slate-800 transition-colors text-base shadow-sm">
                Learn More
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Onyx Bottom Row Content Cards (Tier 06 & Tier 07) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-12">
        <!-- Tier 06 (Operations & Growth Systems) -->
        <div class="bg-white border border-slate-200 rounded-3xl p-8 lg:p-12 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-6">
            <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center text-brand-dark shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-brand-primary block mb-1">Tier 06</span>
              <h3 class="text-2xl font-heading text-brand-dark font-semibold">{t('services.tier6.name')}</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier6.description')}</p>
            <ul class="space-y-3 text-sm text-slate-700">
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Scheduling & Invoicing tools
