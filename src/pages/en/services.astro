            <div class="flex items-start gap-4 pt-4 border-t border-slate-100">
              <div class="w-12 h-12 rounded-2xl bg-slate-50 border border-slate-100 flex-shrink-0 flex items-center justify-center text-brand-dark shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div class="space-y-1">
                <h4 class="text-lg font-heading text-brand-dark font-semibold">Financial Setup Guidance</h4>
                <p class="text-slate-500 text-sm leading-relaxed">
                  Guidance on tracking expenses, opening business bank accounts, and basic bookkeeping setup.
                </p>
              </div>
            </div>

            <!-- Item 3 -->
            <div class="flex items-start gap-4 pt-4 border-t border-slate-100">
              <div class="w-12 h-12 rounded-2xl bg-slate-50 border border-slate-100 flex-shrink-0 flex items-center justify-center text-brand-dark shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.25-2.142V8.25" /></svg>
              </div>
              <div class="space-y-1">
                <h4 class="text-lg font-heading text-brand-dark font-semibold">Permit Lookup & Running</h4>
                <p class="text-slate-500 text-sm leading-relaxed">
                  Assistance with researching, applying for, and securing necessary construction, zoning, or business permits.
                </p>
              </div>
            </div>

            <!-- Item 4 -->
            <div class="flex items-start gap-4 pt-4 border-t border-slate-100">
              <div class="w-12 h-12 rounded-2xl bg-slate-50 border border-slate-100 flex-shrink-0 flex items-center justify-center text-brand-dark shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.125 2.25h-4.5c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125v-9M10.125 2.25h.375a9 9 0 019 9v.375M10.125 2.25A3.375 3.375 0 0113.5 5.625v1.5c0 .621.504 1.125 1.125 1.125h1.5a3.375 3.375 0 013.375 3.375M9 15l2.25 2.25L15 12" /></svg>
              </div>
              <div class="space-y-1">
                <h4 class="text-lg font-heading text-brand-dark font-semibold">Contractor Admin Support</h4>
                <p class="text-slate-500 text-sm leading-relaxed">
                  Back-office support for contractors including professional estimates, invoicing, and contract drafting.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Request a Custom Service Banner -->
      <div class="mt-16 bg-white border border-slate-200 rounded-3xl p-8 lg:p-10 shadow-sm flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 text-brand-primary text-xs font-bold uppercase tracking-wider">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            Custom Work & Special Requests
          </div>
          <h3 class="text-2xl font-heading text-brand-dark font-semibold">
            Don't see the specific service you need?
          </h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            We provide custom business consulting, tailored document assistance, bilingual support, and bespoke digital solutions for small businesses. Contact us today to discuss your specific project.
          </p>
        </div>
        <div class="flex-shrink-0 w-full md:w-auto">
          <a href={`/${lang}/contact`} class="block w-full md:w-auto text-center bg-brand-accent hover:bg-yellow-300 text-brand-dark font-bold py-3.5 px-6 rounded-full transition-colors text-base shadow-md">
            Request Custom Service
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION 4: FAQ Accordion (Figma Node 86:77 style) -->
  <FaqAccordion
    title={t('services.faqTitle')}
    contactText={t('services.faqContactText')}
    contactUrl={`/${lang}/contact`}
    viewMoreText={t('services.faqViewAll')}
    viewMoreUrl={`/${lang}/faq`}
    items={faqItems}
  />

  <!-- SECTION 5: Full-Width Call to Action -->
  <section class="py-24 lg:py-32 bg-slate-100 border-t border-slate-200 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-12 relative z-10">
      <div class="max-w-2xl space-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-semibold leading-tight text-brand-dark">
          Excited to work together on your next project?
        </h2>
        <p class="text-lg text-slate-600 max-w-xl">
          Ready to turn your business idea into reality? Let our bilingual experts guide you through every step of your entrepreneurial journey.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a href={`/${lang}/contact`} class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold py-4 px-8 rounded-full shadow-md hover:bg-brand-primary/90 transition-all text-lg gap-2">
            Get in touch
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href={`/${lang}/services`} class="inline-flex items-center justify-center bg-white border border-slate-300 text-brand-dark font-medium py-4 px-8 rounded-full hover:bg-slate-50 transition-colors text-lg">
            Learn more
          </a>
        </div>
      </div>
      <div class="w-full lg:w-auto flex-shrink-0 flex justify-center">
        <Image src={favImg} alt="Call to Action" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 400px" class="w-full max-w-xs md:max-w-sm mx-auto drop-shadow-xl" loading="lazy" />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
