---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="SEO Agent | Admin" activePath="/admin/seo-agent">
  <!-- Header + master control bar -->
  <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-slate-900 font-heading">SEO & GEO Agent</h1>
        <span id="agent-status-pill" class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
          <span id="agent-status-dot" class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
          <span id="agent-status-text">Loading…</span>
        </span>
      </div>
      <p class="text-sm text-slate-500 mt-1">Autonomous bilingual search intelligence: daily skill rotation, GSC rank snapshots, AEO/GEO citation scoring, and weekly synthesis.</p>
    </div>

    <div class="flex items-center gap-3 w-full md:w-auto">
      <button id="toggle-kill-switch" class="px-3.5 py-2 text-xs font-semibold rounded-lg border transition-colors whitespace-nowrap"
        style="display:none"></button>
      <button id="run-audit-btn" class="cursor-pointer px-4 py-2 bg-white border border-slate-300 text-slate-700 text-sm font-semibold rounded-lg hover:bg-slate-50 transition-colors flex items-center gap-2 whitespace-nowrap disabled:opacity-50">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Run Site-Wide Audit
      </button>
      <button id="run-all-btn" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-emerald-900 transition-colors flex items-center gap-2 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed">
        ⚡ Run All 8 Skills Now
      </button>
    </div>
  </div>

  <div id="agent-toast" style="display:none" class="fixed bottom-6 right-6 z-50 rounded-xl bg-slate-900 px-5 py-3 text-xs font-semibold text-white shadow-xl items-center gap-2">
    <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span id="agent-toast-msg"></span>
  </div>

  <!-- Site-Wide Audit Section (merged from /admin/seo-audit) -->
  <div class="mb-8">
    <!-- Loading / Empty / Results -->
    <div id="audit-loading" class="hidden py-12 text-center bg-white rounded-xl border border-slate-200 shadow-sm p-8">
      <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-slate-200 border-t-brand-primary mb-4"></div>
      <p class="text-slate-800 font-bold text-base">Crawling site & evaluating SEO health with Gemini...</p>
      <p class="text-xs text-slate-500 mt-1">Analyzing all 25+ bilingual pages, meta tags, heading hierarchies, mobile readiness, and structured data.</p>
    </div>

    <div id="audit-empty" class="hidden py-12 text-center bg-white rounded-xl border border-slate-200 shadow-sm">
      <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900">No Audits Found</h3>
      <p class="text-sm text-slate-500 mt-1 mb-6">Run a site-wide scan to generate your first SEO report.</p>
      <button onclick="document.getElementById('run-audit-btn').click()" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-emerald-900 inline-flex items-center gap-2">
        Start First Scan
      </button>
    </div>

    <div id="audit-results" class="hidden">
      <div class="flex flex-col lg:flex-row gap-6 mb-6">
        <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm flex-1">
          <div class="flex flex-col sm:flex-row items-center gap-8 h-full">
            <div class="relative w-36 h-36 flex-shrink-0">
              <svg class="w-36 h-36 -rotate-90" viewBox="0 0 144 144">
                <circle cx="72" cy="72" r="60" fill="none" stroke="#e2e8f0" stroke-width="12" />
                <circle id="score-ring" cx="72" cy="72" r="60" fill="none" stroke="#10b981" stroke-width="12" stroke-dasharray="377" stroke-dashoffset="377" stroke-linecap="round" class="transition-all duration-1000 ease-out" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span id="score-text" class="text-3xl font-bold text-slate-900">0%</span>
                <span id="score-label" class="text-sm font-medium text-emerald-600">POOR</span>
              </div>
            </div>
            <div class="flex-1 text-center sm:text-left">
              <h3 class="text-lg font-bold text-slate-900 mb-1">Global SEO Health</h3>
              <p class="text-sm text-slate-500 mb-3">Aggregated score based on <span id="pages-scanned-count" class="font-bold text-slate-700">0</span> pages scanned.</p>
              <p class="text-xs text-slate-400">Last scan: <span id="last-scan-date" class="font-medium text-slate-600">Never</span></p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-r from-brand-dark to-slate-800 rounded-xl p-8 shadow-sm text-white flex-[2]">
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <h3 class="text-lg font-bold">AI Executive Summary</h3>
          </div>
          <p id="ai-summary-text" class="text-sm text-slate-300 leading-relaxed">Loading summary...</p>
        </div>
      </div>

      <!-- Combined: audit priority items + agent directives, one list, dismiss/fix-now on each -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
          <h3 class="font-bold text-slate-900">Action Items & Agent Directives</h3>
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Fix now, mark done, or dismiss</span>
        </div>
        <div id="action-items-list" class="mb-2">
          <div class="px-6 py-6 text-center text-sm text-slate-500">Loading action items…</div>
        </div>
        <div id="tasks-list">
          <div class="px-6 py-6 text-center text-sm text-slate-500">Loading directives…</div>
        </div>
      </div>
    </div>
  </div>

  <!-- 7-Day Skills Status Grid -->
  <div class="rounded-xl border border-slate-200 bg-white p-6 sm:p-7 shadow-sm mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
      <div>
        <h2 class="font-heading text-base font-bold text-slate-900">7-Day Autonomous Skills Schedule</h2>
        <p class="text-xs text-slate-500 mt-0.5">Daily scheduled runs with lock isolation and Sunday synthesis rollup.</p>
      </div>
      <div class="text-xs text-slate-500 font-mono bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
        Last agent run: <span id="last-run-at">—</span>
      </div>
    </div>

    <div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <!-- rendered by JS -->
    </div>
  </div>

  <!-- Recent Agent Runs -->
  <div class="rounded-xl border border-slate-200 bg-white p-6 sm:p-7 shadow-sm mb-8">
    <div class="flex items-center justify-between gap-3 mb-6">
      <div>
        <h2 class="font-heading text-base font-bold text-slate-900">Recent Agent Runs</h2>
        <p class="text-xs text-slate-500 mt-0.5">Latest executions from scheduled runs and manual triggers.</p>
      </div>
      <button id="refresh-runs-btn" class="text-xs font-semibold text-slate-600 hover:text-slate-900 border border-slate-200 px-3 py-1.5 rounded-lg hover:bg-slate-50 transition">
        Refresh
      </button>
    </div>
    <div id="recent-runs" class="space-y-2.5">
      <!-- rendered by JS -->
    </div>
  </div>
</AdminLayout>

<style>
  .skill-card { transition: border-color .2s ease; }
  .skill-card:hover { border-color: #cbd5e1; }
</style>

<script>
  import { db, aiModel, functions } from '../../lib/firebase';
  import { escapeHtml, safeUrl } from '../../utils/escape-html';
  import { httpsCallable } from 'firebase/functions';
  import { collection, getDocs, addDoc, query, limit, getDoc, orderBy, serverTimestamp, doc } from 'firebase/firestore';
  import type { DocumentData } from 'firebase/firestore';

  interface SkillDef {
    id: string;
    day: string;
    name: string;
    description: string;
  }

  const SKILLS: SkillDef[] = [
    { id: 'onpage-audit',       day: 'Mon', name: 'On-Page Audit',        description: 'Crawls every sitemap URL, scores titles/meta/heading/canonical/hreflang issues (ES + EN).' },
    { id: 'keyword-gaps',       day: 'Tue', name: 'Keyword Gaps',         description: 'Finds striking-distance queries (pos 11-30) in GSC and discovers new keyword opportunities.' },
    { id: 'citation-audit',     day: 'Wed', name: 'AEO/GEO Citation',     description: 'Scores every blog/service page for AI-answer-engine readiness (FAQ/Article schema, Q headings).' },
    { id: 'serp-analysis',      day: 'Thu', name: 'SERP Analysis',        description: 'Probes top keywords, fetches competing pages, stores word/heading/schema gaps.' },
    { id: 'backlink-prospects', day: 'Fri', name: 'Backlink Prospects',   description: 'Discovers local TN/hispanic-business directories and resource pages worth linking to.' },
    { id: 'brand-mentions',     day: 'Sat', name: 'Brand Mentions',       description: 'Sweeps for unlinked "Guia Negocios" brand mentions and press citations.' },
    { id: 'rank-history',       day: 'Sun', name: 'Rank History',         description: 'Captures 7-day Search Console query + page snapshot for bilingual keyword tracking.' },
    { id: 'synthesizer',        day: 'Sun', name: 'Synthesizer',          description: 'Sunday rollup: converts findings into SEO tasks, content briefs, and a weekly executive report.' },
  ];

  let agentConfig: DocumentData | null = null;
  let recentRuns: DocumentData[] = [];

  // ── helpers ──────────────────────────────────────────
  function showToast(msg: string) {
    const toast = document.getElementById('agent-toast');
    const text = document.getElementById('agent-toast-msg');
    if (!toast || !text) return;
    text.textContent = msg;
    // Toggled with inline style, not with `hidden`. The element also carries
    // `flex`, and both classes set `display`, so whichever Tailwind emits later
    // won - the toast was pinned open instead of appearing on demand.
    toast.style.display = 'flex';
    setTimeout(() => { toast.style.display = 'none'; }, 4000);
  }

  // Map an audit/directive label to the admin page that can actually fix it.
  function getFixToolPage(taskLabel: string, itemUrl: string): string {
    const t = taskLabel.toLowerCase();
    if (t.includes('landing') || itemUrl.includes('/lp/') || itemUrl.includes('/services/')) return '/admin/landing-pages';
    if (t.includes('sitemap')) return '/admin/seo-agent';
    if (t.includes('keyword')) return '/admin/keywords';
    if (t.includes('backlink')) return '/admin/backlinks';
    return '/admin/blog';
  }

  async function loadAgentConfig() {
    try {
      const snap = await getDoc(doc(db, 'integrations', 'seo-agent'));
      agentConfig = snap.exists() ? snap.data() : null;
    } catch (err) {
      console.warn('Failed to load agent config:', err);
    }
    const cfg = (agentConfig?.config ?? agentConfig ?? {}) as any;
    const enabled = cfg.enabled !== false;
    const kill = cfg.killSwitch === true;
    const active = enabled && !kill;

    const pill = document.getElementById('agent-status-pill');
    const dot = document.getElementById('agent-status-dot');
    const label = document.getElementById('agent-status-text');
    if (pill && dot && label) {
      pill.classList.toggle('bg-emerald-50', active);
      pill.classList.toggle('text-emerald-700', active);
      pill.classList.toggle('border-emerald-200', active);
      pill.classList.toggle('bg-amber-50', !active);
      pill.classList.toggle('text-amber-700', !active);
      pill.classList.toggle('border-amber-200', !active);
      dot.className = `h-1.5 w-1.5 rounded-full ${active ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500'}`;
      label.textContent = active ? 'Engine Active' : 'Paused (Kill Switch)';
    }
    const toggle = document.getElementById('toggle-kill-switch') as HTMLButtonElement | null;
    if (toggle) {
      toggle.style.display = 'inline-flex';
      toggle.textContent = active ? 'Pause Autonomous' : 'Enable Autonomous';
      toggle.className = 'px-3.5 py-2 text-xs font-semibold rounded-lg border transition-colors whitespace-nowrap ' +
        (active ? 'border-amber-200 bg-amber-50 text-amber-800 hover:bg-amber-100' : 'border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100');
    }

    const last = document.getElementById('last-run-at');
    if (last) {
      const ts = cfg.lastRunAt ? new Date(String(cfg.lastRunAt)) : null;
      last.textContent = ts && !isNaN(ts.getTime()) ? ts.toLocaleString() : 'never';
    }
  }

  async function loadRecentRuns() {
    const container = document.getElementById('recent-runs');
    if (!container) return;
    try {
      const snap = await getDocs(query(collection(db, 'agent-runs'), orderBy('startedAt', 'desc'), limit(10)));
      recentRuns = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
      if (recentRuns.length === 0) {
        container.innerHTML = `<div class="rounded-xl border border-dashed border-slate-200 p-8 text-center"><p class="text-sm font-semibold text-slate-700">No runs recorded yet.</p><p class="text-xs text-slate-400 mt-1">The agent runs automatically Mon-Sun at 03:00 America/Belize, or click "Run All" to trigger now.</p></div>`;
        return;
      }
      container.innerHTML = (recentRuns as any[]).map((run) => {
        const startedAt = run.startedAt?.toDate ? run.startedAt.toDate() : new Date(String(run.startedAt ?? ''));
        const finishedAt = run.finishedAt?.toDate ? run.finishedAt.toDate() : null;
        const running = run.status === 'in-progress';
        const color = run.status === 'completed' ? 'emerald'
          : run.status === 'partial' ? 'blue'
          : run.status === 'in-progress' ? 'blue'
          : run.status === 'error' ? 'rose'
          : 'slate';
        const find = typeof run.findings === 'number' ? run.findings : (run.summary?.written ?? '—');
        const quota = typeof run.queriesUsed === 'number' ? run.queriesUsed : 0;
        return `<div class="flex flex-col md:flex-row md:items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50/50 px-4 py-3">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-${color}-50 text-${color}-700 border border-${color}-200">
              ${escapeHtml(run.skill || 'unknown')}
            </span>
            <span class="text-xs font-semibold text-slate-800">${escapeHtml(run.status || 'unknown')}</span>
            <span class="text-xs text-slate-500">${startedAt.toLocaleString()}${finishedAt ? ` → ${finishedAt.toLocaleTimeString()}` : (running ? ' (running)' : '')}</span>
          </div>
          <div class="text-xs text-slate-500 font-mono">
            findings: <strong>${find}</strong> · queries: <strong>${quota}</strong>
          </div>
        </div>`;
      }).join('');
    } catch (err) {
      console.warn('Recent runs load failed:', err);
      if (container) container.innerHTML = `<p class="text-xs text-slate-500">Could not load recent runs.</p>`;
    }
  }

  function renderSkills() {
    const grid = document.getElementById('skills-grid');
    if (!grid) return;
    // Map latest agent-runs per skill for lastRun/status
    const latestForSkill = new Map<string, any>();
    for (const run of recentRuns) {
      if (!run.skill || latestForSkill.has(run.skill)) continue;
      latestForSkill.set(run.skill, run);
    }
    grid.innerHTML = SKILLS.map((skill) => {
      const last = latestForSkill.get(skill.id);
      const lastTs = last && (last as any).startedAt
        ? ((last as any).startedAt?.toDate ? (last as any).startedAt.toDate() : new Date(String((last as any).startedAt ?? '')))
        : null;
      const status = last
        ? ((last as any).status === 'completed' ? 'Passed' : (last as any).status === 'partial' ? 'Action Needed' : (last as any).status === 'in-progress' ? 'Running' : 'Failed')
        : 'Pending';
      const pillColor = status === 'Passed' ? 'emerald' : (status === 'Action Needed' || status === 'Running') ? 'blue' : 'slate';
      return `
      <div class="skill-card flex flex-col justify-between rounded-xl border border-slate-200 bg-slate-50/50 p-4">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <span class="font-mono text-[11px] font-bold text-slate-600 uppercase tracking-wider bg-white px-2 py-0.5 rounded border border-slate-200">${skill.day}</span>
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-${pillColor}-50 text-${pillColor}-700 border border-${pillColor}-200">
              <span class="h-1.5 w-1.5 rounded-full bg-${pillColor}-500"></span>${status}
            </span>
          </div>
          <h4 class="font-heading text-sm font-bold text-slate-900 mb-1">${skill.name}</h4>
          <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">${skill.description}</p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-200/70 flex items-center justify-between">
          <span class="text-[10px] text-slate-400 font-mono">${lastTs && !isNaN(lastTs.getTime()) ? 'Last: ' + lastTs.toLocaleDateString() : 'Pending'}</span>
          <button data-skill="${skill.id}" data-name="${skill.name}" class="run-single-btn inline-flex items-center gap-1.5 rounded-md bg-white border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-100 disabled:opacity-50 shadow-sm transition">Run</button>
        </div>
      </div>`;
    }).join('');

    grid.querySelectorAll('.run-single-btn').forEach((btn) => {
      btn.addEventListener('click', () => runSingle((btn as HTMLElement).dataset.skill!, (btn as HTMLElement).dataset.name!));
    });
  }

  // ─── Site-Wide Audit (merged from /admin/seo-audit.astro) ───
  async function loadLatestAudit() {
    try {
      const q = query(collection(db, 'seoAudits'), orderBy('scannedAt', 'desc'), limit(1));
      const snap = await getDocs(q);
      if (snap.empty) {
        document.getElementById('audit-empty')?.classList.remove('hidden');
        return;
      }
      const doc0 = snap.docs[0];
      const data = doc0?.data();
      if (data && doc0) renderAuditData({ ...data, id: doc0.id });
    } catch (e) {
      console.error('Failed to load audit:', e);
    }
  }

  function renderAuditData(data: any) {
    document.getElementById('audit-empty')?.classList.add('hidden');
    document.getElementById('audit-results')?.classList.remove('hidden');

    const score = typeof data.globalScore === 'number' ? data.globalScore
      : (typeof data.overallScore === 'number' ? data.overallScore : null);
    const scoreText = document.getElementById('score-text');
    if (scoreText) scoreText.innerText = score === null ? '—' : `${score}%`;
    const pagesCount = document.getElementById('pages-scanned-count');
    if (pagesCount) pagesCount.innerText = data.pagesScanned ?? data.scannedPages ?? 0;

    let dateStr = 'Just now';
    if (data.scannedAt) {
      if (typeof data.scannedAt.toDate === 'function') dateStr = data.scannedAt.toDate().toLocaleString();
      else if (typeof data.scannedAt.toMillis === 'function') dateStr = new Date(data.scannedAt.toMillis()).toLocaleString();
      else { const parsed = new Date(data.scannedAt); dateStr = isNaN(parsed.getTime()) ? 'Recent' : parsed.toLocaleString(); }
    }
    const lastScan = document.getElementById('last-scan-date');
    if (lastScan) lastScan.innerText = dateStr;

    const ring = document.getElementById('score-ring');
    const offset = 377 - (377 * score) / 100;
    setTimeout(() => {
      if (ring) {
        ring.style.strokeDashoffset = offset.toString();
        ring.setAttribute('stroke', score >= 80 ? '#10b981' : score >= 50 ? '#f59e0b' : '#ef4444');
      }
    }, 100);

    const label = document.getElementById('score-label');
    if (label) {
      label.innerText = score >= 80 ? 'OPTIMAL' : score >= 60 ? 'FAIR' : 'POOR';
      label.className = `text-sm font-medium ${score >= 80 ? 'text-emerald-600' : score >= 60 ? 'text-amber-600' : 'text-red-600'}`;
    }

    const summaryText = document.getElementById('ai-summary-text');
    if (summaryText) summaryText.innerText = data.summary || 'Site-wide crawl complete. All core metrics verified.';

    const actionList = document.getElementById('action-items-list');
    const auditId = data.id;
    const items = data.actionableItems || data.actionItems || [];
    if (actionList) {
      if (items && items.length > 0) {
        actionList.innerHTML = items.map((item: any, idx: number) => {
          const priority = item.priority || 'Medium';
          const isHigh = priority === 'High';
          const isMedium = priority === 'Medium';
          const priorityColor = isHigh ? 'bg-red-50 text-red-700 border-red-200' : (isMedium ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-slate-50 text-slate-700 border-slate-200');
          const dotColor = isHigh ? 'bg-red-500' : (isMedium ? 'bg-amber-500' : 'bg-slate-500');
          return `
            <div class="px-6 py-5 flex flex-col md:flex-row md:items-center gap-4 hover:bg-slate-50 transition-colors audit-item" data-audit-id="${auditId || ''}" data-idx="${idx}">
              <div class="flex items-start gap-4 flex-1 min-w-0">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold border ${priorityColor} uppercase tracking-wide flex-shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                  ${escapeHtml(priority)}
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold text-slate-900 mb-1">${escapeHtml(item.task || item.title || 'Optimization Task')}</p>
                  <p class="text-sm text-slate-600">${escapeHtml(item.impact || item.description || '')}</p>
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0 audit-actions" data-dismissed="${item.dismissed === true}" data-item-url="${escapeHtml(safeUrl(item.url))}" data-task-label="${escapeHtml(item.task || item.title || '')}">
              </div>
            </div>
          `;
        }).join('');

        // Wire Dismiss buttons (hidden once dismissed)
        actionList.querySelectorAll('.audit-item').forEach((rowEl) => {
          // querySelectorAll returns Element; dataset lives on HTMLElement.
          const row = rowEl as HTMLElement;
          const actions = row.querySelector('.audit-actions') as HTMLElement | null;
          if (!actions) return;
          if (actions.dataset.dismissed === 'true') {
            actions.innerHTML = '<span class="text-xs text-slate-400 font-semibold uppercase">Dismissed</span>';
            return;
          }
          const auditIdVal = (row.dataset.auditId || '').slice(0, 100);
          const itemUrl = row.dataset.itemUrl || '';
          const fixLabel = row.dataset.taskLabel || '';
          const toolPage = getFixToolPage(fixLabel, itemUrl);
          const fixHref = itemUrl || toolPage;
          actions.innerHTML = `
            <a href="${fixHref}" ${itemUrl ? 'target="_blank" rel="noopener"' : ''} class="fix-audit-item-btn inline-flex items-center gap-1 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white hover:bg-emerald-700 transition shadow-sm">Fix Now →</a>
            <button class="dismiss-audit-item-btn inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">Dismiss</button>
          `;
          actions.querySelector('.dismiss-audit-item-btn')?.addEventListener('click', async () => {
            if (!auditIdVal) { showToast('Older audit entries can not be dismissed — run a new scan.'); return; }
            try {
              const { updateDoc, arrayUnion } = await import('firebase/firestore');
              const idx = Number((row as HTMLElement).dataset.idx || 0);
              const docRef = doc(db, 'seoAudits', auditIdVal);
              await updateDoc(docRef, {
                dismissedItemIndices: arrayUnion(idx),
              });
              actions.innerHTML = '<span class="text-xs text-slate-400 font-semibold uppercase">Dismissed</span>';
              showToast('Item dismissed — will stay hidden for future scans of this audit.');
            } catch (err: any) {
              showToast(err?.message || 'Dismiss failed.');
            }
          });
        });
      } else {
        actionList.innerHTML = '<div class="px-6 py-8 text-center text-slate-500 text-sm">No action items recorded for this audit.</div>';
      }
    }
  }

  async function runSiteWideAudit() {
    const btn = document.getElementById('run-audit-btn') as HTMLButtonElement | null;
    const loading = document.getElementById('audit-loading');
    const results = document.getElementById('audit-results');
    const empty = document.getElementById('audit-empty');

    if (btn) { btn.disabled = true; btn.innerHTML = 'Scanning…'; }
    loading?.classList.remove('hidden');
    results?.classList.add('hidden');
    empty?.classList.add('hidden');

    try {
      // Define key pages to audit
      const keyPages = [
        { url: '/', label: 'Homepage (ES)' },
        { url: '/en/', label: 'Homepage (EN)' },
        { url: '/en/services/', label: 'Services (EN)' },
        { url: '/es/services/', label: 'Services (ES)' },
        { url: '/en/about/', label: 'About (EN)' },
        { url: '/es/about/', label: 'About (ES)' },
        { url: '/en/blog/', label: 'Blog (EN)' },
        { url: '/es/blog/', label: 'Blog (ES)' },
        { url: '/en/contact/', label: 'Contact (EN)' },
        { url: '/es/contact/', label: 'Contact (ES)' }
      ];

      // Fetch and parse pages for SEO data
      const pageData: any[] = [];
      for (const page of keyPages) {
        try {
          const response = await fetch(page.url);
          if (!response.ok) continue;
          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          
          // Extract SEO metadata
          const title = doc.querySelector('title')?.textContent || '';
          const metaDesc = doc.querySelector('meta[name="description"]')?.getAttribute('content') || '';
          const h1 = doc.querySelector('h1')?.textContent?.trim() || '';
          const h2s = Array.from(doc.querySelectorAll('h2')).slice(0, 3).map(h => h.textContent?.trim()).filter(Boolean);
          const canonical = doc.querySelector('link[rel="canonical"]')?.getAttribute('href') || '';
          const hreflangs = Array.from(doc.querySelectorAll('link[rel="alternate"][hreflang]')).map(l => ({
            lang: l.getAttribute('hreflang'),
            href: l.getAttribute('href')
          }));
          const schemas = Array.from(doc.querySelectorAll('script[type="application/ld+json"]')).map(s => {
            try { return JSON.parse(s.textContent || '{}'); } catch { return null; }
          }).filter(Boolean);

          pageData.push({
            url: page.url,
            label: page.label,
            title,
            metaDescription: metaDesc,
            h1,
            h2s: h2s.slice(0, 3),
            canonical,
            hreflangs,
            hasSchema: schemas.length > 0,
            schemaTypes: schemas.map(s => s['@type']).filter(Boolean)
          });
        } catch (e) {
          console.warn(`Failed to fetch ${page.url}:`, e);
        }
      }
      if (pageData.length === 0) {
        throw new Error('Crawl fetched no pages; refusing to score an empty audit.');
      }

      // Deterministic score. Each page is scored out of 100 and the site score
      // is the mean, so every point traces back to a check that actually ran.
      // Previously the number came from the model, so an unparseable reply or a
      // hallucinated figure produced a confident-looking score.
      let criticalCount = 0;
      let warningCount = 0;
      const pageScores = pageData.map(p => {
        let pageScore = 0;

        const titleLen = p.title.length;
        if (titleLen === 0) { criticalCount++; }
        else if (titleLen >= 50 && titleLen <= 60) { pageScore += 25; }
        else if (titleLen >= 10 && titleLen <= 70) { pageScore += 18; warningCount++; }
        else { pageScore += 10; warningCount++; }

        const metaLen = p.metaDescription.length;
        if (metaLen === 0) { criticalCount++; }
        else if (metaLen >= 50 && metaLen <= 160) { pageScore += 20; }
        else { pageScore += 12; warningCount++; }

        if (p.h1) { pageScore += 20; } else { criticalCount++; }

        if (p.canonical) { pageScore += 15; } else { criticalCount++; }

        const hreflangCount = p.hreflangs.length;
        if (hreflangCount >= 2) { pageScore += 10; }
        else if (hreflangCount === 1) { pageScore += 5; warningCount++; }
        else { warningCount++; }

        if (p.hasSchema) { pageScore += 10; } else { warningCount++; }

        return pageScore;
      });

      const computedScore = Math.round(pageScores.reduce((sum, s) => sum + s, 0) / pageScores.length);
      const issueSummary = `Measured across ${pageData.length} page(s): score ${computedScore}/100, ${criticalCount} critical issue(s) (missing title, meta description, H1 or canonical) and ${warningCount} warning(s) (sub-optimal title/meta length, missing hreflang or schema).`;
      const prompt = `
You are the lead SEO Auditor for GUIA DE NEGOCIOS (guianegocios.net).

A browser crawl measured the following ${pageData.length} pages. These are the ONLY facts available:

${pageData.map(p => `
PAGE: ${p.label} (${p.url})
- Title: "${p.title}" (${p.title.length} chars)
- Meta Description: "${p.metaDescription}" (${p.metaDescription.length} chars)
- H1: ${p.h1 || '(none)'}
- H2s: ${p.h2s.join(', ') || '(none)'}
- Canonical: ${p.canonical || '(missing)'}
- Hreflang tags: ${p.hreflangs.length} (${p.hreflangs.map((h: any) => h.lang).join(', ') || 'none'})
- Schema markup: ${p.hasSchema ? 'YES - ' + p.schemaTypes.join(', ') : 'NO'}
`).join('\n')}

This crawl produced a score of ${computedScore}/100, with ${criticalCount} critical issue(s) and ${warningCount} warning(s).
${issueSummary}

Write the summary and the action items.
Return ONLY valid JSON matching this schema:
{
  "summary": "2-3 sentence executive summary of findings",
  "actionableItems": [
    { "priority": "High|Medium|Low", "task": "specific task", "impact": "what it addresses" }
  ]
}

Grounding rules (mandatory):
- Use only the measured facts above. Every action item must trace to a defect listed above.
- Do not invent traffic, impressions, click-through rates, conversions, rankings, competitor data, or Core Web Vitals scores - none of those were measured here.
- Do not claim anything improved or regressed: this is a single snapshot with no history.
`;

      const aiResponse = await aiModel.generateContent(prompt);
      let responseText: string = (aiResponse as any).response?.text?.() ?? '';
      responseText = responseText.replace(/```json/gi, '').replace(/```/g, '').trim();
      const parsed = JSON.parse(responseText);

      // Score, page count and issue counts are computed from the crawl above.
      // They used to come from the model with defaults of 88/26/1, which meant
      // an unparseable response still produced a confident-looking report.
      const auditData = {
        globalScore: computedScore,
        overallScore: computedScore,
        pagesScanned: pageData.length,
        scannedPages: pageData.length,
        criticalCount,
        warningCount,
        summary: typeof parsed.summary === 'string' && parsed.summary.trim()
          ? parsed.summary.trim()
          : issueSummary,
        actionableItems: Array.isArray(parsed.actionableItems) ? parsed.actionableItems : [],
        scannedAt: serverTimestamp(),
      };

      await addDoc(collection(db, 'seoAudits'), auditData);

      try {
        await addDoc(collection(db, 'notifications'), {
          title: 'Site-Wide SEO Audit Completed',
          message: `New scan finished with a health score of ${auditData.globalScore}% across ${auditData.pagesScanned} pages.`,
          type: 'seo',
          read: false,
          link: '/admin/seo-agent',
          createdAt: serverTimestamp(),
        });
      } catch (ne) {
        console.warn('Failed to write audit notification:', ne);
      }

      renderAuditData({ ...auditData, scannedAt: new Date() });
      loading?.classList.add('hidden');
      results?.classList.remove('hidden');
      showToast('SEO Audit completed and score updated!');
    } catch (error: any) {
      console.error(error);
      showToast(`Audit scan notice: ${error?.message || 'error running scan'}`);
      loading?.classList.add('hidden');
      loadLatestAudit();
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg> Run Site-Wide Audit`;
      }
    }
  }

  // ─── Actions & init ─────────────────────────────────
  // ─── Agent Directives (from /seo-tasks) ──────────────────
  interface TaskEntry { id: string; data: DocumentData; }
  let taskEntries: TaskEntry[] = [];

  async function loadAgentTasks() {
    const container = document.getElementById('tasks-list');
    if (!container) return;
    try {
      const snap = await getDocs(query(collection(db, 'seo-tasks'), orderBy('updatedAt', 'desc'), limit(50)));
      taskEntries = snap.docs.filter((d) => (d.data()?.status ?? 'open') !== 'dismissed' && (d.data()?.status ?? 'open') !== 'resolved')
        .map((d) => ({ id: d.id, data: d.data() }));
    } catch (err) {
      console.warn('Agent tasks load failed:', err);
      taskEntries = [];
    }
    if (taskEntries.length === 0) {
      container.innerHTML = '<div class="px-6 py-8 text-center"><p class="text-sm font-semibold text-slate-700">No open directives.</p><p class="text-xs text-slate-400 mt-1">Agent findings (crawled pages, skill results) appear here once the agent runs Mon-Sun, or after Run All.</p></div>';
      return;
    }
    container.innerHTML = taskEntries.map(({ id, data }) => {
      const severity = data.severity || 'medium';
      const sevColor = severity === 'high' ? 'rose' : severity === 'medium' ? 'amber' : 'blue';
      return `
        <div class="px-6 py-5 flex flex-col md:flex-row md:items-center gap-4 border-b border-slate-100 last:border-0 hover:bg-slate-50 transition-colors" data-task-id="${id}">
          <div class="flex items-start gap-3 flex-1 min-w-0">
            <span class="inline-flex items-center rounded px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-${sevColor}-50 text-${sevColor}-700 border border-${sevColor}-200 flex-shrink-0">${escapeHtml(severity)} priority</span>
            <span class="rounded bg-slate-200/70 px-2 py-0.5 text-[10px] font-semibold text-slate-700 flex-shrink-0">${escapeHtml(data.type || 'issue')}</span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-slate-900">${escapeHtml(data.message || 'Issue detected')}</p>
              ${data.fix ? `<p class="text-xs text-slate-600 mt-1">${escapeHtml(data.fix)}</p>` : ''}
              ${data.url ? `<a href="${escapeHtml(safeUrl(data.url))}" class="text-xs text-blue-600 hover:underline truncate block">${escapeHtml(data.url)}</a>` : ''}
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            ${data.url ? `<a href="${data.url}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-lg bg-brand-primary px-3.5 py-2 text-xs font-bold text-white hover:bg-emerald-900 transition shadow-sm">Fix Now →</a>` : `<a href="${getFixToolPage(data.message || '', '')}" class="inline-flex items-center gap-1.5 rounded-lg bg-brand-primary px-3.5 py-2 text-xs font-bold text-white hover:bg-emerald-900 transition shadow-sm">Fix Now →</a>`}
            <button class="resolve-task-btn inline-flex items-center gap-1 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800 hover:bg-emerald-100 transition">Mark Done</button>
            <button class="dismiss-task-btn p-2 text-slate-400 hover:text-slate-600 transition" title="Dismiss">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
        </div>`;
    }).join('');

    container.querySelectorAll('[data-task-id]').forEach((row) => {
      const taskId = (row as HTMLElement).dataset.taskId || '';
      const markStatus = async (status: string) => {
        try {
          const { updateDoc } = await import('firebase/firestore');
          await updateDoc(doc(db, 'seo-tasks', taskId), { status, updatedAt: new Date() });
          row.remove();
          showToast(status === 'resolved' ? 'Marked done.' : 'Dismissed.');
        } catch (err: any) {
          showToast(err?.message || 'Update failed.');
        }
      };
      row.querySelector('.resolve-task-btn')?.addEventListener('click', () => markStatus('resolved'));
      row.querySelector('.dismiss-task-btn')?.addEventListener('click', () => markStatus('dismissed'));
    });
  }

  async function runSingle(skillId: string, skillName: string) {
    try {
      const callable = httpsCallable(functions, 'seoAgentRun');
      const res: any = await callable({ skill: skillId });
      const status = res?.data?.status ?? 'unknown';
      showToast(status === 'ok' || status === 'partial' ? `${skillName} executed (${status}).` : status === 'locked' ? `${skillName} is already running — skipped.` : status === 'killswitch' ? 'Kill switch is engaged.' : `${skillName}: ${status}`);
    } catch (err: any) {
      showToast(err?.message || `Error running ${skillName}.`);
    } finally {
      await Promise.all([loadRecentRuns(), loadAgentConfig()]);
      renderSkills();
    }
  }

  async function runAll() {
    const btn = document.getElementById('run-all-btn') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.innerHTML = 'Running all skills…'; }
    const results: string[] = [];
    for (const skill of SKILLS) {
      try {
        const callable = httpsCallable(functions, 'seoAgentRun');
        const res: any = await callable({ skill: skill.id });
        results.push(`${skill.day} ${skill.name}: ${res?.data?.status ?? 'unknown'}`);
      } catch (err: any) {
        results.push(`${skill.day} ${skill.name}: ${err?.message || 'error'}`);
      }
    }
    showToast(`Executed 8 skills. ${results[0]} … ` + results[results.length - 1]);
    await Promise.all([loadRecentRuns(), loadAgentConfig()]);
    renderSkills();
    if (btn) { btn.disabled = false; btn.innerHTML = '⚡ Run All 8 Skills Now'; }
  }

  async function toggleKillSwitch() {
    try {
      const cfg = (agentConfig?.config ?? agentConfig ?? {}) as { enabled?: boolean; killSwitch?: boolean };
      const currentlyActive = cfg.enabled !== false && cfg.killSwitch !== true;
      await getDoc(doc(db, 'integrations', 'seo-agent'));
      // Write directly — config doc is admin-writable via Firestore UI for now.
      const { updateDoc } = await import('firebase/firestore');
      await updateDoc(doc(db, 'integrations', 'seo-agent'), { config: { enabled: currentlyActive, killSwitch: !currentlyActive } });
      showToast(currentlyActive ? 'Kill switch engaged — autonomous engine paused.' : 'Engine re-enabled.');
      await loadAgentConfig();
    } catch (err: any) {
      showToast(err?.message || 'Toggle failed.');
    }
  }

  (document.getElementById('toggle-kill-switch') as HTMLElement | null)?.addEventListener('click', toggleKillSwitch);
  (document.getElementById('run-all-btn') as HTMLElement | null)?.addEventListener('click', runAll);
  (document.getElementById('run-audit-btn') as HTMLElement | null)?.addEventListener('click', runSiteWideAudit);
  (document.getElementById('refresh-runs-btn') as HTMLElement | null)?.addEventListener('click', async () => {
    await Promise.all([loadRecentRuns(), loadAgentConfig()]);
    renderSkills();
  });

  (async function init() {
    await Promise.all([loadAgentConfig(), loadRecentRuns(), loadLatestAudit(), loadAgentTasks()]);
    renderSkills();
  })();
</script>
