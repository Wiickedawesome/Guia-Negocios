---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<!--
  This page is a live mirror of Google Search Console.

  It deliberately keeps NO copy of the data: every load reads GSC through the
  getSearchConsoleQueries callable, so what is shown here is exactly what GSC
  reports for the selected window. The previous version of this page rendered
  a manually-curated "tracked keywords" collection, which drifted from reality
  (it once displayed invented rankings) and never showed the queries Google
  actually reports. Removed 2026-10-18 per owner decision.
-->

<AdminLayout title="Keywords | Admin">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Keywords</h1>
      <p class="text-sm text-slate-500 mt-1">Live query performance, read directly from Google Search Console.</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="sc-refresh-btn" class="cursor-pointer px-4 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-medium rounded-lg shadow-sm hover:bg-slate-50 transition-colors flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Refresh
      </button>
      <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-lg p-1">
        <button class="sc-range-btn px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900" data-range="28">28 Days</button>
        <button class="sc-range-btn px-3 py-1.5 text-sm font-medium rounded-md bg-slate-100 text-slate-900" data-range="90">90 Days</button>
        <button class="sc-range-btn px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900" data-range="365">Year</button>
      </div>
    </div>
  </div>

  <!-- Shown when the GSC query fails; the metrics blank out rather than
       leaving stale numbers on screen. -->
  <div id="sc-error" class="hidden mb-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800"></div>

  <!-- Headline metrics, mirroring the Search Console performance summary -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Clicks</div>
      <div class="text-3xl font-bold text-slate-900" id="sc-clicks">...</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Impressions</div>
      <div class="text-3xl font-bold text-slate-900" id="sc-impressions">...</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Average CTR</div>
      <div class="text-3xl font-bold text-slate-900" id="sc-ctr">...</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Average Position</div>
      <div class="text-3xl font-bold text-slate-900" id="sc-position">...</div>
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-8">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Queries by position</h3>
      <span id="sc-range-label" class="text-xs text-slate-400"></span>
    </div>
    <div class="grid grid-cols-4 gap-4 text-center">
      <div>
        <div id="sc-band-top3" class="text-2xl font-bold text-emerald-600">—</div>
        <div class="text-xs text-slate-500 mt-1">Top 3</div>
      </div>
      <div>
        <div id="sc-band-top10" class="text-2xl font-bold text-blue-600">—</div>
        <div class="text-xs text-slate-500 mt-1">4 – 10</div>
      </div>
      <div>
        <div id="sc-band-top20" class="text-2xl font-bold text-slate-700">—</div>
        <div class="text-xs text-slate-500 mt-1">11 – 20</div>
      </div>
      <div>
        <div id="sc-band-rest" class="text-2xl font-bold text-slate-400">—</div>
        <div class="text-xs text-slate-500 mt-1">21+</div>
      </div>
    </div>
  </div>

  <!-- Search Console queries table -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <div class="relative w-64">
        <input id="sc-search-input" type="text" placeholder="Search queries..." class="w-full pl-9 pr-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary" />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </div>
      <span id="sc-count" class="text-xs font-semibold text-slate-400 uppercase tracking-wider">—</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-4 font-medium">Query</th>
            <th class="px-6 py-4 font-medium">Position</th>
            <th class="px-6 py-4 font-medium">Impressions</th>
            <th class="px-6 py-4 font-medium">Clicks</th>
            <th class="px-6 py-4 font-medium">CTR</th>
          </tr>
        </thead>
        <tbody id="sc-queries-body" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-slate-500">
              <svg class="animate-spin h-5 w-5 text-brand-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Loading Search Console data...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { app } from '../../lib/firebase';
    import { escapeHtml } from '../../utils/escape-html';
    import { getFunctions, httpsCallable } from 'firebase/functions';

    interface SearchConsoleQuery {
      query: string;
      clicks: number;
      impressions: number;
      ctr: number | null;
      position: number | null;
    }

    function setRangeButtons(activeRange: string) {
      document.querySelectorAll('.sc-range-btn').forEach(btn => {
        const isActive = (btn as HTMLElement).dataset.range === activeRange;
        btn.classList.toggle('bg-slate-100', isActive);
        btn.classList.toggle('text-slate-900', isActive);
        btn.classList.toggle('text-slate-600', !isActive);
        btn.classList.toggle('hover:text-slate-900', !isActive);
      });
    }

    function setText(id: string, value: string) {
      const el = document.getElementById(id);
      if (el) el.innerText = value;
    }

    function clearSummary() {
      [
        'sc-clicks', 'sc-impressions', 'sc-ctr', 'sc-position',
        'sc-band-top3', 'sc-band-top10', 'sc-band-top20', 'sc-band-rest',
        'sc-count',
      ].forEach(id => setText(id, '—'));
      setText('sc-range-label', '');
    }

    function positionBand(query: SearchConsoleQuery): 'top3' | 'top10' | 'top20' | 'rest' {
      if (query.position === null) return 'rest';
      if (query.position <= 3) return 'top3';
      if (query.position <= 10) return 'top10';
      if (query.position <= 20) return 'top20';
      return 'rest';
    }

    function renderSummary(queries: SearchConsoleQuery[], rangeLabel: string) {
      const clicks = queries.reduce((sum, q) => sum + q.clicks, 0);
      const impressions = queries.reduce((sum, q) => sum + q.impressions, 0);
      const ctr = impressions > 0 ? (clicks / impressions) * 100 : null;

      // Impression-weighted average, the same way Search Console computes it.
      const positioned = queries.filter(q => q.position !== null);
      const weighted = positioned.reduce((sum, q) => sum + (q.position as number) * Math.max(q.impressions, 1), 0);
      const totalWeight = positioned.reduce((sum, q) => sum + Math.max(q.impressions, 1), 0);
      const avgPosition = totalWeight > 0 ? weighted / totalWeight : null;

      const bands = { top3: 0, top10: 0, top20: 0, rest: 0 };
      queries.forEach(q => { bands[positionBand(q)]++; });

      setText('sc-clicks', String(clicks));
      setText('sc-impressions', String(impressions));
      setText('sc-ctr', ctr === null ? '—' : `${ctr.toFixed(1)}%`);
      setText('sc-position', avgPosition === null ? '—' : `#${avgPosition.toFixed(1)}`);
      setText('sc-band-top3', String(bands.top3));
      setText('sc-band-top10', String(bands.top10));
      setText('sc-band-top20', String(bands.top20));
      setText('sc-band-rest', String(bands.rest));
      setText('sc-range-label', rangeLabel);
    }

    function renderQueries(queries: SearchConsoleQuery[]) {
      const tbody = document.getElementById('sc-queries-body');
      const count = document.getElementById('sc-count');
      if (!tbody) return;

      if (queries.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">No queries recorded in this period. Google reports nothing for a window with no impressions.</td></tr>`;
        if (count) count.innerText = '0 queries';
        return;
      }

      tbody.innerHTML = queries.map(q => {
        const posClass = q.position !== null && q.position <= 10 ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-700';
        const posText = q.position === null ? '—' : `#${q.position.toFixed(1)}`;
        const ctrText = q.impressions > 0 && q.ctr !== null ? `${(q.ctr * 100).toFixed(1)}%` : '—';
        return `
          <tr class="sc-query-row hover:bg-slate-50/50" data-q="${escapeHtml(q.query.toLowerCase())}">
            <td class="px-6 py-4 font-medium text-brand-dark">${escapeHtml(q.query)}</td>
            <td class="px-6 py-4"><span class="px-2 py-1 ${posClass} font-bold rounded">${posText}</span></td>
            <td class="px-6 py-4 text-slate-600">${q.impressions}</td>
            <td class="px-6 py-4 text-slate-600">${q.clicks}</td>
            <td class="px-6 py-4 text-slate-600">${ctrText}</td>
          </tr>
        `;
      }).join('');
      if (count) count.innerText = `${queries.length} queries`;
    }

    function showError(message: string) {
      const banner = document.getElementById('sc-error');
      if (banner) {
        banner.textContent = message;
        banner.classList.remove('hidden');
      }
      clearSummary();
      const tbody = document.getElementById('sc-queries-body');
      if (tbody) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">Search Console data unavailable.</td></tr>`;
      }
    }

    async function loadQueries(range: string) {
      setRangeButtons(range);

      const tbody = document.getElementById('sc-queries-body');
      if (tbody) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">Loading Search Console data...</td></tr>`;
      }
      clearSummary();

      try {
        const functions = getFunctions(app);
        const fetchQueries = httpsCallable(functions, 'getSearchConsoleQueries');
        const response = await fetchQueries({ range });
        const data = response.data as any;

        if (data.ok === false) {
          showError(`Google Search Console did not return data: ${data.message || 'the query failed'}. Nothing is shown because nothing was returned.`);
          return;
        }

        const banner = document.getElementById('sc-error');
        if (banner) banner.classList.add('hidden');

        renderSummary(data.queries, `Last ${data.range.days} days · ${data.range.startDate} → ${data.range.endDate}`);
        renderQueries(data.queries);
      } catch (error: any) {
        console.error('Search Console fetch failed:', error);
        showError(`Could not reach Search Console: ${error?.message || error}. Nothing is shown because nothing was returned.`);
      }
    }

    document.querySelectorAll('.sc-range-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const range = (btn as HTMLElement).dataset.range || '90';
        loadQueries(range);
      });
    });

    document.getElementById('sc-refresh-btn')?.addEventListener('click', () => {
      const active = document.querySelector('.sc-range-btn.bg-slate-100') as HTMLElement | null;
      loadQueries(active?.dataset.range || '90');
    });

    document.getElementById('sc-search-input')?.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll('.sc-query-row').forEach(row => {
        const query = row.getAttribute('data-q') || '';
        (row as HTMLElement).style.display = query.includes(term) ? '' : 'none';
      });
    });

    loadQueries('90');
  </script>
</AdminLayout>
