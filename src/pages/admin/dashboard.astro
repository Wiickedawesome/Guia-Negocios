---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard Overview | Admin">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Overview</h1>
      <p class="text-sm text-slate-500 mt-1">Welcome back, Admin. Here is what's happening with your site.</p>
    </div>
    <div class="flex gap-3">
      <a href="/admin/blog" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
        + New Post
      </a>
      <a href="/admin/reports" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-medium rounded-lg shadow-sm hover:bg-slate-50 transition-colors">
        Generate Report
      </a>
    </div>
  </div>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div>
          <p class="text-sm font-medium text-slate-500">Total Visitors (30d)</p>
          <h3 class="text-2xl font-bold text-slate-900 mt-1" id="dash-metric-visitors">...</h3>
        </div>
        <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </div>
      </div>
      <div class="flex items-center text-xs text-slate-500 font-medium" id="dash-metric-visitors-sub">
        <span>Verified GA4 Traffic</span>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div>
          <p class="text-sm font-medium text-slate-500">Tracked Keywords</p>
          <h3 class="text-2xl font-bold text-slate-900 mt-1" id="dash-metric-keywords">...</h3>
        </div>
        <div class="p-2 bg-purple-50 text-purple-600 rounded-lg">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>
        </div>
      </div>
      <div class="flex items-center text-xs text-slate-500 font-medium" id="dash-metric-keywords-sub">
        <span>Active Search Rankings</span>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div>
          <p class="text-sm font-medium text-slate-500">Global SEO Health</p>
          <h3 class="text-2xl font-bold text-slate-900 mt-1" id="dash-metric-seo">...</h3>
        </div>
        <div class="p-2 bg-emerald-50 text-emerald-600 rounded-lg">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
      </div>
      <div class="flex items-center text-xs font-medium" id="dash-metric-seo-sub">
        <span class="text-emerald-600 font-semibold" id="dash-metric-seo-label">Latest Audit Health</span>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div>
          <p class="text-sm font-medium text-slate-500">Backlinks</p>
          <h3 class="text-2xl font-bold text-slate-900 mt-1" id="dash-metric-backlinks">...</h3>
        </div>
        <div class="p-2 bg-amber-50 text-amber-600 rounded-lg">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
        </div>
      </div>
      <div class="flex items-center text-xs text-slate-500 font-medium" id="dash-metric-backlinks-sub">
        <span>Verified Referring Links</span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Chart placeholder -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm lg:col-span-2">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-lg font-bold text-slate-900">Traffic Overview</h3>
        <select class="text-sm border-slate-200 rounded-md text-slate-600">
          <option>Last 30 Days</option>
          <option>Last 7 Days</option>
          <option>This Year</option>
        </select>
      </div>
      <div class="h-64 w-full relative">
        <canvas id="trafficChart"></canvas>
      </div>
    </div>

    <!-- Right column -->
    <div class="space-y-6">
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-4">Top Keywords</h3>
        <div class="space-y-4" id="dash-top-keywords-list">
          <div class="animate-pulse flex justify-between items-center">
            <div class="h-4 bg-slate-200 rounded w-1/2"></div>
            <div class="h-4 bg-slate-200 rounded w-8"></div>
          </div>
          <div class="animate-pulse flex justify-between items-center">
            <div class="h-4 bg-slate-200 rounded w-1/3"></div>
            <div class="h-4 bg-slate-200 rounded w-8"></div>
          </div>
          <div class="animate-pulse flex justify-between items-center">
            <div class="h-4 bg-slate-200 rounded w-2/5"></div>
            <div class="h-4 bg-slate-200 rounded w-8"></div>
          </div>
        </div>
        <a href="/admin/keywords" class="block text-center text-sm text-brand-primary font-medium mt-4 hover:underline">View all keywords</a>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-4">Recent AI Drafts</h3>
        <div class="space-y-3" id="dash-recent-drafts">
          <div class="animate-pulse flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-slate-200"></span>
            <div class="h-4 bg-slate-200 rounded w-3/4"></div>
          </div>
          <div class="animate-pulse flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-slate-200"></span>
            <div class="h-4 bg-slate-200 rounded w-1/2"></div>
          </div>
        </div>
        <a href="/admin/blog" class="block text-center text-sm text-brand-primary font-medium mt-4 hover:underline">Manage Blog</a>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    import { app } from '../../lib/firebase';
    import { getFunctions, httpsCallable } from 'firebase/functions';
    import { getFirestore, collection, getDocs, query, orderBy, limit, getCountFromServer, where } from 'firebase/firestore';

    async function loadDashAnalytics() {
      try {
        const functions = getFunctions(app);
        const getAnalyticsData = httpsCallable(functions, 'getAnalyticsData');
        const result = await getAnalyticsData();
        const data = result.data as any;

        // getAnalyticsData reports a genuine failure instead of substituting
        // sample numbers, so say the data is unavailable rather than leaving
        // the loading placeholder in place forever.
        if (data.ok === false) {
          const el = document.getElementById('dash-metric-visitors');
          if (el) el.innerText = '—';
          const sub = document.getElementById('dash-metric-visitors-sub');
          if (sub) {
            sub.innerText = 'GA4 unavailable';
            sub.className = 'flex items-center text-xs text-amber-600 font-medium';
          }
          return;
        }

        if (data.totals) {
          const el = document.getElementById('dash-metric-visitors');
          if (el) el.innerText = data.totals.activeUsers;
        }

        if (data.timeSeries && data.timeSeries.length > 0) {
          const labels = data.timeSeries.map((item: any) => item.date);
          const users = data.timeSeries.map((item: any) => parseInt(item.users, 10));
          
          const formattedLabels = labels.map((dateStr: string) => {
            if (dateStr.length !== 8) return dateStr;
            const year = dateStr.substring(0, 4);
            const month = dateStr.substring(4, 6);
            const day = dateStr.substring(6, 8);
            const d = new Date(`${year}-${month}-${day}T12:00:00Z`);
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          });

          const ctx = document.getElementById('trafficChart') as HTMLCanvasElement;
          if (ctx) {
            // @ts-ignore
            new window.Chart(ctx, {
              type: 'line',
              data: {
                labels: formattedLabels,
                datasets: [{
                  label: 'Active Users',
                  data: users,
                  borderColor: '#0284c7',
                  backgroundColor: 'rgba(2, 132, 199, 0.1)',
                  borderWidth: 2,
                  fill: true,
                  tension: 0.4
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                  legend: { display: false }
                },
                scales: {
                  y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                  x: { grid: { display: false } }
                }
              }
            });
          }
        }
      } catch (error) {
        console.error('Error fetching analytics:', error);
      }
    }

    async function loadFirestoreMetrics() {
      const db = getFirestore(app);

      try {
        // 1. Total Keywords (approx count)
        const keywordsSnap = await getCountFromServer(collection(db, 'keywords'));
        const kwEl = document.getElementById('dash-metric-keywords');
        if (kwEl) kwEl.innerText = keywordsSnap.data().count.toString();
        
        // 2. SEO Score (latest audit from seoAudits collection)
        let seoScoreVal: number | null = null;

        try {
          const seoQuery = query(collection(db, 'seoAudits'), orderBy('scannedAt', 'desc'), limit(1));
          const seoSnap = await getDocs(seoQuery);
          if (!seoSnap.empty) {
            const auditData = seoSnap.docs[0].data();
            seoScoreVal = auditData.globalScore ?? auditData.overallScore ?? auditData.score ?? null;
          }
        } catch (e) {
          console.warn('Fallback query for seoAudits:', e);
        }

        if (seoScoreVal === null) {
          try {
            const fallbackQuery = query(collection(db, 'seoAudits'), limit(5));
            const fallbackSnap = await getDocs(fallbackQuery);
            if (!fallbackSnap.empty) {
              const auditData = fallbackSnap.docs[0].data();
              seoScoreVal = auditData.globalScore ?? auditData.overallScore ?? auditData.score ?? null;
            }
          } catch (e) {
            console.error('Error fetching fallback seoAudits:', e);
          }
        }

        const seoEl = document.getElementById('dash-metric-seo');
        const seoSubLabel = document.getElementById('dash-metric-seo-label');
        if (seoEl) {
          if (seoScoreVal !== null && !isNaN(seoScoreVal)) {
            seoEl.innerText = `${seoScoreVal}%`;
            if (seoSubLabel) {
              seoSubLabel.innerText = seoScoreVal >= 80 ? 'Good Health Score' : (seoScoreVal >= 50 ? 'Fair Health Score' : 'Needs Optimization');
              seoSubLabel.className = seoScoreVal >= 80 ? 'text-emerald-600 font-semibold' : (seoScoreVal >= 50 ? 'text-amber-600 font-semibold' : 'text-rose-600 font-semibold');
            }
          } else {
            // No audit exists yet. This branch used to display a hardcoded
            // "79% / Fair Health (25 Pages Scanned)", i.e. a score for a scan
            // that never ran. Say so instead.
            seoEl.innerText = '—';
            if (seoSubLabel) {
              seoSubLabel.innerText = 'No audit yet — run one from SEO Agent';
              seoSubLabel.className = 'text-slate-400 font-semibold';
            }
          }
        }

        // 3. Backlinks
        const backlinksSnap = await getCountFromServer(collection(db, 'backlinks'));
        const blEl = document.getElementById('dash-metric-backlinks');
        if (blEl) blEl.innerText = backlinksSnap.data().count.toString();

        // 4. Recent AI Drafts & Blog Posts
        try {
          const blogsQuery = query(collection(db, 'blogs'), orderBy('createdAt', 'desc'), limit(15));
          let blogsSnap;
          try {
            blogsSnap = await getDocs(blogsQuery);
          } catch {
            blogsSnap = await getDocs(query(collection(db, 'blogs'), limit(10)));
          }
          const draftsContainer = document.getElementById('dash-recent-drafts');
          if (draftsContainer && blogsSnap) {
            const validDrafts = blogsSnap.docs.filter(doc => {
              const d = doc.data();
              return (d.titleEs && d.titleEs.trim() !== '') || (d.titleEn && d.titleEn.trim() !== '') || (d.title && d.title.trim() !== '');
            }).slice(0, 5);
            if (validDrafts.length === 0) {
              draftsContainer.innerHTML = '<p class="text-sm text-slate-500 italic">No recent drafts.</p>';
            } else {
              draftsContainer.innerHTML = validDrafts.map(doc => {
                const data = doc.data();
                const title = data.titleEs || data.titleEn || data.title || 'Untitled Post';
                const isPublished = (data.status || '').toLowerCase() === 'published';
                const dotColor = isPublished ? 'bg-emerald-500' : 'bg-amber-400';
                return `
                  <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full ${dotColor} shrink-0"></span>
                    <span class="text-sm text-slate-700 truncate flex-1 font-medium">${title}</span>
                    <span class="text-xs px-2 py-0.5 rounded-full font-medium ${isPublished ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}">${isPublished ? 'Published' : 'Draft'}</span>
                  </div>
                `;
              }).join('');
            }
          }
        } catch (e) {
          console.error('Error fetching recent drafts:', e);
        }

        // 5. Top Keywords (List)
        try {
          const topKwQuery = query(collection(db, 'keywords'), orderBy('position', 'asc'), limit(3));
          const topKwSnap = await getDocs(topKwQuery);
          const topKwContainer = document.getElementById('dash-top-keywords-list');
          if (topKwContainer) {
            if (topKwSnap.empty) {
              topKwContainer.innerHTML = '<p class="text-sm text-slate-500 italic">No keywords tracked yet.</p>';
            } else {
              topKwContainer.innerHTML = topKwSnap.docs.map(doc => {
                const data = doc.data();
                const trend = (data.trend || '').toLowerCase();
                
                let trendIcon = '';
                let trendColor = 'text-slate-500';
                if (trend.includes('up')) {
                  trendIcon = '↑';
                  trendColor = 'text-emerald-600';
                } else if (trend.includes('down')) {
                  trendIcon = '↓';
                  trendColor = 'text-red-500';
                } else if (trend.includes('stable') || trend.includes('flat')) {
                  trendIcon = '−';
                  trendColor = 'text-slate-400';
                }
                
                return `
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-slate-700 font-medium">${data.keyword || 'Unknown'}</span>
                    <span class="text-sm font-bold ${trendColor}">#${Math.round(data.position || 0)} ${trendIcon}</span>
                  </div>
                `;
              }).join('');
            }
          }
        } catch (e) {
          console.error('Error fetching top keywords:', e);
        }

      } catch (error) {
        console.error('Error fetching Firestore metrics:', error);
      }
    }

    setTimeout(loadDashAnalytics, 1500);
    setTimeout(loadFirestoreMetrics, 500);
  </script>
</AdminLayout>
