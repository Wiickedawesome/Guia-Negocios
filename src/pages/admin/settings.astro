---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings | Admin">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 font-heading">Settings</h1>
    <p class="text-sm text-slate-500 mt-1">Manage your profile, API keys, and dashboard preferences.</p>
  </div>

  <div class="space-y-6 max-w-3xl">
    <!-- Profile -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <h3 class="text-lg font-bold text-slate-900 mb-4">Profile</h3>
      <div class="space-y-4">
        <div class="flex items-center gap-4 mb-2">
          <div id="settings-avatar" class="w-16 h-16 rounded-full bg-brand-primary/10 flex items-center justify-center text-2xl font-bold text-brand-primary uppercase">
            A
          </div>
          <button id="btn-upload-photo" class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50">Upload Photo</button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Name</label>
            <input id="prof-name" type="text" placeholder="Loading..." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white disabled:bg-slate-50" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
            <input id="prof-email" type="email" disabled placeholder="Loading..." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 cursor-not-allowed" />
          </div>
        </div>
        <button id="btn-save-profile" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
          Save Profile
        </button>
      </div>
    </div>

    <!-- API Keys -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold text-slate-900">API Keys</h3>
        <div class="flex items-center gap-2">
          <span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 font-semibold rounded-full border border-emerald-200 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Vertex AI Active ($300 Credit)
          </span>
        </div>
      </div>
      <div class="space-y-4">
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block text-sm font-medium text-slate-700">Gemini / Vertex AI API Key <span class="text-xs text-slate-400 font-normal">(Optional Fallback)</span></label>
            <span id="key-badge" class="text-xs text-slate-400">Untested</span>
          </div>
          <div class="flex gap-2">
            <input id="api-gemini" type="password" placeholder="Enter optional fallback key..." class="flex-1 px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-mono" />
            <button id="btn-show-key" type="button" class="px-3 py-2 text-sm border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 flex-shrink-0">Show</button>
            <button id="btn-test-key" type="button" class="px-3 py-2 text-sm bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg text-slate-700 font-medium flex-shrink-0 flex items-center gap-1.5 transition-colors">
              <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              Test Key
            </button>
          </div>
          <p class="text-xs text-slate-400 mt-1">Vertex AI is automatically enabled through your Firebase project credits. You do not need to provide a separate API key unless you want an external fallback.</p>
          <div id="gemini-key-status" class="mt-2 text-xs hidden"></div>
        </div>
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block text-sm font-medium text-slate-700">Pexels API Key</label>
            <span id="pexels-badge" class="text-xs text-slate-400">Untested</span>
          </div>
          <div class="flex gap-2">
            <input id="api-pexels" type="password" placeholder="Enter Pexels API Key..." class="flex-1 px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-mono" />
            <button id="btn-show-pexels" type="button" class="px-3 py-2 text-sm border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 flex-shrink-0">Show</button>
            <button id="btn-test-pexels" type="button" class="px-3 py-2 text-sm bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg text-slate-700 font-medium flex-shrink-0 flex items-center gap-1.5 transition-colors">
              <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Test Key
            </button>
          </div>
          <div id="pexels-key-status" class="mt-2 text-xs hidden"></div>
        </div>
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block text-sm font-medium text-slate-700">Unsplash Access Key</label>
            <span id="unsplash-badge" class="text-xs text-slate-400">Untested</span>
          </div>
          <div class="flex gap-2">
            <input id="api-unsplash" type="password" placeholder="Enter Unsplash Access Key..." class="flex-1 px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-mono" />
            <button id="btn-show-unsplash" type="button" class="px-3 py-2 text-sm border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 flex-shrink-0">Show</button>
            <button id="btn-test-unsplash" type="button" class="px-3 py-2 text-sm bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg text-slate-700 font-medium flex-shrink-0 flex items-center gap-1.5 transition-colors">
              <svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Test Key
            </button>
          </div>
          <div id="unsplash-key-status" class="mt-2 text-xs hidden"></div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">GA4 Measurement ID</label>
          <input id="api-ga4" type="text" placeholder="G-XXXXXXXXXX" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-mono" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Search Console Property URL</label>
          <input id="api-gsc" type="url" placeholder="https://guianegocios.net" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-mono" />
        </div>
        <button id="btn-save-apikeys" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
          Save API Keys
        </button>
      </div>
    </div>

    <!-- Preferences -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <h3 class="text-lg font-bold text-slate-900 mb-4">Preferences</h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between py-2">
          <div>
            <p class="text-sm font-medium text-slate-700">Dark Mode</p>
            <p class="text-xs text-slate-500">Use dark theme for the admin dashboard</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input id="toggle-dark-mode" type="checkbox" class="sr-only peer" />
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-primary"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white rounded-xl border border-red-200 p-6 shadow-sm">
      <h3 class="text-lg font-bold text-red-600 mb-2">Danger Zone</h3>
      <p class="text-sm text-slate-500 mb-4">Irreversible actions. Proceed with caution.</p>
      <div class="flex gap-3">
        <button id="btn-reset-data" class="px-4 py-2 bg-white border border-red-200 text-red-600 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors">
          Reset All Data
        </button>
      </div>
    </div>
  </div>

  <script>
    import { app, getGeminiApiKey, testGeminiApiKey } from '../../lib/firebase';
    import { getUnsplashAccessKey, testUnsplashKey, getPexelsApiKey, testPexelsApiKey } from '../../utils/unsplash';
    import { getAuth, updateProfile } from 'firebase/auth';
    import { getFirestore, doc, getDoc, setDoc } from 'firebase/firestore';

    const auth = getAuth(app);
    const db = getFirestore(app);

    // Initial Load
    auth.onAuthStateChanged(async (user) => {
      if (user) {
        // One-time hygiene: earlier versions cached API keys in localStorage.
        ['gemini_api_key', 'pexels_api_key', 'unsplash_access_key'].forEach((key) => {
          try { localStorage.removeItem(key); } catch { /* storage unavailable */ }
        });

        // Load Profile
        (document.getElementById('prof-name') as HTMLInputElement).value = user.displayName || 'Admin';
        (document.getElementById('prof-email') as HTMLInputElement).value = user.email || '';
        document.getElementById('settings-avatar')!.innerText = (user.displayName || user.email || 'A')[0].toUpperCase();

        // Load Settings
        let currentGeminiKey = '';
        let currentUnsplashKey = '';
        let currentPexelsKey = '';
        try {
          const settingsDoc = await getDoc(doc(db, 'settings', 'admin'));
          if (settingsDoc.exists()) {
            const data = settingsDoc.data();
            currentGeminiKey = data.geminiKey || '';
            currentUnsplashKey = data.unsplashKey || '';
            currentPexelsKey = data.pexelsKey || '';
            (document.getElementById('api-ga4') as HTMLInputElement).value = data.ga4Id || '';
            (document.getElementById('api-gsc') as HTMLInputElement).value = data.gscUrl || '';
          }
        } catch (e) {
          console.warn('Settings load notice:', e);
        }

        if (!currentGeminiKey) {
          currentGeminiKey = await getGeminiApiKey();
        }
        if (!currentUnsplashKey) {
          currentUnsplashKey = await getUnsplashAccessKey();
        }
        if (!currentPexelsKey) {
          currentPexelsKey = await getPexelsApiKey();
        }

        // Keys are write-only in this form: inputs are never prefilled with
        // the stored secret (a prefilled value sits in the DOM for any script
        // to read). The badge/test below still verifies the saved key.
        const geminiInput = document.getElementById('api-gemini') as HTMLInputElement;
        if (geminiInput && currentGeminiKey) {
          geminiInput.placeholder = 'Key saved — leave blank to keep it';
          runKeyTest(currentGeminiKey, false);
        }

        const pexelsInput = document.getElementById('api-pexels') as HTMLInputElement;
        if (pexelsInput && currentPexelsKey) {
          pexelsInput.placeholder = 'Key saved — leave blank to keep it';
          runPexelsTest(currentPexelsKey, false);
        }

        const unsplashInput = document.getElementById('api-unsplash') as HTMLInputElement;
        if (unsplashInput && currentUnsplashKey) {
          unsplashInput.placeholder = 'Key saved — leave blank to keep it';
          runUnsplashTest(currentUnsplashKey, false);
        }
      }
    });

    // Test Gemini Key Function
    async function runKeyTest(keyToTest: string, showAlert = true) {
      const statusEl = document.getElementById('gemini-key-status');
      const badgeEl = document.getElementById('key-badge');
      const testBtn = document.getElementById('btn-test-key') as HTMLButtonElement;

      if (!keyToTest) {
        if (badgeEl) { badgeEl.textContent = 'Missing Key'; badgeEl.className = 'text-xs text-amber-500 font-medium'; }
        if (statusEl) { statusEl.className = 'mt-2 text-xs text-amber-600'; statusEl.textContent = 'Please enter a Gemini API Key.'; statusEl.classList.remove('hidden'); }
        return;
      }

      if (testBtn) { testBtn.disabled = true; testBtn.innerText = 'Testing...'; }
      if (badgeEl) { badgeEl.textContent = 'Verifying...'; badgeEl.className = 'text-xs text-slate-400'; }

      const result = await testGeminiApiKey(keyToTest);

      if (testBtn) {
        testBtn.disabled = false;
        testBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Test Key';
      }

      if (result.valid) {
        if (badgeEl) { badgeEl.textContent = `✓ Active (${result.model})`; badgeEl.className = 'text-xs text-emerald-600 font-semibold'; }
        if (statusEl) {
          statusEl.className = 'mt-2 text-xs text-emerald-600 font-medium flex items-center gap-1';
          statusEl.innerHTML = `✓ Connected successfully to Google Gemini (${result.model}). Ready for blog generation!`;
          statusEl.classList.remove('hidden');
        }
        if (showAlert) window.showToast?.('Gemini API key is verified and operational!', 'success');
      } else {
        if (badgeEl) { badgeEl.textContent = '✕ Issue Detected'; badgeEl.className = 'text-xs text-red-500 font-semibold'; }
        if (statusEl) {
          statusEl.className = 'mt-2 text-xs text-red-600 font-medium';
          statusEl.textContent = `Connection issue: ${result.error}`;
          statusEl.classList.remove('hidden');
        }
        if (showAlert) window.showToast?.(`Key error: ${result.error}`, 'error');
      }
    }

    document.getElementById('btn-test-key')?.addEventListener('click', () => {
      const keyVal = (document.getElementById('api-gemini') as HTMLInputElement)?.value?.trim();
      runKeyTest(keyVal, true);
    });

    // Test Pexels Key Function
    async function runPexelsTest(keyToTest: string, showAlert = true) {
      const statusEl = document.getElementById('pexels-key-status');
      const badgeEl = document.getElementById('pexels-badge');
      const testBtn = document.getElementById('btn-test-pexels') as HTMLButtonElement;

      if (!keyToTest) {
        if (badgeEl) { badgeEl.textContent = 'Optional'; badgeEl.className = 'text-xs text-slate-400 font-medium'; }
        if (statusEl) { statusEl.className = 'mt-2 text-xs text-slate-500'; statusEl.textContent = 'Pexels API key not configured.'; statusEl.classList.remove('hidden'); }
        return;
      }

      if (testBtn) { testBtn.disabled = true; testBtn.innerText = 'Testing...'; }
      if (badgeEl) { badgeEl.textContent = 'Verifying...'; badgeEl.className = 'text-xs text-slate-400'; }

      const result = await testPexelsApiKey(keyToTest);

      if (testBtn) {
        testBtn.disabled = false;
        testBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg> Test Key';
      }

      if (result.valid) {
        if (badgeEl) { badgeEl.textContent = '✓ Active & Verified'; badgeEl.className = 'text-xs text-emerald-600 font-semibold'; }
        if (statusEl) {
          statusEl.className = 'mt-2 text-xs text-emerald-600 font-medium';
          statusEl.textContent = '✓ Connected to Pexels API. Live stock photo search and unique image selection are active!';
          statusEl.classList.remove('hidden');
        }
        if (showAlert) window.showToast?.('Pexels API Key verified successfully!', 'success');
      } else {
        if (badgeEl) { badgeEl.textContent = '✕ Error'; badgeEl.className = 'text-xs text-red-500 font-semibold'; }
        if (statusEl) {
          statusEl.className = 'mt-2 text-xs text-red-600 font-medium';
          statusEl.textContent = `Pexels issue: ${result.error}`;
          statusEl.classList.remove('hidden');
        }
        if (showAlert) window.showToast?.(`Pexels error: ${result.error}`, 'error');
      }
    }

    document.getElementById('btn-test-pexels')?.addEventListener('click', () => {
      const keyVal = (document.getElementById('api-pexels') as HTMLInputElement)?.value?.trim();
      runPexelsTest(keyVal, true);
    });

    // Test Unsplash Key Function
    async function runUnsplashTest(keyToTest: string, showAlert = true) {
      const statusEl = document.getElementById('unsplash-key-status');
      const badgeEl = document.getElementById('unsplash-badge');
      const testBtn = document.getElementById('btn-test-unsplash') as HTMLButtonElement;

      if (!keyToTest) {
        if (badgeEl) { badgeEl.textContent = 'Curated Pool Active'; badgeEl.className = 'text-xs text-brand-primary font-medium'; }
        if (statusEl) { statusEl.className = 'mt-2 text-xs text-slate-500'; statusEl.textContent = 'Using Pexels or curated pool of 65+ unique business photos.'; statusEl.classList.remove('hidden'); }
        return;
      }

      if (testBtn) { testBtn.disabled = true; testBtn.innerText = 'Testing...'; }
      if (badgeEl) { badgeEl.textContent = 'Verifying...'; badgeEl.className = 'text-xs text-slate-400'; }

      const result = await testUnsplashKey(keyToTest);

      if (testBtn) {
        testBtn.disabled = false;
        testBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg> Test Key';
      }

      if (result.valid) {
        if (badgeEl) { badgeEl.textContent = '✓ Active & Verified'; badgeEl.className = 'text-xs text-emerald-600 font-semibold'; }
        if (statusEl) {
          statusEl.className = 'mt-2 text-xs text-emerald-600 font-medium';
          statusEl.textContent = '✓ Connected to Unsplash API. Unique photo search & album tracking are active!';
          statusEl.classList.remove('hidden');
        }
        if (showAlert) window.showToast?.('Unsplash Access Key verified successfully!', 'success');
      } else {
        if (badgeEl) { badgeEl.textContent = '✕ Error'; badgeEl.className = 'text-xs text-red-500 font-semibold'; }
        if (statusEl) {
          statusEl.className = 'mt-2 text-xs text-red-600 font-medium';
          statusEl.textContent = `Unsplash issue: ${result.error}`;
          statusEl.classList.remove('hidden');
        }
        if (showAlert) window.showToast?.(`Unsplash error: ${result.error}`, 'error');
      }
    }

    document.getElementById('btn-test-unsplash')?.addEventListener('click', () => {
      const keyVal = (document.getElementById('api-unsplash') as HTMLInputElement)?.value?.trim();
      runUnsplashTest(keyVal, true);
    });

    // Save Profile
    document.getElementById('btn-save-profile')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-save-profile') as HTMLButtonElement;
      const name = (document.getElementById('prof-name') as HTMLInputElement).value;
      
      btn.disabled = true;
      btn.innerText = 'Saving...';
      try {
        if (auth.currentUser) {
          await updateProfile(auth.currentUser, { displayName: name });
          document.getElementById('settings-avatar')!.innerText = name[0].toUpperCase();
          window.showToast?.('Profile updated successfully!', 'success');
        }
      } catch (e: any) {
        alert('Failed to update profile: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerText = 'Save Profile';
      }
    });

    // Save API Keys & Preferences
    const saveSettings = async (btnId: string, originalText: string) => {
      const btn = document.getElementById(btnId) as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = 'Saving...';
      try {
        const geminiVal = (document.getElementById('api-gemini') as HTMLInputElement).value?.trim();
        const pexelsVal = (document.getElementById('api-pexels') as HTMLInputElement)?.value?.trim() || '';
        const unsplashVal = (document.getElementById('api-unsplash') as HTMLInputElement)?.value?.trim() || '';

        // Fields start blank (write-only form); a blank field means "keep the
        // stored key", so only non-empty values are persisted. Keys live in
        // settings/admin only — never in localStorage.
        await setDoc(doc(db, 'settings', 'admin'), {
          ...(geminiVal ? { geminiKey: geminiVal } : {}),
          ...(pexelsVal ? { pexelsKey: pexelsVal } : {}),
          ...(unsplashVal ? { unsplashKey: unsplashVal } : {}),
          ga4Id: (document.getElementById('api-ga4') as HTMLInputElement).value,
          gscUrl: (document.getElementById('api-gsc') as HTMLInputElement).value
        }, { merge: true });

        if (geminiVal) await runKeyTest(geminiVal, false);
        if (pexelsVal) await runPexelsTest(pexelsVal, false);
        if (unsplashVal) await runUnsplashTest(unsplashVal, false);

        window.showToast?.('Settings saved successfully!', 'success');
      } catch (e: any) {
        alert('Failed to save settings: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerText = originalText;
      }
    };

    document.getElementById('btn-save-apikeys')?.addEventListener('click', () => saveSettings('btn-save-apikeys', 'Save API Keys'));
    
    // Danger Zone
    document.getElementById('btn-reset-data')?.addEventListener('click', () => {
      window.showConfirm?.('Reset All Data', 'This will permanently delete all SEO metrics, keyword tracking data, and report history. This cannot be undone.').then(ok => {
        if (ok) window.showToast?.('Data reset cancelled — this is a demo environment.', 'warning');
      });
    });

    // Show/hide API keys
    document.getElementById('btn-show-key')?.addEventListener('click', function() {
      const input = document.getElementById('api-gemini') as HTMLInputElement;
      if (input?.type === 'password') {
        input.type = 'text';
        this.textContent = 'Hide';
      } else if (input) {
        input.type = 'password';
        this.textContent = 'Show';
      }
    });

    document.getElementById('btn-show-pexels')?.addEventListener('click', function() {
      const input = document.getElementById('api-pexels') as HTMLInputElement;
      if (input?.type === 'password') {
        input.type = 'text';
        this.textContent = 'Hide';
      } else if (input) {
        input.type = 'password';
        this.textContent = 'Show';
      }
    });

    document.getElementById('btn-show-unsplash')?.addEventListener('click', function() {
      const input = document.getElementById('api-unsplash') as HTMLInputElement;
      if (input?.type === 'password') {
        input.type = 'text';
        this.textContent = 'Hide';
      } else if (input) {
        input.type = 'password';
        this.textContent = 'Show';
      }
    });
    
    // Dark mode logic
    const darkModeToggle = document.getElementById('toggle-dark-mode') as HTMLInputElement;
    if (darkModeToggle) {
      darkModeToggle.checked = document.documentElement.classList.contains('dark');
      darkModeToggle.addEventListener('change', (e: any) => {
        if (e.target.checked) {
          document.documentElement.classList.add('dark');
          localStorage.setItem('adminDarkMode', 'true');
          window.showToast?.('Dark mode enabled', 'success');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('adminDarkMode', 'false');
          window.showToast?.('Dark mode disabled', 'info');
        }
      });
    }
  </script>
</AdminLayout>
