---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Tracked Backlinks | Admin">
  <div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Tracked Backlinks</h1>
      <p class="text-sm text-slate-500 mt-1">Autonomous monitoring for active backlinks, dofollow status, and link health.</p>
    </div>
    <div class="flex items-center gap-3 w-full md:w-auto">
      <button id="verify-links-btn" class="cursor-pointer px-4 py-2 bg-white text-slate-700 border border-slate-200 text-sm font-medium rounded-lg shadow-sm hover:bg-slate-50 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Verify All Now
      </button>
      <button id="add-link-btn" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        Add Backlink
      </button>
    </div>
  </div>

  <!-- Sub-Navigation Tabs between the 2 pages -->
  <div class="flex items-center gap-2 mb-6 border-b border-slate-200 pb-3">
    <a href="/admin/backlinks" class="px-4 py-2 text-sm font-bold bg-brand-primary text-white rounded-lg shadow-sm flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
      Tracked Backlinks
      <span id="tab-tracked-badge" class="px-1.5 py-0.5 bg-white/20 text-white text-xs font-bold rounded-full">0</span>
    </a>
    <a href="/admin/backlinks/outreach" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      Outreach & Pitch Drafts
      <span id="tab-outreach-badge" class="px-1.5 py-0.5 bg-brand-primary/10 text-brand-primary text-xs font-bold rounded-full">0</span>
    </a>
  </div>

  <!-- Metric Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-8">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-xs md:text-sm font-medium text-slate-500 mb-1">Total Tracked</p>
      <h3 id="stat-total" class="text-xl md:text-2xl font-bold text-slate-900">0</h3>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-xs md:text-sm font-medium text-slate-500 mb-1">Active</p>
      <h3 id="stat-active" class="text-xl md:text-2xl font-bold text-emerald-600">0</h3>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-xs md:text-sm font-medium text-slate-500 mb-1">Lost / Error</p>
      <h3 id="stat-lost" class="text-xl md:text-2xl font-bold text-red-500">0</h3>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-xs md:text-sm font-medium text-slate-500 mb-1">NoFollow</p>
      <h3 id="stat-nofollow" class="text-xl md:text-2xl font-bold text-amber-500">0</h3>
    </div>
  </div>

  <!-- Full-Width Tracked Backlinks Table -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <div>
        <h3 class="text-lg font-bold text-slate-900">Active Monitored Backlinks</h3>
        <p class="text-xs text-slate-500 mt-0.5">Automated crawling verifies anchor text, indexability, and HTTP response codes.</p>
      </div>
      <span id="loading-indicator" class="text-xs text-brand-primary font-medium animate-pulse hidden">Verifying...</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 font-medium">Source URL</th>
            <th class="px-6 py-3 font-medium">Status</th>
            <th class="px-6 py-3 font-medium">Type</th>
            <th class="px-6 py-3 font-medium">Last Verified</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="backlinks-table-body" class="divide-y divide-slate-100">
          <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">Loading backlinks...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Prospecting Queue (filled by the Friday/Saturday SEO sweeps) -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
      <div>
        <h3 class="text-lg font-bold text-slate-900">Prospecting Queue</h3>
        <p class="text-xs text-slate-500 mt-0.5">Resource pages and unlinked brand mentions found by the Friday/Saturday SEO sweeps.</p>
      </div>
      <span id="prospects-count-badge" class="px-2.5 py-1 bg-brand-primary/10 text-brand-primary text-xs font-bold rounded-full">0</span>
    </div>
    <ul id="prospects-list" class="divide-y divide-slate-100">
      <li class="px-6 py-6 text-center text-slate-400 text-sm">Loading prospects...</li>
    </ul>
  </div>

  <script>
    import { app } from '../../lib/firebase';
    import { escapeHtml, safeUrl } from '../../utils/escape-html';
    import { getFirestore, collection, addDoc, deleteDoc, doc, getDocs, onSnapshot, serverTimestamp, orderBy, query, limit } from 'firebase/firestore';
    import { getFunctions, httpsCallable } from 'firebase/functions';

    const db = getFirestore(app);
    const functions = getFunctions(app);

    // --- Load Data: Tracked Backlinks ---
    const q = query(collection(db, 'backlinks'), orderBy('createdAt', 'desc'));
    onSnapshot(q, (snap) => {
      let total = 0, active = 0, lost = 0, nofollow = 0;
      
      const rows = snap.docs.map(d => {
        const data = d.data();
        total++;
        if (data.status === 'Active') active++;
        if (data.status === 'Lost' || data.status === 'Error') lost++;
        if (data.isNofollow) nofollow++;

        const statusColor = data.status === 'Active' ? 'bg-emerald-100 text-emerald-700' : (data.status === 'Lost' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-700');
        const typeColor = data.isNofollow ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700';
        const typeText = data.isNofollow ? 'NoFollow' : 'DoFollow';
        const dateStr = data.lastVerifiedAt ? new Date(data.lastVerifiedAt.toDate()).toLocaleDateString() : 'Never';

        return `
          <tr class="hover:bg-slate-50 group">
            <td class="px-6 py-4">
              <a href="${escapeHtml(safeUrl(data.url))}" target="_blank" class="font-semibold text-brand-primary hover:underline block max-w-md truncate" title="${escapeHtml(data.url)}">${escapeHtml(data.url)}</a>
              <div class="text-xs text-slate-400 truncate max-w-md mt-0.5" title="${escapeHtml(data.pageTitle || '')}">${escapeHtml(data.pageTitle || 'Target Listing')}</div>
            </td>
            <td class="px-6 py-4"><span class="px-2.5 py-1 ${statusColor} text-xs font-bold rounded-full">${escapeHtml(data.status || 'Pending')}</span></td>
            <td class="px-6 py-4"><span class="px-2.5 py-1 ${typeColor} text-xs font-bold rounded">${typeText}</span></td>
            <td class="px-6 py-4 text-slate-500 text-xs">${dateStr}</td>
            <td class="px-6 py-4 text-right">
              <button data-delete-id="${d.id}" class="text-red-400 hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer p-1">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        `;
      });

      const tbody = document.getElementById('backlinks-table-body');
      if (tbody) {
        if (rows.length === 0) tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">No backlinks tracked yet. Click "Add Backlink" to start tracking.</td></tr>';
        else tbody.innerHTML = rows.join('');
      }

      document.getElementById('stat-total')!.innerText = total.toString();
      document.getElementById('stat-active')!.innerText = active.toString();
      document.getElementById('stat-lost')!.innerText = lost.toString();
      document.getElementById('stat-nofollow')!.innerText = nofollow.toString();
      
      const tabBadge = document.getElementById('tab-tracked-badge');
      if (tabBadge) tabBadge.innerText = total.toString();
    });

    // --- Prospecting Queue (backlink-prospects, written by the SEO agent) ---
    const prospectsQuery = query(collection(db, 'backlink-prospects'), orderBy('updatedAt', 'desc'), limit(50));
    onSnapshot(prospectsQuery, (snap) => {
      const badge = document.getElementById('prospects-count-badge');
      const list = document.getElementById('prospects-list');
      if (badge) badge.innerText = snap.size.toString();
      if (!list) return;
      if (snap.empty) {
        list.innerHTML = '<li class="px-6 py-6 text-center text-slate-400 text-sm">No prospects yet. The Friday/Saturday sweep fills this queue once a Brave Search API key is saved in Settings.</li>';
        return;
      }
      list.innerHTML = snap.docs.map((d) => {
        const p = d.data();
        const updated = p.updatedAt?.toDate ? p.updatedAt.toDate() : null;
        const dateStr = updated ? updated.toLocaleDateString() : '';
        const brand = p.kind === 'brand';
        const kindLabel = brand ? 'Brand mention' : 'Resource page';
        const kindCls = brand ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700';
        return `
          <li class="px-6 py-4 flex items-start justify-between gap-4">
            <div class="min-w-0">
              <a href="${escapeHtml(safeUrl(p.url))}" target="_blank" rel="noopener" class="font-semibold text-brand-primary hover:underline block truncate">${escapeHtml(p.title || p.url)}</a>
              <div class="text-xs text-slate-400 truncate mt-0.5">${escapeHtml(p.url)}</div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="px-2.5 py-1 ${kindCls} text-xs font-bold rounded-full">${kindLabel}</span>
              <span class="text-xs text-slate-400">${dateStr}</span>
            </div>
          </li>
        `;
      }).join('');
    }, (error) => {
      console.warn('Prospects listener note:', error);
    });

    // Keep the outreach tab badge honest.
    onSnapshot(collection(db, 'linkOutreach'), (snap) => {
      const el = document.getElementById('tab-outreach-badge');
      if (el) el.innerText = snap.size.toString();
    }, (error) => {
      console.warn('Outreach badge listener note:', error);
    });

    // --- Delete Backlink ---
    document.body.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const deleteBtn = target.closest('[data-delete-id]') as HTMLButtonElement;
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-delete-id');
        if (id && confirm('Stop tracking this backlink?')) {
          await deleteDoc(doc(db, 'backlinks', id));
        }
      }
    });

    // --- Add Backlink Modal ---
    document.getElementById('add-link-btn')?.addEventListener('click', () => {
      (window as any).showModal('Add Tracked Backlink', `
        <div class="space-y-4">
          <p class="text-sm text-slate-600">Enter the URL of each external page where your link was placed — one per line. The verifier checks them on demand and every 48 hours.</p>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Target URLs</label>
            <textarea id="new-bl-url" rows="4" placeholder="https://example.com/blog/business-tips&#10;https://directory.example.org/guia-negocios" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-mono"></textarea>
          </div>
        </div>
      `, {
        footer: `
          <button id="modal-cancel-btn" class="cursor-pointer px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50">Cancel</button>
          <button id="modal-save-bl-btn" class="cursor-pointer px-4 py-2 text-sm font-medium text-white bg-brand-primary rounded-lg hover:bg-opacity-90">Start Tracking</button>
        `
      });

      // Handle Save
      const saveBtn = document.getElementById('modal-save-bl-btn');
      const cancelBtn = document.getElementById('modal-cancel-btn');
      
      cancelBtn?.addEventListener('click', () => {
        (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
      });

      saveBtn?.addEventListener('click', async () => {
        const input = document.getElementById('new-bl-url') as HTMLTextAreaElement;
        const entries = input.value.split(/\s+/).filter(Boolean);
        const valid = entries.filter(u => u.startsWith('http://') || u.startsWith('https://'));
        if (valid.length === 0) return alert('Please enter at least one URL starting with http:// or https://');

        saveBtn.disabled = true;
        saveBtn.innerText = 'Saving...';

        try {
          // Skip URLs already tracked so pasting the same list twice is safe.
          const existing = await getDocs(collection(db, 'backlinks'));
          const known = new Set(existing.docs.map(d => (d.data() as any).url));
          let added = 0;
          for (const url of valid) {
            if (known.has(url)) continue;
            await addDoc(collection(db, 'backlinks'), {
              url,
              status: 'Pending',
              isNofollow: false,
              pageTitle: '',
              createdAt: serverTimestamp(),
            });
            added++;
          }
          // Close modal
          (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
          const skipped = valid.length - added;
          const invalid = entries.length - valid.length;
          alert(`Tracking ${added} URL${added === 1 ? '' : 's'}.`
            + (skipped ? ` Skipped ${skipped} already tracked.` : '')
            + (invalid ? ` Ignored ${invalid} without http(s).` : ''));
        } catch (e: any) {
          alert('Failed to save: ' + e.message);
          saveBtn.disabled = false;
          saveBtn.innerText = 'Start Tracking';
        }
      });
    });

    // --- Verify All Button ---
    document.getElementById('verify-links-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('verify-links-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Verifying...';
      
      try {
        const verifyBacklinks = httpsCallable(functions, 'verifyBacklinks');
        const result = await verifyBacklinks();
        const verifiedCount = (result.data as any)?.verified || 0;
        alert(`Successfully verified ${verifiedCount} tracked links.`);
      } catch (e: any) {
        alert('Verification failed: ' + (e.message || 'unknown error'));
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg> Verify All Now';
      }
    });
  </script>
</AdminLayout>
