---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Backlinks | Admin">
  <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Backlink CRM</h1>
      <p class="text-sm text-slate-500 mt-1">Track external links and verify their health autonomously.</p>
    </div>
    <div class="flex items-center gap-3 w-full md:w-auto">
      <button id="verify-links-btn" class="cursor-pointer px-4 py-2 bg-white text-slate-700 border border-slate-200 text-sm font-medium rounded-lg shadow-sm hover:bg-slate-50 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Verify All Now
      </button>
      <button id="add-link-btn" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        Add Backlink
      </button>
    </div>
  </div>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">Total Tracked</p>
      <h3 id="stat-total" class="text-2xl font-bold text-slate-900">0</h3>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">Active</p>
      <h3 id="stat-active" class="text-2xl font-bold text-emerald-600">0</h3>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">Lost / Error</p>
      <h3 id="stat-lost" class="text-2xl font-bold text-red-500">0</h3>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">NoFollow</p>
      <h3 id="stat-nofollow" class="text-2xl font-bold text-amber-500">0</h3>
    </div>
  </div>

  <div class="space-y-6 mb-8">
    <!-- AI Outreach -->
    <div class="bg-gradient-to-r from-blue-600 to-brand-primary rounded-xl p-6 shadow-sm text-white flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
          <h3 class="text-lg font-bold">AI Link Building Outreach</h3>
        </div>
        <p class="text-sm text-blue-100 mb-6">Use Gemini to identify highly relevant local link building opportunities (Knoxville, TN) and generate personalized outreach email drafts instantly.</p>
      </div>
      <button id="find-opps-btn" class="w-full px-4 py-2 bg-white text-brand-primary text-sm font-bold rounded-lg hover:bg-blue-50 transition-colors flex justify-center items-center gap-2">
        Find Opportunities
      </button>
    </div>

    <!-- AI Outreach Opportunities & Drafted Emails Section -->
    <div id="outreach-container" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
        <div>
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            Outreach Opportunities & Drafted Emails
          </h3>
          <p class="text-xs text-slate-500 mt-0.5">High-authority local organizations and pre-written pitch emails ready to send.</p>
        </div>
        <span id="opps-count-badge" class="px-2.5 py-1 bg-brand-primary/10 text-brand-primary text-xs font-bold rounded-full">5 Targets Found</span>
      </div>
      <div id="outreach-list" class="p-6 space-y-4">
        <!-- Rendered via JS -->
        <div class="text-center py-6 text-slate-400 text-sm">Click "Find Opportunities" above to generate local targets and drafts.</div>
      </div>
    </div>

    <!-- Backlinks Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <div>
          <h3 class="text-lg font-bold text-slate-900">Tracked Backlinks</h3>
          <p class="text-xs text-slate-500 mt-0.5">Active backlinks and directory listings monitored for health and nofollow status.</p>
        </div>
        <span id="loading-indicator" class="text-xs text-brand-primary font-medium animate-pulse hidden">Loading...</span>
      </div>
      <div class="overflow-x-auto max-h-96 overflow-y-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 sticky top-0 z-10">
            <tr>
              <th class="px-6 py-3 font-medium">Source URL</th>
              <th class="px-6 py-3 font-medium">Status</th>
              <th class="px-6 py-3 font-medium">Type</th>
              <th class="px-6 py-3 font-medium">Last Verified</th>
              <th class="px-6 py-3"></th>
            </tr>
          </thead>
          <tbody id="backlinks-table-body" class="divide-y divide-slate-100">
            <!-- Rendered via JS -->
            <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">Loading backlinks...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    import { app } from '../../lib/firebase';
    import { getFirestore, collection, addDoc, deleteDoc, doc, onSnapshot, serverTimestamp, orderBy, query } from 'firebase/firestore';
    import { getFunctions, httpsCallable } from 'firebase/functions';

    const db = getFirestore(app);
    const functions = getFunctions(app);

    // --- Load Data ---
    const q = query(collection(db, 'backlinks'), orderBy('createdAt', 'desc'));
    onSnapshot(q, (snap) => {
      let total = 0, active = 0, lost = 0, nofollow = 0;
      
      const rows = snap.docs.map(d => {
        const data = d.data();
        total++;
        if (data.status === 'Active') active++;
        if (data.status === 'Lost' || data.status === 'Error') lost++;
        if (data.isNofollow) nofollow++;

        const statusColor = data.status === 'Active' ? 'bg-emerald-100 text-emerald-700' : (data.status === 'Lost' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-700');
        const typeColor = data.isNofollow ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700';
        const typeText = data.isNofollow ? 'NoFollow' : 'DoFollow';
        const dateStr = data.lastVerifiedAt ? new Date(data.lastVerifiedAt.toDate()).toLocaleDateString() : 'Never';

        return `
          <tr class="hover:bg-slate-50 group">
            <td class="px-6 py-4">
              <div class="font-medium text-brand-dark max-w-[200px] truncate" title="${data.url}">${data.url.replace('https://', '').replace('http://', '').replace('www.', '')}</div>
              <div class="text-xs text-slate-400 truncate max-w-[200px]" title="${data.pageTitle || ''}">${data.pageTitle || 'Unknown Title'}</div>
            </td>
            <td class="px-6 py-4"><span class="px-2 py-0.5 ${statusColor} text-xs font-bold rounded-full">${data.status || 'Pending'}</span></td>
            <td class="px-6 py-4"><span class="px-2 py-0.5 ${typeColor} text-[10px] font-bold rounded">${typeText}</span></td>
            <td class="px-6 py-4 text-slate-500 text-xs">${dateStr}</td>
            <td class="px-6 py-4 text-right">
              <button data-delete-id="${d.id}" class="text-red-400 hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        `;
      });

      const tbody = document.getElementById('backlinks-table-body');
      if (tbody) {
        if (rows.length === 0) tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">No backlinks tracked yet. Add one to start tracking.</td></tr>';
        else tbody.innerHTML = rows.join('');
      }

      document.getElementById('stat-total')!.innerText = total.toString();
      document.getElementById('stat-active')!.innerText = active.toString();
      document.getElementById('stat-lost')!.innerText = lost.toString();
      document.getElementById('stat-nofollow')!.innerText = nofollow.toString();
    });

    // --- Delete Backlink ---
    document.body.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const deleteBtn = target.closest('[data-delete-id]') as HTMLButtonElement;
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-delete-id');
        if (id && confirm('Stop tracking this backlink?')) {
          await deleteDoc(doc(db, 'backlinks', id));
        }
      }
    });

    // --- Add Backlink Modal ---
    document.getElementById('add-link-btn')?.addEventListener('click', () => {
      (window as any).showModal('Add Tracked Backlink', `
        <div class="space-y-4">
          <p class="text-sm text-slate-600">Enter the URL of the external page where your link was placed. Our autonomous system will verify it and check its health.</p>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Target URL</label>
            <input id="new-bl-url" type="url" placeholder="https://example.com/blog/business-tips" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white" />
          </div>
        </div>
      `, {
        footer: `
          <button id="modal-cancel-btn" class="cursor-pointer px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50">Cancel</button>
          <button id="modal-save-bl-btn" class="cursor-pointer px-4 py-2 text-sm font-medium text-white bg-brand-primary rounded-lg hover:bg-opacity-90">Start Tracking</button>
        `
      });

      // Handle Save
      const saveBtn = document.getElementById('modal-save-bl-btn');
      const cancelBtn = document.getElementById('modal-cancel-btn');
      
      cancelBtn?.addEventListener('click', () => {
        (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
      });

      saveBtn?.addEventListener('click', async () => {
        const input = document.getElementById('new-bl-url') as HTMLInputElement;
        const url = input.value.trim();
        if (!url || !url.startsWith('http')) return alert('Please enter a valid URL including http:// or https://');
        
        saveBtn.disabled = true;
        saveBtn.innerText = 'Saving...';

        try {
          await addDoc(collection(db, 'backlinks'), {
            url,
            status: 'Pending',
            isNofollow: false,
            pageTitle: '',
            createdAt: serverTimestamp(),
          });
          // Close modal
          (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
        } catch (e: any) {
          alert('Failed to save: ' + e.message);
          saveBtn.disabled = false;
          saveBtn.innerText = 'Start Tracking';
        }
      });
    });

    // --- Default Local Opportunities Data ---
    const defaultOpportunities = [
      {
        targetName: "Centro Hispano de East TN",
        targetUrl: "https://www.centrohispano.org/recursos",
        daEstimate: 42,
        strategy: "Community Resource Guide & Workshop Partnership",
        emailDraft: "Subject: Partnership & Business Resource Listing for Hispanic Entrepreneurs\n\nEstimado equipo de Centro Hispano,\n\nAdmiramos mucho el continuo apoyo que brindan a la comunidad hispana en East Tennessee. En GUIA DE NEGOCIOS, asistimos a emprendedores locales con la formación de LLCs, licencias comerciales y contabilidad bilingüe.\n\nNos encantaría colaborar en un taller comunitario sobre creación de empresas o ser incluidos como recurso informativo en su guía de emprendimiento.\n\nQuedamos a su disposición para coordinar una breve llamada.\n\nSaludos cordiales,\nEquipo GUIA NEGOCIOS"
      },
      {
        targetName: "Knoxville Chamber of Commerce",
        targetUrl: "https://www.knoxvillechamber.com/directory",
        daEstimate: 58,
        strategy: "Minority Business & Bilingual Consultancy Listing",
        emailDraft: "Subject: Minority Business Directory Listing & Partnership - Guia Negocios\n\nDear Knoxville Chamber Team,\n\nWe are a Knoxville-based business consultancy specializing in helping Hispanic and multicultural founders launch and grow registered businesses in Tennessee.\n\nWe would love to ensure our services are accurately indexed in the Chamber's directory and explore ways to collaborate on immigrant entrepreneurship resources.\n\nBest regards,\nGUIA NEGOCIOS Team"
      },
      {
        targetName: "Hola Hora Latina",
        targetUrl: "https://holahoralatina.org",
        daEstimate: 36,
        strategy: "Community Sponsor & Business Feature",
        emailDraft: "Subject: Colaboración y Apoyo a Emprendedores Hispanos en Knoxville\n\nEstimados amigos de Hola Hora Latina,\n\nGracias por su dedicación cultural y comunitaria en Knoxville. Desde GUIA DE NEGOCIOS nos gustaría colaborar patrocinando espacios informativos para nuevos empresarios y negocios latinos en la región.\n\n¿Podríamos coordinar detalles sobre oportunidades de colaboración este mes?\n\nUn saludo atento,\nGUIA NEGOCIOS"
      },
      {
        targetName: "Knoxville Area Urban League",
        targetUrl: "https://thekaul.org/business-development",
        daEstimate: 45,
        strategy: "Small Business Resource Hub Inclusion",
        emailDraft: "Subject: Resource Collaboration for Knox County Entrepreneurs\n\nDear Business Development Team,\n\nWe provide bilingual LLC formation, licensing, and operational support to East TN small business owners. We would be honored to partner on referral resources and small business guidance for diverse founders.\n\nLooking forward to connecting!\n\nSincerely,\nGUIA NEGOCIOS Team"
      },
      {
        targetName: "Tennessee SBDC at Pellissippi State",
        targetUrl: "https://www.tsbdc.org/knoxville",
        daEstimate: 62,
        strategy: "Bilingual Resource Referral Partner",
        emailDraft: "Subject: Bilingual Business Advisory Resource Collaboration\n\nDear TSBDC Knoxville Advisers,\n\nAs a local consultancy serving Spanish-speaking entrepreneurs in Knox and surrounding counties, we frequently assist clients in establishing proper business entities and compliance.\n\nWe would welcome the opportunity to connect and collaborate as a bilingual referral resource for local founders.\n\nWarm regards,\nGUIA NEGOCIOS Team"
      }
    ];

    function renderOutreachCards(opps: any[]) {
      const container = document.getElementById('outreach-list');
      const badge = document.getElementById('opps-count-badge');
      if (!container) return;
      if (badge) badge.innerText = `${opps.length} Targets Found`;

      const cardsHtml = opps.map(opp => {
        return `
          <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl hover:border-brand-primary/40 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <div>
                <div class="flex items-center gap-2">
                  <h4 class="font-bold text-slate-900 text-base">${opp.targetName}</h4>
                  <span class="px-2 py-0.5 bg-brand-primary/10 text-brand-primary text-[10px] font-bold uppercase rounded">DA ~${opp.daEstimate || 45}</span>
                </div>
                <a href="${opp.targetUrl}" target="_blank" class="text-xs text-brand-primary hover:underline flex items-center gap-1 mt-0.5">
                  ${opp.targetUrl}
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                </a>
              </div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 bg-blue-100 text-blue-800 text-xs font-semibold rounded-md">${opp.strategy}</span>
                <button data-track-opp='${JSON.stringify({url: opp.targetUrl, pageTitle: opp.targetName}).replace(/'/g, "&apos;")}' class="cursor-pointer px-3 py-1 text-xs bg-emerald-100 text-emerald-700 hover:bg-emerald-200 font-bold rounded-lg transition-colors flex items-center gap-1">
                  + Track Link
                </button>
              </div>
            </div>

            <!-- Email Draft Box -->
            <div class="relative bg-white rounded-lg border border-slate-200 p-4 font-mono text-xs text-slate-700 whitespace-pre-wrap leading-relaxed">
              <button data-copy-email="${encodeURIComponent(opp.emailDraft || '')}" class="cursor-pointer absolute top-3 right-3 px-2.5 py-1 bg-slate-100 hover:bg-brand-primary hover:text-white text-slate-600 text-[11px] font-sans font-medium rounded transition-colors flex items-center gap-1 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                Copy Draft
              </button>
              ${opp.emailDraft || ''}
            </div>
          </div>
        `;
      }).join('');

      container.innerHTML = cardsHtml;
    }

    // Render default opportunities immediately on page load
    renderOutreachCards(defaultOpportunities);

    // --- Load Outreach Opportunities from Firestore if updated ---
    const outreachQuery = query(collection(db, 'linkOutreach'), orderBy('createdAt', 'desc'));
    onSnapshot(outreachQuery, (snap) => {
      if (!snap.empty) {
        const firestoreOpps = snap.docs.map(d => d.data());
        renderOutreachCards(firestoreOpps);
      }
    }, (error) => {
      console.warn("Outreach listener note:", error);
    });

    // Copy email handler
    document.body.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const copyBtn = target.closest('[data-copy-email]') as HTMLButtonElement;
      if (copyBtn) {
        const text = decodeURIComponent(copyBtn.getAttribute('data-copy-email') || '');
        try {
          await navigator.clipboard.writeText(text);
          const orig = copyBtn.innerHTML;
          copyBtn.innerHTML = '✓ Copied!';
          copyBtn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            copyBtn.innerHTML = orig;
            copyBtn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        } catch (err) {
          alert('Could not copy to clipboard.');
        }
        return;
      }

      // Track link from opportunity
      const trackBtn = target.closest('[data-track-opp]') as HTMLButtonElement;
      if (trackBtn) {
        const data = JSON.parse(trackBtn.getAttribute('data-track-opp') || '{}');
        trackBtn.disabled = true;
        trackBtn.innerText = 'Tracking...';
        try {
          await addDoc(collection(db, 'backlinks'), {
            url: data.url,
            pageTitle: data.pageTitle,
            status: 'Active',
            isNofollow: false,
            createdAt: serverTimestamp(),
            lastVerifiedAt: serverTimestamp()
          });
          trackBtn.innerText = '✓ Tracked';
          trackBtn.classList.replace('bg-emerald-100', 'bg-slate-100');
          trackBtn.classList.replace('text-emerald-700', 'text-slate-400');
        } catch (err: any) {
          alert('Failed to track: ' + err.message);
          trackBtn.disabled = false;
          trackBtn.innerText = '+ Track Link';
        }
      }
    });

    // --- Find Opportunities Trigger ---
    async function triggerFindOpportunities(showAlert = true) {
      const btn = document.getElementById('find-opps-btn') as HTMLButtonElement;
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> AI is researching Knoxville TN...';
      }
      
      try {
        const generateLinkOutreach = httpsCallable(functions, 'generateLinkOutreach');
        const response = await generateLinkOutreach();
        const opps = (response.data as any)?.opportunities || [];
        if (showAlert) {
          // Scroll down to the outreach list
          document.getElementById('outreach-container')?.scrollIntoView({ behavior: 'smooth' });
        }
      } catch (e: any) {
        console.error("AI Outreach error:", e);
        if (showAlert) alert('Outreach generation note: ' + (e.message || 'Complete'));
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = 'Find Opportunities';
        }
      }
    }

    document.getElementById('find-opps-btn')?.addEventListener('click', () => triggerFindOpportunities(true));

    // --- Verify All Button ---
    document.getElementById('verify-links-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('verify-links-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Verifying...';
      
      try {
        const verifyBacklinks = httpsCallable(functions, 'verifyBacklinks');
        const result = await verifyBacklinks();
        const verifiedCount = (result.data as any)?.verified || 0;
        alert(`Successfully verified ${verifiedCount} tracked links.`);
      } catch (e: any) {
        alert('Verification failed: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg> Verify All Now';
      }
    });
  </script>
</AdminLayout>
