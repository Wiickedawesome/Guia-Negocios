---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Backlinks | Admin">
  <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Backlink CRM</h1>
      <p class="text-sm text-slate-500 mt-1">Track external links and verify their health autonomously.</p>
    </div>
    <div class="flex items-center gap-3 w-full md:w-auto">
      <button id="verify-links-btn" class="cursor-pointer px-4 py-2 bg-white text-slate-700 border border-slate-200 text-sm font-medium rounded-lg shadow-sm hover:bg-slate-50 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Verify All Now
      </button>
      <button id="add-link-btn" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        Add Backlink
      </button>
    </div>
  </div>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">Total Tracked</p>
      <h3 id="stat-total" class="text-2xl font-bold text-slate-900">0</h3>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">Active</p>
      <h3 id="stat-active" class="text-2xl font-bold text-emerald-600">0</h3>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">Lost / Error</p>
      <h3 id="stat-lost" class="text-2xl font-bold text-red-500">0</h3>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <p class="text-sm font-medium text-slate-500 mb-1">NoFollow</p>
      <h3 id="stat-nofollow" class="text-2xl font-bold text-amber-500">0</h3>
    </div>
  </div>

  <div class="space-y-6 mb-8">
    <!-- AI Outreach -->
    <div class="bg-gradient-to-r from-blue-600 to-brand-primary rounded-xl p-6 shadow-sm text-white flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
          <h3 class="text-lg font-bold">AI Link Building Outreach</h3>
        </div>
        <p class="text-sm text-blue-100 mb-6">Use Gemini to identify highly relevant local link building opportunities (Knoxville, TN) and generate personalized outreach email drafts instantly.</p>
      </div>
      <button id="find-opps-btn" class="w-full px-4 py-2 bg-white text-brand-primary text-sm font-bold rounded-lg hover:bg-blue-50 transition-colors flex justify-center items-center gap-2">
        Find Opportunities
      </button>
    </div>

    <!-- Backlinks Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
        <h3 class="text-lg font-bold text-slate-900">Tracked Backlinks</h3>
        <span id="loading-indicator" class="text-xs text-brand-primary font-medium animate-pulse hidden">Loading...</span>
      </div>
      <div class="overflow-x-auto max-h-96 overflow-y-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 sticky top-0 z-10">
            <tr>
              <th class="px-6 py-3 font-medium">Source URL</th>
              <th class="px-6 py-3 font-medium">Status</th>
              <th class="px-6 py-3 font-medium">Type</th>
              <th class="px-6 py-3 font-medium">Last Verified</th>
              <th class="px-6 py-3"></th>
            </tr>
          </thead>
          <tbody id="backlinks-table-body" class="divide-y divide-slate-100">
            <!-- Rendered via JS -->
            <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">Loading backlinks...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    import { app } from '../../lib/firebase';
    import { getFirestore, collection, addDoc, deleteDoc, doc, onSnapshot, serverTimestamp, orderBy, query } from 'firebase/firestore';
    import { getFunctions, httpsCallable } from 'firebase/functions';

    const db = getFirestore(app);
    const functions = getFunctions(app);

    // --- Load Data ---
    const q = query(collection(db, 'backlinks'), orderBy('createdAt', 'desc'));
    onSnapshot(q, (snap) => {
      let total = 0, active = 0, lost = 0, nofollow = 0;
      
      const rows = snap.docs.map(d => {
        const data = d.data();
        total++;
        if (data.status === 'Active') active++;
        if (data.status === 'Lost' || data.status === 'Error') lost++;
        if (data.isNofollow) nofollow++;

        const statusColor = data.status === 'Active' ? 'bg-emerald-100 text-emerald-700' : (data.status === 'Lost' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-700');
        const typeColor = data.isNofollow ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700';
        const typeText = data.isNofollow ? 'NoFollow' : 'DoFollow';
        const dateStr = data.lastVerifiedAt ? new Date(data.lastVerifiedAt.toDate()).toLocaleDateString() : 'Never';

        return `
          <tr class="hover:bg-slate-50 group">
            <td class="px-6 py-4">
              <div class="font-medium text-brand-dark max-w-[200px] truncate" title="${data.url}">${data.url.replace('https://', '').replace('http://', '').replace('www.', '')}</div>
              <div class="text-xs text-slate-400 truncate max-w-[200px]" title="${data.pageTitle || ''}">${data.pageTitle || 'Unknown Title'}</div>
            </td>
            <td class="px-6 py-4"><span class="px-2 py-0.5 ${statusColor} text-xs font-bold rounded-full">${data.status || 'Pending'}</span></td>
            <td class="px-6 py-4"><span class="px-2 py-0.5 ${typeColor} text-[10px] font-bold rounded">${typeText}</span></td>
            <td class="px-6 py-4 text-slate-500 text-xs">${dateStr}</td>
            <td class="px-6 py-4 text-right">
              <button data-delete-id="${d.id}" class="text-red-400 hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </td>
          </tr>
        `;
      });

      const tbody = document.getElementById('backlinks-table-body');
      if (tbody) {
        if (rows.length === 0) tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">No backlinks tracked yet. Add one to start tracking.</td></tr>';
        else tbody.innerHTML = rows.join('');
      }

      document.getElementById('stat-total')!.innerText = total.toString();
      document.getElementById('stat-active')!.innerText = active.toString();
      document.getElementById('stat-lost')!.innerText = lost.toString();
      document.getElementById('stat-nofollow')!.innerText = nofollow.toString();
    });

    // --- Delete Backlink ---
    document.body.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const deleteBtn = target.closest('[data-delete-id]') as HTMLButtonElement;
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-delete-id');
        if (id && confirm('Stop tracking this backlink?')) {
          await deleteDoc(doc(db, 'backlinks', id));
        }
      }
    });

    // --- Add Backlink Modal ---
    document.getElementById('add-link-btn')?.addEventListener('click', () => {
      (window as any).showModal('Add Tracked Backlink', `
        <div class="space-y-4">
          <p class="text-sm text-slate-600">Enter the URL of the external page where your link was placed. Our autonomous system will verify it and check its health.</p>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Target URL</label>
            <input id="new-bl-url" type="url" placeholder="https://example.com/blog/business-tips" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white" />
          </div>
        </div>
      `, {
        footer: `
          <button id="modal-cancel-btn" class="cursor-pointer px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50">Cancel</button>
          <button id="modal-save-bl-btn" class="cursor-pointer px-4 py-2 text-sm font-medium text-white bg-brand-primary rounded-lg hover:bg-opacity-90">Start Tracking</button>
        `
      });

      // Handle Save
      const saveBtn = document.getElementById('modal-save-bl-btn');
      const cancelBtn = document.getElementById('modal-cancel-btn');
      
      cancelBtn?.addEventListener('click', () => {
        (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
      });

      saveBtn?.addEventListener('click', async () => {
        const input = document.getElementById('new-bl-url') as HTMLInputElement;
        const url = input.value.trim();
        if (!url || !url.startsWith('http')) return alert('Please enter a valid URL including http:// or https://');
        
        saveBtn.disabled = true;
        saveBtn.innerText = 'Saving...';

        try {
          await addDoc(collection(db, 'backlinks'), {
            url,
            status: 'Pending',
            isNofollow: false,
            pageTitle: '',
            createdAt: serverTimestamp(),
          });
          // Close modal
          (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
        } catch (e: any) {
          alert('Failed to save: ' + e.message);
          saveBtn.disabled = false;
          saveBtn.innerText = 'Start Tracking';
        }
      });
    });

    // --- Verify All Button ---
    document.getElementById('verify-links-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('verify-links-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Verifying...';
      
      try {
        const verifyBacklinks = httpsCallable(functions, 'verifyBacklinks');
        const result = await verifyBacklinks();
        const verifiedCount = (result.data as any)?.verified || 0;
        alert(`Successfully verified ${verifiedCount} tracked links.`);
      } catch (e: any) {
        alert('Verification failed: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg> Verify All Now';
      }
    });

    // --- AI Link Building Outreach ---
    document.getElementById('find-opps-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('find-opps-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> AI is researching Knoxville TN...';
      
      try {
        const generateLinkOutreach = httpsCallable(functions, 'generateLinkOutreach');
        const response = await generateLinkOutreach();
        const opps = (response.data as any)?.opportunities || [];

        const html = opps.map((opp: any) => `
          <div class="p-4 bg-slate-50 border border-slate-100 rounded-lg mb-4">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h4 class="font-bold text-slate-900">${opp.targetName}</h4>
                <a href="${opp.targetUrl}" target="_blank" class="text-xs text-brand-primary hover:underline">${opp.targetUrl}</a>
              </div>
              <span class="px-2 py-1 bg-blue-100 text-blue-800 text-[10px] font-bold uppercase rounded">${opp.strategy}</span>
            </div>
            <div class="mt-3 bg-white p-3 border border-slate-200 rounded text-sm text-slate-600 whitespace-pre-wrap font-mono relative group">
              ${opp.emailDraft}
            </div>
          </div>
        `).join('');

        (window as any).showModal('AI Link Building Opportunities', `
          <div class="space-y-2 max-h-[60vh] overflow-y-auto pr-2">
            <p class="text-sm text-slate-500 mb-4">Gemini found these highly relevant local targets and drafted personalized outreach emails. Review and send them manually.</p>
            ${html}
          </div>
        `, {
          wide: true,
          footer: '<button id="close-opps-btn-modal" class="px-4 py-2 bg-slate-100 text-slate-700 font-medium rounded-lg">Close</button>'
        });

        document.getElementById('close-opps-btn-modal')?.addEventListener('click', () => {
          (document.getElementById('admin-modal-overlay')?.querySelector('#modal-close-btn') as HTMLButtonElement)?.click();
        });

      } catch (e: any) {
        alert('AI generation failed: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerText = 'Find Opportunities';
      }
    });
  </script>
</AdminLayout>
