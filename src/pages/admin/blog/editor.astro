  <!-- EasyMDE & Marked CDN Scripts -->
  <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
  <script src="https://unpkg.com/easymde/dist/easymde.min.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>

  <style is:inline>
    .editor-toolbar { border-color: #e2e8f0; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem; background-color: #f8fafc; }
    .CodeMirror { border-color: #e2e8f0; border-bottom-left-radius: 0.5rem; border-bottom-right-radius: 0.5rem; font-family: 'ui-monospace', 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', monospace; font-size: 0.875rem; }
    .editor-toolbar button.active, .editor-toolbar button:hover { background: #e2e8f0; }
  </style>

  <script>
    import { aiModel, db } from '../../../lib/firebase';
    import { collection, addDoc, doc, getDoc, updateDoc, serverTimestamp } from 'firebase/firestore';
    import { 
      searchUnsplashPhotos, 
      getUsedPhotoSet, 
      markPhotoAsUsed, 
      getUniqueUnsplashPhoto,
      CURATED_UNSPLASH_POOL 
    } from '../../../utils/unsplash';
    import { getRelevantCitations, AUTHORITATIVE_SOURCES } from '../../../utils/research';

    let easyMdeEs: any, easyMdeEn: any;
    let currentPreviewLang: 'es' | 'en' = 'es';

    // Parse URL ID
    const urlParams = new URLSearchParams(window.location.search);
    const postId = urlParams.get('id');

    // Initialize EasyMDE after DOM loads
    document.addEventListener('DOMContentLoaded', () => {
      // @ts-ignore
      easyMdeEs = new EasyMDE({ 
        element: document.getElementById('md-es'),
        spellChecker: false,
        placeholder: "Escribe tu contenido en Markdown aquí...",
        status: false,
        toolbar: ["bold", "italic", "heading-2", "heading-3", "|", "quote", "unordered-list", "ordered-list", "|", "link", "image", "table", "|", "preview", "side-by-side", "fullscreen", "|", "guide"]
      });

      // @ts-ignore
      easyMdeEn = new EasyMDE({ 
        element: document.getElementById('md-en'),
        spellChecker: false,
        placeholder: "Write your Markdown content here...",
        status: false,
        toolbar: ["bold", "italic", "heading-2", "heading-3", "|", "quote", "unordered-list", "ordered-list", "|", "link", "image", "table", "|", "preview", "side-by-side", "fullscreen", "|", "guide"]
      });

      // Word count listeners
      easyMdeEs.codemirror.on('change', () => updateWordCount('es'));
      easyMdeEn.codemirror.on('change', () => updateWordCount('en'));

      loadPost();
    });

    function updateWordCount(lang: 'es' | 'en') {
      const editor = lang === 'es' ? easyMdeEs : easyMdeEn;
      const text = editor ? editor.value().trim() : '';
      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
      const badge = document.getElementById(`wordcount-${lang}-badge`);
      if (badge) badge.textContent = `${words} words`;
    }

    // Load Existing Post
    async function loadPost() {
      if (!postId) {
        // New post defaults
        (document.getElementById('publish-date') as HTMLInputElement).value = new Date().toISOString().split('T')[0];
        document.getElementById('editor-page-title')!.textContent = 'New Blog Post';
        return;
      }

      try {
        const docRef = doc(db, 'blogs', postId);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
          const data = docSnap.data();
          
          (document.getElementById('title-es') as HTMLInputElement).value = data.titleEs || '';
          (document.getElementById('title-en') as HTMLInputElement).value = data.titleEn || '';
          
          if (easyMdeEs) easyMdeEs.value(data.contentEs || '');
          if (easyMdeEn) easyMdeEn.value(data.contentEn || '');
          
          (document.getElementById('slug-es') as HTMLInputElement).value = data.slugEs || '';
          (document.getElementById('slug-en') as HTMLInputElement).value = data.slugEn || '';
          (document.getElementById('meta-desc') as HTMLTextAreaElement).value = data.metaDesc || '';
          (document.getElementById('keywords') as HTMLInputElement).value = (data.keywords || []).join(', ');
          (document.getElementById('featured-image') as HTMLInputElement).value = data.featuredImage || '';
          (document.getElementById('author') as HTMLInputElement).value = data.author || 'Guia Negocios Team';
          (document.getElementById('author-avatar') as HTMLInputElement).value = data.authorAvatar || '';
          (document.getElementById('read-time') as HTMLInputElement).value = data.readTime || 5;
          (document.getElementById('publish-date') as HTMLInputElement).value = data.publishDate || '';
          (document.getElementById('status-select') as HTMLSelectElement).value = data.status || 'Draft';
          
          updateStatusBadge(data.status || 'Draft');
          updateWordCount('es');
          updateWordCount('en');

          // Trigger inputs
          document.getElementById('meta-desc')?.dispatchEvent(new Event('input'));
          document.getElementById('featured-image')?.dispatchEvent(new Event('input'));
          document.getElementById('author-avatar')?.dispatchEvent(new Event('input'));
        }
      } catch (e) {
        console.error("Error loading document:", e);
        // @ts-ignore
        window.showToast('Error loading blog post', 'error');
      }
    }

    function updateStatusBadge(status: string) {
      const badge = document.getElementById('post-status-badge');
      if (!badge) return;
      badge.textContent = status;
      if (status === 'Published') {
        badge.className = 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200';
      } else if (status === 'Archived') {
        badge.className = 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-slate-100 text-slate-800 border border-slate-200';
      } else {
        badge.className = 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200';
      }
    }

    // Tab switching logic
    const tabEs = document.getElementById('tab-es');
    const tabEn = document.getElementById('tab-en');
    const containerEs = document.getElementById('editor-es-container');
    const containerEn = document.getElementById('editor-en-container');

    function switchTab(lang: 'es' | 'en') {
      if (lang === 'es') {
        tabEs!.className = 'border-brand-primary text-brand-primary whitespace-nowrap py-3 px-1 border-b-2 font-semibold text-sm flex items-center gap-2';
        tabEn!.className = 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2';
        containerEs!.classList.remove('hidden');
        containerEs!.classList.add('block');
        containerEn!.classList.add('hidden');
        containerEn!.classList.remove('block');
        if (easyMdeEs) easyMdeEs.codemirror.refresh();
      } else {
        tabEn!.className = 'border-brand-primary text-brand-primary whitespace-nowrap py-3 px-1 border-b-2 font-semibold text-sm flex items-center gap-2';
        tabEs!.className = 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2';
        containerEn!.classList.remove('hidden');
        containerEn!.classList.add('block');
        containerEs!.classList.add('hidden');
        containerEs!.classList.remove('block');
        if (easyMdeEn) easyMdeEn.codemirror.refresh();
      }
    }

    tabEs?.addEventListener('click', () => switchTab('es'));
    tabEn?.addEventListener('click', () => switchTab('en'));

    // =========================================================================
    // FULL-DOCUMENT AI COPILOT LOGIC
    // =========================================================================
    const copilotInput = document.getElementById('copilot-input') as HTMLInputElement;
    const copilotSend = document.getElementById('copilot-send') as HTMLButtonElement;
    const copilotChat = document.getElementById('copilot-chat') as HTMLElement;

    function appendCopilotMessage(content: string, isUser = false, actions: any[] = []) {
      const div = document.createElement('div');
      div.className = isUser ? 'flex items-start gap-3 flex-row-reverse' : 'flex items-start gap-3';
      
      const avatar = isUser 
        ? `<div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center shrink-0"><svg class="w-4 h-4 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg></div>`
        : `<div class="w-8 h-8 rounded-full bg-brand-primary/10 flex items-center justify-center shrink-0 border border-brand-primary/20"><svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg></div>`;
      
      const bubbleClasses = isUser
        ? 'bg-brand-primary text-white p-3 rounded-2xl rounded-tr-none shadow-xs text-sm'
        : 'bg-white p-3.5 rounded-2xl rounded-tl-none border border-slate-200 shadow-xs text-sm text-slate-800 space-y-2 max-w-xl';
        
      let actionsHtml = '';
      if (actions.length > 0) {
        actionsHtml = `<div class="pt-2 border-t border-slate-100 flex flex-wrap gap-1.5">
          ${actions.map((act, i) => `<button type="button" class="copilot-action-btn text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-100 hover:bg-brand-primary hover:text-white transition-all text-slate-700 flex items-center gap-1" data-action-index="${i}">${act.label}</button>`).join('')}
        </div>`;
      }

      div.innerHTML = `
        ${avatar}
        <div class="${bubbleClasses}">
          <div class="prose prose-xs max-w-none text-slate-700 prose-headings:text-slate-900">${// @ts-ignore
            window.marked ? window.marked.parse(content) : content}</div>
          ${actionsHtml}
        </div>
      `;

      // Bind action buttons
      if (actions.length > 0) {
        div.querySelectorAll('.copilot-action-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.getAttribute('data-action-index') || '0', 10);
            if (actions[idx] && actions[idx].handler) {
              actions[idx].handler();
            }
          });
        });
      }

      copilotChat.appendChild(div);
      copilotChat.scrollTop = copilotChat.scrollHeight;
    }

    async function handleCopilotPrompt(userPrompt: string) {
      if (!userPrompt.trim()) return;

      appendCopilotMessage(userPrompt, true);
      copilotInput.value = '';

      const isEnglish = document.getElementById('editor-en-container')?.classList.contains('block');
      const activeLang = isEnglish ? 'English' : 'Spanish';
      const activeEditor = isEnglish ? easyMdeEn : easyMdeEs;
      const otherEditor = isEnglish ? easyMdeEs : easyMdeEn;

      const titleEs = (document.getElementById('title-es') as HTMLInputElement)?.value || '';
      const titleEn = (document.getElementById('title-en') as HTMLInputElement)?.value || '';
      const currentContentEs = easyMdeEs ? easyMdeEs.value() : '';
      const currentContentEn = easyMdeEn ? easyMdeEn.value() : '';
      const metaDesc = (document.getElementById('meta-desc') as HTMLTextAreaElement)?.value || '';
      const keywords = (document.getElementById('keywords') as HTMLInputElement)?.value || '';

      const selectedText = activeEditor ? activeEditor.codemirror.getSelection() : '';

      try {
        const fullSystemContext = `
You are the lead bilingual business editor, designer, and SEO strategist for GUIA DE NEGOCIOS (consultancy in Knoxville, TN for Hispanic entrepreneurs).
You help write in-depth, authoritative, well-structured articles and design responsive HTML/CSS/SVG infographics for blog posts and social media flyers.

BRAND IDENTITY & DESIGN SYSTEM:
- Primary Color: #1B4E2B (Deep Forest Green)
- Accent Color: #F0C850 (Golden Yellow / Warm Amber)
- Dark Slate: #1A2E35 (Navy / Charcoal)
- Light Background: #F2F7F4 (Minty Soft White)
- Danger / Warning: #D92D3C (Red for common mistakes and risks)
- Body Text / Slate: #1E2A2F, #334155, #64748b

INFOGRAPHIC CAPABILITIES:
When asked to create an infographic, visual chart, process map, or comparison, generate responsive, self-contained HTML/CSS/SVG components formatted cleanly with Tailwind utility classes and inline styles matching the above brand tokens:
1. Step-by-Step Process Flow: Numbered step cards (#1B4E2B badge with white text, title, concise description, and flow indicators).
2. Problem vs. Solution Matrix: 2-column or 3-column rows showing Red problem boxes (#fef2f2 / #D92D3C) with warning icons -> Arrow -> Green solution boxes (#F2F7F4 / #1B4E2B) with checkmark icons.
3. Data & Metrics Highlight Card: #1A2E35 slate dark background, bold stats in #F0C850 (e.g., 178%, $653B, 3.5M), labels, and source badges.
4. Split Decision Card (Bad vs. Good Way): Side-by-side comparison panels (Red danger panel for wrong/mixed methods vs. Green panel for Guia Negocios recommended method).

RESEARCH CITATIONS & OPEN WEB POLICY:
You are NOT restricted to a fixed list of sites. You are authorized and encouraged to research, reference, and cite ANY verified official source across the open web relevant to the topic:
- Federal Agencies (.gov): IRS (irs.gov), SBA (sba.gov), OSHA (osha.gov), USPTO (uspto.gov), FTC (ftc.gov), U.S. Dept of Labor (dol.gov).
- State & County Authorities: Tennessee Secretary of State (sos.tn.gov), TN Department of Revenue (tn.gov/revenue), TN Board for Licensing Contractors, Knox County Clerk (knoxcounty.org), local municipal zoning/clerk portals.
- Academic & Economic Research (.edu/.org): Brookings Institution (brookings.edu), Stanford Latino Entrepreneurship Initiative (gsb.stanford.edu/slei), Michigan State University JSRI (jsri.msu.edu), U.S. Census Bureau (census.gov), SCORE (score.org).
- Internal Guia Negocios Links: [/es/services/paquete-lanzamiento-completo](/es/services/paquete-lanzamiento-completo), [/es/services/operaciones-crecimiento](/es/services/operaciones-crecimiento), [/es/services/apoyo-creedava](/es/services/apoyo-creedava), [/es/contact](/es/contact).
When writing, editing, or adding citations, naturally weave relevant Markdown hyperlinks into factual sentences and compile a comprehensive "Official Sources & References" / "Fuentes y Referencias Oficiales" section at the end.

Current Document Context:
- Active Tab Language: ${activeLang}
- Spanish Title: "${titleEs}"
- English Title: "${titleEn}"
- Spanish Body Content:
"""${currentContentEs.slice(0, 4000)}"""
- English Body Content:
"""${currentContentEn.slice(0, 4000)}"""
- Meta Description: "${metaDesc}"
- Keywords: "${keywords}"
${selectedText ? `- Editor Selected Text: """${selectedText}"""` : ''}

User Request: "${userPrompt}"

Instructions:
1. Provide a direct, highly helpful, and actionable editorial response in ${activeLang}.
2. Ensure explanations are detailed, comprehensive, and tailored to business owners.
3. If outputting markdown or an infographic component, output clean markdown with the embedded HTML/CSS/SVG block so it can be inserted into the editor with 1 click.
`;

        const result = await aiModel.generateContent(fullSystemContext);
        const responseText = result.response.text();

        // Action buttons without emojis
        const actions: any[] = [
          {
            label: 'Apply to Editor',
            handler: () => {
              if (activeEditor) {
                const cm = activeEditor.codemirror;
                if (selectedText) {
                  cm.replaceSelection(responseText);
                } else {
                  const cursor = cm.getCursor();
                  const prefix = cursor.ch > 0 ? '\n\n' : '';
                  cm.replaceSelection(prefix + responseText + '\n\n');
                }
                activeEditor.codemirror.focus();
                // @ts-ignore
                window.showToast('Content applied to editor!', 'success');
              }
            }
          },
          {
            label: 'Fill Opposite Language Tab',
            handler: () => {
              if (otherEditor) {
                otherEditor.value(responseText);
                switchTab(isEnglish ? 'es' : 'en');
                // @ts-ignore
                window.showToast('Updated translated tab content!', 'success');
              }
            }
          },
          {
            label: 'Copy Text',
            handler: () => {
              navigator.clipboard.writeText(responseText);
              // @ts-ignore
              window.showToast('Copied to clipboard!', 'info');
            }
          }
        ];

        appendCopilotMessage(responseText, false, actions);
      } catch (error: any) {
        console.error('Copilot AI Error:', error);
        appendCopilotMessage('Error communicating with AI: ' + (error?.message || 'Please verify API connection in Settings.'), false);
      }
    }

    copilotSend?.addEventListener('click', () => handleCopilotPrompt(copilotInput.value));
    copilotInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') handleCopilotPrompt(copilotInput.value);
    });

    // Quick Action Pills Handlers
    document.querySelectorAll('.copilot-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const action = pill.getAttribute('data-action');
        const isEnglish = document.getElementById('editor-en-container')?.classList.contains('block');
        const activeLang = isEnglish ? 'English' : 'Spanish';

        if (action === 'improve') {
          handleCopilotPrompt(`Improve and polish the writing flow, grammar, and depth of the active ${activeLang} post while keeping markdown formatting.`);
        } else if (action === 'translate') {
          const targetLang = isEnglish ? 'Spanish' : 'English';
          handleCopilotPrompt(`Translate the current ${activeLang} blog post completely into high-quality, natural ${targetLang}, preserving all markdown headers, structure, and infographics.`);
        } else if (action === 'seo') {
          handleCopilotPrompt(`Optimize the current post for local Knoxville TN and business search SEO. Ensure keyword density for LLC formation, business consulting, and legal compliance.`);
        } else if (action === 'faq') {
          handleCopilotPrompt(`Generate a 4-question FAQ section (## Preguntas Frecuentes / Frequently Asked Questions) in ${activeLang} addressing common concerns for this topic.`);
        } else if (action === 'infographic_steps') {
          handleCopilotPrompt(`Generate a responsive HTML/CSS Step-by-Step Flow Infographic in ${activeLang} for this topic using Guia Negocios brand styling (#1B4E2B green, #F2F7F4 light background, numbered badges).`);
        } else if (action === 'infographic_comparison') {
          handleCopilotPrompt(`Generate a responsive HTML/CSS Problem vs. Solution Matrix Infographic in ${activeLang} for this topic comparing common pitfalls (#D92D3C red) to Guia Negocios solutions (#1B4E2B green).`);
        } else if (action === 'infographic_stats') {
          handleCopilotPrompt(`Generate a responsive HTML/CSS Data & Metrics Highlight Card in ${activeLang} with key business data in #F0C850 on a #1A2E35 dark background.`);
        } else if (action === 'infographic_split') {
          handleCopilotPrompt(`Generate a responsive HTML/CSS Split Comparison Card in ${activeLang} (Bad/Mixed Way in red vs. Good/Separated Way in green) illustrating key choices for this topic.`);
        } else if (action === 'citations') {
          const topicVal = ((document.getElementById('title-es') as HTMLInputElement)?.value || (document.getElementById('title-en') as HTMLInputElement)?.value || 'business formation');
          const citations = getRelevantCitations(topicVal, isEnglish ? 'en' : 'es');
          handleCopilotPrompt(`Enrich and back this ${activeLang} article with verified government, legal, and academic citations. Naturally embed in-text markdown links to official sources (IRS, Tennessee Secretary of State, Department of Revenue, SBA, Brookings, and Guia Negocios services) and add an official References section at the bottom.\n\nVerified Sources:\n${citations}`);
        } else if (action === 'title_meta') {
          handleCopilotPrompt(`Suggest 3 high-converting, click-worthy Titles and 2 SEO Meta Descriptions (under 160 characters) in both Spanish and English for this post.`);
        }
      });
    });

    // =========================================================================
    // 3. LIVE BLOG PREVIEW MODAL LOGIC
    // =========================================================================
    const previewModal = document.getElementById('preview-modal') as HTMLElement;
    const btnPreview = document.getElementById('btn-preview') as HTMLButtonElement;
    const btnClosePreview = document.getElementById('btn-close-preview') as HTMLButtonElement;
    const btnBackEditor = document.getElementById('btn-back-editor') as HTMLButtonElement;
    const btnPreviewSave = document.getElementById('btn-preview-save') as HTMLButtonElement;

    const previewLangEs = document.getElementById('preview-lang-es') as HTMLButtonElement;
    const previewLangEn = document.getElementById('preview-lang-en') as HTMLButtonElement;
    const previewViewDesktop = document.getElementById('preview-view-desktop') as HTMLButtonElement;
    const previewViewMobile = document.getElementById('preview-view-mobile') as HTMLButtonElement;
    const previewViewportContainer = document.getElementById('preview-viewport-container') as HTMLElement;

    function openPreviewModal() {
      renderPreview(currentPreviewLang);
      previewModal.classList.remove('hidden');
      previewModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closePreviewModal() {
      previewModal.classList.add('hidden');
      previewModal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function renderPreview(lang: 'es' | 'en') {
      currentPreviewLang = lang;

      // Update Preview Lang Button styles
      if (lang === 'es') {
        previewLangEs.className = 'px-3 py-1.5 rounded-md bg-white text-brand-primary shadow-xs transition-all';
        previewLangEn.className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-all';
      } else {
        previewLangEn.className = 'px-3 py-1.5 rounded-md bg-white text-brand-primary shadow-xs transition-all';
        previewLangEs.className = 'px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-all';
      }

      const title = lang === 'es' 
        ? ((document.getElementById('title-es') as HTMLInputElement)?.value || 'Sin Título')
        : ((document.getElementById('title-en') as HTMLInputElement)?.value || 'Untitled Post');

      const markdown = lang === 'es'
        ? (easyMdeEs ? easyMdeEs.value() : '')
        : (easyMdeEn ? easyMdeEn.value() : '');

      const featuredImg = (document.getElementById('featured-image') as HTMLInputElement)?.value || '';
      const author = (document.getElementById('author') as HTMLInputElement)?.value || 'Guia Negocios Team';
      const authorAvatar = (document.getElementById('author-avatar') as HTMLInputElement)?.value || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80';
      const readTime = (document.getElementById('read-time') as HTMLInputElement)?.value || '5';
      const publishDate = (document.getElementById('publish-date') as HTMLInputElement)?.value || new Date().toISOString().split('T')[0];
      const status = (document.getElementById('status-select') as HTMLSelectElement)?.value || 'Draft';
      const keywords = ((document.getElementById('keywords') as HTMLInputElement)?.value || '').split(',').map(k => k.trim()).filter(Boolean);

      // Set Metadata
      document.getElementById('preview-title')!.textContent = title;
      document.getElementById('preview-author-name')!.textContent = author;
      (document.getElementById('preview-author-avatar') as HTMLImageElement).src = authorAvatar;
      document.getElementById('preview-badge-date')!.textContent = publishDate;
      document.getElementById('preview-badge-readtime')!.textContent = `${readTime} min read`;
      
      const badgeStatus = document.getElementById('preview-badge-status')!;
      badgeStatus.textContent = status;
      badgeStatus.className = status === 'Published' 
        ? 'px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200'
        : 'px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200';

      // Featured Cover Image
      const featuredContainer = document.getElementById('preview-featured-container')!;
      const featuredImgEl = document.getElementById('preview-featured-img') as HTMLImageElement;
      if (featuredImg) {
        featuredImgEl.src = featuredImg;
        featuredContainer.classList.remove('hidden');
      } else {
        featuredContainer.classList.add('hidden');
      }

      // Parse Markdown to HTML
      // @ts-ignore
      const html = window.marked ? window.marked.parse(markdown) : markdown;
      const contentEl = document.getElementById('preview-content-html')!;
      contentEl.innerHTML = html;

      // Extract Table of Contents from H2 & H3 headings
      const headings = contentEl.querySelectorAll('h2, h3');
      const tocBox = document.getElementById('preview-toc-box')!;
      const tocList = document.getElementById('preview-toc-list')!;
      tocList.innerHTML = '';

      if (headings.length > 1) {
        tocBox.classList.remove('hidden');
        headings.forEach((h, i) => {
          const id = `heading-${i}`;
          h.id = id;
          const a = document.createElement('a');
          a.href = `#${id}`;
          a.className = h.tagName === 'H3' ? 'block pl-4 text-xs text-slate-500 hover:text-brand-primary transition-colors' : 'block text-sm font-medium text-slate-700 hover:text-brand-primary transition-colors';
          a.textContent = h.textContent;
          a.addEventListener('click', (e) => {
            e.preventDefault();
            h.scrollIntoView({ behavior: 'smooth' });
          });
          tocList.appendChild(a);
        });
      } else {
        tocBox.classList.add('hidden');
      }

      // Render Tags
      const tagsContainer = document.getElementById('preview-tags-container')!;
      tagsContainer.innerHTML = keywords.map(tag => `<span class="px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md text-xs font-medium">${tag}</span>`).join('');
    }

    btnPreview?.addEventListener('click', openPreviewModal);
    btnClosePreview?.addEventListener('click', closePreviewModal);
    btnBackEditor?.addEventListener('click', closePreviewModal);
    btnPreviewSave?.addEventListener('click', () => {
      closePreviewModal();
      saveBlogPost('Published');
    });

    previewLangEs?.addEventListener('click', () => renderPreview('es'));
    previewLangEn?.addEventListener('click', () => renderPreview('en'));

    // Viewport Toggle
    previewViewDesktop?.addEventListener('click', () => {
      previewViewportContainer.style.maxWidth = '48rem'; // max-w-3xl
      previewViewDesktop.className = 'px-2.5 py-1.5 rounded-md bg-white text-slate-800 shadow-xs';
      previewViewMobile.className = 'px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900';
    });

    previewViewMobile?.addEventListener('click', () => {
      previewViewportContainer.style.maxWidth = '390px';
      previewViewMobile.className = 'px-2.5 py-1.5 rounded-md bg-white text-slate-800 shadow-xs';
      previewViewDesktop.className = 'px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900';
    });

    // =========================================================================
    // 4. UNSPLASH PHOTO PICKER & USED ALBUM MODAL LOGIC
    // =========================================================================
    const unsplashModal = document.getElementById('unsplash-modal') as HTMLElement;
    const btnOpenUnsplash = document.getElementById('btn-open-unsplash-modal');
    const btnChangeImage = document.getElementById('btn-change-image');
    const btnCloseUnsplash = document.getElementById('btn-close-unsplash');
    const btnDoneUnsplash = document.getElementById('btn-done-unsplash');
    const unsplashSearchInput = document.getElementById('unsplash-search-input') as HTMLInputElement;
    const unsplashGrid = document.getElementById('unsplash-grid') as HTMLElement;
    const unsplashLoading = document.getElementById('unsplash-loading') as HTMLElement;

    const tabUnsplashAll = document.getElementById('tab-unsplash-all') as HTMLButtonElement;
    const tabUnsplashUsed = document.getElementById('tab-unsplash-used') as HTMLButtonElement;

    let currentUnsplashFilter: 'all' | 'used' = 'all';

    function openUnsplashModal() {
      unsplashModal.classList.remove('hidden');
      unsplashModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      
      const topicVal = (document.getElementById('title-es') as HTMLInputElement)?.value || (document.getElementById('title-en') as HTMLInputElement)?.value || 'business';
      if (!unsplashSearchInput.value) {
        unsplashSearchInput.value = topicVal.split(' ')[0] || 'business';
      }
      loadUnsplashPhotos(unsplashSearchInput.value.trim());
    }

    function closeUnsplashModal() {
      unsplashModal.classList.add('hidden');
      unsplashModal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    btnOpenUnsplash?.addEventListener('click', openUnsplashModal);
    btnChangeImage?.addEventListener('click', openUnsplashModal);
    btnCloseUnsplash?.addEventListener('click', closeUnsplashModal);
    btnDoneUnsplash?.addEventListener('click', closeUnsplashModal);

    let searchDebounce: any = null;
    unsplashSearchInput?.addEventListener('input', (e: any) => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        loadUnsplashPhotos(e.target.value.trim());
      }, 400);
    });

    tabUnsplashAll?.addEventListener('click', () => {
      currentUnsplashFilter = 'all';
      tabUnsplashAll.className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-primary text-white shadow-xs';
      tabUnsplashUsed.className = 'px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 border border-slate-200';
      loadUnsplashPhotos(unsplashSearchInput.value.trim());
    });

    tabUnsplashUsed?.addEventListener('click', async () => {
      currentUnsplashFilter = 'used';
      tabUnsplashUsed.className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-primary text-white shadow-xs';
      tabUnsplashAll.className = 'px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 border border-slate-200';
      loadUsedAlbumPhotos();
    });

    async function loadUnsplashPhotos(query: string) {
      if (currentUnsplashFilter === 'used') {
        return loadUsedAlbumPhotos();
      }

      unsplashLoading.classList.remove('hidden');
      unsplashGrid.innerHTML = '';

      try {
        const [photos, usedSet] = await Promise.all([
          searchUnsplashPhotos(query || 'business strategy', 1, 15),
          getUsedPhotoSet()
        ]);

        unsplashLoading.classList.add('hidden');

        if (!photos || photos.length === 0) {
          unsplashGrid.innerHTML = `<div class="col-span-3 text-center py-8 text-slate-500 text-sm">No photos found. Try a different query like "consulting", "law", or "taxes".</div>`;
          return;
        }

        photos.forEach(photo => {
          const isUsed = usedSet.has(photo.id);
          const card = createPhotoCard(photo, isUsed);
          unsplashGrid.appendChild(card);
        });
      } catch (e) {
        console.error("Error loading photos:", e);
        unsplashLoading.classList.add('hidden');
      }
    }

    async function loadUsedAlbumPhotos() {
      unsplashLoading.classList.remove('hidden');
      unsplashGrid.innerHTML = '';

      try {
        const usedSet = await getUsedPhotoSet();
        const photos = CURATED_UNSPLASH_POOL.map(p => ({
          id: p.id,
          url: p.url,
          thumbUrl: p.url.replace('&w=1200', '&w=400'),
          alt: p.alt,
          photographer: 'Curated Photo',
          photographerUrl: 'https://unsplash.com'
        }));

        unsplashLoading.classList.add('hidden');

        photos.forEach(photo => {
          const isUsed = usedSet.has(photo.id);
          const card = createPhotoCard(photo, isUsed);
          unsplashGrid.appendChild(card);
        });
      } catch (e) {
        console.error("Error loading used album:", e);
        unsplashLoading.classList.add('hidden');
      }
    }

    function createPhotoCard(photo: any, isUsed: boolean) {
      const card = document.createElement('div');
      card.className = 'group relative bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col';

      const badgeHtml = isUsed
        ? `<span class="absolute top-2 left-2 px-2 py-0.5 bg-amber-500/90 backdrop-blur-xs text-white text-[10px] font-bold rounded-full shadow-xs">📁 In Used Album</span>`
        : `<span class="absolute top-2 left-2 px-2 py-0.5 bg-emerald-500/90 backdrop-blur-xs text-white text-[10px] font-bold rounded-full shadow-xs">✓ Fresh & Unused</span>`;

      card.innerHTML = `
        <div class="aspect-video bg-slate-100 relative overflow-hidden">
          <img src="${photo.thumbUrl}" alt="${photo.alt}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          ${badgeHtml}
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-3 gap-1.5">
            <button type="button" class="btn-set-cover w-full py-1.5 bg-brand-primary hover:bg-brand-dark text-white text-xs font-semibold rounded shadow-xs transition-colors">
              🌟 Set as Cover Image
            </button>
            <button type="button" class="btn-insert-editor w-full py-1 bg-white/90 hover:bg-white text-slate-800 text-xs font-medium rounded shadow-xs transition-colors">
              📝 Insert in Markdown
            </button>
          </div>
        </div>
        <div class="p-2.5 flex items-center justify-between text-[11px] text-slate-500 bg-white">
          <span class="truncate max-w-[150px]">${photo.alt}</span>
          <a href="${photo.photographerUrl}" target="_blank" rel="noopener" class="text-slate-400 hover:text-brand-primary underline truncate max-w-[90px]">by ${photo.photographer}</a>
        </div>
      `;

      card.querySelector('.btn-set-cover')?.addEventListener('click', async () => {
        (document.getElementById('featured-image') as HTMLInputElement).value = photo.url;
        document.getElementById('featured-image')?.dispatchEvent(new Event('input'));
        await markPhotoAsUsed({ id: photo.id, url: photo.url, alt: photo.alt, blogId: postId || '' });
        // @ts-ignore
        window.showToast('Featured cover image set!', 'success');
        closeUnsplashModal();
      });

      card.querySelector('.btn-insert-editor')?.addEventListener('click', async () => {
        const isEnglish = document.getElementById('editor-en-container')?.classList.contains('block');
        const activeEditor = isEnglish ? easyMdeEn : easyMdeEs;
        if (activeEditor) {
          const cm = activeEditor.codemirror;
          const imgMarkdown = `\n\n![${photo.alt}](${photo.url})\n\n`;
          cm.replaceSelection(imgMarkdown);
          activeEditor.codemirror.focus();
        }
        await markPhotoAsUsed({ id: photo.id, url: photo.url, alt: photo.alt, blogId: postId || '' });
        // @ts-ignore
        window.showToast('Image embedded into editor!', 'success');
        closeUnsplashModal();
      });

      return card;
    }

    // =========================================================================
    // 5. FIRESTORE SAVING LOGIC
    // =========================================================================
    async function saveBlogPost(statusOverride?: string) {
      const titleEs = (document.getElementById('title-es') as HTMLInputElement).value;
      const titleEn = (document.getElementById('title-en') as HTMLInputElement).value;
      const publishDate = (document.getElementById('publish-date') as HTMLInputElement).value || new Date().toISOString().split('T')[0];
      const slugEn = (document.getElementById('slug-en') as HTMLInputElement).value;
      const slugEs = (document.getElementById('slug-es') as HTMLInputElement).value;
      const metaDesc = (document.getElementById('meta-desc') as HTMLTextAreaElement).value;
      const keywords = (document.getElementById('keywords') as HTMLInputElement).value;
      const featuredImage = (document.getElementById('featured-image') as HTMLInputElement).value;
      const author = (document.getElementById('author') as HTMLInputElement).value;
      const authorAvatar = (document.getElementById('author-avatar') as HTMLInputElement).value;
      const readTime = parseInt((document.getElementById('read-time') as HTMLInputElement).value, 10) || 5;
      
      const contentEs = easyMdeEs ? easyMdeEs.value() : '';
      const contentEn = easyMdeEn ? easyMdeEn.value() : '';

      if (!titleEn && !titleEs) {
        // @ts-ignore
        window.showToast('Please provide a title', 'warning');
        return;
      }

      const status = statusOverride || (document.getElementById('status-select') as HTMLSelectElement).value;

      const data: any = {
        titleEn,
        titleEs,
        contentEn,
        contentEs,
        slugEn,
        slugEs,
        status,
        publishDate,
        metaDesc,
        featuredImage,
        author,
        authorAvatar,
        readTime,
        keywords: keywords.split(',').map(k => k.trim()).filter(Boolean),
        updatedAt: new Date().toISOString()
      };

      try {
        if (postId) {
          await updateDoc(doc(db, 'blogs', postId), data);
        } else {
          data.createdAt = new Date().toISOString();
          data.views = 0;
          const newDoc = await addDoc(collection(db, 'blogs'), data);
          // If we just created a new post, update URL quietly
          window.history.replaceState({}, '', `/admin/blog/editor?id=${newDoc.id}`);
        }

        if (status === 'Published') {
          try {
            await addDoc(collection(db, 'notifications'), {
              title: 'Blog Post Published',
              message: `"${titleEs || titleEn || 'New Post'}" is now live on the site.`,
              type: 'blog',
              read: false,
              link: '/admin/blog',
              createdAt: serverTimestamp()
            });
          } catch (ne) {
            console.warn('Failed to add blog notification:', ne);
          }
        }

        updateStatusBadge(status);
        // @ts-ignore
        window.showToast(status === 'Published' ? 'Post published successfully!' : 'Draft saved securely!', 'success');
      } catch (error) {
        console.error('Error saving blog: ', error);
        // @ts-ignore
        window.showToast('Error saving to database.', 'error');
      }
    }

    document.getElementById('btn-save-draft')?.addEventListener('click', () => saveBlogPost('Draft'));
    document.getElementById('btn-publish')?.addEventListener('click', () => saveBlogPost('Published'));

    // =========================================================================
    // 6. UX ENHANCEMENTS
    // =========================================================================
    // Dynamic Meta Description Counter
    const metaDesc = document.getElementById('meta-desc');
    const metaCounter = document.getElementById('meta-counter');
    metaDesc?.addEventListener('input', (e: any) => {
      const length = e.target.value.length;
      if (metaCounter) {
        metaCounter.textContent = `${length} / 160`;
        if (length > 160) {
          metaCounter.className = 'text-xs text-red-500 mt-1 text-right font-medium';
        } else {
          metaCounter.className = 'text-xs text-slate-500 mt-1 text-right';
        }
      }
    });

    // Image Previews
    function setupImagePreview(inputId: string, previewId: string, placeholderId: string) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const preview = document.getElementById(previewId) as HTMLImageElement;
      const placeholder = document.getElementById(placeholderId);
      
      input?.addEventListener('input', (e: any) => {
        const url = e.target.value.trim();
        if (url) {
          preview.src = url;
          preview.classList.remove('hidden');
          if (placeholder) placeholder.classList.add('hidden');
        } else {
          preview.classList.add('hidden');
          preview.src = '';
          if (placeholder) placeholder.classList.remove('hidden');
        }
      });
    }
    
    setupImagePreview('featured-image', 'featured-image-preview', 'featured-image-placeholder');
    setupImagePreview('author-avatar', 'avatar-preview', 'avatar-placeholder');

    // Auto-generate Slugs
    function generateSlug(text: string) {
      return text.toString().toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    }

    const titleEn = document.getElementById('title-en') as HTMLInputElement;
    const titleEs = document.getElementById('title-es') as HTMLInputElement;
    const slugEn = document.getElementById('slug-en') as HTMLInputElement;
    const slugEs = document.getElementById('slug-es') as HTMLInputElement;

    titleEn?.addEventListener('input', (e: any) => {
      if (!slugEn.value || slugEn.dataset.autoGenerated === 'true') {
        slugEn.value = generateSlug(e.target.value);
        slugEn.dataset.autoGenerated = 'true';
      }
    });
    
    titleEs?.addEventListener('input', (e: any) => {
      if (!slugEs.value || slugEs.dataset.autoGenerated === 'true') {
        slugEs.value = generateSlug(e.target.value);
        slugEs.dataset.autoGenerated = 'true';
      }
    });

    slugEn?.addEventListener('input', () => { if (slugEn) slugEn.dataset.autoGenerated = 'false'; });
    slugEs?.addEventListener('input', () => { if (slugEs) slugEs.dataset.autoGenerated = 'false'; });
  </script>
</AdminLayout>
