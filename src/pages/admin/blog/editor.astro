    function autoLinkContent(content: string): { newContent: string; count: number } {
      let count = 0;
      const linkRules: [RegExp, string][] = [
        [/\b(IRS(?:\.gov)?)\b(?![^\[]*\])(?![^\(]*\))/g, '[IRS](https://www.irs.gov)'],
        [/\b(Formulario SS-4|Form SS-4)\b(?![^\[]*\])(?![^\(]*\))/g, '[Form SS-4](https://www.irs.gov/businesses/small-businesses-self-employed/apply-for-an-employer-identification-number-ein-online)'],
        [/\b(Secretar(?:í|i)a de Estado de Tennessee|Tennessee Secretary of State)\b(?![^\[]*\])(?![^\(]*\))/g, '[Secretaría de Estado de Tennessee](https://sos.tn.gov/business-services)'],
        [/\b(Departamento de Ingresos de Tennessee|Tennessee Department of Revenue)\b(?![^\[]*\])(?![^\(]*\))/g, '[Tennessee Department of Revenue](https://www.tn.gov/revenue/taxes/business-tax.html)'],
        [/\b(Secretario del Condado de Knox|Knox County Clerk)\b(?![^\[]*\])(?![^\(]*\))/g, '[Knox County Clerk](https://www.knoxcounty.org/clerk/business_tax.php)'],
        [/\b(Small Business Administration|SBA)\b(?![^\[]*\])(?![^\(]*\))/g, '[SBA](https://www.sba.gov/business-guide/launch-your-business)'],
        [/\b(OSHA)\b(?![^\[]*\])(?![^\(]*\))/g, '[OSHA](https://www.osha.gov/smallbusiness)'],
        [/\b(USPTO|Oficina de Patentes y Marcas)\b(?![^\[]*\])(?![^\(]*\))/g, '[USPTO](https://www.uspto.gov/trademarks)'],
        [/\b(Brookings Institution|Instituto Brookings)\b(?![^\[]*\])(?![^\(]*\))/g, '[Brookings Institution](https://www.brookings.edu)'],
        [/\b(Stanford Latino Entrepreneurship Initiative|SLEI)\b(?![^\[]*\])(?![^\(]*\))/g, '[Stanford Latino Entrepreneurship Initiative](https://www.gsb.stanford.edu/faculty-research/centers-initiatives/slei)'],
        [/\b(Michigan State University|JSRI)\b(?![^\[]*\])(?![^\(]*\))/g, '[Michigan State University JSRI](https://jsri.msu.edu)'],
        [/\b(U\.S\. Census Bureau|Oficina del Censo)\b(?![^\[]*\])(?![^\(]*\))/g, '[U.S. Census Bureau](https://www.census.gov)'],
        [/\b(Paquete de Lanzamiento Completo|Complete Launch Bundle)\b(?![^\[]*\])(?![^\(]*\))/g, '[Paquete de Lanzamiento Completo](/es/services/paquete-lanzamiento-completo)'],
        [/\b(Operaciones y Crecimiento|Operations and Growth)\b(?![^\[]*\])(?![^\(]*\))/g, '[Asesoría en Operaciones y Crecimiento](/es/services/operaciones-crecimiento)'],
        [/\b(Apoyo Creedava|Creedava Support)\b(?![^\[]*\])(?![^\(]*\))/g, '[Apoyo Creedava](/es/services/apoyo-creedava)']
      ];

      let result = content;
      for (const [regex, replacement] of linkRules) {
        const matches = result.match(regex);
        if (matches) {
          count += matches.length;
          result = result.replace(regex, replacement);
        }
      }
      return { newContent: result, count };
    }

