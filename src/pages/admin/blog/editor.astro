---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Blog Editor | Admin">
  <!-- Top Navigation & Action Bar -->
  <div class="mb-8 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a href="/admin/blog" class="text-sm text-slate-500 hover:text-brand-primary flex items-center gap-1 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Back to Blog Manager
        </a>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading flex items-center gap-3">
        <span id="editor-page-title">Edit Post</span>
        <span id="post-status-badge" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200">Draft</span>
      </h1>
    </div>
    <div class="flex items-center gap-2.5">
      <button id="btn-preview" type="button" class="px-4 py-2 border border-slate-200 text-slate-700 bg-white text-sm font-medium rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center gap-1.5 shadow-sm">
        <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        Preview
      </button>
      <button id="btn-save-draft" type="button" class="px-4 py-2 border border-slate-200 text-slate-700 bg-white text-sm font-medium rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm">
        Save Draft
      </button>
      <button id="btn-publish" type="button" class="px-5 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-95 hover:shadow transition-all flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        Publish Now
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content Area -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <!-- Language Switcher Tabs -->
        <div class="border-b border-slate-200 mb-6 flex justify-between items-center">
          <nav class="-mb-px flex space-x-8" aria-label="Tabs">
            <button id="tab-es" type="button" class="border-brand-primary text-brand-primary whitespace-nowrap py-3 px-1 border-b-2 font-semibold text-sm flex items-center gap-2">
              <span>🇪🇸</span> Español (Primary)
              <span id="wordcount-es-badge" class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-normal">0 words</span>
            </button>
            <button id="tab-en" type="button" class="border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
              <span>🇺🇸</span> English
              <span id="wordcount-en-badge" class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-normal">0 words</span>
            </button>
          </nav>
          <div class="text-xs text-slate-400 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span> Markdown Editor
          </div>
        </div>

        <!-- Spanish Editor -->
        <div id="editor-es-container" class="block space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Título en Español</label>
            <input type="text" id="title-es" placeholder="Título de la publicación (Español)" class="w-full text-2xl font-bold text-slate-900 placeholder-slate-300 border border-transparent hover:border-slate-200 focus:border-brand-primary focus:ring-0 rounded-lg p-2 transition-all bg-slate-50/50 focus:bg-white" />
          </div>
          <textarea id="md-es" class="w-full h-[550px] p-6 text-slate-700 bg-white border border-slate-200 rounded-xl font-mono text-sm focus:outline-none focus:border-brand-primary resize-y shadow-inner" placeholder="Escribe tu contenido en Markdown aquí..."></textarea>
        </div>

        <!-- English Editor -->
        <div id="editor-en-container" class="hidden space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">English Title</label>
            <input type="text" id="title-en" placeholder="Post Title (English)" class="w-full text-2xl font-bold text-slate-900 placeholder-slate-300 border border-transparent hover:border-slate-200 focus:border-brand-primary focus:ring-0 rounded-lg p-2 transition-all bg-slate-50/50 focus:bg-white" />
          </div>
          <textarea id="md-en" class="w-full h-[550px] p-6 text-slate-700 bg-white border border-slate-200 rounded-xl font-mono text-sm focus:outline-none focus:border-brand-primary resize-y shadow-inner" placeholder="Write your Markdown content here..."></textarea>
        </div>
      </div>
      
      <!-- Smart AI Blog Copilot & Editor Assistant -->
      <div class="bg-white border border-slate-200 rounded-xl flex flex-col shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-50 to-white">
          <div class="flex items-center gap-2">
            <span class="bg-brand-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shadow-xs">Gemini 3.5</span>
            <h3 class="font-bold text-slate-800 text-sm">Full-Document AI Copilot</h3>
          </div>
          <span class="text-xs text-slate-500">Context-Aware Assistant</span>
        </div>

        <!-- Quick AI Action Pills -->
        <div class="p-3 bg-slate-50/80 border-b border-slate-200 flex items-center gap-2 overflow-x-auto text-xs whitespace-nowrap scrollbar-thin">
          <span class="text-slate-400 font-medium text-[11px]">Quick Actions:</span>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="improve">
            Polish & Flow
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="translate">
            Translate Article
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="seo">
            Optimize SEO & Keywords
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="faq">
            Add FAQ Section
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="infographic_steps">
            Step-by-Step Infographic
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="infographic_comparison">
            Problem vs Solution Matrix
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="infographic_stats">
            Data & Metrics Grid
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="infographic_split">
            Split Comparison Card
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="citations">
            Add Citations & Research Links
          </button>
          <button type="button" class="copilot-pill px-2.5 py-1 bg-white hover:bg-brand-primary/10 hover:text-brand-primary hover:border-brand-primary/30 border border-slate-200 rounded-full text-slate-600 transition-all font-medium" data-action="title_meta">
            Enhance Title & Meta
          </button>
        </div>

        <!-- Chat Feed -->
        <div class="p-4 flex flex-col gap-4 max-h-80 overflow-y-auto bg-slate-50/40" id="copilot-chat">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-brand-primary/10 flex items-center justify-center shrink-0 border border-brand-primary/20">
              <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <div class="bg-white p-3.5 rounded-2xl rounded-tl-none border border-slate-200 shadow-xs text-sm text-slate-700 space-y-1.5 max-w-xl">
              <p class="font-medium text-slate-900">Hello! I'm your AI Editorial Assistant.</p>
              <p class="text-xs text-slate-600 leading-relaxed">
                I have full awareness of this article in both Spanish & English. You can ask me to rewrite sections, boost keyword density, generate FAQs, or translate the entire post. Use the quick actions above or type any request below.
              </p>
            </div>
          </div>
        </div>

        <!-- Chat Input -->
        <div class="p-3 border-t border-slate-200 bg-white">
          <div class="relative flex items-center">
            <input type="text" id="copilot-input" placeholder="e.g. 'Rewrite the introduction to emphasize Tennessee LLC tax perks'..." class="w-full pl-3 pr-24 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary bg-slate-50/50" />
            <button id="copilot-send" type="button" class="absolute right-2 px-3 py-1.5 bg-brand-primary text-white text-xs font-semibold rounded-md hover:bg-opacity-90 transition-colors shadow-xs flex items-center gap-1">
              <span>Send</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Settings -->
    <div class="space-y-6">
      <!-- Publish Settings -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">Publish Settings</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
            <select id="status-select" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50">
              <option value="Draft">Draft</option>
              <option value="Published" selected>Published</option>
              <option value="Archived">Archived</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Publish Date</label>
            <input type="date" id="publish-date" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" />
          </div>
        </div>
      </div>

      <!-- SEO & Meta -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">SEO & Meta</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Slug (English)</label>
            <input type="text" id="slug-en" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 mb-3" placeholder="e.g. how-to-start-llc" />
            
            <label class="block text-sm font-medium text-slate-700 mb-1">Slug (Español)</label>
            <input type="text" id="slug-es" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" placeholder="e.g. como-iniciar-llc" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Meta Description</label>
            <textarea id="meta-desc" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 h-24" placeholder="Brief description for search results..."></textarea>
            <p id="meta-counter" class="text-xs text-slate-500 mt-1 text-right">0 / 160</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Keywords</label>
            <input type="text" id="keywords" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" placeholder="e.g. LLC, Tennessee, business" value="LLC, Knoxville, Tennessee, business formation" />
          </div>
        </div>
      </div>

      <!-- Featured Image & Unsplash Album Picker -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-2">
          <h3 class="font-bold text-slate-900">Featured Cover Image</h3>
          <button id="btn-open-unsplash-modal" type="button" class="text-xs text-brand-primary hover:text-brand-dark font-semibold flex items-center gap-1 bg-brand-primary/10 px-2.5 py-1 rounded-md border border-brand-primary/20 hover:bg-brand-primary/20 transition-all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Photo Album
          </button>
        </div>
        
        <input type="text" id="featured-image" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 mb-3" placeholder="https://images.unsplash.com/..." />
        
        <div class="w-full aspect-video bg-slate-100 rounded-lg border border-slate-200 overflow-hidden flex items-center justify-center relative group">
          <span class="text-slate-400 text-xs" id="featured-image-placeholder">No cover image selected</span>
          <img id="featured-image-preview" src="" alt="Featured Preview" class="absolute inset-0 w-full h-full object-cover hidden" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
            <button type="button" id="btn-change-image" class="px-3 py-1.5 bg-white/90 text-slate-800 text-xs font-semibold rounded shadow hover:bg-white transition-all">
              Change Image
            </button>
          </div>
        </div>
      </div>

      <!-- Post Meta -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">Author & Reading Meta</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Author Name</label>
            <input type="text" id="author" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" value="Guia Negocios Team" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Author Avatar (URL)</label>
            <div class="flex gap-3 items-center">
              <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 shrink-0 overflow-hidden flex items-center justify-center relative">
                <svg id="avatar-placeholder" class="w-6 h-6 text-slate-400 absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                <img id="avatar-preview" src="" alt="Avatar" class="absolute inset-0 w-full h-full object-cover hidden" />
              </div>
              <input type="text" id="author-avatar" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" placeholder="https://images.unsplash.com/..." />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Estimated Read Time (minutes)</label>
            <input type="number" id="read-time" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" value="5" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. LIVE BLOG PREVIEW MODAL -->
  <!-- ========================================================================= -->
  <div id="preview-modal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-6 overflow-y-auto">
    <div class="bg-white w-full max-w-5xl rounded-2xl shadow-2xl flex flex-col max-h-[92vh] overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-150">
      <!-- Preview Modal Header -->
      <div class="px-6 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4 bg-slate-50">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center font-bold">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900">Live Post Preview</h2>
            <p class="text-xs text-slate-500">Real-time rendered representation of the article</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Language Toggle in Preview -->
          <div class="bg-slate-200/80 p-0.5 rounded-lg flex items-center text-xs font-semibold">
            <button id="preview-lang-es" type="button" class="px-3 py-1.5 rounded-md bg-white text-brand-primary shadow-xs transition-all">🇪🇸 Español</button>
            <button id="preview-lang-en" type="button" class="px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-all">🇺🇸 English</button>
          </div>

          <!-- Viewport Switcher -->
          <div class="bg-slate-200/80 p-0.5 rounded-lg hidden sm:flex items-center text-xs font-semibold">
            <button id="preview-view-desktop" type="button" class="px-2.5 py-1.5 rounded-md bg-white text-slate-800 shadow-xs" title="Desktop View">💻 Desktop</button>
            <button id="preview-view-mobile" type="button" class="px-2.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900" title="Mobile View">📱 Mobile</button>
          </div>

          <!-- Close Preview Button -->
          <button id="btn-close-preview" type="button" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <!-- Preview Modal Body (Article rendering) -->
      <div class="flex-1 overflow-y-auto p-6 sm:p-10 bg-slate-50/50 flex justify-center">
        <div id="preview-viewport-container" class="w-full max-w-3xl bg-white rounded-xl shadow-xs border border-slate-200/80 p-6 sm:p-10 transition-all">
          
          <!-- Article Header -->
          <div class="mb-8 border-b border-slate-100 pb-8">
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span id="preview-badge-status" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Published</span>
              <span id="preview-badge-date" class="text-xs text-slate-500">August 16, 2026</span>
              <span class="text-slate-300">•</span>
              <span id="preview-badge-readtime" class="text-xs text-slate-500">5 min read</span>
            </div>

            <h1 id="preview-title" class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-heading leading-tight mb-6">
              Post Title Preview
            </h1>

            <div class="flex items-center gap-3">
              <img id="preview-author-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="Author" class="w-10 h-10 rounded-full object-cover border border-slate-200" />
              <div>
                <p id="preview-author-name" class="text-sm font-bold text-slate-900">Guia Negocios Team</p>
                <p class="text-xs text-slate-500">Business & Legal Advisory</p>
              </div>
            </div>
          </div>

          <!-- Featured Cover Image in Preview -->
          <div id="preview-featured-container" class="mb-10 rounded-xl overflow-hidden border border-slate-200 aspect-video bg-slate-100 relative">
            <img id="preview-featured-img" src="" alt="Featured cover" class="w-full h-full object-cover" />
          </div>

          <!-- Table of Contents Preview -->
          <div id="preview-toc-box" class="mb-10 p-5 rounded-xl bg-slate-50 border border-slate-200 hidden">
            <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
              Table of Contents
            </h4>
            <div id="preview-toc-list" class="space-y-1.5 text-sm text-brand-primary"></div>
          </div>

          <!-- Markdown Rendered HTML -->
          <div id="preview-content-html" class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:text-slate-900 prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-xl prose-p:leading-relaxed prose-img:rounded-xl prose-img:border prose-img:border-slate-200 prose-img:shadow-sm">
