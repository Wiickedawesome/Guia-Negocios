        const usedSet = await getUsedPhotoSet();
        const photos = CURATED_UNSPLASH_POOL.map(p => ({
          id: p.id,
          url: p.url,
          thumbUrl: p.url.replace('&w=1200', '&w=400'),
          alt: p.alt,
          photographer: 'Curated Photo',
