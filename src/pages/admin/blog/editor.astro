    async function saveBlogPost(statusOverride?: string) {
      const titleEs = (document.getElementById('title-es') as HTMLInputElement).value;
      const titleEn = (document.getElementById('title-en') as HTMLInputElement).value;
      const publishDate = (document.getElementById('publish-date') as HTMLInputElement).value || new Date().toISOString().split('T')[0];
      let slugEn = (document.getElementById('slug-en') as HTMLInputElement).value;
      let slugEs = (document.getElementById('slug-es') as HTMLInputElement).value;
      let metaDesc = (document.getElementById('meta-desc') as HTMLTextAreaElement).value;
      const keywords = (document.getElementById('keywords') as HTMLInputElement).value;
      let featuredImage = (document.getElementById('featured-image') as HTMLInputElement).value;
      const author = (document.getElementById('author') as HTMLInputElement).value || 'Guia Negocios Team';
      const authorAvatar = (document.getElementById('author-avatar') as HTMLInputElement).value || '/images/team-avatar.webp';
      const readTime = parseInt((document.getElementById('read-time') as HTMLInputElement).value, 10) || 7;
      
      const contentEs = easyMdeEs ? easyMdeEs.value() : '';
      const contentEn = easyMdeEn ? easyMdeEn.value() : '';

      if (!titleEn && !titleEs) {
        // @ts-ignore
        window.showToast('Please provide a title', 'warning');
        return;
      }

      // Auto slug generation if empty
      if (!slugEs.trim() && titleEs.trim()) {
        slugEs = slugify(titleEs);
        (document.getElementById('slug-es') as HTMLInputElement).value = slugEs;
      }
      if (!slugEn.trim() && titleEn.trim()) {
        slugEn = slugify(titleEn);
        (document.getElementById('slug-en') as HTMLInputElement).value = slugEn;
      }
      if (!slugEs.trim() && slugEn.trim()) slugEs = slugEn;
      if (!slugEn.trim() && slugEs.trim()) slugEn = slugEs;

      // Auto featured image fallback if empty
      if (!featuredImage.trim()) {
        featuredImage = 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1200&q=80';
        (document.getElementById('featured-image') as HTMLInputElement).value = featuredImage;
      }

      // Auto meta description fallback if empty
      if (!metaDesc.trim()) {
        const bodySample = (contentEs || contentEn).replace(/[#*`_\[\]()!]/g, '').trim();
        metaDesc = bodySample.slice(0, 155) + '...';
        (document.getElementById('meta-desc') as HTMLTextAreaElement).value = metaDesc;
      }

      const status = statusOverride || (document.getElementById('status-select') as HTMLSelectElement).value;

      const data: any = {
        titleEn,
        titleEs,
        contentEn,
        contentEs,
        slugEn,
        slugEs,
        status,
        publishDate,
        metaDesc,
        featuredImage,
        author,
        authorAvatar,
        readTime,
        keywords: keywords.split(',').map(k => k.trim()).filter(Boolean),
        updatedAt: new Date().toISOString()
      };

      try {
        if (postId) {
          await updateDoc(doc(db, 'blogs', postId), data);
        } else {
          data.createdAt = new Date().toISOString();
          data.views = 0;
          const newDoc = await addDoc(collection(db, 'blogs'), data);
          postId = newDoc.id;
          document.getElementById('btn-delete')?.classList.remove('hidden');
          window.history.replaceState({}, '', `/admin/blog/editor?id=${newDoc.id}`);
        }
        updatePreviewLinks();

        if (status === 'Published') {
          try {
            await addDoc(collection(db, 'notifications'), {
              title: 'Blog Post Published',
              message: `"${titleEs || titleEn || 'New Post'}" is now live on the site.`,
              type: 'blog',
              read: false,
              link: '/admin/blog',
              createdAt: serverTimestamp()
            });
          } catch (ne) {
            console.warn('Failed to add blog notification:', ne);
          }

          const isEnglish = document.getElementById('editor-en-container')?.classList.contains('block');
          const activeLang = isEnglish ? 'en' : 'es';
          const activeSlug = isEnglish ? slugEn : slugEs;
          const liveUrl = `${window.location.origin}/${activeLang}/blog/${activeSlug}`;

          if (livePostUrlDisplay) livePostUrlDisplay.value = liveUrl;
          if (btnOpenLiveArticle) btnOpenLiveArticle.href = liveUrl;

          if (publishSuccessModal) {
            publishSuccessModal.classList.remove('hidden');
            publishSuccessModal.classList.add('flex');
          }
        }

        updateStatusBadge(status);
        // @ts-ignore
        window.showToast(status === 'Published' ? 'Post published and live!' : 'Draft saved securely!', 'success');
      } catch (error) {
        console.error('Error saving blog: ', error);
        // @ts-ignore
        window.showToast('Error saving to database.', 'error');
      }
    }

