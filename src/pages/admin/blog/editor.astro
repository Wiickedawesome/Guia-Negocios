  <script>
    import { aiModel, db } from '../../../lib/firebase';
    import { collection, addDoc, doc, getDoc, updateDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';
    import { 
      searchUnsplashPhotos, 
