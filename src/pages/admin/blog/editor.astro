          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <!-- Search & Filters -->
      <div class="p-4 border-b border-slate-200 bg-white flex flex-col sm:flex-row gap-3 items-center justify-between">
        <div class="relative w-full sm:w-80">
          <input type="text" id="unsplash-search-input" placeholder="Search photos (e.g. LLC, taxes, startup)..." class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
          <button id="tab-unsplash-all" type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-primary text-white shadow-xs">Fresh Unsplash Photos</button>
          <button id="tab-unsplash-used" type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 border border-slate-200">Used Album Registry</button>
        </div>
      </div>

      <!-- Photo Grid Content -->
      <div class="flex-1 overflow-y-auto p-6 bg-slate-50/50">
        <div id="unsplash-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          <!-- Loaded dynamically -->
        </div>
        <div id="unsplash-loading" class="hidden text-center py-12">
          <svg class="w-8 h-8 animate-spin text-brand-primary mx-auto mb-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          <p class="text-xs text-slate-500">Searching Unsplash photo collection...</p>
        </div>
      </div>

      <!-- Footer Notice -->
      <div class="px-6 py-3 border-t border-slate-200 bg-white flex items-center justify-between text-xs text-slate-500">
        <span>Photos provided via Unsplash API • Tracked in Firestore Album</span>
        <button id="btn-done-unsplash" type="button" class="px-4 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition-colors">Done</button>
      </div>
