    // Tab switching logic
    const tabEs = document.getElementById('tab-es');
    const tabEn = document.getElementById('tab-en');
    const containerEs = document.getElementById('editor-es-container');
    const containerEn = document.getElementById('editor-en-container');

    function switchTab(lang: 'es' | 'en') {
      if (lang === 'es') {
        tabEs!.className = 'border-brand-primary text-brand-primary whitespace-nowrap py-3 px-1 border-b-2 font-semibold text-sm flex items-center gap-2';
        tabEn!.className = 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2';
        containerEs!.classList.remove('hidden');
        containerEs!.classList.add('block');
        containerEn!.classList.add('hidden');
        containerEn!.classList.remove('block');
        if (easyMdeEs) easyMdeEs.codemirror.refresh();
      } else {
        tabEn!.className = 'border-brand-primary text-brand-primary whitespace-nowrap py-3 px-1 border-b-2 font-semibold text-sm flex items-center gap-2';
        tabEs!.className = 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3 px-1 border-b-2 font-medium text-sm flex items-center gap-2';
        containerEn!.classList.remove('hidden');
        containerEn!.classList.add('block');
        containerEs!.classList.add('hidden');
        containerEs!.classList.remove('block');
        if (easyMdeEn) easyMdeEn.codemirror.refresh();
      }
      updatePreviewLinks();
