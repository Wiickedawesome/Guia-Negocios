User Request: "${userPrompt}"
`;

        const result = await aiModel.generateContent(fullSystemContext);
        const responseRaw = result.response.text();
        const activeContent = isEnglish ? currentContentEn : currentContentEs;

        const parsed = parseAiEditorialResponse(responseRaw, activeContent);

        const actions: any[] = [];

        // Primary Apply Action
        if (selectedText) {
          actions.push({
            label: '🔄 Replace Highlighted Text',
            primary: true,
            handler: () => {
              if (activeEditor) {
                saveUndoSnapshot();
                activeEditor.codemirror.replaceSelection(parsed.cleanMarkdown);
                activeEditor.codemirror.focus();
                // @ts-ignore
                window.showToast('Selected text replaced successfully! Undo available.', 'success');
              }
            }
          });
        } else {
          actions.push({
            label: '✨ Apply Update to Blog Post',
            primary: true,
            handler: () => {
              if (activeEditor) {
                saveUndoSnapshot();
                activeEditor.value(parsed.cleanMarkdown);
                if (parsed.suggestedTitle) {
                  const titleInput = document.getElementById(isEnglish ? 'title-en' : 'title-es') as HTMLInputElement;
                  if (titleInput && !titleInput.value) titleInput.value = parsed.suggestedTitle;
                }
                if (parsed.suggestedMetaDesc) {
                  const metaInput = document.getElementById('meta-desc') as HTMLTextAreaElement;
                  if (metaInput) metaInput.value = parsed.suggestedMetaDesc;
                }
                updateWordCount(isEnglish ? 'en' : 'es');
                // @ts-ignore
                window.showToast('Blog post updated and enhanced! Undo available.', 'success');
              }
            }
          });

          actions.push({
            label: '📥 Insert as Section at End',
            primary: false,
            handler: () => {
              if (activeEditor) {
                saveUndoSnapshot();
                const curVal = activeEditor.value().trim();
                activeEditor.value(curVal + '\n\n' + parsed.cleanMarkdown);
                updateWordCount(isEnglish ? 'en' : 'es');
                // @ts-ignore
                window.showToast('Section appended to post!', 'success');
              }
            }
          });
        }

        // Fill opposite language
        actions.push({
          label: '🌐 Sync Opposite Language Tab',
          primary: false,
          handler: () => {
            if (otherEditor) {
              saveUndoSnapshot();
              otherEditor.value(parsed.cleanMarkdown);
              switchTab(isEnglish ? 'es' : 'en');
              // @ts-ignore
              window.showToast('Updated opposite language tab!', 'success');
            }
          }
        });

        // Copy clean markdown
        actions.push({
          label: '📋 Copy Clean Markdown',
          primary: false,
          handler: () => {
            navigator.clipboard.writeText(parsed.cleanMarkdown);
            // @ts-ignore
            window.showToast('Clean Markdown copied to clipboard!', 'info');
          }
        });

        appendCopilotMessage(parsed.commentary, false, actions, parsed.suggestedIdeas);
      } catch (error: any) {
        console.error('Copilot AI Error:', error);
        appendCopilotMessage('Error communicating with AI: ' + (error?.message || 'Please verify API connection in Settings.'), false);
      }
    }

