    const copilotInput = document.getElementById('copilot-input') as HTMLInputElement;
    const copilotSend = document.getElementById('copilot-send') as HTMLButtonElement;
    const copilotChat = document.getElementById('copilot-chat') as HTMLElement;
    const btnCopilotUndo = document.getElementById('btn-copilot-undo') as HTMLButtonElement;

    let editorUndoStack: { es: string; en: string; titleEs: string; titleEn: string; metaDesc: string }[] = [];

    function saveUndoSnapshot() {
      editorUndoStack.push({
        es: easyMdeEs ? easyMdeEs.value() : '',
        en: easyMdeEn ? easyMdeEn.value() : '',
        titleEs: (document.getElementById('title-es') as HTMLInputElement)?.value || '',
        titleEn: (document.getElementById('title-en') as HTMLInputElement)?.value || '',
        metaDesc: (document.getElementById('meta-desc') as HTMLTextAreaElement)?.value || ''
      });
      if (editorUndoStack.length > 10) editorUndoStack.shift();
      btnCopilotUndo?.classList.remove('hidden');
    }

    function revertUndoSnapshot() {
      const prev = editorUndoStack.pop();
      if (!prev) {
        // @ts-ignore
        window.showToast('Nothing to undo.', 'info');
        btnCopilotUndo?.classList.add('hidden');
        return;
      }
      if (easyMdeEs) easyMdeEs.value(prev.es);
      if (easyMdeEn) easyMdeEn.value(prev.en);
      if (prev.titleEs) (document.getElementById('title-es') as HTMLInputElement).value = prev.titleEs;
      if (prev.titleEn) (document.getElementById('title-en') as HTMLInputElement).value = prev.titleEn;
      if (prev.metaDesc) (document.getElementById('meta-desc') as HTMLTextAreaElement).value = prev.metaDesc;
      
      updateWordCount('es');
      updateWordCount('en');
      if (editorUndoStack.length === 0) {
        btnCopilotUndo?.classList.add('hidden');
      }
      // @ts-ignore
      window.showToast('Reverted to previous article state!', 'success');
    }

    btnCopilotUndo?.addEventListener('click', revertUndoSnapshot);

    function parseAiEditorialResponse(rawText: string, activeContent: string) {
      let commentary = '';
      let cleanMarkdown = '';
      let actionType: 'REPLACE_FULL_DOCUMENT' | 'INSERT_SECTION' | 'REPLACE_SELECTION' | 'BRAINSTORM_IDEAS' = 'REPLACE_FULL_DOCUMENT';
      let suggestedIdeas: string[] = [];
      let suggestedTitle: string | null = null;
      let suggestedMetaDesc: string | null = null;

      try {
        let cleanedJsonStr = rawText.trim();
        if (cleanedJsonStr.startsWith('```json')) {
          cleanedJsonStr = cleanedJsonStr.replace(/^```json\s*/, '').replace(/\s*```$/, '');
        } else if (cleanedJsonStr.startsWith('```')) {
          cleanedJsonStr = cleanedJsonStr.replace(/^```\s*/, '').replace(/\s*```$/, '');
        }

        const data = JSON.parse(cleanedJsonStr);
        commentary = data.commentary || data.summary || data.explanation || '';
        cleanMarkdown = data.cleanMarkdown || data.markdown || data.content || '';
        actionType = data.actionType || 'REPLACE_FULL_DOCUMENT';
        suggestedIdeas = Array.isArray(data.suggestedIdeas) ? data.suggestedIdeas : [];
        suggestedTitle = data.suggestedTitle || null;
        suggestedMetaDesc = data.suggestedMetaDesc || null;
      } catch (e) {
        const jsonMatch = rawText.match(/\{[\s\S]*"cleanMarkdown"[\s\S]*\}/);
        if (jsonMatch) {
          try {
            const data = JSON.parse(jsonMatch[0]);
            commentary = data.commentary || data.summary || '';
            cleanMarkdown = data.cleanMarkdown || data.markdown || '';
            actionType = data.actionType || 'REPLACE_FULL_DOCUMENT';
            suggestedIdeas = Array.isArray(data.suggestedIdeas) ? data.suggestedIdeas : [];
            suggestedTitle = data.suggestedTitle || null;
            suggestedMetaDesc = data.suggestedMetaDesc || null;
          } catch (e2) {}
        }
      }

      if (!cleanMarkdown) {
        const lines = rawText.split('\n');
        const filteredLines: string[] = [];
        let skippingGreeting = true;
        for (const line of lines) {
          const trimmed = line.trim();
          if (skippingGreeting) {
            if (
              trimmed.startsWith('Estimado') ||
              trimmed.startsWith('Hola') ||
              trimmed.startsWith('Como estratega') ||
              trimmed.startsWith('Here are') ||
              trimmed.startsWith('Sure,') ||
              trimmed.startsWith('### Estrategia de Optimización') ||
              trimmed.startsWith('Certainly')
            ) {
              continue;
            }
            if (trimmed.length > 0) {
              skippingGreeting = false;
              filteredLines.push(line);
            }
          } else {
            filteredLines.push(line);
          }
        }
        cleanMarkdown = filteredLines.join('\n').trim();
        commentary = `Evaluated the document and prepared the enhanced publication content below.`;
      }

      return {
        commentary: commentary || 'Formulated strategic optimizations and article content.',
        cleanMarkdown: cleanMarkdown.trim(),
        actionType,
        suggestedIdeas,
        suggestedTitle,
        suggestedMetaDesc
      };
    }

    function appendCopilotMessage(content: string, isUser = false, actions: any[] = [], ideas: string[] = []) {
      const div = document.createElement('div');
      div.className = isUser ? 'flex items-start gap-3 flex-row-reverse' : 'flex items-start gap-3';
      
