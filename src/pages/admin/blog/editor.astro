    // Image Previews
    function setupImagePreview(inputId: string, previewId: string, placeholderId: string) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      const preview = document.getElementById(previewId) as HTMLImageElement;
      const placeholder = document.getElementById(placeholderId);
      
      input?.addEventListener('input', (e: any) => {
        const url = e.target.value.trim();
        if (url) {
          preview.src = url;
          preview.classList.remove('hidden');
          if (placeholder) placeholder.classList.add('hidden');
        } else {
          preview.classList.add('hidden');
          preview.src = '';
          if (placeholder) placeholder.classList.remove('hidden');
        }
      });
    }
    
    setupImagePreview('featured-image', 'featured-image-preview', 'featured-image-placeholder');
    setupImagePreview('author-avatar', 'avatar-preview', 'avatar-placeholder');

    // Auto-generate Slugs
    function generateSlug(text: string) {
      return text.toString().toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    }

    const titleEn = document.getElementById('title-en') as HTMLInputElement;
    const titleEs = document.getElementById('title-es') as HTMLInputElement;
    const slugEn = document.getElementById('slug-en') as HTMLInputElement;
    const slugEs = document.getElementById('slug-es') as HTMLInputElement;

    titleEn?.addEventListener('input', (e: any) => {
      if (!slugEn.value || slugEn.dataset.autoGenerated === 'true') {
        slugEn.value = generateSlug(e.target.value);
        slugEn.dataset.autoGenerated = 'true';
      }
    });
    
    titleEs?.addEventListener('input', (e: any) => {
      if (!slugEs.value || slugEs.dataset.autoGenerated === 'true') {
        slugEs.value = generateSlug(e.target.value);
        slugEs.dataset.autoGenerated = 'true';
      }
    });

    slugEn?.addEventListener('input', () => { if (slugEn) slugEn.dataset.autoGenerated = 'false'; });
    slugEs?.addEventListener('input', () => { if (slugEs) slugEs.dataset.autoGenerated = 'false'; });
  </script>

