        : `<div class="w-8 h-8 rounded-full bg-brand-primary/10 flex items-center justify-center shrink-0 border border-brand-primary/20"><svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg></div>`;
      
      const bubbleClasses = isUser
        ? 'bg-brand-primary text-white p-3.5 rounded-2xl rounded-tr-none shadow-xs text-sm font-medium max-w-xl'
        : 'bg-white p-4 rounded-2xl rounded-tl-none border border-slate-200 shadow-xs text-sm text-slate-800 space-y-2.5 max-w-xl';
        
      let actionsHtml = '';
      if (actions.length > 0) {
        actionsHtml = `<div class="pt-2.5 border-t border-slate-100 flex flex-wrap gap-1.5">
          ${actions.map((act, i) => `<button type="button" class="copilot-action-btn text-xs font-semibold px-3 py-1.5 rounded-lg ${act.primary ? 'bg-brand-primary text-white hover:bg-emerald-900 shadow-xs' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'} transition-all flex items-center gap-1" data-action-index="${i}">${act.label}</button>`).join('')}
        </div>`;
      }

      let ideasHtml = '';
      if (ideas.length > 0) {
        ideasHtml = `
          <div class="pt-2 border-t border-slate-100">
            <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5 flex items-center gap-1">
              <span>💡 Explore & Expand Next:</span>
            </p>
            <div class="flex flex-wrap gap-1.5">
              ${ideas.map((idea) => `<button type="button" class="copilot-idea-pill text-xs bg-emerald-50/80 hover:bg-brand-primary hover:text-white text-brand-dark px-2.5 py-1 rounded-md transition-all font-medium border border-emerald-200/60 shadow-2xs flex items-center gap-1 text-left" data-idea-text="${idea.replace(/"/g, '&quot;')}"><span>✨ ${idea}</span></button>`).join('')}
            </div>
          </div>
        `;
      }

      const escapedContent = content.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const innerContent = isUser
        ? `<div class="text-white text-sm font-medium leading-relaxed whitespace-pre-wrap">${escapedContent}</div>`
        : `<div class="prose prose-xs max-w-none text-slate-700 prose-headings:text-slate-900 leading-relaxed">${// @ts-ignore
            window.marked ? window.marked.parse(content) : content}</div>`;

      div.innerHTML = `
        ${avatar}
        <div class="${bubbleClasses}">
          ${innerContent}
          ${ideasHtml}
          ${actionsHtml}
        </div>
      `;

      if (actions.length > 0) {
        div.querySelectorAll('.copilot-action-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.getAttribute('data-action-index') || '0', 10);
            if (actions[idx] && actions[idx].handler) {
              actions[idx].handler();
            }
          });
        });
      }

      div.querySelectorAll('.copilot-idea-pill').forEach(btn => {
        btn.addEventListener('click', () => {
          const ideaText = btn.getAttribute('data-idea-text') || '';
          if (ideaText) {
            handleCopilotPrompt(`Por favor investiga, amplía y redacta la siguiente sección/idea para este artículo: "${ideaText}"`);
          }
        });
      });

      copilotChat.appendChild(div);
      copilotChat.scrollTop = copilotChat.scrollHeight;
    }

    async function handleCopilotPrompt(userPrompt: string) {
