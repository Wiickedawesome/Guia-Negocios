---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Blog Editor | Admin">
  <!-- Top Navigation & Action Bar -->
  <div class="mb-8 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a href="/admin/blog" class="text-sm text-slate-500 hover:text-brand-primary flex items-center gap-1 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Back to Blog Manager
        </a>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading flex items-center gap-3">
        <span id="editor-page-title">Edit Post</span>
        <span id="post-status-badge" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200">Draft</span>
      </h1>
    </div>
    <div class="flex items-center gap-2.5">
      <button id="btn-delete" type="button" class="px-4 py-2 border border-rose-200 text-rose-600 bg-rose-50 text-sm font-medium rounded-lg hover:bg-rose-100 hover:border-rose-300 transition-all flex items-center gap-1.5 shadow-sm hidden">
        <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        Delete
      </button>
      <a id="btn-view-new-tab" href="#" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border border-slate-200 text-slate-700 bg-white text-sm font-medium rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center gap-1.5 shadow-sm" title="Preview post in a new tab">
        <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        <span>Preview</span>
      </a>
      <button id="btn-save-draft" type="button" class="px-4 py-2 border border-slate-200 text-slate-700 bg-white text-sm font-medium rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm">
        Save Draft
      </button>
      <button id="btn-publish" type="button" class="px-5 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-95 hover:shadow transition-all flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        Publish Now
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content Area -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <!-- Language Switcher Tabs -->
        <div class="border-b border-slate-200 mb-6 flex justify-between items-center">
          <nav class="-mb-px flex space-x-8" aria-label="Tabs">
            <button id="tab-es" type="button" class="border-brand-primary text-brand-primary whitespace-nowrap py-3.5 px-1 border-b-2 font-bold text-base flex items-center gap-2.5">
              <span class="px-2 py-0.5 rounded bg-brand-primary/10 text-xs font-bold text-brand-primary">ES</span>
              <span>Español (Principal)</span>
              <span id="wordcount-es-badge" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full font-normal">0 palabras</span>
            </button>
            <button id="tab-en" type="button" class="border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 whitespace-nowrap py-3.5 px-1 border-b-2 font-semibold text-base flex items-center gap-2.5">
              <span class="px-2 py-0.5 rounded bg-slate-100 text-xs font-bold text-slate-600">EN</span>
              <span>English</span>
              <span id="wordcount-en-badge" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full font-normal">0 words</span>
            </button>
          </nav>
          <div class="text-xs text-slate-400 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span> Markdown Editor
          </div>
        </div>

        <!-- Spanish Editor -->
        <div id="editor-es-container" class="block space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Título en Español</label>
            <input type="text" id="title-es" placeholder="Título de la publicación (Español)" class="w-full text-2xl font-bold text-slate-900 placeholder-slate-300 border border-transparent hover:border-slate-200 focus:border-brand-primary focus:ring-0 rounded-lg p-2 transition-all bg-slate-50/50 focus:bg-white" />
          </div>
          <textarea id="md-es" class="w-full h-[550px] p-6 text-slate-700 bg-white border border-slate-200 rounded-xl font-mono text-sm focus:outline-none focus:border-brand-primary resize-y shadow-inner" placeholder="Escribe tu contenido en Markdown aquí..."></textarea>
        </div>

        <!-- English Editor -->
        <div id="editor-en-container" class="hidden space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">English Title</label>
            <input type="text" id="title-en" placeholder="Post Title (English)" class="w-full text-2xl font-bold text-slate-900 placeholder-slate-300 border border-transparent hover:border-slate-200 focus:border-brand-primary focus:ring-0 rounded-lg p-2 transition-all bg-slate-50/50 focus:bg-white" />
          </div>
          <textarea id="md-en" class="w-full h-[550px] p-6 text-slate-700 bg-white border border-slate-200 rounded-xl font-mono text-sm focus:outline-none focus:border-brand-primary resize-y shadow-inner" placeholder="Write your Markdown content here..."></textarea>
        </div>
      </div>
      
      <!-- Smart AI Blog Copilot & Editor Assistant -->
      <div class="bg-white border border-slate-200 rounded-xl flex flex-col shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-50 to-white">
          <div class="flex items-center gap-2">
            <span class="bg-brand-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider shadow-xs">Gemini 3.5</span>
            <h3 class="font-bold text-slate-800 text-sm">Full-Document AI Copilot</h3>
          </div>
          <div class="flex items-center gap-2">
            <button id="btn-copilot-undo" type="button" class="hidden text-xs text-slate-600 hover:text-brand-primary font-medium px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 transition-all flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a5 5 0 015 5v2a5 5 0 01-5 5H6" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 6L3 10l4 4" /></svg>
              <span>Undo Edit</span>
            </button>
            <span class="text-xs text-slate-500">Autonomous Editor</span>
          </div>
        </div>

        <!-- Quick AI Strategy Prompts -->
        <div class="px-3 py-2 bg-slate-50/80 border-b border-slate-100 flex items-center gap-1.5 overflow-x-auto text-[11px]">
          <span class="text-slate-400 font-semibold uppercase tracking-wider shrink-0 mr-1">Quick:</span>
          <button type="button" class="copilot-quick-chip whitespace-nowrap px-2.5 py-1 rounded-full bg-white hover:bg-brand-primary hover:text-white border border-slate-200 text-slate-700 transition-all font-medium shadow-2xs" data-prompt="Revisa exhaustivamente este artículo, amplía su profundidad técnica, agrega mejores consejos prácticos, estadísticas oficiales y optimiza la estructura para SEO y motores de IA (AEO/GEO).">
            🚀 Deep SEO & AEO Rewrite
          </button>
          <button type="button" class="copilot-quick-chip whitespace-nowrap px-2.5 py-1 rounded-full bg-white hover:bg-brand-primary hover:text-white border border-slate-200 text-slate-700 transition-all font-medium shadow-2xs" data-prompt="Diseña e inserta un componente infográfico visual interactivo en HTML/CSS responsivo que resuma de forma gráfica los puntos clave o el proceso paso a paso de este artículo.">
            📊 Insert Infographic
          </button>
          <button type="button" class="copilot-quick-chip whitespace-nowrap px-2.5 py-1 rounded-full bg-white hover:bg-brand-primary hover:text-white border border-slate-200 text-slate-700 transition-all font-medium shadow-2xs" data-prompt="Evalúa qué aspectos clave faltan en este artículo y explora 5 ideas o ángulos nuevos de alto valor que podamos integrar para enriquecerlo.">
            💡 Brainstorm Angles
          </button>
          <button type="button" class="copilot-quick-chip whitespace-nowrap px-2.5 py-1 rounded-full bg-white hover:bg-brand-primary hover:text-white border border-slate-200 text-slate-700 transition-all font-medium shadow-2xs" data-prompt="Agrega una sección detallada sobre regulaciones federales (IRS/SBA/FinCEN), multas por incumplimiento y particularidades para emprendedores hispanos y dueños no residentes (NRA / ITIN).">
            ⚖️ Legal & IRS Rules
          </button>
        </div>

        <!-- Chat Feed -->
        <div class="p-4 flex flex-col gap-4 max-h-96 overflow-y-auto bg-slate-50/40" id="copilot-chat">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-brand-primary/10 flex items-center justify-center shrink-0 border border-brand-primary/20">
              <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <div class="bg-white p-3.5 rounded-2xl rounded-tl-none border border-slate-200 shadow-xs text-sm text-slate-700 space-y-1.5 max-w-xl">
              <p class="font-medium text-slate-900">AI Editorial Co-Author</p>
              <p class="text-xs text-slate-600 leading-relaxed">
                I evaluate your entire blog post, craft strategic enhancements, brainstorm new angles, insert infographics, and apply clean edits directly to your article.
              </p>
            </div>
          </div>
        </div>

        <!-- Chat Input -->
        <div class="p-3 border-t border-slate-200 bg-white">
          <div class="relative flex items-center">
            <input type="text" id="copilot-input" placeholder="e.g. 'Add 3 more strategies for building tier-2 credit vendor lines'..." class="w-full pl-3 pr-24 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-900 placeholder-slate-400 font-normal focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary bg-slate-50/50 focus:bg-white transition-colors" />
            <button id="copilot-send" type="button" class="absolute right-2 px-3 py-1.5 bg-brand-primary text-white text-xs font-semibold rounded-md hover:bg-opacity-90 transition-colors shadow-xs flex items-center gap-1">
              <span>Send</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar Settings -->
    <div class="space-y-6">
      <!-- Publish Settings -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">Publish Settings</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
            <select id="status-select" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50">
              <option value="Draft">Draft</option>
              <option value="Published" selected>Published</option>
              <option value="Archived">Archived</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Publish Date</label>
            <input type="date" id="publish-date" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" />
          </div>
        </div>
      </div>

      <!-- SEO & Meta -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">SEO & Meta</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Slug (English)</label>
            <input type="text" id="slug-en" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 mb-3" placeholder="e.g. how-to-start-llc" />
            
            <label class="block text-sm font-medium text-slate-700 mb-1">Slug (Español)</label>
            <input type="text" id="slug-es" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" placeholder="e.g. como-iniciar-llc" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Meta Description</label>
            <textarea id="meta-desc" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 h-24" placeholder="Brief description for search results..."></textarea>
            <p id="meta-counter" class="text-xs text-slate-500 mt-1 text-right">0 / 160</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Keywords</label>
            <input type="text" id="keywords" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" placeholder="e.g. LLC, Tennessee, business" value="LLC, Knoxville, Tennessee, business formation" />
          </div>
        </div>
      </div>

      <!-- Featured Image & Unsplash Album Picker -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-2">
          <h3 class="font-bold text-slate-900">Featured Cover Image</h3>
          <button id="btn-open-unsplash-modal" type="button" class="text-xs text-brand-primary hover:text-brand-dark font-semibold flex items-center gap-1 bg-brand-primary/10 px-2.5 py-1 rounded-md border border-brand-primary/20 hover:bg-brand-primary/20 transition-all">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Photo Album
          </button>
        </div>
        
        <input type="text" id="featured-image" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50 mb-3" placeholder="https://images.unsplash.com/..." />
        
        <div class="w-full aspect-video bg-slate-100 rounded-lg border border-slate-200 overflow-hidden flex items-center justify-center relative group">
          <span class="text-slate-400 text-xs" id="featured-image-placeholder">No cover image selected</span>
          <img id="featured-image-preview" src="" alt="Featured Preview" class="absolute inset-0 w-full h-full object-cover hidden" />
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
            <button type="button" id="btn-change-image" class="px-3 py-1.5 bg-white/90 text-slate-800 text-xs font-semibold rounded shadow hover:bg-white transition-all">
              Change Image
            </button>
          </div>
        </div>
      </div>

      <!-- Post Meta -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">Author & Reading Meta</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Author Name</label>
            <input type="text" id="author" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" value="Guia Negocios Team" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Author Avatar (URL)</label>
            <div class="flex gap-3 items-center">
              <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 shrink-0 overflow-hidden flex items-center justify-center relative">
                <svg id="avatar-placeholder" class="w-6 h-6 text-slate-400 absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                <img id="avatar-preview" src="" alt="Avatar" class="absolute inset-0 w-full h-full object-cover hidden" />
              </div>
              <input type="text" id="author-avatar" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" placeholder="/images/team-avatar.webp" value="/images/team-avatar.webp" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Estimated Read Time (minutes)</label>
            <input type="number" id="read-time" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-slate-50" value="5" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. POST PUBLISHED LIVE CONFIRMATION MODAL -->
  <!-- ========================================================================= -->
  <div id="publish-success-modal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white max-w-lg w-full rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-200 text-center animate-in zoom-in-95">
      <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 border border-emerald-200">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
      </div>
      <h3 class="text-xl font-bold text-slate-900 font-heading mb-2">🎉 Your Post is Live & Published!</h3>
      <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
        Your article has been saved to Firebase Firestore with verified SEO URL slugs, OG metadata, and is instantly accessible on the public site.
      </p>
      
      <!-- Canonical Link Box -->
      <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 mb-6 text-left space-y-1.5">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Canonical Live Link:</span>
        <div class="flex items-center justify-between gap-2">
          <input id="live-post-url-display" type="text" readonly class="w-full text-xs text-slate-800 font-mono bg-transparent outline-none select-all" />
          <button id="btn-copy-live-link" type="button" class="shrink-0 px-3 py-1.5 bg-white hover:bg-slate-100 text-brand-dark font-semibold text-xs rounded-lg border border-slate-200 transition-colors shadow-2xs">
            Copy
          </button>
        </div>
      </div>
      
      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a id="btn-open-live-article" href="#" target="_blank" class="w-full sm:w-auto px-6 py-2.5 bg-brand-primary hover:bg-emerald-900 text-white text-sm font-semibold rounded-xl transition-all flex items-center justify-center gap-2 shadow-xs">
          <span>🚀 View Live Post</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
        <button id="btn-close-publish-modal" type="button" class="w-full sm:w-auto px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-xl transition-all">
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. UNSPLASH PHOTO PICKER & ALBUM MODAL -->
  <!-- ========================================================================= -->
  <div id="unsplash-modal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-6 overflow-y-auto">
    <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden border border-slate-200">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900">Stock Photo Picker & Used Album</h2>
            <p class="text-xs text-slate-500">Pick high-resolution business photos from Pexels & Unsplash. Images already used are tracked to prevent duplicates.</p>
          </div>
        </div>
        <button id="btn-close-unsplash" type="button" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <!-- Search & Filters -->
      <div class="p-4 border-b border-slate-200 bg-white flex flex-col sm:flex-row gap-3 items-center justify-between">
        <div class="relative w-full sm:w-80">
