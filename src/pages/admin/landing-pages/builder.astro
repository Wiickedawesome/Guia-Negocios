---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Visual Page Builder | Admin">
  <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a href="/admin/landing-pages" class="text-xs text-slate-500 hover:text-brand-primary flex items-center gap-1 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Back to Landing Pages
        </a>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading flex items-center gap-2.5">
        <span id="header-page-title">Visual Page Builder</span>
        <span id="page-status-badge" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200">Draft</span>
      </h1>
      <p id="page-subtitle" class="text-xs text-slate-500 mt-0.5">Editing: New Landing Page</p>
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Viewport Toggle -->
      <div class="flex bg-slate-100 rounded-lg p-1 mr-1 border border-slate-200 shadow-xs">
        <button id="view-desktop" class="p-1.5 bg-white text-slate-900 shadow-xs rounded font-medium flex items-center gap-1.5 text-xs px-3" title="Desktop View">
          <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Desktop
        </button>
        <button id="view-mobile" class="p-1.5 text-slate-500 hover:text-slate-900 rounded font-medium flex items-center gap-1.5 text-xs px-3 transition-colors" title="Mobile View">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
          Mobile
        </button>
      </div>

      <!-- Delete Page Button (shown when editing an existing page) -->
      <button id="btn-delete" type="button" class="px-4 py-2 border border-rose-200 text-rose-600 bg-rose-50 text-xs font-semibold rounded-lg hover:bg-rose-100 hover:border-rose-300 transition-all flex items-center gap-1.5 shadow-xs hidden">
        <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        Delete
      </button>

      <!-- Live Full Preview Button -->
      <button id="btn-preview" type="button" class="px-4 py-2 border border-slate-200 text-slate-700 bg-white text-xs font-semibold rounded-lg hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center gap-1.5 shadow-xs">
        <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        Preview
      </button>

      <button id="btn-save-draft" class="px-4 py-2 text-xs border border-slate-200 rounded-lg text-slate-700 bg-white hover:bg-slate-50 font-semibold transition-colors shadow-xs">
        Save Draft
      </button>
      <button id="btn-publish" class="px-4 py-2 text-xs bg-brand-primary text-white rounded-lg hover:bg-emerald-900 font-semibold shadow-sm transition-colors flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        Publish Live
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
    <!-- Left Sidebar: Components & AI Assistant -->
    <div class="xl:col-span-3 bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5 h-[calc(100vh-14rem)] overflow-y-auto flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-2.5">
          <h3 class="font-bold text-slate-900 text-sm">Components</h3>
          <span class="bg-slate-100 text-slate-600 text-xs px-2.5 py-0.5 rounded-full font-medium">Click to add</span>
        </div>
        
        <div class="space-y-2.5">
          <!-- Hero Section -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-brand-primary hover:shadow-xs transition-all flex items-center gap-3" data-type="hero">
            <div class="p-2.5 bg-blue-50 text-blue-600 rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">Hero Section</div>
              <div class="text-xs text-slate-500">Headline & action button</div>
            </div>
          </button>

          <!-- Features Grid -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-emerald-500 hover:shadow-xs transition-all flex items-center gap-3" data-type="features">
            <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">Features / Benefits</div>
              <div class="text-xs text-slate-500">3-column value cards</div>
            </div>
          </button>

          <!-- Standard FAQ (FaqAccordion style) -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-purple-500 hover:shadow-xs transition-all flex items-center gap-3" data-type="faq">
            <div class="p-2.5 bg-purple-50 text-purple-600 rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">FAQ Accordion</div>
              <div class="text-xs text-slate-500">Standard 2-column numbered FAQ</div>
            </div>
          </button>

          <!-- Lead Capture Form -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-blue-500 hover:shadow-xs transition-all flex items-center gap-3" data-type="form_lead">
            <div class="p-2.5 bg-blue-50 text-blue-600 rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">Lead Capture Form</div>
              <div class="text-xs text-slate-500">Name, phone, email & message</div>
            </div>
          </button>

          <!-- Discount Promo Claim Form -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-amber-500 hover:shadow-xs transition-all flex items-center gap-3" data-type="form_promo">
            <div class="p-2.5 bg-amber-50 text-amber-600 rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V4a2 2 0 10-2 2h2m0 13l4-4m-4 4l-4-4" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">15% Promo Claim Form</div>
              <div class="text-xs text-slate-500">Discount activation with gold CTA</div>
            </div>
          </button>

          <!-- Call Booking Form -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-emerald-500 hover:shadow-xs transition-all flex items-center gap-3" data-type="form_call">
            <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">Call Booking Form</div>
              <div class="text-xs text-slate-500">Schedule phone consultation</div>
            </div>
          </button>

          <!-- Call To Action -->
          <button class="add-block-btn w-full text-left p-3 bg-white border border-slate-200 rounded-xl hover:border-brand-primary hover:shadow-xs transition-all flex items-center gap-3" data-type="cta">
            <div class="p-2.5 bg-brand-dark text-white rounded-lg shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <div>
              <div class="font-semibold text-sm text-slate-900">Call To Action</div>
              <div class="text-xs text-slate-500">Dark navy banner with gold CTA</div>
            </div>
          </button>
        </div>
      </div>

      <!-- AI Assistant -->
      <div class="mt-4 border-t border-slate-100 pt-3">
        <h3 class="font-bold text-slate-900 mb-1.5 flex items-center gap-1.5 text-xs">
          <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          AI Designer Assistant
          <span class="bg-brand-primary/10 text-brand-primary text-[10px] px-2 py-0.5 rounded-full font-bold uppercase">Gemini</span>
        </h3>
        <p class="text-xs text-slate-500 mb-2">Describe what you want to build or change, and AI will format it using our website design system.</p>
        
        <div class="relative">
          <textarea id="ai-builder-prompt" rows="3" class="w-full text-sm p-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-brand-primary focus:bg-white resize-none text-slate-800 placeholder-slate-400" placeholder="e.g., Generate a 3-section promo landing page for tax prep with 15% discount form and FAQ..."></textarea>
          <button id="ai-builder-submit" class="absolute bottom-2.5 right-2.5 p-1.5 bg-brand-primary text-white rounded-lg hover:bg-emerald-900 transition-colors shadow-xs" title="Send request">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Center: Canvas -->
    <div class="xl:col-span-6 bg-slate-100 rounded-xl border border-slate-200 shadow-inner h-[calc(100vh-14rem)] overflow-y-auto p-4 flex justify-center items-start" id="canvas-scroll-container">
      <div id="canvas-viewport-wrapper" class="w-full transition-all duration-300 max-w-full">
        <div id="canvas" class="min-h-full flex flex-col gap-4">
          
          <div id="empty-state" class="p-16 flex flex-col items-center justify-center text-slate-400 bg-white rounded-2xl border-2 border-dashed border-slate-200 my-8 text-center">
            <div class="w-12 h-12 mb-3 rounded-full bg-slate-50 flex items-center justify-center text-slate-300">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
            </div>
            <p class="font-medium text-slate-700 text-base mb-1">Your page is empty</p>
            <p class="text-xs text-slate-500">Click components on the left or use the AI assistant to start building.</p>
          </div>

        </div>
      </div>
    </div>

    <!-- Right Sidebar: Page & Block Settings -->
    <div class="xl:col-span-3 bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5 h-[calc(100vh-14rem)] overflow-y-auto">
      
      <!-- Page Settings -->
      <div id="page-settings" class="block animate-fade-in">
        <h3 class="font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2.5 flex items-center gap-1.5 text-sm">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Page Settings
        </h3>
        
        <div class="space-y-4">
          <!-- Title -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Page Title</label>
            <input type="text" id="lp-title" value="Starter Business Setup | Guia de Negocios" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary" />
          </div>

          <!-- Slug & Live URL Preview -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">URL Slug</label>
            <input type="text" id="lp-slug" value="starter" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary font-mono" />
            <div id="slug-preview" class="text-xs text-slate-500 mt-1 truncate">
              Preview: <span class="text-brand-primary font-semibold">/es/lp/starter</span>
            </div>
          </div>

          <!-- SEO Description with Counter -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="block text-xs font-semibold text-slate-700">SEO Description</label>
              <span id="meta-counter" class="text-xs text-slate-400 font-mono">0 / 160</span>
            </div>
            <textarea id="lp-meta-desc" rows="3" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary resize-none">Get your business off the ground with our comprehensive starter package designed for new entrepreneurs.</textarea>
          </div>

          <!-- Target Language -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Target Language</label>
            <select id="lp-lang" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white">
              <option value="es">ES - Español (Primary)</option>
              <option value="en">EN - English</option>
            </select>
          </div>

          <!-- Primary Goal Category -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Primary Goal / Offer</label>
            <select id="lp-goal" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white">
              <option value="lead">Lead Generation (General Contact)</option>
              <option value="discount">15% Discount / Promo Offer</option>
              <option value="call">Book a Consultation Call</option>
              <option value="sales">Direct Package Purchase</option>
              <option value="quote">Price Quote / Estimate</option>
              <option value="nra">Non-Resident Alien (NRA) Formation</option>
              <option value="contractor">Contractor Licensing</option>
            </select>
          </div>

          <!-- Status -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Publication Status</label>
            <select id="lp-status" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand-primary bg-white font-medium">
              <option value="Draft">Draft (Private)</option>
              <option value="Active">Active (Published Live)</option>
            </select>
          </div>

          <!-- Secondary In-Settings Delete Button -->
          <div id="settings-delete-container" class="pt-4 border-t border-slate-100 hidden">
            <button id="btn-delete-sidebar" type="button" class="w-full py-2.5 border border-rose-200 text-rose-600 bg-rose-50 hover:bg-rose-100 text-xs font-semibold rounded-lg transition-colors flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              Permanently Delete Page
            </button>
          </div>
        </div>
      </div>

      <!-- Block Settings -->
      <div id="block-settings" class="hidden animate-fade-in">
        <div class="flex items-center justify-between border-b border-slate-100 mb-3 pb-2.5">
          <h3 class="font-bold text-brand-primary flex items-center gap-1.5 text-sm" id="block-settings-title">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
            Block Settings
          </h3>
          <button class="text-xs px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md transition-colors font-semibold" id="back-to-page-settings">
            Done
          </button>
        </div>
        
        <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 mb-3">
          <p class="text-xs text-blue-800 flex items-start gap-2">
            <svg class="w-4 h-4 shrink-0 text-blue-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span><strong>Tip:</strong> Click any text directly on the canvas to edit it in place.</span>
          </p>
        </div>

        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-2">
            <button id="btn-move-up" class="py-2.5 px-3 border border-slate-200 rounded-lg hover:bg-slate-50 text-xs font-semibold text-slate-700 flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
              Move Up
            </button>
            <button id="btn-move-down" class="py-2.5 px-3 border border-slate-200 rounded-lg hover:bg-slate-50 text-xs font-semibold text-slate-700 flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              Move Down
            </button>
          </div>
          
          <button id="delete-active-block-btn" class="w-full py-2.5 border border-red-200 text-red-600 rounded-lg hover:bg-red-50 text-xs font-semibold transition-colors flex justify-center items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            Remove Block
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- FULLSCREEN LIVE PREVIEW MODAL -->
  <div id="preview-modal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-2 sm:p-6 animate-fade-in">
    <div class="bg-white w-full max-w-6xl h-[92vh] rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-200">
      
      <!-- Preview Modal Header -->
      <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50 shrink-0">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-brand-primary/10 rounded-lg text-brand-primary">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900">Live Landing Page Preview</h2>
            <p id="preview-modal-subtitle" class="text-xs text-slate-500">Real-time rendered replica of the landing page</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Viewport Switcher -->
          <div class="bg-slate-200/80 p-0.5 rounded-lg flex items-center text-xs font-semibold">
            <button id="modal-view-desktop" type="button" class="px-3.5 py-1.5 rounded-md bg-white text-slate-800 shadow-xs" title="Desktop View">💻 Desktop</button>
            <button id="modal-view-mobile" type="button" class="px-3.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-colors" title="Mobile View">📱 Mobile</button>
          </div>

          <!-- Close Preview Button -->
          <button id="btn-close-preview" type="button" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <!-- Preview Modal Content Container -->
      <div class="flex-1 overflow-y-auto bg-slate-100 flex justify-center p-4 sm:p-8">
        <div id="modal-viewport-container" class="w-full transition-all bg-white min-h-full rounded-2xl shadow-sm p-6 sm:p-10 space-y-6">
          <div id="modal-preview-content" class="max-w-4xl mx-auto space-y-6"></div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* In-place contenteditable styling */
    [contenteditable="true"]:focus {
      outline: 2px dashed rgba(27, 78, 43, 0.4);
      outline-offset: 4px;
      border-radius: 4px;
      background-color: rgba(255, 255, 255, 0.6);
    }
    [contenteditable="true"]:hover:not(:focus) {
      outline: 1px dashed rgba(148, 163, 184, 0.5);
      outline-offset: 4px;
    }
    .builder-block-selected {
      outline: 2px solid #1B4E2B !important;
      box-shadow: 0 0 0 4px rgba(27, 78, 43, 0.15) !important;
    }
  </style>

  <script>
    import { db, aiModel } from '../../../lib/firebase';
    import { doc, getDoc, setDoc, deleteDoc } from 'firebase/firestore';
    import { LANDING_PAGE_TEMPLATES } from '../../../utils/landing-page-templates';

    const canvas = document.getElementById('canvas') as HTMLElement;
    const emptyState = document.getElementById('empty-state') as HTMLElement;
    const pageSettings = document.getElementById('page-settings') as HTMLElement;
    const blockSettings = document.getElementById('block-settings') as HTMLElement;
    const backToPageBtn = document.getElementById('back-to-page-settings') as HTMLElement;
    const deleteBtn = document.getElementById('delete-active-block-btn') as HTMLElement;
    const btnMoveUp = document.getElementById('btn-move-up') as HTMLElement;
    const btnMoveDown = document.getElementById('btn-move-down') as HTMLElement;

    const btnDeleteTop = document.getElementById('btn-delete') as HTMLElement;
    const btnDeleteSidebar = document.getElementById('btn-delete-sidebar') as HTMLElement;
    const settingsDeleteContainer = document.getElementById('settings-delete-container') as HTMLElement;

    const viewDesktop = document.getElementById('view-desktop') as HTMLElement;
    const viewMobile = document.getElementById('view-mobile') as HTMLElement;
    const canvasViewportWrapper = document.getElementById('canvas-viewport-wrapper') as HTMLElement;

    // Fullscreen Preview Modal elements
    const btnPreview = document.getElementById('btn-preview') as HTMLElement;
    const previewModal = document.getElementById('preview-modal') as HTMLElement;
    const btnClosePreview = document.getElementById('btn-close-preview') as HTMLElement;
    const modalViewDesktop = document.getElementById('modal-view-desktop') as HTMLElement;
    const modalViewMobile = document.getElementById('modal-view-mobile') as HTMLElement;
    const modalViewportContainer = document.getElementById('modal-viewport-container') as HTMLElement;
    const modalPreviewContent = document.getElementById('modal-preview-content') as HTMLElement;
    const previewModalSubtitle = document.getElementById('preview-modal-subtitle') as HTMLElement;

    const lpSlugInput = document.getElementById('lp-slug') as HTMLInputElement;
    const lpLangSelect = document.getElementById('lp-lang') as HTMLSelectElement;
    const slugPreview = document.getElementById('slug-preview') as HTMLElement;
    const lpMetaDescInput = document.getElementById('lp-meta-desc') as HTMLTextAreaElement;
    const metaCounter = document.getElementById('meta-counter') as HTMLElement;

    let activeBlock: HTMLElement | null = null;
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('id');

    // Live Slug & Counter updates
    function updateUrlPreview() {
      const slug = lpSlugInput.value.trim() || 'slug';
      const lang = lpLangSelect.value || 'es';
      if (slugPreview) {
        slugPreview.innerHTML = `Preview: <span class="text-brand-primary font-semibold">/${lang}/lp/${slug}</span>`;
      }
    }

    function updateMetaCounter() {
      const len = lpMetaDescInput?.value.length || 0;
      if (metaCounter) {
        metaCounter.textContent = `${len} / 160`;
        metaCounter.className = len > 160 ? 'text-xs text-red-500 font-bold font-mono' : 'text-xs text-slate-400 font-mono';
      }
    }

    lpSlugInput?.addEventListener('input', updateUrlPreview);
    lpLangSelect?.addEventListener('change', updateUrlPreview);
    lpMetaDescInput?.addEventListener('input', updateMetaCounter);

    // Canvas Viewport Toggle (Desktop / Mobile)
    viewDesktop?.addEventListener('click', () => {
      canvasViewportWrapper.style.maxWidth = '100%';
      canvasViewportWrapper.className = 'w-full transition-all duration-300 max-w-full';
      viewDesktop.className = 'p-1.5 bg-white text-slate-900 shadow-xs rounded font-medium flex items-center gap-1.5 text-xs px-3';
      viewMobile.className = 'p-1.5 text-slate-500 hover:text-slate-900 rounded font-medium flex items-center gap-1.5 text-xs px-3 transition-colors';
    });

    viewMobile?.addEventListener('click', () => {
      canvasViewportWrapper.style.maxWidth = '390px';
      canvasViewportWrapper.className = 'w-full transition-all duration-300 mx-auto bg-white rounded-3xl p-3 sm:p-4 shadow-md border-4 border-slate-300';
      viewMobile.className = 'p-1.5 bg-white text-slate-900 shadow-xs rounded font-medium flex items-center gap-1.5 text-xs px-3';
      viewDesktop.className = 'p-1.5 text-slate-500 hover:text-slate-900 rounded font-medium flex items-center gap-1.5 text-xs px-3 transition-colors';
    });

    // =========================================================================
    // FULLSCREEN PREVIEW MODAL LOGIC
    // =========================================================================
    function openPreviewModal() {
      const clone = canvas.cloneNode(true) as HTMLElement;
      const empty = clone.querySelector('#empty-state');
      if (empty) empty.remove();

      clone.querySelectorAll('.builder-block').forEach(b => {
        b.classList.remove('builder-block-selected');
      });
      clone.querySelectorAll('[contenteditable="true"]').forEach(el => {
        el.removeAttribute('contenteditable');
      });

      modalPreviewContent.innerHTML = clone.innerHTML;
      const lang = lpLangSelect.value || 'es';
      const slug = lpSlugInput.value || 'page';
      if (previewModalSubtitle) {
        previewModalSubtitle.textContent = `/${lang}/lp/${slug}`;
      }

      previewModal.classList.remove('hidden');
      previewModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closePreviewModal() {
      previewModal.classList.add('hidden');
      previewModal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    btnPreview?.addEventListener('click', openPreviewModal);
    btnClosePreview?.addEventListener('click', closePreviewModal);

    modalViewDesktop?.addEventListener('click', () => {
      modalViewportContainer.style.maxWidth = '100%';
      modalViewportContainer.className = 'w-full transition-all bg-white min-h-full rounded-2xl shadow-sm p-6 sm:p-10 space-y-6';
      modalViewDesktop.className = 'px-3.5 py-1.5 rounded-md bg-white text-slate-800 shadow-xs';
      modalViewMobile.className = 'px-3.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-colors';
    });

    modalViewMobile?.addEventListener('click', () => {
      modalViewportContainer.style.maxWidth = '390px';
      modalViewportContainer.className = 'w-full transition-all bg-white min-h-full rounded-3xl shadow-xl p-4 space-y-6 border-8 border-slate-800';
      modalViewMobile.className = 'px-3.5 py-1.5 rounded-md bg-white text-slate-800 shadow-xs';
      modalViewDesktop.className = 'px-3.5 py-1.5 rounded-md text-slate-600 hover:text-slate-900 transition-colors';
    });

    function showPageSettings() {
      if (activeBlock) {
        activeBlock.classList.remove('builder-block-selected');
        activeBlock = null;
      }
      blockSettings.classList.add('hidden');
      pageSettings.classList.remove('hidden');
    }

    function selectBlock(block: HTMLElement) {
      document.querySelectorAll('#canvas .builder-block').forEach(b => {
        b.classList.remove('builder-block-selected');
      });

      block.classList.add('builder-block-selected');
      activeBlock = block;

      pageSettings.classList.add('hidden');
      blockSettings.classList.remove('hidden');
    }

    function attachBlockEvents(block: HTMLElement) {
      block.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).getAttribute('contenteditable') === 'true') {
          return;
        }
        selectBlock(block);
      });
    }

    // Add Component from Sidebar
    document.querySelectorAll('.add-block-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).dataset.type as keyof typeof LANDING_PAGE_TEMPLATES;
        if (LANDING_PAGE_TEMPLATES[type]) {
          if (emptyState) emptyState.style.display = 'none';

          const wrapper = document.createElement('div');
          wrapper.innerHTML = LANDING_PAGE_TEMPLATES[type].trim();
          const block = wrapper.firstElementChild as HTMLElement;

          attachBlockEvents(block);
          canvas.appendChild(block);
          selectBlock(block);

          block.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    backToPageBtn?.addEventListener('click', showPageSettings);

    deleteBtn?.addEventListener('click', () => {
      if (activeBlock) {
        activeBlock.remove();
        activeBlock = null;
        if (canvas.querySelectorAll('.builder-block').length === 0 && emptyState) {
          emptyState.style.display = 'flex';
        }
        showPageSettings();
      }
    });

    btnMoveUp?.addEventListener('click', () => {
      if (activeBlock && activeBlock.previousElementSibling && activeBlock.previousElementSibling !== emptyState) {
        canvas.insertBefore(activeBlock, activeBlock.previousElementSibling);
        activeBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    btnMoveDown?.addEventListener('click', () => {
      if (activeBlock && activeBlock.nextElementSibling) {
        canvas.insertBefore(activeBlock.nextElementSibling, activeBlock);
        activeBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // =========================================================================
    // AI ASSISTANT (CONCISE, GOAL-AWARE, OFFICIAL BRAND DESIGN SYSTEM)
    // =========================================================================
    async function handleAiPrompt(userPrompt: string) {
      if (!userPrompt.trim()) return;

      const title = (document.getElementById('lp-title') as HTMLInputElement)?.value || '';
      const slug = (document.getElementById('lp-slug') as HTMLInputElement)?.value || '';
      const metaDesc = (document.getElementById('lp-meta-desc') as HTMLTextAreaElement)?.value || '';
      const lang = (document.getElementById('lp-lang') as HTMLSelectElement)?.value || 'es';
      const goal = (document.getElementById('lp-goal') as HTMLSelectElement)?.value || 'lead';

      const submitBtn = document.getElementById('ai-builder-submit') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

      try {
        const systemPrompt = `
You are the official landing page designer for GUIA DE NEGOCIOS (bilingual business consultancy, guianegocios.net).
The user wants to generate or modify sections for this landing page:
- Page Title: "${title}"
- Slug: "${slug}"
- Description: "${metaDesc}"
- Language: "${lang}"
- Primary Goal: "${goal}"

USER REQUEST: "${userPrompt}"

CRITICAL BRAND & DESIGN SYSTEM RULES:
1. OFFICIAL COLOR PALETTE:
   - Primary Action Buttons: 'bg-brand-primary hover:bg-emerald-900 text-white font-semibold py-3.5 px-8 rounded-full shadow-md text-base' (Forest green #1B4E2B).
   - Sales / Promo / Special Offer Buttons: 'bg-brand-accent hover:bg-yellow-400 text-brand-dark font-bold py-3.5 px-8 rounded-full shadow-md text-base' (Warm Gold #F0C850 with Dark Navy text #1A2E35).
   - Dark Cards (CTA banners): 'bg-brand-dark text-white rounded-3xl p-8 sm:p-14 text-center shadow-xl'.
   - Light Cards / Sections: 'bg-slate-50 border border-slate-200 rounded-3xl p-8 sm:p-14 text-slate-900 shadow-sm'.
2. STRICT TYPOGRAPHY & CONTRAST (NO WASHED-OUT WHITE TEXT):
   - On light backgrounds: Headings MUST be 'text-brand-dark font-heading font-bold text-3xl sm:text-4xl' (Navy #1A2E35) or 'text-slate-900', paragraphs 'text-slate-600', labels 'text-slate-800 font-semibold text-sm', inputs 'bg-white border border-slate-300 text-slate-900 text-sm'.
   - NEVER put white text inside light or white containers.
3. CONCISE 3-4 SECTIONS: Keep landing pages short and focused (Hero, 3-Benefit Cards, High-converting Form, and 2-Column FAQ).
4. MANDATORY STANDARD 2-COLUMN FAQ STRUCTURE (DO NOT INVENT DIFFERENT FAQ DESIGNS):
   If generating an FAQ, you MUST strictly use this 2-column HTML blueprint:
   <div class="builder-block bg-white p-8 sm:p-14 rounded-3xl border border-slate-200 shadow-sm my-6 font-sans">
     <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
       <div class="lg:col-span-5 space-y-4">
         <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-brand-dark leading-tight" contenteditable="true">Preguntas Frecuentes</h2>
         <div><a href="/es/contact" class="inline-flex items-center text-brand-primary font-semibold hover:underline text-base gap-2" contenteditable="true">Contáctenos para más información <span>→</span></a></div>
       </div>
       <div class="lg:col-span-7 space-y-4">
         <details class="group border-b border-slate-200 pb-5 transition-all duration-200" open>
           <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
             <div class="flex items-center gap-4 sm:gap-6">
               <span class="text-brand-primary font-heading font-bold text-xl min-w-[32px]">01</span>
               <h3 class="text-base sm:text-lg font-heading text-brand-dark font-semibold leading-snug" contenteditable="true">[Relevant Question 1]</h3>
             </div>
             <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light shrink-0">+</span>
           </summary>
           <div class="pl-12 sm:pl-14 pt-3 pr-4 text-slate-600 text-sm leading-relaxed" contenteditable="true"><p>[Relevant Answer 1]</p></div>
         </details>
         <details class="group border-b border-slate-200 pb-5 transition-all duration-200">
           <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
             <div class="flex items-center gap-4 sm:gap-6">
               <span class="text-brand-primary font-heading font-bold text-xl min-w-[32px]">02</span>
               <h3 class="text-base sm:text-lg font-heading text-brand-dark font-semibold leading-snug" contenteditable="true">[Relevant Question 2]</h3>
             </div>
             <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light shrink-0">+</span>
           </summary>
           <div class="pl-12 sm:pl-14 pt-3 pr-4 text-slate-600 text-sm leading-relaxed" contenteditable="true"><p>[Relevant Answer 2]</p></div>
         </details>
         <details class="group border-b border-slate-200 pb-5 transition-all duration-200">
           <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
             <div class="flex items-center gap-4 sm:gap-6">
               <span class="text-brand-primary font-heading font-bold text-xl min-w-[32px]">03</span>
               <h3 class="text-base sm:text-lg font-heading text-brand-dark font-semibold leading-snug" contenteditable="true">[Relevant Question 3]</h3>
             </div>
             <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light shrink-0">+</span>
           </summary>
           <div class="pl-12 sm:pl-14 pt-3 pr-4 text-slate-600 text-sm leading-relaxed" contenteditable="true"><p>[Relevant Answer 3]</p></div>
         </details>
         <div class="pt-3"><a href="/es/faq" class="inline-flex items-center text-brand-primary font-semibold hover:underline text-sm gap-2" contenteditable="true">Ver todas las preguntas y respuestas <span>→</span></a></div>
       </div>
     </div>
   </div>
5. NO FLAG EMOJIS: Use clean SVG icons or text labels.
6. Add contenteditable="true" to all editable headings, paragraphs, and buttons.
7. Output ONLY raw HTML string wrapped in <div class="builder-block ...">...</div>. Do NOT include markdown code fences.
`;

        const result = await aiModel.generateContent(systemPrompt);
        let rawHtml = result.response.text().trim();
        rawHtml = rawHtml.replace(/```html\s*/gi, '').replace(/```\s*$/gi, '').trim();

        if (emptyState) emptyState.style.display = 'none';

        if (userPrompt.toLowerCase().includes('completa') || userPrompt.toLowerCase().includes('entire') || canvas.querySelectorAll('.builder-block').length === 0) {
          canvas.innerHTML = rawHtml;
          canvas.querySelectorAll('.builder-block').forEach(b => attachBlockEvents(b as HTMLElement));
        } else if (activeBlock && (userPrompt.toLowerCase().includes('modificar') || userPrompt.toLowerCase().includes('cambiar') || userPrompt.toLowerCase().includes('edit'))) {
          const temp = document.createElement('div');
          temp.innerHTML = rawHtml;
          const newBlock = temp.firstElementChild as HTMLElement;
          if (newBlock) {
            attachBlockEvents(newBlock);
            activeBlock.replaceWith(newBlock);
            selectBlock(newBlock);
          }
        } else {
          const temp = document.createElement('div');
          temp.innerHTML = rawHtml;
          Array.from(temp.children).forEach(child => {
            const block = child as HTMLElement;
            attachBlockEvents(block);
            canvas.appendChild(block);
            selectBlock(block);
          });
        }

        // @ts-ignore
        window.showToast('Section generated and added!', 'success');

      } catch (err: any) {
        console.error("AI Builder Error:", err);
        // @ts-ignore
        window.showToast('AI Generation error: ' + (err.message || 'Check connection'), 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>';
      }
    }

    document.getElementById('ai-builder-submit')?.addEventListener('click', () => {
      const input = document.getElementById('ai-builder-prompt') as HTMLTextAreaElement;
      handleAiPrompt(input.value);
    });

    // =========================================================================
    // SAVE & PUBLISH TO FIRESTORE
    // =========================================================================
    async function saveLandingPage(statusOverride?: 'Draft' | 'Active') {
      const title = (document.getElementById('lp-title') as HTMLInputElement)?.value.trim();
      const slug = (document.getElementById('lp-slug') as HTMLInputElement)?.value.trim();
      const metaDesc = (document.getElementById('lp-meta-desc') as HTMLTextAreaElement)?.value.trim();
      const lang = (document.getElementById('lp-lang') as HTMLSelectElement)?.value || 'es';
      const goal = (document.getElementById('lp-goal') as HTMLSelectElement)?.value || 'lead';
      const status = statusOverride || ((document.getElementById('lp-status') as HTMLSelectElement)?.value as 'Draft' | 'Active') || 'Draft';

      if (!title || !slug) {
        // @ts-ignore
        window.showToast('Title and URL Slug are required', 'warning');
        return;
      }

      // Clone canvas and clean internal attributes
      const clone = canvas.cloneNode(true) as HTMLElement;
      const empty = clone.querySelector('#empty-state');
      if (empty) empty.remove();

      clone.querySelectorAll('.builder-block').forEach(b => {
        b.classList.remove('builder-block-selected');
      });

      clone.querySelectorAll('[contenteditable="true"]').forEach(el => {
        el.removeAttribute('contenteditable');
      });

      const cleanHtml = clone.innerHTML.trim();
      const docId = editId || `${lang}_${slug}`;

      try {
        await setDoc(doc(db, 'landingPages', docId), {
          title,
          slug,
          metaDesc,
          lang,
          goal,
          content: cleanHtml,
          status,
          updatedAt: new Date().toISOString(),
          views: 0,
          conversions: 0
        }, { merge: true });

        // Update status badge UI
        const badge = document.getElementById('page-status-badge');
        if (badge) {
          badge.textContent = status;
          badge.className = status === 'Active'
            ? 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200'
            : 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200';
        }

        // @ts-ignore
        window.showToast(status === 'Active' ? 'Page published live!' : 'Draft saved securely!', 'success');

        setTimeout(() => {
          window.location.href = '/admin/landing-pages';
        }, 1000);

      } catch (err: any) {
        console.error("Error saving landing page:", err);
        // @ts-ignore
        window.showToast('Error saving to database: ' + err.message, 'error');
      }
    }

    // =========================================================================
    // DELETE LANDING PAGE HANDLER
    // =========================================================================
    async function deleteCurrentPage() {
      const docToDelete = editId || `${lpLangSelect.value}_${lpSlugInput.value}`;
      if (!docToDelete) return;

      // @ts-ignore
      const ok = (typeof window.showConfirm === 'function') 
        // @ts-ignore
        ? await window.showConfirm(
            'Delete Landing Page',
            'Are you sure you want to permanently delete this landing page? This action cannot be undone.'
          )
        : confirm('Are you sure you want to permanently delete this landing page? This action cannot be undone.');

      if (ok) {
        try {
          await deleteDoc(doc(db, 'landingPages', docToDelete));
          // @ts-ignore
          window.showToast('Landing page deleted successfully!', 'success');
          setTimeout(() => {
            window.location.href = '/admin/landing-pages';
          }, 600);
        } catch (err: any) {
          console.error("Delete error:", err);
          alert('Failed to delete page: ' + (err?.message || err));
        }
      }
    }

    btnDeleteTop?.addEventListener('click', deleteCurrentPage);
    btnDeleteSidebar?.addEventListener('click', deleteCurrentPage);

    // Load existing page if editing
    if (editId) {
      getDoc(doc(db, 'landingPages', editId)).then(snap => {
        if (snap.exists()) {
          const data = snap.data();
          (document.getElementById('lp-title') as HTMLInputElement).value = data.title || '';
          (document.getElementById('lp-slug') as HTMLInputElement).value = data.slug || '';
          (document.getElementById('lp-meta-desc') as HTMLTextAreaElement).value = data.metaDesc || '';
          (document.getElementById('lp-lang') as HTMLSelectElement).value = data.lang || 'es';
          if (data.goal) (document.getElementById('lp-goal') as HTMLSelectElement).value = data.goal;
          if (data.status) (document.getElementById('lp-status') as HTMLSelectElement).value = data.status;

          document.getElementById('header-page-title')!.textContent = data.title || 'Visual Page Builder';
          document.getElementById('page-subtitle')!.textContent = `Editing: ${data.title} (/${data.lang || 'es'}/lp/${data.slug})`;
          
          // Show delete button
          btnDeleteTop?.classList.remove('hidden');
          settingsDeleteContainer?.classList.remove('hidden');

          // Update Status Badge
          const badge = document.getElementById('page-status-badge');
          if (badge) {
            const status = data.status || 'Draft';
            badge.textContent = status;
            badge.className = status === 'Active'
              ? 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200'
              : 'text-xs px-2.5 py-0.5 rounded-full font-semibold bg-amber-100 text-amber-800 border border-amber-200';
          }

          updateUrlPreview();
          updateMetaCounter();

          if (data.content && data.content.trim()) {
            if (emptyState) emptyState.style.display = 'none';
            canvas.innerHTML = data.content;
            canvas.querySelectorAll('.builder-block').forEach(b => {
              b.querySelectorAll('h1, h2, h3, h4, h5, p, span, a, button, li').forEach(el => {
                if (!el.getAttribute('contenteditable')) el.setAttribute('contenteditable', 'true');
              });
              attachBlockEvents(b as HTMLElement);
            });
          }
        }
      }).catch(e => console.warn("Failed to load page for edit:", e));
    } else {
      updateUrlPreview();
      updateMetaCounter();
    }

    document.getElementById('btn-save-draft')?.addEventListener('click', () => saveLandingPage('Draft'));
    document.getElementById('btn-publish')?.addEventListener('click', () => saveLandingPage('Active'));
  </script>
</AdminLayout>
