    function showPageSettings() {
      activeBlock = null;
      document.querySelectorAll('.builder-block').forEach(b => {
         b.classList.remove('border-brand-primary', 'ring-4', 'ring-brand-primary/20', 'z-10');
         b.classList.add('border-transparent');
      });
      blockSettings.classList.add('hidden');
      pageSettings.classList.remove('hidden');
    }

    addButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.type;
        if (blockTemplates[type]) {
          if (emptyState) emptyState.style.display = 'none';
          
          // Create wrapper
          const div = document.createElement('div');
          div.innerHTML = blockTemplates[type];
          const block = div.firstElementChild;
          
          // Select logic
          block.addEventListener('click', (e) => {
            // Deselect others
            document.querySelectorAll('.builder-block').forEach(b => {
               b.classList.remove('border-brand-primary', 'ring-4', 'ring-brand-primary/20', 'z-10');
               b.classList.add('border-transparent');
            });
            
            // Select this
            block.classList.remove('border-transparent');
            block.classList.add('border-brand-primary', 'ring-4', 'ring-brand-primary/20', 'z-10');
            activeBlock = block;
            
            // Show settings
            pageSettings.classList.add('hidden');
            blockSettings.classList.remove('hidden');
            
            const titles = {
              'hero': 'Hero Section Settings',
              'features': 'Features Settings',
              'cta': 'Call to Action Settings',
              'testimonials': 'Testimonials Settings'
            };
            blockSettingsTitle.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg> ${titles[type]}`;
          });

          // Insert block
          canvas.appendChild(block);
          
          // Auto select newly created block
          block.click();
          
          // Scroll to bottom
          setTimeout(() => {
            document.getElementById('canvas-container').scrollTop = canvas.scrollHeight;
          }, 50);
          
          showToast(type.charAt(0).toUpperCase() + type.slice(1) + ' block added!', 'success');
        }
      });
    });

    backToPageBtn.addEventListener('click', showPageSettings);

    deleteBtn.addEventListener('click', () => {
      if (activeBlock) {
        activeBlock.classList.add('opacity-0', 'scale-95'); // animate out
        setTimeout(() => {
          activeBlock.remove();
          if (canvas.querySelectorAll('.builder-block').length === 0) {
            emptyState.style.display = 'flex';
          }
          showPageSettings();
        }, 200);
      }
    });

    // AI Assistant Integration
    document.getElementById('ai-builder-submit')?.addEventListener('click', async function() {
      const promptInput = document.getElementById('ai-builder-prompt').value.trim();
      if (!promptInput) {
        showToast('Please type a request for the AI', 'warning');
        return;
      }
      
      document.getElementById('ai-builder-prompt').value = '';
      simulateAction('Gemini is designing...', 'AI generated a new custom block based on your request!', 4000);
      
      try {
        emptyState.style.display = 'none';
        
        const prompt = `You are an expert Tailwind CSS web designer. The user wants to add a new section to their landing page. 
Request: "${promptInput}". 
Generate the raw HTML code for this section using Tailwind CSS classes. 
Make it look modern, professional, and responsive. Use nice padding (e.g. p-12) and rounded corners.
Do not include \`\`\`html or any markdown blocks. Output ONLY the raw HTML string. 
Use generic text/images if needed, and add contenteditable="true" to headings and paragraphs.`;
        
        const result = await aiModel.generateContent(prompt);
        let htmlContent = await result.response.text();
        htmlContent = htmlContent.replace(/```html\\n?/gi, '').replace(/```\\n?/g, '');
        
        const newBlock = document.createElement('div');
        newBlock.className = 'builder-block relative group border-2 border-transparent hover:border-brand-primary rounded-xl cursor-pointer transition-all mb-4';


        newBlock.innerHTML = `
          ${htmlContent}
          <div class="absolute -top-3 -right-3 hidden group-hover:flex bg-white shadow-lg border border-slate-200 rounded-lg p-1 z-10">
            <button class="p-1.5 text-slate-400 hover:text-red-500 rounded" title="Delete block" onclick="this.closest('.builder-block').remove(); if(document.querySelectorAll('.builder-block').length===0) document.getElementById('empty-state').style.display='flex'; event.stopPropagation();">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
          </div>
        `;

        newBlock.addEventListener('click', (e) => {
          if(e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
          document.querySelectorAll('.builder-block').forEach(b => b.classList.remove('ring-4', 'ring-brand-primary/30'));
          newBlock.classList.add('ring-4', 'ring-brand-primary/30');
          activeBlock = newBlock;
          showBlockSettings();
        });

        canvas.appendChild(newBlock);
        newBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        console.error('AI Design Error:', error);
        showToast('Error communicating with the AI service.', 'error');
      }
    });

    // Save Landing Page to Firestore
    async function saveLandingPage(status) {
      const title = document.getElementById('lp-title').value;
      const slug = document.getElementById('lp-slug').value;
      const metaDesc = document.getElementById('lp-meta-desc').value;
      const lang = document.getElementById('lp-lang').value;

      if (!title || !slug) {
        showToast('Title and Slug are required', 'warning');
        return;
      }

      simulateAction('Saving landing page...', 'Saved securely to Firestore', 1500);

      // Clone canvas to strip builder classes and contenteditable attributes
      const clone = canvas.cloneNode(true);
      const empty = clone.querySelector('#empty-state');
      if (empty) empty.remove();
      
      clone.querySelectorAll('.builder-block').forEach(b => {
        b.classList.remove('border-brand-primary', 'ring-4', 'ring-brand-primary/20', 'border-2', 'border-transparent', 'hover:border-brand-primary/50', 'hover:border-brand-primary', 'cursor-pointer', 'z-10', 'animate-fade-in');
        const deleteBtn = b.querySelector('.absolute.-top-3.-right-3');
        if (deleteBtn) deleteBtn.remove();
      });
      
      clone.querySelectorAll('[contenteditable="true"]').forEach(el => {
        el.removeAttribute('contenteditable');
      });

      const content = clone.innerHTML.trim();

      try {
        // Use setDoc with a fixed ID pattern based on lang + slug to allow updating existing pages
        const docId = `${lang}_${slug}`;
        await setDoc(doc(db, 'landingPages', docId), {
          title,
          slug,
          metaDesc,
          lang,
          content,
          status,
          updatedAt: new Date().toISOString(),
          views: 0,
          conversions: 0
        });

        // @ts-ignore
        showToast(status === 'Active' ? 'Page published successfully!' : 'Draft saved!', 'success');
        
        setTimeout(() => {
          window.location.href = '/admin/landing-pages';
        }, 1200);
      } catch (error) {
        console.error('Error saving landing page: ', error);
        // @ts-ignore
        showToast('Error saving to database.', 'error');
      }
    }

    // Load existing page if editing
    const urlParams = new URLSearchParams(window.location.search);
    const editId = urlParams.get('id');
    if (editId) {
      getDoc(doc(db, 'landingPages', editId)).then(snap => {
        if (snap.exists()) {
          const data = snap.data();
          const titleInput = document.getElementById('lp-title') as HTMLInputElement;
          const slugInput = document.getElementById('lp-slug') as HTMLInputElement;
          const descInput = document.getElementById('lp-meta-desc') as HTMLTextAreaElement;
          const langSelect = document.getElementById('lp-lang') as HTMLSelectElement;

          if (titleInput) titleInput.value = data.title || '';
          if (slugInput) slugInput.value = data.slug || '';
          if (descInput) descInput.value = data.metaDesc || '';
          if (langSelect) langSelect.value = data.lang || 'es';

          if (data.content && data.content.trim()) {
            if (emptyState) emptyState.style.display = 'none';
            canvas.innerHTML = data.content;
          }
        }
      }).catch(e => console.warn("Failed to load page for edit:", e));
    }

    document.getElementById('btn-save-draft')?.addEventListener('click', () => saveLandingPage('Draft'));
    document.getElementById('btn-publish')?.addEventListener('click', () => saveLandingPage('Active'));
  </script>
