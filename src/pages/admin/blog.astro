---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Blog Manager | Admin">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Blog Manager</h1>
      <p class="text-sm text-slate-500 mt-1">Create, manage, and optimize blog posts.</p>
    </div>
    <a href="/admin/blog/editor" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
      + New Post
    </a>
  </div>

  <!-- AI Draft Generator -->
  <div class="bg-gradient-to-r from-brand-dark to-slate-800 rounded-xl p-6 shadow-sm text-white mb-6">
    <div class="flex items-center gap-3 mb-4">
      <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      <h3 class="text-lg font-bold">AI Blog Draft Generator</h3>
      <span class="px-2.5 py-0.5 bg-amber-400/20 text-amber-300 text-xs font-bold rounded-full border border-amber-400/30">Gemini</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Topic</label>
        <input id="ai-topic" type="text" placeholder="e.g., How to make a successful business plan" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Target Keywords</label>
        <input id="ai-keywords" type="text" placeholder="e.g., tax, llc, business, plan" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Primary Language</label>
        <select id="ai-lang" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white text-sm focus:outline-none focus:border-brand-primary">
          <option value="es" class="text-slate-900" selected>ES - Spanish (Bilingual)</option>
          <option value="en" class="text-slate-900">EN - English (Bilingual)</option>
        </select>
      </div>
    </div>
    <button id="ai-generate-btn" class="px-5 py-2.5 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-opacity-90 transition-colors flex items-center gap-2 font-semibold shadow-sm">
      <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      Generate Draft with Gemini
    </button>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
    <div class="flex items-center gap-1 p-2 border-b border-slate-200 bg-slate-50 overflow-x-auto">
      <button class="px-4 py-1.5 text-sm font-medium rounded-md bg-brand-primary text-white">All</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Draft</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Published</button>
      <div class="w-px h-6 bg-slate-200 mx-1"></div>
      <button class="px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100 flex items-center gap-1.5">
        <span class="px-1.5 py-0.5 rounded bg-slate-200 text-[11px] font-bold text-slate-700">EN</span>
        <span>English</span>
      </button>
      <button class="px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100 flex items-center gap-1.5">
        <span class="px-1.5 py-0.5 rounded bg-slate-200 text-[11px] font-bold text-slate-700">ES</span>
        <span>Español</span>
      </button>
    </div>

    <!-- Posts Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 font-medium">Title</th>
            <th class="px-6 py-3 font-medium">Status</th>
            <th class="px-6 py-3 font-medium">Lang</th>
            <th class="px-6 py-3 font-medium">Views</th>
            <th class="px-6 py-3 font-medium">Date</th>
            <th class="px-6 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="blog-table-body" class="divide-y divide-slate-100">
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-slate-500">
              <svg class="animate-spin h-5 w-5 text-brand-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Loading blogs...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { collection, getDocs, addDoc, updateDoc, deleteDoc, doc, serverTimestamp } from 'firebase/firestore';
    import { db, aiModel } from '../../lib/firebase';
    import { getUniqueUnsplashPhoto } from '../../utils/unsplash';
    import { getRelevantCitations, AUTHORITATIVE_SOURCES } from '../../utils/research';
    import { getInfographicSystemPrompt } from '../../utils/infographics';
    
    // Filter tabs
    document.querySelectorAll('.flex.items-center.gap-1 button').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.flex.items-center.gap-1 button').forEach(t => {
          t.classList.remove('bg-brand-primary', 'text-white');
          t.classList.add('text-slate-600');
        });
        tab.classList.add('bg-brand-primary', 'text-white');
        tab.classList.remove('text-slate-600');
        
        const filter = tab.textContent?.trim();
        document.querySelectorAll('tbody tr').forEach(row => {
          const rowEl = row as HTMLElement;
          if (filter === 'All') {
            rowEl.style.display = '';
          } else if (filter === 'Draft' || filter === 'Published') {
            const status = rowEl.querySelector('td:nth-child(2)')?.textContent?.trim();
            rowEl.style.display = status === filter ? '' : 'none';
          } else if (filter === 'EN' || filter === 'ES') {
            const lang = rowEl.querySelector('td:nth-child(3)')?.textContent?.trim();
            rowEl.style.display = (lang === filter || lang === 'EN/ES') ? '' : 'none';
          }
        });
      });
    });

    // Helper: Parse AI response with support for delimited blocks, clean JSON, and fallback extraction
    function parseAiDraftResponse(rawText: string, topic: string) {
      // 1. Check for Delimited Section Headers (Crash-proof format)
      if (rawText.includes('===CONTENT_ES===') || rawText.includes('===TITLE_ES===')) {
        const extractBlock = (marker: string, nextMarker: string): string => {
          const parts = rawText.split(marker);
          if (parts.length < 2) return '';
          const content = parts[1].split(nextMarker)[0];
          return content.trim();
        };

        const titleEs = extractBlock('===TITLE_ES===', '===TITLE_EN===') || topic;
        const titleEn = extractBlock('===TITLE_EN===', '===SLUG_ES===') || topic;
        const slugEs = extractBlock('===SLUG_ES===', '===SLUG_EN===') || topic.toLowerCase().replace(/\s+/g, '-');
        const slugEn = extractBlock('===SLUG_EN===', '===META_DESC===') || topic.toLowerCase().replace(/\s+/g, '-');
        const metaDesc = extractBlock('===META_DESC===', '===KEYWORDS===');
        const keywordsStr = extractBlock('===KEYWORDS===', '===CONTENT_ES===');
        const contentEs = extractBlock('===CONTENT_ES===', '===CONTENT_EN===');
        
        const enParts = rawText.split('===CONTENT_EN===');
        const contentEn = enParts.length > 1 ? enParts[1].trim() : '';

        const keywords = keywordsStr ? keywordsStr.split(',').map(k => k.trim()).filter(Boolean) : [topic];

        return { titleEs, titleEn, slugEs, slugEn, metaDesc, keywords, contentEs, contentEn };
      }

      // 2. Fallback to JSON parsing if model output JSON
      const cleanedText = rawText.replace(/```json\s*/gi, '').replace(/```\s*$/gi, '').trim();
      const jsonMatch = cleanedText.match(/\{[\s\S]*\}/);
      if (jsonMatch) {
        try {
          const data = JSON.parse(jsonMatch[0]);
          return {
            titleEs: data.titleEs || topic,
            titleEn: data.titleEn || topic,
            slugEs: data.slugEs || topic.toLowerCase().replace(/\s+/g, '-'),
            slugEn: data.slugEn || topic.toLowerCase().replace(/\s+/g, '-'),
            metaDesc: data.metaDesc || '',
            keywords: Array.isArray(data.keywords) ? data.keywords : [topic],
            contentEs: data.contentEs || '',
            contentEn: data.contentEn || ''
          };
        } catch (jsonErr) {
          console.warn("JSON parse error, attempting regex extraction...", jsonErr);
          const extractJsonField = (field: string) => {
            const regex = new RegExp(`"${field}"\\s*:\\s*"([\\s\\S]*?)(?="\\s*,\\s*"[a-zA-Z]+"|"$|}\\s*$)`, 'i');
            const match = jsonMatch[0].match(regex);
            return match ? match[1].replace(/\\"/g, '"').replace(/\\n/g, '\n') : '';
          };

          return {
            titleEs: extractJsonField('titleEs') || topic,
            titleEn: extractJsonField('titleEn') || topic,
            slugEs: extractJsonField('slugEs') || topic.toLowerCase().replace(/\s+/g, '-'),
            slugEn: extractJsonField('slugEn') || topic.toLowerCase().replace(/\s+/g, '-'),
            metaDesc: extractJsonField('metaDesc') || '',
            keywords: [topic],
            contentEs: extractJsonField('contentEs') || '',
            contentEn: extractJsonField('contentEn') || ''
          };
        }
      }

      throw new Error("Could not parse AI generated draft. Please try again.");
    }

    // AI Generate Blog Draft
    document.getElementById('ai-generate-btn')?.addEventListener('click', async () => {
      const topic = (document.getElementById('ai-topic') as HTMLInputElement)?.value;
      const customKeywords = (document.getElementById('ai-keywords') as HTMLInputElement)?.value;
      const primaryLang = (document.getElementById('ai-lang') as HTMLSelectElement)?.value;

      if (!topic) {
        alert("Please provide a topic for the blog post.");
        return;
      }

      const btn = document.getElementById('ai-generate-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gemini is writing full blog draft...';

      try {
        const uniqueCover = await getUniqueUnsplashPhoto(topic);
        const uniqueBodyImage = await getUniqueUnsplashPhoto(`${topic} strategy analysis`);
        const citationsEs = getRelevantCitations(topic, 'es');
        const citationsEn = getRelevantCitations(topic, 'en');

        const prompt = `
          You are the lead bilingual SEO, AEO (Answer Engine Optimization), GEO (Generative Engine Optimization), and business consultancy strategist for GUIA DE NEGOCIOS.
          Topic: "${topic}".
          ${customKeywords ? `Target Keywords: "${customKeywords}".` : ''}
          Primary Focus: ${primaryLang === 'es' ? 'Spanish (with full English translation)' : 'English (with full Spanish translation)'}.
          
          Generate a comprehensive, deeply informative, research-backed, long-form (1,500+ words) blog post in both Spanish and English versions.
          
          GEOGRAPHIC SCOPE & AUDIENCE INTELLIGENCE (CRITICAL):
          - Country-Wide & International Audience (Default): GUIA DE NEGOCIOS serves entrepreneurs nationwide across all 50 U.S. states and internationally (Latin America, Spain, and global founders).
          - Educational Scope: For general business topics (e.g., Business Plans, EINs, LLC vs S-Corp, Marketing, Bookkeeping, SBA Loans, Building Credit), write for a GENERAL NATIONWIDE AUDIENCE. DO NOT force or restrict the title or body to Tennessee unless the user explicitly requested Tennessee or the topic is inherently state-specific.
          - State & Local Expertise: If state-level nuances apply (e.g. filing fees, annual reports), explain how they operate generally across major states (such as Florida, Texas, Delaware, Wyoming, Tennessee, California). Only focus strictly on Tennessee/Knoxville if the prompt specifically asks for it.
          - Headquarter Branding: In the closing section, highlight that GUIA DE NEGOCIOS is headquartered in Knoxville, Tennessee, offering bilingual consulting and remote services to entrepreneurs nationwide.
          
          SEO, AEO & GEO OPTIMIZATION ENGINE:
          - AEO Direct-Answer Definitions: Immediately under each H2 heading, provide a clear, authoritative 1-2 sentence direct definition answering the search intent (optimized for Google AI Overviews, Perplexity, and ChatGPT).
          - High-Intent Subheadings (H2/H3): Structured for Google search snippets and automatic Table of Contents extraction.
          - Entity & Semantic Density: Weave verified citations, federal agencies (IRS, SBA, SCORE, Census Bureau, USPTO), and Hispanic economic statistics ($653B revenue contribution, 5M+ Latino businesses).
          
          GOLDEN STANDARD ARCHITECTURE:
          1. Hook Introduction:
             - 2-3 short, punchy paragraphs (maximum 2-3 sentences each).
             - Bold core keywords (**negocio**, **empresa**, **LLC**, **impuestos**, **EIN**, **plan de negocios**, **estrategia**).
             - Use '---' horizontal divider after the intro.
          
          2. Core Educational Breakdown (H2 and H3 Headings):
             - Section 1: "## ¿Qué es [Concepto] y Por Qué es Esencial?" (Include immediate 1-2 sentence direct answer definition).
             - Follow with a structured numbered list with bold lead titles:
               1. **[Punto Clave 1]:** [Explicación clara y concisa en 2 oraciones].
               2. **[Punto Clave 2]:** [Explicación clara y concisa en 2 oraciones].
               3. **[Punto Clave 3]:** [Explicación clara y concisa en 2 oraciones].
             - Embed body image: ![${uniqueBodyImage.alt}](${uniqueBodyImage.url})
          
          3. Mandatory Embedded Infographics & Data Visualizations (2 to 3 Components):
             - Embed AT LEAST 2 to 3 distinct custom HTML/CSS/SVG visual components spaced naturally throughout the article:
               * Visual 1 (Early in article): Responsive CSS Bar Chart / Growth Graph OR Metric Stat Card highlighting key industry data.
               * Visual 2 (Middle of article): Visual Checklist Card OR Step-by-Step Flow Map breaking down the actionable process.
               * Visual 3 (Later in article): Split Decision Card (Do's vs Don'ts) OR Comparison Matrix.
             - Every HTML component MUST be flush to column 0 with 0 leading spaces (NO 4-space indent).
          
          4. Real-World Case Studies (Ejemplos Prácticos):
             - "## Ejemplos Prácticos y Casos de Estudio"
             - "### Caso 1: [Nombre] ([Perfil del Emprendedor, ej. Mateo en Bogotá o Carlos en Miami])"
               [2 oraciones de contexto sobre el problema o meta del negocio].
               * **Solución Aplicada:** [Acción tomada con Guia Negocios o registro legal].
               * **Resultado Clave:** [Beneficio medible, ahorro en impuestos o contrato conseguido].
             - "### Caso 2: [Nombre] ([Perfil del Emprendedor, ej. Elena en Texas o Knoxville])"
               [2 oraciones de contexto].
               * **Solución Aplicada:** [Acción tomada].
               * **Resultado Clave:** [Beneficio medible].
          
          5. Structured Comparison Table (Markdown Table):
             - "## [Comparativa / Diferencias Clave]"
             - Markdown table with clean borders:
               | Concepto / Opción | Definición Oficial | ¿Para quién aplica? | Beneficio Principal |
               | :--- | :--- | :--- | :--- |
               | **Opción A** | ... | ... | ... |
               | **Opción B** | ... | ... | ... |
          
          6. Critical Pitfalls & Penalties:
             - "## Errores Críticos que Debe Evitar"
             - Numbered list with bold leads and real financial/legal penalties (e.g. IRS $25,000 penalties for Form 5472, loss of corporate veil, state administrative dissolution).
          
          7. Closing Call to Action:
             - "## ¿Necesita Asesoría Estratégica para su Empresa en EE.UU.?"
             - "En **GUIA NEGOCIOS**, con sede en Knoxville, Tennessee, asesoramos a emprendedores hispanos en todo Estados Unidos y a nivel internacional..."
             - "**¿Listo para dar el siguiente paso?** [Póngase en contacto con nuestro equipo de consultores bilingües](/es/contact) hoy mismo para una asesoría personalizada." (Use /en/contact for English version).
          
          8. Official Sources & References Section:
             - Include the verified citations list provided below.
          
          // Infographic Rules
          ${getInfographicSystemPrompt()}
          
          Verified Research Reference Library to use:
          [SPANISH CITATIONS]:
          ${citationsEs}

          [ENGLISH CITATIONS]:
          ${citationsEn}
          
          CRITICAL TYPOGRAPHY & VISUAL PACING RULES:
          - ZERO EMOJI POLICY: NEVER use informal unicode emojis in headings, lists, or visual cards. Use clean inline SVG icons, sleek numeral badges, or bold typography accents.
          - NEVER produce long continuous blocks of unformatted text or read like a dense textbook. 
          - MAXIMUM 2 to 3 sentences per paragraph!
          - Use rich brand colors, bold lead-in titles for lists, comparison matrices, quote callout banners, and 2-3 embedded visual graphics/charts so the post looks and feels like a modern digital magazine.
          
          OUTPUT FORMAT (Output STRICTLY using these exact section headers so the content renders flawlessly without JSON syntax errors):

          ===TITLE_ES===
          [Compelling Spanish Title]

          ===TITLE_EN===
          [Compelling English Title]

          ===SLUG_ES===
          [spanish-url-slug]

          ===SLUG_EN===
          [english-url-slug]

          ===META_DESC===
          [150-160 char high-CTR SEO summary]

          ===KEYWORDS===
          [keyword 1, keyword 2, keyword 3, keyword 4]

          ===CONTENT_ES===
          [Full in-depth Spanish article with ## headings, in-text research links, embedded HTML checklist/infographic, image markdown, and official references section]

          ===CONTENT_EN===
          [Full in-depth English article with ## headings, in-text research links, embedded HTML checklist/infographic, image markdown, and official references section]
        `;

        const result = await aiModel.generateContent(prompt);
        const rawText = result.response.text();

        // Resilient Parser that supports delimited blocks, clean JSON, and corrupted JSON
        const parsedData = parseAiDraftResponse(rawText, topic);

        const publishDate = new Date().toISOString().split('T')[0];
        const rawKeywords = parsedData.keywords && parsedData.keywords.length > 0 
          ? parsedData.keywords 
          : (customKeywords ? customKeywords.split(',').map((k: string) => k.trim()) : [topic]);

        // Save to Firestore
        const docRef = await addDoc(collection(db, 'blogs'), {
          titleEs: parsedData.titleEs || topic,
          titleEn: parsedData.titleEn || topic,
          slugEs: parsedData.slugEs || topic.toLowerCase().replace(/\s+/g, '-'),
          slugEn: parsedData.slugEn || topic.toLowerCase().replace(/\s+/g, '-'),
          contentEs: parsedData.contentEs || '',
          contentEn: parsedData.contentEn || '',
          metaDesc: parsedData.metaDesc || '',
          keywords: rawKeywords,
          featuredImage: uniqueCover.url,
          author: 'Guia Negocios Team',
          authorAvatar: '/images/team-avatar.webp',
          readTime: 7,
          status: 'Draft',
          publishDate,
          createdAt: new Date().toISOString(),
          views: 0
        });

        // @ts-ignore
        window.showToast('Draft generated and saved to Firestore!', 'success');

        setTimeout(() => {
          window.location.href = `/admin/blog/editor?id=${docRef.id}`;
        }, 800);

      } catch (err: any) {
        console.error("AI Draft Generation Error:", err);
        const errMsg = err?.message || 'Unknown error';
        alert('Failed to generate draft with AI: ' + errMsg);
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Generate Draft with Gemini';
      }
    });

    // Load Blogs from Firestore
    async function loadBlogs() {
      const tbody = document.getElementById('blog-table-body');
      if (!tbody) return;

      try {
        const snapshot = await getDocs(collection(db, 'blogs'));
        
        if (snapshot.empty) {
          tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-slate-500">No blog posts found. Create your first one!</td></tr>`;
          return;
        }

        let html = '';
        snapshot.forEach(docSnap => {
          const blog = docSnap.data();
          const id = docSnap.id;
          
          const hasEn = !!blog.titleEn;
          const hasEs = !!blog.titleEs;
          const title = blog.titleEs || blog.titleEn || blog.title || 'Untitled Post';
          const lang = hasEn && hasEs ? 'EN/ES' : (hasEn ? 'EN' : 'ES');
          
          const statusClass = blog.status === 'Published' 
            ? 'bg-emerald-100 text-emerald-700' 
            : 'bg-amber-100 text-amber-700';

          const viewSlug = blog.slugEs || blog.slugEn || blog.slug || id;
          const viewUrl = `/${hasEs ? 'es' : 'en'}/blog/view?id=${id}&slug=${viewSlug}`;
          
          const publishButton = blog.status !== 'Published'
            ? `<button data-publish-id="${id}" class="publish-btn text-xs text-emerald-600 hover:text-emerald-700 font-semibold cursor-pointer">Publish</button>`
            : '';

          html += `
            <tr class="hover:bg-slate-50/50">
              <td class="px-6 py-4 font-medium text-brand-dark">${title}</td>
              <td class="px-6 py-4"><span class="px-2.5 py-1 ${statusClass} text-xs font-medium rounded-full">${blog.status || 'Draft'}</span></td>
              <td class="px-6 py-4 text-slate-600">${lang}</td>
              <td class="px-6 py-4 text-slate-600">${blog.views || 0}</td>
              <td class="px-6 py-4 text-slate-500">${blog.publishDate || 'N/A'}</td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <a href="/admin/blog/editor?id=${id}" class="text-xs text-slate-500 hover:text-brand-primary font-medium">Edit</a>
                  <a href="${viewUrl}" target="_blank" class="text-xs text-slate-500 hover:text-brand-primary font-medium">View</a>
                  ${blog.status !== 'Published' ? `<button data-publish-id="${id}" class="publish-btn text-xs text-emerald-600 hover:text-emerald-700 font-medium cursor-pointer">Publish</button>` : ''}
                </div>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = html;
        
        // Attach publish handlers
        document.querySelectorAll('[data-publish-id]').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const id = (btn as HTMLElement).dataset.publishId;
            if (!id) return;
            // @ts-ignore
            const ok = await window.showConfirm('Publish Post', 'Are you sure you want to publish this post live to the site?');
            if (ok) {
              try {
                await updateDoc(doc(db, 'blogs', id), { status: 'Published' });
                // @ts-ignore
                window.showToast('Post published successfully!', 'success');
                loadBlogs();
              } catch (err: any) {
                console.error("Publish error:", err);
                alert("Failed to publish: " + err.message);
              }
            }
          });
        });

      } catch (error) {
        console.error("Error fetching blogs:", error);
        tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-500">Error loading blog posts. Check console.</td></tr>`;
      }
    }

    loadBlogs();
  </script>
</AdminLayout>
