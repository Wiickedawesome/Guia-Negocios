---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Landing Pages | Admin">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Landing Pages</h1>
      <p class="text-sm text-slate-500 mt-1">Manage and build high-converting landing pages.</p>
    </div>
    <a href="/admin/landing-pages/builder" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
      + New Page
    </a>
  </div>

  <!-- AI Landing Page Generator -->
  <div class="bg-gradient-to-r from-brand-dark to-slate-800 rounded-xl p-6 shadow-sm text-white mb-6">
    <div class="flex items-center gap-3 mb-4">
      <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      <h3 class="text-lg font-bold">AI Landing Page Generator</h3>
      <span class="px-2.5 py-0.5 bg-amber-400/20 text-amber-300 text-xs font-bold rounded-full border border-amber-400/30">Gemini</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Service / Offer</label>
        <input id="ai-lp-topic" type="text" placeholder="e.g., Summer Tax Prep Special" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Target Audience</label>
        <input id="ai-lp-audience" type="text" placeholder="e.g., Small business owners in TN" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Primary Goal</label>
        <select id="ai-lp-goal" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white text-sm focus:outline-none focus:border-brand-primary">
          <option value="lead" class="text-slate-900">Lead Generation (Form & WhatsApp)</option>
          <option value="call" class="text-slate-900">Book a Consultation Call</option>
          <option value="discount" class="text-slate-900">Special Discount / Limited-Time Offer (15% OFF)</option>
          <option value="sales" class="text-slate-900">Direct Sales / Packages</option>
          <option value="quote" class="text-slate-900">Request a Free Quote / Estimate</option>
          <option value="nra" class="text-slate-900">Non-Resident Alien (NRA) Business Launch</option>
          <option value="contractor" class="text-slate-900">Contractor / Construction Licensing</option>
          <option value="bookkeeping" class="text-slate-900">Bookkeeping & Separate Finances</option>
          <option value="tax" class="text-slate-900">Tax Preparation & IRS Compliance</option>
          <option value="download" class="text-slate-900">Download Free Guide / Checklist</option>
        </select>
      </div>
    </div>
    <button id="ai-lp-generate-btn" class="px-5 py-2.5 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-opacity-90 transition-colors flex items-center gap-2 font-semibold shadow-sm">
      <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      Generate Landing Page Structure
    </button>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
    <div class="flex items-center gap-1 p-2 border-b border-slate-200 bg-slate-50 overflow-x-auto">
      <button class="px-4 py-1.5 text-sm font-medium rounded-md bg-brand-primary text-white">All</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Draft</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Published</button>
      <div class="w-px h-6 bg-slate-200 mx-1"></div>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100 flex items-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img"><path fill="#BD3D44" d="M36 27a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v18z"></path><path fill="#FFF" d="M0 12h36v4H0zm0 8h36v4H0z"></path><path fill="#192F5D" d="M0 5a4 4 0 0 1 4-4h14v18H0V5z"></path></svg>
        EN
      </button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100 flex items-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img"><path fill="#C60A1D" d="M32 5H4a4 4 0 0 0-4 4v18a4 4 0 0 0 4 4h28a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4z"></path><path fill="#FFC400" d="M0 12h36v12H0z"></path></svg>
        ES
      </button>
    </div>

    <!-- Landing Pages Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 font-medium">Title</th>
            <th class="px-6 py-3 font-medium">URL</th>
            <th class="px-6 py-3 font-medium">Status</th>
            <th class="px-6 py-3 font-medium">Lang</th>
            <th class="px-6 py-3 font-medium text-right">Views</th>
            <th class="px-6 py-3 font-medium text-right">Conversions</th>
            <th class="px-6 py-3 font-medium text-right">Conv. Rate</th>
            <th class="px-6 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="lp-table-body" class="divide-y divide-slate-100">
          <tr>
            <td colspan="8" class="px-6 py-8 text-center text-slate-500">
              <svg class="animate-spin h-5 w-5 text-brand-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Loading landing pages...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { collection, getDocs, doc, setDoc } from 'firebase/firestore';
    import { db, aiModel } from '../../lib/firebase';

    // Filters tab logic
    document.querySelectorAll('.flex.items-center.gap-1 button').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.flex.items-center.gap-1 button').forEach(t => {
          t.classList.remove('bg-brand-primary', 'text-white');
          t.classList.add('text-slate-600');
        });
        tab.classList.add('bg-brand-primary', 'text-white');
        tab.classList.remove('text-slate-600');
        
        const filter = tab.textContent?.trim();
        document.querySelectorAll('#lp-table-body tr').forEach(row => {
          const rowEl = row as HTMLElement;
          if (filter === 'All') {
            rowEl.style.display = '';
          } else if (filter === 'Draft' || filter === 'Published') {
            const status = rowEl.querySelector('td:nth-child(3)')?.textContent?.trim();
            rowEl.style.display = (status === filter || (filter === 'Published' && status === 'Active')) ? '' : 'none';
          } else if (filter === 'EN' || filter === 'ES') {
            const lang = rowEl.querySelector('td:nth-child(4)')?.textContent?.trim();
            rowEl.style.display = (lang === filter) ? '' : 'none';
          }
        });
      });
    });

    // Load Landing Pages from Firestore
    async function loadLandingPages() {
      const tbody = document.getElementById('lp-table-body');
      if (!tbody) return;

      try {
        const snapshot = await getDocs(collection(db, 'landingPages'));
        
        if (snapshot.empty) {
          tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-slate-500">No landing pages found. Create your first one!</td></tr>`;
          return;
        }

        let html = '';
        snapshot.forEach(docSnap => {
          const lp = docSnap.data();
          const id = docSnap.id;
          
          const statusClass = (lp.status === 'Active' || lp.status === 'Published')
            ? 'bg-emerald-100 text-emerald-700' 
            : 'bg-amber-100 text-amber-700';

          const views = lp.views || 0;
          const conversions = lp.conversions || 0;
          const rate = views > 0 ? ((conversions / views) * 100).toFixed(1) + '%' : '0%';
          const lang = (lp.lang || 'es').toUpperCase();

          html += `
            <tr class="hover:bg-slate-50/50">
              <td class="px-6 py-4 font-medium text-brand-dark">${lp.title || 'Untitled Page'}</td>
              <td class="px-6 py-4 text-slate-500">/${lp.lang || 'es'}/lp/${lp.slug || 'page'}</td>
              <td class="px-6 py-4"><span class="px-2.5 py-1 ${statusClass} text-xs font-medium rounded-full">${lp.status || 'Draft'}</span></td>
              <td class="px-6 py-4 text-slate-600 font-medium">${lang}</td>
              <td class="px-6 py-4 text-right text-slate-600">${views}</td>
              <td class="px-6 py-4 text-right text-slate-600">${conversions}</td>
              <td class="px-6 py-4 text-right"><span class="text-emerald-600 font-medium">${rate}</span></td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="/admin/landing-pages/builder?id=${id}" class="text-xs text-slate-500 hover:text-brand-primary font-medium">Edit</a>
                  <a href="/${lp.lang || 'es'}/lp/${lp.slug || 'page'}" target="_blank" class="text-xs text-slate-500 hover:text-brand-primary font-medium">View</a>
                </div>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = html;

      } catch (error) {
        console.error("Error fetching landing pages:", error);
        tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-red-500">Error loading landing pages. Check console.</td></tr>`;
      }
    }

    loadLandingPages();

    // AI Landing Page Generator
    document.getElementById('ai-lp-generate-btn')?.addEventListener('click', async function() {
      const topicInput = document.getElementById('ai-lp-topic') as HTMLInputElement;
      const audienceInput = document.getElementById('ai-lp-audience') as HTMLInputElement;
      const goalSelect = document.getElementById('ai-lp-goal') as HTMLSelectElement;

      const topic = topicInput?.value?.trim();
      const audience = audienceInput?.value?.trim() || 'Small business owners in TN';
      const goal = goalSelect?.value || 'lead';

      if (!topic) {
        // @ts-ignore
        window.showToast('Please enter a Service / Offer first', 'warning');
        return;
      }

      const btn = document.getElementById('ai-lp-generate-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gemini is designing landing page...';

      try {
        const prompt = `
          You are an expert web designer and copywriter for GUIA DE NEGOCIOS (a bilingual business consultancy in Knoxville, TN).
          Create a high-converting landing page for the following service/offer: "${topic}".
          Target Audience: "${audience}".
          Primary Goal: "${goal}".
          
          Generate a high-converting, modern landing page matching the Guia Negocios website design elements:
          1. Hero Section: Light grey/mint background ('bg-slate-50/80 border border-slate-200 rounded-3xl p-10 sm:p-14 text-center') with dark headline ('text-slate-900 font-heading font-bold text-3xl sm:text-5xl'), dark paragraph ('text-slate-600'), and action button ('bg-brand-primary text-white py-3.5 px-8 rounded-full'). NEVER use white text on white/light backgrounds!
          2. Features / Value Proposition: 3-column cards ('bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs') with SVG icons and dark text ('text-slate-900' and 'text-slate-500').
          3. Process Flow / How We Work: 4-step cards ('bg-slate-50 p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-sm') with step numbers (01, 02, 03, 04).
          4. Testimonials: Client review cards ('bg-slate-50/70 border border-slate-200/80 rounded-3xl p-8') with 5 amber stars and client initials avatar circle.
          5. FAQ Section: Accordion style ('bg-slate-50/60 p-8 sm:p-12 rounded-3xl border border-slate-200/80 shadow-sm') with white Q&A cards.
          6. Call To Action: Dark banner ('bg-brand-dark text-white p-8 sm:p-14 rounded-3xl text-center shadow-lg') with white headline, text, and action button ('bg-white text-brand-dark py-3.5 px-8 rounded-full').
          
          STRICT CONTRAST & TYPOGRAPHY RULE:
          - Every heading on light/white backgrounds MUST be 'text-slate-900' or 'text-brand-dark'.
          - Every paragraph on light/white backgrounds MUST be 'text-slate-600' or 'text-slate-500'.
          - Only use 'text-white' when the container has 'bg-brand-dark' or 'bg-slate-900'.
          - Add contenteditable="true" to all editable headings, paragraphs, and buttons.
          
          Format your output strictly as a JSON object:
          {
            "title": "string (Compelling page title)",
            "slug": "string (url-friendly-slug-in-spanish-or-english)",
            "metaDesc": "string (150-160 character description)",
            "lang": "es",
            "html": "string (Raw HTML string containing all sections wrapped in container divs with Tailwind styling)"
          }
        `;

        const result = await aiModel.generateContent(prompt);
        const text = result.response.text();
        const jsonMatch = text.match(/\{[\s\S]*\}/);
        if (!jsonMatch) throw new Error("Could not parse AI response JSON");

        const data = JSON.parse(jsonMatch[0]);
        const slug = (data.slug || topic.toLowerCase().replace(/[^a-z0-9]+/g, '-')).replace(/^-|-$/g, '');
        const docId = `${data.lang || 'es'}_${slug}`;

        await setDoc(doc(db, 'landingPages', docId), {
          title: data.title || topic,
          slug: slug,
          metaDesc: data.metaDesc || '',
          lang: data.lang || 'es',
          content: data.html || '',
          status: 'Draft',
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
          views: 0,
          conversions: 0
        });

        // @ts-ignore
        window.showToast('Landing Page generated and saved to Firestore!', 'success');

        setTimeout(() => {
          window.location.href = `/admin/landing-pages/builder?id=${docId}`;
        }, 1200);

      } catch (err: any) {
        console.error("AI Landing Page Generation Error:", err);
        alert('Failed to generate landing page: ' + (err.message || 'Unknown error'));
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Generate Landing Page Structure';
      }
    });
  </script>
</AdminLayout>
