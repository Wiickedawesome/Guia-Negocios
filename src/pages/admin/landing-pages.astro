---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Landing Pages | Admin">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Landing Pages</h1>
      <p class="text-sm text-slate-500 mt-1">Manage and build high-converting landing pages.</p>
    </div>
    <a href="/admin/landing-pages/builder" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
      + New Page
    </a>
  </div>

  <!-- AI Landing Page Generator -->
  <div class="bg-gradient-to-r from-brand-dark to-slate-800 rounded-xl p-6 shadow-sm text-white mb-6">
    <div class="flex items-center gap-3 mb-4">
      <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      <h3 class="text-lg font-bold">AI Landing Page Generator</h3>
      <span class="px-2.5 py-0.5 bg-amber-400/20 text-amber-300 text-xs font-bold rounded-full border border-amber-400/30">Gemini</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Service / Offer</label>
        <input id="ai-lp-topic" type="text" placeholder="e.g., Summer Tax Prep Special" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Target Audience</label>
        <input id="ai-lp-audience" type="text" placeholder="e.g., Small business owners in TN" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Primary Goal</label>
        <select id="ai-lp-goal" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white text-sm focus:outline-none focus:border-brand-primary">
          <option value="lead" class="text-slate-900">Lead Generation (Form & WhatsApp)</option>
          <option value="call" class="text-slate-900">Book a Consultation Call</option>
          <option value="discount" class="text-slate-900">Special Discount / Limited-Time Offer (15% OFF)</option>
          <option value="sales" class="text-slate-900">Direct Sales / Packages</option>
          <option value="quote" class="text-slate-900">Request a Free Quote / Estimate</option>
          <option value="nra" class="text-slate-900">Non-Resident Alien (NRA) Business Launch</option>
          <option value="contractor" class="text-slate-900">Contractor / Construction Licensing</option>
          <option value="bookkeeping" class="text-slate-900">Bookkeeping & Separate Finances</option>
          <option value="tax" class="text-slate-900">Tax Preparation & IRS Compliance</option>
          <option value="download" class="text-slate-900">Download Free Guide / Checklist</option>
        </select>
      </div>
    </div>
    <button id="ai-lp-generate-btn" class="px-5 py-2.5 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-opacity-90 transition-colors flex items-center gap-2 font-semibold shadow-sm cursor-pointer">
      <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      Generate Landing Page Structure
    </button>
  </div>

  <!-- Filters (Identical 1:1 with Blog Manager) -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
    <div class="flex items-center gap-1 p-2 border-b border-slate-200 bg-slate-50 overflow-x-auto">
      <button class="px-4 py-1.5 text-sm font-medium rounded-md bg-brand-primary text-white">All</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Draft</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Published</button>
      <div class="w-px h-6 bg-slate-200 mx-1"></div>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">EN</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">ES</button>
    </div>

    <!-- Landing Pages Table (Clean consistent design matching Blog Manager) -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 font-medium">Title</th>
            <th class="px-6 py-3 font-medium">URL</th>
            <th class="px-6 py-3 font-medium">Status</th>
            <th class="px-6 py-3 font-medium">Lang</th>
            <th class="px-6 py-3 font-medium">Views</th>
            <th class="px-6 py-3 font-medium">Date</th>
            <th class="px-6 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="lp-table-body" class="divide-y divide-slate-100">
          <tr>
            <td colspan="7" class="px-6 py-8 text-center text-slate-500">
              <svg class="animate-spin h-5 w-5 text-brand-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Loading landing pages...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { collection, getDocs, doc, setDoc, deleteDoc } from 'firebase/firestore';
    import { db, aiModel } from '../../lib/firebase';

    // Filters tab logic
    document.querySelectorAll('.flex.items-center.gap-1 button').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.flex.items-center.gap-1 button').forEach(t => {
          t.classList.remove('bg-brand-primary', 'text-white');
          t.classList.add('text-slate-600');
        });
        tab.classList.add('bg-brand-primary', 'text-white');
        tab.classList.remove('text-slate-600');
        
        const filter = tab.textContent?.trim();
        document.querySelectorAll('#lp-table-body tr').forEach(row => {
          const rowEl = row as HTMLElement;
          if (filter === 'All') {
            rowEl.style.display = '';
          } else if (filter === 'Draft' || filter === 'Published') {
            const status = rowEl.querySelector('td:nth-child(3)')?.textContent?.trim();
            rowEl.style.display = (status === filter || (filter === 'Published' && status === 'Active')) ? '' : 'none';
          } else if (filter === 'EN' || filter === 'ES') {
            const lang = rowEl.querySelector('td:nth-child(4)')?.textContent?.trim();
            rowEl.style.display = (lang === filter) ? '' : 'none';
          }
        });
      });
    });

    // Load Landing Pages from Firestore
    async function loadLandingPages() {
      const tbody = document.getElementById('lp-table-body');
      if (!tbody) return;

      try {
        const snapshot = await getDocs(collection(db, 'landingPages'));
        
        if (snapshot.empty) {
          tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-slate-500">No landing pages found. Create your first one!</td></tr>`;
          return;
        }

        let html = '';
        snapshot.forEach(docSnap => {
          const lp = docSnap.data();
          const id = docSnap.id;
          
          const statusClass = (lp.status === 'Active' || lp.status === 'Published')
            ? 'bg-emerald-100 text-emerald-700' 
            : 'bg-amber-100 text-amber-700';

          const views = lp.views || 0;
          const lang = (lp.lang || 'es').toUpperCase();
          const title = lp.title || 'Untitled Page';
          const date = lp.updatedAt ? new Date(lp.updatedAt).toISOString().split('T')[0] : 'N/A';

          html += `
            <tr class="hover:bg-slate-50/50">
              <td class="px-6 py-4 font-medium text-brand-dark">${title}</td>
              <td class="px-6 py-4 text-slate-500 font-mono text-xs">/${lp.lang || 'es'}/lp/${lp.slug || 'page'}</td>
              <td class="px-6 py-4"><span class="px-2.5 py-1 ${statusClass} text-xs font-medium rounded-full">${lp.status || 'Draft'}</span></td>
              <td class="px-6 py-4 text-slate-600">${lang}</td>
              <td class="px-6 py-4 text-slate-600">${views}</td>
              <td class="px-6 py-4 text-slate-500">${date}</td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <a href="/admin/landing-pages/builder?id=${id}" class="text-xs text-slate-500 hover:text-brand-primary font-medium">Edit</a>
                  <a href="/${lp.lang || 'es'}/lp/${lp.slug || 'page'}" target="_blank" class="text-xs text-slate-500 hover:text-brand-primary font-medium">View</a>
                  <button data-delete-lp-id="${id}" data-delete-lp-title="${title}" class="text-xs text-rose-500 hover:text-rose-700 font-medium cursor-pointer">Delete</button>
                </div>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = html;

        // Attach delete handlers
        document.querySelectorAll('[data-delete-lp-id]').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const id = (btn as HTMLElement).dataset.deleteLpId;
            const title = (btn as HTMLElement).dataset.deleteLpTitle || 'this landing page';
            if (!id) return;
            // @ts-ignore
            const ok = (typeof window.showConfirm === 'function')
              // @ts-ignore
              ? await window.showConfirm('Delete Landing Page', `Are you sure you want to permanently delete "${title}"?`)
              : confirm(`Are you sure you want to permanently delete "${title}"?`);
            
            if (ok) {
              try {
                await deleteDoc(doc(db, 'landingPages', id));
                // @ts-ignore
                window.showToast('Landing page deleted!', 'success');
                loadLandingPages();
              } catch (err: any) {
                console.error("Delete error:", err);
                alert("Failed to delete: " + (err?.message || err));
              }
            }
          });
        });

      } catch (error) {
        console.error("Error fetching landing pages:", error);
        tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-red-500">Error loading landing pages. Check console.</td></tr>`;
      }
    }

    loadLandingPages();

    // =========================================================================
    // RESILIENT AI DRAFT PARSER (NEVER FAILS ON QUOTES / NEWLINES)
    // =========================================================================
    function parseAiLandingPageResponse(rawText: string, defaultTopic: string) {
      let title = '';
      let slug = '';
      let metaDesc = '';
      let lang = 'es';
      let html = '';

      if (rawText.includes('===TITLE===') && rawText.includes('===HTML===')) {
        const extractSection = (tag: string, nextTag?: string) => {
          const start = rawText.indexOf(`===${tag}===`);
          if (start === -1) return '';
          const contentStart = start + `===${tag}===`.length;
          if (!nextTag) {
            return rawText.slice(contentStart).trim();
          }
          const end = rawText.indexOf(`===${nextTag}===`, contentStart);
          return end !== -1 ? rawText.slice(contentStart, end).trim() : rawText.slice(contentStart).trim();
        };

        title = extractSection('TITLE', 'SLUG') || defaultTopic;
        slug = extractSection('SLUG', 'META_DESC') || defaultTopic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        metaDesc = extractSection('META_DESC', 'LANG') || '';
        lang = extractSection('LANG', 'HTML') || 'es';
        html = extractSection('HTML');
      } else {
        // Fallback parser if output is formatted differently
        const clean = rawText.replace(/```json\s*/gi, '').replace(/```html\s*/gi, '').replace(/```\s*$/gi, '').trim();
        try {
          const parsed = JSON.parse(clean);
          title = parsed.title || defaultTopic;
          slug = parsed.slug || defaultTopic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          metaDesc = parsed.metaDesc || '';
          lang = parsed.lang || 'es';
          html = parsed.html || '';
        } catch {
          const titleMatch = rawText.match(/title["']?\s*:\s*["']([^"'\n]+)/i);
          const slugMatch = rawText.match(/slug["']?\s*:\s*["']([^"'\n]+)/i);
          const metaMatch = rawText.match(/metaDesc["']?\s*:\s*["']([^"'\n]+)/i);
          
          title = titleMatch ? titleMatch[1] : defaultTopic;
          slug = slugMatch ? slugMatch[1] : defaultTopic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          metaDesc = metaMatch ? metaMatch[1] : '';

          const htmlStart = rawText.indexOf('"html"');
          if (htmlStart !== -1) {
            const afterColon = rawText.indexOf(':', htmlStart);
            html = rawText.slice(afterColon + 1).replace(/^\s*"/, '').replace(/"\s*\}\s*$/, '').trim();
          } else {
            html = clean;
          }
        }
      }

      return {
        title: title.replace(/^["']|["']$/g, '').trim(),
        slug: slug.replace(/^["']|["']$/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
        metaDesc: metaDesc.replace(/^["']|["']$/g, '').trim(),
        lang: lang.toLowerCase().includes('en') ? 'en' : 'es',
        html: html.trim()
      };
    }

    // AI Landing Page Generator
    document.getElementById('ai-lp-generate-btn')?.addEventListener('click', async function() {
      const topicInput = document.getElementById('ai-lp-topic') as HTMLInputElement;
      const audienceInput = document.getElementById('ai-lp-audience') as HTMLInputElement;
      const goalSelect = document.getElementById('ai-lp-goal') as HTMLSelectElement;

      const topic = topicInput?.value?.trim();
      const audience = audienceInput?.value?.trim() || 'Small business owners in TN';
      const goal = goalSelect?.value || 'lead';

      if (!topic) {
        // @ts-ignore
        window.showToast('Please enter a Service / Offer first', 'warning');
        return;
      }

      const btn = document.getElementById('ai-lp-generate-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gemini is designing landing page...';

      try {
        const prompt = `
          You are an expert web designer and copywriter for GUIA DE NEGOCIOS (a bilingual business consultancy in Knoxville, TN).
          Create a concise, high-converting landing page for the following service/offer: "${topic}".
          Target Audience: "${audience}".
          Primary Goal: "${goal}".
          
          STRUCTURE RULES (4 SECTIONS TOTAL):
          
          1. Hero Section (CUSTOMIZABLE TO OFFER):
             - Light card: 'bg-slate-50 border border-slate-200 rounded-3xl p-8 sm:p-14 text-center shadow-sm font-sans'
             - Category Badge: 'inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-bold tracking-wide'
             - Dynamic Headline: 'text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-brand-dark leading-tight tracking-tight' (highlight key phrase with 'text-brand-primary')
             - Dynamic Subheading: 'text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed'
             - Action Button: 'bg-brand-primary hover:bg-emerald-900 text-white font-semibold py-3.5 px-8 rounded-full transition-all text-base shadow-md'

          2. Benefits / Value Proposition (3 CARDS CUSTOMIZED TO OFFER):
             - Container: 'bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-sm my-6 font-sans' with section title & subtitle
             - Grid: 3 cards in 'grid grid-cols-1 md:grid-cols-3 gap-6'
             - Each Card: 'bg-slate-50/70 p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-xs flex flex-col space-y-4' with emerald icon badge ('w-12 h-12 rounded-2xl bg-emerald-100/70 border border-emerald-200 flex items-center justify-center text-brand-primary'), bold title ('text-lg font-heading text-brand-dark font-bold mb-2'), and description ('text-slate-600 text-sm leading-relaxed').

          3. Purpose-Tailored Action Form (CONSISTENT HIGH-CONTRAST STRUCTURE):
             - If goal is 'discount': Include 15% discount claim form ('bg-slate-50 border border-slate-200 p-8 sm:p-12 rounded-3xl my-6 shadow-md font-sans') with Name, WhatsApp/Phone, Business Type, and Gold CTA button ('bg-brand-accent hover:bg-yellow-400 text-brand-dark font-bold rounded-full py-4 text-base shadow-md').
             - If goal is 'download': Include Free Guide download form ('bg-slate-50 border border-slate-200 p-8 sm:p-12 rounded-3xl my-6 shadow-sm font-sans') with Name, Email, WhatsApp/Phone, and Dark Green CTA button ('bg-brand-primary hover:bg-emerald-900 text-white font-semibold rounded-full py-4 text-base shadow-md').
             - If goal is 'call': Include Consultation Call booking form ('bg-white border border-slate-200 p-8 sm:p-12 rounded-3xl my-6 shadow-sm font-sans') with Name, Phone, Preferred Time, and Dark Green CTA button.
             - If goal is 'lead' or other: Include Lead Capture form ('bg-slate-50 border border-slate-200 p-8 sm:p-12 rounded-3xl my-6 shadow-sm font-sans') with Name, Phone, Email, Message, and Dark Green CTA button.

          4. STANDARD WEBSITE FAQ (MANDATORY EXACT 2-COLUMN STRUCTURE MATCHING FaqAccordion.astro):
             You MUST use this EXACT HTML structure with 3 relevant questions/answers for "${topic}":
             \`\`\`
             <div class="builder-block bg-white p-8 sm:p-14 rounded-3xl border border-slate-200 shadow-sm my-6 font-sans">
               <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
                 <div class="lg:col-span-5 space-y-4">
                   <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-brand-dark leading-tight" contenteditable="true">Preguntas Frecuentes</h2>
                   <div><a href="/es/contact" class="inline-flex items-center text-brand-primary font-semibold hover:underline text-base gap-2" contenteditable="true">Contáctenos para más información <span>→</span></a></div>
                 </div>
                 <div class="lg:col-span-7 space-y-4">
                   <details class="group border-b border-slate-200 pb-5 transition-all duration-200" open>
                     <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
                       <div class="flex items-center gap-4 sm:gap-6">
                         <span class="text-brand-primary font-heading font-bold text-xl min-w-[32px]">01</span>
                         <h3 class="text-base sm:text-lg font-heading text-brand-dark font-semibold leading-snug" contenteditable="true">[Topic Specific Question 1]</h3>
                       </div>
                       <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light shrink-0">+</span>
                     </summary>
                     <div class="pl-12 sm:pl-14 pt-3 pr-4 text-slate-600 text-sm leading-relaxed" contenteditable="true"><p>[Topic Specific Answer 1]</p></div>
                   </details>
                   <details class="group border-b border-slate-200 pb-5 transition-all duration-200">
                     <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
                       <div class="flex items-center gap-4 sm:gap-6">
                         <span class="text-brand-primary font-heading font-bold text-xl min-w-[32px]">02</span>
                         <h3 class="text-base sm:text-lg font-heading text-brand-dark font-semibold leading-snug" contenteditable="true">[Topic Specific Question 2]</h3>
                       </div>
                       <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light shrink-0">+</span>
                     </summary>
                     <div class="pl-12 sm:pl-14 pt-3 pr-4 text-slate-600 text-sm leading-relaxed" contenteditable="true"><p>[Topic Specific Answer 2]</p></div>
                   </details>
                   <details class="group border-b border-slate-200 pb-5 transition-all duration-200">
                     <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
                       <div class="flex items-center gap-4 sm:gap-6">
                         <span class="text-brand-primary font-heading font-bold text-xl min-w-[32px]">03</span>
                         <h3 class="text-base sm:text-lg font-heading text-brand-dark font-semibold leading-snug" contenteditable="true">[Topic Specific Question 3]</h3>
                       </div>
                       <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light shrink-0">+</span>
                     </summary>
                     <div class="pl-12 sm:pl-14 pt-3 pr-4 text-slate-600 text-sm leading-relaxed" contenteditable="true"><p>[Topic Specific Answer 3]</p></div>
                   </details>
                   <div class="pt-3"><a href="/es/faq" class="inline-flex items-center text-brand-primary font-semibold hover:underline text-sm gap-2" contenteditable="true">Ver todas las preguntas y respuestas <span>→</span></a></div>
                 </div>
               </div>
             </div>
             \`\`\`
          
          STRICT CONTRAST & TYPOGRAPHY RULE:
          - Every heading on light/white backgrounds MUST be 'text-brand-dark' or 'text-slate-900'. NEVER use 'text-white' on light backgrounds.
          - Every paragraph on light/white backgrounds MUST be 'text-slate-600'.
          - Absolutely NO flag emojis.
          - Add contenteditable="true" to all editable headings, paragraphs, and buttons.
          
          OUTPUT FORMAT (Output STRICTLY using these exact section headers so the content parses flawlessly):

          ===TITLE===
          [Compelling page title in Spanish]

          ===SLUG===
          [url-friendly-slug-in-spanish]

          ===META_DESC===
          [150-160 character description in Spanish]

          ===LANG===
          es

          ===HTML===
          [Full raw HTML string containing all 3-4 sections styled using our website classes wrapped in container divs]
        `;

        const result = await aiModel.generateContent(prompt);
        const rawText = result.response.text();

        const data = parseAiLandingPageResponse(rawText, topic);
        const docId = `${data.lang || 'es'}_${data.slug}`;

        await setDoc(doc(db, 'landingPages', docId), {
          title: data.title || topic,
          slug: data.slug,
          metaDesc: data.metaDesc || '',
          lang: data.lang || 'es',
          goal: goal,
          content: data.html || '',
          status: 'Draft',
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
          views: 0,
          conversions: 0
        });

        // @ts-ignore
        window.showToast('Landing Page generated and saved to Firestore!', 'success');

        setTimeout(() => {
          window.location.href = `/admin/landing-pages/builder?id=${docId}`;
        }, 1200);

      } catch (err: any) {
        console.error("AI Landing Page Generation Error:", err);
        alert('Failed to generate landing page: ' + (err.message || 'Unknown error'));
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Generate Landing Page Structure';
      }
    });
  </script>
</AdminLayout>
