---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Landing Pages | Admin">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Landing Pages</h1>
      <p class="text-sm text-slate-500 mt-1">Manage and build high-converting landing pages.</p>
    </div>
    <a href="/admin/landing-pages/builder" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors">
      + New Page
    </a>
  </div>

  <!-- AI Landing Page Generator -->
  <div class="bg-gradient-to-r from-brand-dark to-slate-800 rounded-xl p-6 shadow-sm text-white mb-6">
    <div class="flex items-center gap-3 mb-4">
      <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      <h3 class="text-lg font-bold">AI Landing Page Generator</h3>
      <span class="px-2.5 py-0.5 bg-amber-400/20 text-amber-300 text-xs font-bold rounded-full border border-amber-400/30">Gemini Pro</span>
    </div>

    <!-- Main Descriptive Prompt Input -->
    <div class="mb-4">
      <label class="block text-xs text-slate-300 mb-1.5 font-medium">Describe what you want (Topic, SEO Keywords, Offer, City/Location, Campaign Goal, Pain Points)</label>
      <textarea id="ai-lp-topic" rows="2" placeholder="e.g., Landing page for Hispanic roofing and painting contractors in Knoxville needing TN state licensing, general liability insurance, and LLC protection..." class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary resize-none"></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Target Audience / Location</label>
        <input id="ai-lp-audience" type="text" placeholder="e.g., Hispanic business owners in Knoxville & East TN" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-brand-primary" />
      </div>
      <div>
        <label class="block text-xs text-slate-300 mb-1.5 font-medium">Primary Goal & Form Archetype</label>
        <select id="ai-lp-goal" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/20 text-white text-sm focus:outline-none focus:border-brand-primary">
          <option value="lead" class="text-slate-900">Lead Generation (Form & WhatsApp)</option>
          <option value="call" class="text-slate-900">Book a Consultation Call</option>
          <option value="discount" class="text-slate-900">Special Discount / Limited-Time Offer (15% OFF)</option>
          <option value="sales" class="text-slate-900">Direct Sales / Packages</option>
          <option value="quote" class="text-slate-900">Request a Free Quote / Estimate</option>
          <option value="nra" class="text-slate-900">Non-Resident Alien (NRA) Business Launch</option>
          <option value="contractor" class="text-slate-900">Contractor / Construction Licensing</option>
          <option value="bookkeeping" class="text-slate-900">Bookkeeping & Separate Finances</option>
          <option value="tax" class="text-slate-900">Tax Preparation & IRS Compliance</option>
          <option value="download" class="text-slate-900">Download Free Guide / Checklist</option>
        </select>
      </div>
    </div>

    <button id="ai-lp-generate-btn" class="px-5 py-2.5 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-opacity-90 transition-colors flex items-center gap-2 font-semibold shadow-sm cursor-pointer">
      <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      Generate Landing Page Structure
    </button>
  </div>

  <!-- Filters (Identical 1:1 with Blog Manager) -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
    <div class="flex items-center gap-1 p-2 border-b border-slate-200 bg-slate-50 overflow-x-auto">
      <button class="px-4 py-1.5 text-sm font-medium rounded-md bg-brand-primary text-white">All</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Draft</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">Published</button>
      <div class="w-px h-6 bg-slate-200 mx-1"></div>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">EN</button>
      <button class="px-4 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:bg-slate-100">ES</button>
    </div>

    <!-- Landing Pages Table (Clean consistent design matching Blog Manager) -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3 font-medium">Title</th>
            <th class="px-6 py-3 font-medium">URL</th>
            <th class="px-6 py-3 font-medium">Status</th>
            <th class="px-6 py-3 font-medium">Lang</th>
            <th class="px-6 py-3 font-medium">Views</th>
            <th class="px-6 py-3 font-medium">Date</th>
            <th class="px-6 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="lp-table-body" class="divide-y divide-slate-100">
          <tr>
            <td colspan="7" class="px-6 py-8 text-center text-slate-500">
              <svg class="animate-spin h-5 w-5 text-brand-primary mx-auto mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Loading landing pages...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { collection, getDocs, doc, setDoc, deleteDoc } from 'firebase/firestore';
    import { db, aiModel } from '../../lib/firebase';

    // Filters tab logic
    document.querySelectorAll('.flex.items-center.gap-1 button').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.flex.items-center.gap-1 button').forEach(t => {
          t.classList.remove('bg-brand-primary', 'text-white');
          t.classList.add('text-slate-600');
        });
        tab.classList.add('bg-brand-primary', 'text-white');
        tab.classList.remove('text-slate-600');
        
        const filter = tab.textContent?.trim();
        document.querySelectorAll('#lp-table-body tr').forEach(row => {
          const rowEl = row as HTMLElement;
          if (filter === 'All') {
            rowEl.style.display = '';
          } else if (filter === 'Draft' || filter === 'Published') {
            const status = rowEl.querySelector('td:nth-child(3)')?.textContent?.trim();
            rowEl.style.display = (status === filter || (filter === 'Published' && status === 'Active')) ? '' : 'none';
          } else if (filter === 'EN' || filter === 'ES') {
            const lang = rowEl.querySelector('td:nth-child(4)')?.textContent?.trim();
            rowEl.style.display = (lang === filter) ? '' : 'none';
          }
        });
      });
    });

    // Load Landing Pages from Firestore
    async function loadLandingPages() {
      const tbody = document.getElementById('lp-table-body');
      if (!tbody) return;

      try {
        const snapshot = await getDocs(collection(db, 'landingPages'));
        
        if (snapshot.empty) {
          tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-slate-500">No landing pages found. Create your first one!</td></tr>`;
          return;
        }

        let html = '';
        snapshot.forEach(docSnap => {
          const lp = docSnap.data();
          const id = docSnap.id;
          
          const statusClass = (lp.status === 'Active' || lp.status === 'Published')
            ? 'bg-emerald-100 text-emerald-700' 
            : 'bg-amber-100 text-amber-700';

          const views = lp.views || 0;
          const lang = (lp.lang || 'es').toUpperCase();
          const title = lp.title || 'Untitled Page';
          const date = lp.updatedAt ? new Date(lp.updatedAt).toISOString().split('T')[0] : 'N/A';

          html += `
            <tr class="hover:bg-slate-50/50">
              <td class="px-6 py-4 font-medium text-brand-dark">${title}</td>
              <td class="px-6 py-4 text-slate-500 font-mono text-xs">/${lp.lang || 'es'}/lp/${lp.slug || 'page'}</td>
              <td class="px-6 py-4"><span class="px-2.5 py-1 ${statusClass} text-xs font-medium rounded-full">${lp.status || 'Draft'}</span></td>
              <td class="px-6 py-4 text-slate-600">${lang}</td>
              <td class="px-6 py-4 text-slate-600">${views}</td>
              <td class="px-6 py-4 text-slate-500">${date}</td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-3">
                  <a href="/admin/landing-pages/builder?id=${id}" class="text-xs text-slate-500 hover:text-brand-primary font-medium">Edit</a>
                  <a href="/${lp.lang || 'es'}/lp/${lp.slug || 'page'}" target="_blank" class="text-xs text-slate-500 hover:text-brand-primary font-medium">View</a>
                </div>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = html;

      } catch (error) {
        console.error("Error fetching landing pages:", error);
        tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-8 text-center text-red-500">Error loading landing pages. Check console.</td></tr>`;
      }
    }

    loadLandingPages();

    // =========================================================================
    // RESILIENT AI DRAFT PARSER (NEVER FAILS ON QUOTES / NEWLINES)
    // =========================================================================
    function parseAiLandingPageResponse(rawText: string, defaultTopic: string) {
      let title = '';
      let slug = '';
      let metaDesc = '';
      let lang = 'es';
      let html = '';

      if (rawText.includes('===TITLE===') && rawText.includes('===HTML===')) {
        const extractSection = (tag: string, nextTag?: string) => {
          const start = rawText.indexOf(`===${tag}===`);
          if (start === -1) return '';
          const contentStart = start + `===${tag}===`.length;
          if (!nextTag) {
            return rawText.slice(contentStart).trim();
          }
          const end = rawText.indexOf(`===${nextTag}===`, contentStart);
          return end !== -1 ? rawText.slice(contentStart, end).trim() : rawText.slice(contentStart).trim();
        };

        title = extractSection('TITLE', 'SLUG') || defaultTopic;
        slug = extractSection('SLUG', 'META_DESC') || defaultTopic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        metaDesc = extractSection('META_DESC', 'LANG') || '';
        lang = extractSection('LANG', 'HTML') || 'es';
        html = extractSection('HTML');
      } else {
        // Fallback parser if output is formatted differently
        const clean = rawText.replace(/```json\s*/gi, '').replace(/```html\s*/gi, '').replace(/```\s*$/gi, '').trim();
        try {
          const parsed = JSON.parse(clean);
          title = parsed.title || defaultTopic;
          slug = parsed.slug || defaultTopic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          metaDesc = parsed.metaDesc || '';
          lang = parsed.lang || 'es';
          html = parsed.html || '';
        } catch {
          const titleMatch = rawText.match(/title["']?\s*:\s*["']([^"'\n]+)/i);
          const slugMatch = rawText.match(/slug["']?\s*:\s*["']([^"'\n]+)/i);
          const metaMatch = rawText.match(/metaDesc["']?\s*:\s*["']([^"'\n]+)/i);
          
          title = titleMatch ? titleMatch[1] : defaultTopic;
          slug = slugMatch ? slugMatch[1] : defaultTopic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          metaDesc = metaMatch ? metaMatch[1] : '';

          const htmlStart = rawText.indexOf('"html"');
          if (htmlStart !== -1) {
            const afterColon = rawText.indexOf(':', htmlStart);
            html = rawText.slice(afterColon + 1).replace(/^\s*"/, '').replace(/"\s*\}\s*$/, '').trim();
          } else {
            html = clean;
          }
        }
      }

      return {
        title: title.replace(/^["']|["']$/g, '').trim(),
        slug: slug.replace(/^["']|["']$/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
        metaDesc: metaDesc.replace(/^["']|["']$/g, '').trim(),
        lang: lang.toLowerCase().includes('en') ? 'en' : 'es',
        html: html.trim()
      };
    }

    const topicInput = document.getElementById('ai-lp-topic') as HTMLTextAreaElement;
    const audienceInput = document.getElementById('ai-lp-audience') as HTMLInputElement;
    const goalSelect = document.getElementById('ai-lp-goal') as HTMLSelectElement;

    // AI Landing Page Generator
    document.getElementById('ai-lp-generate-btn')?.addEventListener('click', async function() {
      const topic = topicInput?.value?.trim();
      const audience = audienceInput?.value?.trim() || 'Small business owners in Tennessee';
      const goal = goalSelect?.value || 'lead';

      if (!topic) {
        // @ts-ignore
        window.showToast('Please describe what you want first', 'warning');
        return;
      }

      const btn = document.getElementById('ai-lp-generate-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gemini is crafting SEO landing page...';

      try {
        const prompt = `
          You are the elite direct-response conversion copywriter, SEO/AEO/GEO strategist, and web designer for GUIA DE NEGOCIOS (guianegocios.net, bilingual business consultancy in Knoxville, TN).
          
          USER PROMPT / TOPIC / KEYWORDS: "${topic}"
          TARGET AUDIENCE / GEO: "${audience}"
          PRIMARY GOAL / OFFER: "${goal}"
          
          SEO / AEO / GEO OPTIMIZATION REQUIREMENTS:
          - Automatically identify and weave target keywords and geographic terms (e.g. Knoxville, TN, East Tennessee, local trade terms) into H1, H2s, and Meta Description.
          - Incorporate AEO (Answer Engine Optimization) direct-answer hooks and GEO entity grounding (e.g., IRS, Tennessee Secretary of State, local licensing boards).
          - Craft an irresistible, emotionally resonant value proposition addressing real pains (IRS fines, legal confusion, English language barrier).

          MANDATORY SECTION BLUEPRINT (BRAND DESIGN SYSTEM WITH HERO & LAYOUT VARIETY):
          
          1. Hero Section (CHOOSE THE BEST FIT FOR THIS CAMPAIGN - ALWAYS RICH & BRAND-ALIGNED):
             
             OPTION 1 - EXECUTIVE DARK GLOW HERO (Navy #1A2E35 + Emerald & Gold aura):
             <div class="builder-block bg-brand-dark text-white rounded-3xl p-8 sm:p-14 lg:p-16 my-6 shadow-2xl relative overflow-hidden font-sans">
               <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-emerald-500/25 via-brand-primary/20 to-transparent pointer-events-none"></div>
               <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>
               <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
                 <div><span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs sm:text-sm font-bold tracking-wider uppercase"><span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span><span contenteditable="true">[Badge]</span></span></div>
                 <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold leading-tight text-white" contenteditable="true">[Punchy Headline with <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-yellow-400">Gold Accent</span>]</h1>
                 <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed" contenteditable="true">[2 compelling sentences]</p>
                 <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                   <a href="#formulario" class="w-full sm:w-auto inline-flex items-center justify-center bg-brand-accent hover:bg-yellow-400 text-brand-dark font-bold py-4 px-8 rounded-full transition-all text-base shadow-lg shadow-yellow-500/20 transform hover:-translate-y-0.5" contenteditable="true">[CTA]</a>
                   <a href="tel:8652027112" class="w-full sm:w-auto inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-semibold py-4 px-6 rounded-full border border-white/20 transition-all text-base gap-2 backdrop-blur-sm"><svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><span contenteditable="true">(865) 202-7112</span></a>
                 </div>
                 <div class="pt-6 border-t border-white/10 grid grid-cols-3 gap-2 sm:gap-4 text-center">
                   <div><div class="text-emerald-400 font-bold text-base sm:text-xl font-heading" contenteditable="true">100%</div><div class="text-slate-400 text-xs sm:text-sm" contenteditable="true">Atención Bilingüe</div></div>
                   <div class="border-x border-white/10"><div class="text-amber-400 font-bold text-base sm:text-xl font-heading" contenteditable="true">24 Horas</div><div class="text-slate-400 text-xs sm:text-sm" contenteditable="true">Respuesta Rápida</div></div>
                   <div><div class="text-emerald-400 font-bold text-base sm:text-xl font-heading" contenteditable="true">Knoxville, TN</div><div class="text-slate-400 text-xs sm:text-sm" contenteditable="true">Presencia Local</div></div>
                 </div>
               </div>
             </div>

             OPTION 2 - MODERN CRISP LIGHT HERO (Matches Main Website - Mint #F2F7F4 & Dark Navy #1A2E35):
             <div class="builder-block bg-gradient-to-b from-[#F2F7F4] via-white to-slate-50 text-slate-900 rounded-3xl p-8 sm:p-14 lg:p-16 my-6 shadow-sm border border-slate-200 relative overflow-hidden font-sans">
               <div class="max-w-3xl mx-auto text-center space-y-6">
                 <div><span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-100/90 border border-emerald-200 text-brand-primary text-xs sm:text-sm font-bold tracking-wider uppercase"><span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span><span contenteditable="true">[Badge]</span></span></div>
                 <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold text-brand-dark leading-tight" contenteditable="true">[Punchy Headline with <span class="text-brand-primary">[Green Accent]</span>]</h1>
                 <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed" contenteditable="true">[2 compelling sentences]</p>
                 <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                   <a href="#formulario" class="w-full sm:w-auto inline-flex items-center justify-center bg-brand-primary hover:bg-emerald-900 text-white font-bold py-4 px-8 rounded-full transition-all text-base shadow-lg shadow-emerald-900/20 transform hover:-translate-y-0.5" contenteditable="true">[CTA]</a>
                   <a href="tel:8652027112" class="w-full sm:w-auto inline-flex items-center justify-center bg-white hover:bg-slate-100 text-brand-dark font-semibold py-4 px-6 rounded-full border border-slate-300 transition-all text-base gap-2 shadow-xs"><svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><span contenteditable="true">(865) 202-7112</span></a>
                 </div>
                 <div class="pt-6 border-t border-slate-200/80 grid grid-cols-3 gap-2 sm:gap-4 text-center">
                   <div><div class="text-brand-primary font-bold text-base sm:text-xl font-heading" contenteditable="true">100%</div><div class="text-slate-500 text-xs sm:text-sm" contenteditable="true">Atención Bilingüe</div></div>
                   <div class="border-x border-slate-200/80"><div class="text-amber-500 font-bold text-base sm:text-xl font-heading" contenteditable="true">24 Horas</div><div class="text-slate-500 text-xs sm:text-sm" contenteditable="true">Respuesta Rápida</div></div>
                   <div><div class="text-brand-primary font-bold text-base sm:text-xl font-heading" contenteditable="true">Knoxville, TN</div><div class="text-slate-500 text-xs sm:text-sm" contenteditable="true">Presencia Local</div></div>
                 </div>
               </div>
             </div>

             OPTION 3 - HIGH-CONVERTING 2-COLUMN SPLIT HERO (Value Bullets + Action Card):
             <div class="builder-block bg-brand-dark text-white rounded-3xl p-8 sm:p-12 lg:p-14 my-6 shadow-2xl relative overflow-hidden font-sans">
               <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-emerald-500/20 via-transparent to-transparent pointer-events-none"></div>
               <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
                 <div class="lg:col-span-7 space-y-6">
                   <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs sm:text-sm font-bold tracking-wider uppercase"><span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span><span contenteditable="true">[Badge]</span></span>
                   <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-bold text-white leading-tight" contenteditable="true">[Headline with <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-yellow-400">Gold Accent</span>]</h1>
                   <p class="text-slate-300 text-base leading-relaxed" contenteditable="true">[Description]</p>
                   <div class="space-y-2.5 pt-2">
