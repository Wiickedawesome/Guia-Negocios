---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Landing Pages | Admin">
  <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Landing Pages</h1>
      <p class="text-sm text-slate-500 mt-1">Manage and build high-converting bilingual landing pages.</p>
    </div>
    <a href="/admin/landing-pages/builder" class="px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-xl shadow-sm hover:bg-opacity-95 transition-all flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      New Landing Page
    </a>
  </div>

  <!-- AI Landing Page Generator -->
  <div class="bg-gradient-to-r from-[#1A2E35] via-[#1B4E2B]/80 to-[#1A2E35] rounded-2xl p-6 shadow-md text-white mb-8 border border-slate-700 font-sans">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-amber-400/20 flex items-center justify-center text-[#F0C850]">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-bold">AI Landing Page Generator</h3>
          <p class="text-xs text-slate-300">Creates magazine-grade, high-converting landing pages with Guia Negocios design components.</p>
        </div>
      </div>
      <span class="px-2.5 py-0.5 bg-[#F0C850]/20 text-[#F0C850] text-xs font-bold rounded-full border border-[#F0C850]/30 uppercase tracking-wider">Gemini Pro</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs text-slate-200 mb-1.5 font-semibold">Service / Offer / Topic</label>
        <input id="ai-lp-topic" type="text" placeholder="e.g., 15% OFF en Tu Página Web Profesional" class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-xs focus:outline-none focus:border-[#F0C850] focus:bg-white/15 transition-all" />
      </div>
      <div>
        <label class="block text-xs text-slate-200 mb-1.5 font-semibold">Target Audience / Location</label>
        <input id="ai-lp-audience" type="text" placeholder="e.g., Emprendedores hispanos en Knoxville y todo EE.UU." class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-xs focus:outline-none focus:border-[#F0C850] focus:bg-white/15 transition-all" />
      </div>
      <div>
        <label class="block text-xs text-slate-200 mb-1.5 font-semibold">Primary Goal</label>
        <select id="ai-lp-goal" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-white/20 text-white text-xs focus:outline-none focus:border-[#F0C850] transition-all">
          <option value="lead">Lead Generation (Form & WhatsApp)</option>
          <option value="call">Book a Strategic Consultation Call</option>
          <option value="discount">Special Discount / Limited-Time Offer (e.g. 15% OFF)</option>
          <option value="sales">Direct Service / Package Purchase</option>
          <option value="quote">Request a Free Quote / Price Estimate</option>
          <option value="nra">Non-Resident Alien (NRA) Remote U.S. Business</option>
          <option value="contractor">Construction / Contractor Licensing & Bonding</option>
          <option value="bookkeeping">Bookkeeping & Separate Finances Setup</option>
          <option value="tax">Tax Preparation & IRS Compliance Defense</option>
          <option value="download">Download Free Starter Guide / Checklist</option>
        </select>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2 border-t border-white/10">
      <label class="flex items-center gap-2.5 cursor-pointer text-xs font-medium text-slate-200 select-none">
        <input type="checkbox" id="ai-lp-dual-lang" checked class="w-4 h-4 text-brand-primary rounded accent-[#F0C850]" />
        <span>Auto-Generate Dual Language (🇪🇸 Español + 🇺🇸 English)</span>
      </label>

      <button id="ai-lp-generate-btn" class="px-5 py-2.5 bg-[#F0C850] hover:bg-amber-400 text-slate-900 text-xs font-extrabold rounded-xl transition-all flex items-center gap-2 shadow-md">
        <svg class="w-4 h-4 text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        Generate Landing Page
      </button>
    </div>
  </div>

  <!-- Landing Pages Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-600 border-b border-slate-200 text-xs uppercase font-bold">
          <tr>
            <th class="px-6 py-3.5 font-bold">Title</th>
            <th class="px-6 py-3.5 font-bold">URL</th>
            <th class="px-6 py-3.5 font-bold">Lang</th>
            <th class="px-6 py-3.5 font-bold">Status</th>
            <th class="px-6 py-3.5 font-bold text-right">Views</th>
            <th class="px-6 py-3.5 font-bold text-right">Conversions</th>
            <th class="px-6 py-3.5 font-bold text-right">Conv. Rate</th>
            <th class="px-6 py-3.5 font-bold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="lp-table-body" class="divide-y divide-slate-100 text-xs">
          <tr>
            <td colspan="8" class="px-6 py-8 text-center text-slate-500">
              <div class="w-6 h-6 border-2 border-brand-primary/20 border-t-brand-primary rounded-full animate-spin mx-auto mb-2"></div>
              Loading landing pages...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { collection, getDocs, doc, setDoc } from 'firebase/firestore';
    import { db, aiModel } from '../../lib/firebase';

    // Load Landing Pages from Firestore
    async function loadLandingPages() {
      const tbody = document.getElementById('lp-table-body');
      if (!tbody) return;

      try {
        const snapshot = await getDocs(collection(db, 'landingPages'));
        
        if (snapshot.empty) {
          tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-slate-500">No landing pages found. Create your first one!</td></tr>`;
          return;
        }

        let html = '';
        snapshot.forEach(docSnap => {
          const lp = docSnap.data();
          const id = docSnap.id;
          
          const statusClass = lp.status === 'Active' 
            ? 'bg-emerald-100 text-emerald-700' 
            : 'bg-amber-100 text-amber-700';

          const views = lp.views || 0;
          const conversions = lp.conversions || 0;
          const rate = views > 0 ? ((conversions / views) * 100).toFixed(1) + '%' : '0%';
          const langFlag = lp.lang === 'en' ? '🇺🇸 EN' : '🇪🇸 ES';

          html += `
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="px-6 py-4 font-bold text-[#1A2E35]">
                ${lp.title || 'Untitled Page'}
              </td>
              <td class="px-6 py-4 text-slate-500">/${lp.lang || 'es'}/lp/${lp.slug || 'page'}</td>
              <td class="px-6 py-4">
                <span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded-md font-bold text-[10px]">${langFlag}</span>
              </td>
              <td class="px-6 py-4"><span class="px-2.5 py-0.5 ${statusClass} text-[11px] font-bold rounded-full">${lp.status || 'Draft'}</span></td>
              <td class="px-6 py-4 text-right text-slate-600 font-medium">${views}</td>
              <td class="px-6 py-4 text-right text-slate-600 font-medium">${conversions}</td>
              <td class="px-6 py-4 text-right"><span class="text-emerald-600 font-bold">${rate}</span></td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="/admin/landing-pages/builder?id=${id}" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold transition-colors">Edit</a>
                  <a href="/${lp.lang || 'es'}/lp/${lp.slug || 'page'}" target="_blank" class="px-2.5 py-1 bg-brand-primary/10 hover:bg-brand-primary text-brand-primary hover:text-white rounded-lg text-xs font-bold transition-colors">View Live</a>
                </div>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = html;

      } catch (error) {
        console.error("Error fetching landing pages:", error);
        tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-red-500">Error loading landing pages. Check console.</td></tr>`;
      }
    }

    loadLandingPages();

    // AI Landing Page Generator
    document.getElementById('ai-lp-generate-btn')?.addEventListener('click', async function() {
      const topicInput = document.getElementById('ai-lp-topic') as HTMLInputElement;
      const audienceInput = document.getElementById('ai-lp-audience') as HTMLInputElement;
      const goalSelect = document.getElementById('ai-lp-goal') as HTMLSelectElement;
      const isDualLang = (document.getElementById('ai-lp-dual-lang') as HTMLInputElement)?.checked;

      const topic = topicInput?.value?.trim();
      const audience = audienceInput?.value?.trim() || 'Emprendedores hispanos en EE.UU.';
      const goal = goalSelect?.value || 'lead';

      if (!topic) {
        // @ts-ignore
        window.showToast('Please enter a Service / Offer topic first', 'warning');
        return;
      }

      const btn = document.getElementById('ai-lp-generate-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gemini is designing...';

      try {
        const prompt = `
You are the lead UX designer and conversion copywriter for GUIA DE NEGOCIOS (a high-authority bilingual business consultancy).
Create high-converting landing page(s) for the following offer:
- Topic: "${topic}"
- Target Audience: "${audience}"
- Primary Goal: "${goal}"
- Dual Language Required: ${isDualLang ? 'YES (Generate both Spanish AND English)' : 'NO (Spanish only)'}

DESIGN & ARCHITECTURE GUIDELINES (GUIA DE NEGOCIOS DESIGN SYSTEM):
1. Hero Section: Dark navy (#1A2E35) background with golden amber (#F0C850) accents, gold SVG underline under key phrase, high-contrast white bold headline, trust stats bar, and dual CTAs (Primary Gold + Secondary Glass with phone (865) 202-7112).
2. 4-Stat Metric Bar: 4 metric cards with authoritative research source badges (MSU Research, Brookings 2025, Stanford SLEI, Census Bureau).
3. Problem vs. Solution Row Matrix (or Split Mixed vs. Separated Card): Red problem boxes with danger SVG icon -> Green arrow -> Green solution boxes with checkmark SVG icon.
4. Process Flow or 6-Step Snake Map Roadmap: Numbered milestone cards (1. Diagnóstico -> 2. Estructura -> 3. Registro & EIN -> 4. Banca & Operación).
5. 2-Tier Pricing / Service Packages Matrix: Básico vs Completo with "Más Popular" gold badge and checklists.
6. Real Testimonials & Social Proof: 5-star cards with Hispanic client reviews and avatar emblems.
7. FAQ Accordion: 3-4 top customer objections answered cleanly.
8. Lead Capture Form & Final Contact Band: Form fields (Nombre, Teléfono/WhatsApp, Correo, Tipo de Negocio) + Contact row band (Phone, Email, Web, Location).

STRICT RULES:
- Use Tailwind CSS classes with modern rounded styling (rounded-2xl, shadow-sm, p-8 sm:p-12).
- ZERO EMOJI POLICY: NEVER output unicode emojis. Always use clean inline SVG vector icons.
- Add contenteditable="true" to all editable headings, paragraphs, and buttons.
- Output strictly a JSON object:
${isDualLang ? `
{
  "es": {
    "title": "string (Compelling Spanish title)",
    "slug": "string (url-slug-in-spanish)",
    "metaDesc": "string (150-160 char Spanish description)",
    "html": "string (Complete HTML containing all <section class=\\"builder-block ...\\">...</section> sections in Spanish)"
  },
  "en": {
    "title": "string (Compelling English title)",
    "slug": "string (url-slug-in-english)",
    "metaDesc": "string (150-160 char English description)",
    "html": "string (Complete HTML containing all <section class=\\"builder-block ...\\">...</section> sections in English)"
  }
}
` : `
{
  "title": "string (Compelling Spanish title)",
  "slug": "string (url-slug-in-spanish)",
  "metaDesc": "string (150-160 char Spanish description)",
  "html": "string (Complete HTML containing all <section class=\\"builder-block ...\\">...</section> sections in Spanish)"
}
`}
`;

        const result = await aiModel.generateContent(prompt);
        const text = result.response.text();
        const jsonMatch = text.match(/\{[\s\S]*\}/);
        if (!jsonMatch) throw new Error("Could not parse AI response JSON");

        const data = JSON.parse(jsonMatch[0]);
        let primaryDocId = '';

        if (isDualLang && data.es && data.en) {
          // Save Spanish
          const slugEs = (data.es.slug || topic.toLowerCase().replace(/[^a-z0-9]+/g, '-')).replace(/^-|-$/g, '');
          const docIdEs = `es_${slugEs}`;
          await setDoc(doc(db, 'landingPages', docIdEs), {
            title: data.es.title || topic,
            slug: slugEs,
            metaDesc: data.es.metaDesc || '',
            lang: 'es',
            content: data.es.html || '',
            status: 'Draft',
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            views: 0,
            conversions: 0
          });

          // Save English
          const slugEn = (data.en.slug || slugEs).replace(/^-|-$/g, '');
          const docIdEn = `en_${slugEn}`;
          await setDoc(doc(db, 'landingPages', docIdEn), {
            title: data.en.title || topic,
            slug: slugEn,
            metaDesc: data.en.metaDesc || '',
            lang: 'en',
            content: data.en.html || '',
            status: 'Draft',
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            views: 0,
            conversions: 0
          });

          primaryDocId = docIdEs;
        } else {
          const singleData = data.es || data;
          const slug = (singleData.slug || topic.toLowerCase().replace(/[^a-z0-9]+/g, '-')).replace(/^-|-$/g, '');
          primaryDocId = `es_${slug}`;

          await setDoc(doc(db, 'landingPages', primaryDocId), {
            title: singleData.title || topic,
            slug: slug,
            metaDesc: singleData.metaDesc || '',
            lang: 'es',
            content: singleData.html || '',
            status: 'Draft',
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            views: 0,
            conversions: 0
          });
        }

        // @ts-ignore
        window.showToast(isDualLang ? 'Dual Language Landing Pages generated & saved!' : 'Landing Page generated successfully!', 'success');

        setTimeout(() => {
          window.location.href = `/admin/landing-pages/builder?id=${primaryDocId}`;
        }, 1200);

      } catch (err: any) {
        console.error("AI Landing Page Generation Error:", err);
        alert('Failed to generate landing page: ' + (err.message || 'Unknown error'));
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Generate Landing Page';
      }
    });
  </script>
</AdminLayout>
