---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Analytics | Admin">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Analytics</h1>
      <p class="text-sm text-slate-500 mt-1">Detailed traffic and engagement metrics.</p>
    </div>
    <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-lg p-1">
      <button id="btn-range-30" class="date-range-btn px-3 py-1.5 text-sm font-medium rounded-md bg-slate-100 text-slate-900" data-range="30">30 Days</button>
      <button id="btn-range-90" class="date-range-btn px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900" data-range="90">90 Days</button>
      <button id="btn-range-365" class="date-range-btn px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900" data-range="365">Year</button>
    </div>
  </div>

  <!-- Shown when GA4 cannot be queried. The dashboard must not fall back to
       invented figures, so the cards are blanked and this explains why. -->
  <div id="analytics-error" class="hidden mb-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800"></div>

  <!-- Top Metrics -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Total Visitors (Active)</div>
      <div class="text-3xl font-bold text-slate-900" id="metric-visitors">...</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">New Users</div>
      <div class="text-3xl font-bold text-slate-900" id="metric-new">...</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Bounce Rate</div>
      <div class="text-3xl font-bold text-slate-900" id="metric-bounce">...</div>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm text-center">
      <div class="text-sm font-medium text-slate-500 mb-1">Avg Session</div>
      <div class="text-3xl font-bold text-slate-900" id="metric-session">...</div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <!-- Main Chart -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm lg:col-span-2">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-lg font-bold text-slate-900">Traffic Volume</h3>
          <p class="text-xs text-slate-500 mt-0.5">Daily active users from GA4</p>
        </div>
        <div id="chart-total-tag" class="text-xs font-bold px-2.5 py-1 rounded-full bg-brand-primary/10 text-brand-primary">
          Live Data
        </div>
      </div>
      <div id="traffic-chart-container" class="h-64 bg-slate-50/50 border border-slate-100 rounded-lg relative overflow-hidden">
        <div class="h-full flex items-center justify-center">
          <div class="text-center text-slate-400">
            <svg class="w-8 h-8 mx-auto mb-2 animate-spin text-brand-primary" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-xs">Loading GA4 chart...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Traffic Sources -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      <h3 class="text-lg font-bold text-slate-900 mb-6">Traffic Sources</h3>
      <div class="space-y-4" id="traffic-sources-container">
        <div class="animate-pulse space-y-4">
          <div class="h-8 bg-slate-100 rounded-lg"></div>
          <div class="h-8 bg-slate-100 rounded-lg"></div>
          <div class="h-8 bg-slate-100 rounded-lg"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Top Pages -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-200 flex items-center justify-between">
        <h3 class="text-lg font-bold text-slate-900">Top Pages</h3>
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Views</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
            <tr>
              <th class="px-6 py-3 font-medium">Page URL</th>
              <th class="px-6 py-3 font-medium text-right">Views</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="top-pages-body">
            <tr>
              <td colspan="2" class="px-6 py-3 text-center text-slate-500">Loading top pages...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Demographics -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <h3 class="text-lg font-bold text-slate-900 mb-6">Demographics</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Top Cities</h4>
          <ul class="space-y-2 text-sm" id="demographic-locations">
            <li class="text-slate-500">Loading locations...</li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Languages</h4>
          <div class="flex flex-col space-y-2" id="demographic-languages">
             <span class="text-slate-500 text-sm">Loading languages...</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1"></script>
  <script>
    import { app } from '../../lib/firebase';
    import { escapeHtml } from '../../utils/escape-html';
    import { clearTrafficChart, renderTrafficChart } from '../../utils/traffic-chart';
    import { getFunctions, httpsCallable } from 'firebase/functions';

    // Channel color and icon styling registry
    const channelConfig: Record<string, { color: string; icon: string }> = {
      'Organic Social': {
        color: '#ec4899', // pink-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />'
      },
      'Direct': {
        color: '#3b82f6', // blue-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />'
      },
      'Organic Search': {
        color: '#10b981', // emerald-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />'
      },
      'Unassigned': {
        color: '#64748b', // slate-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />'
      },
      'Referral': {
        color: '#8b5cf6', // purple-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />'
      },
      'Paid Search': {
        color: '#f59e0b', // amber-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />'
      },
      'Email': {
        color: '#06b6d4', // cyan-500
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />'
      }
    };

    // Single failure surface for both "GA4 returned nothing" and "the call
    // never arrived": blank every card so none is left pulsing, show the
    // reason, and hide the badge so it cannot contradict the empty chart.
    function showAnalyticsUnavailable(message: string) {
      ['metric-visitors', 'metric-new', 'metric-bounce', 'metric-session'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.innerText = '—';
      });
      const banner = document.getElementById('analytics-error');
      if (banner) {
        banner.textContent = message;
        banner.classList.remove('hidden');
      }
      const badge = document.getElementById('chart-total-tag');
      if (badge) badge.classList.add('hidden');
      const chart = document.getElementById('traffic-chart-container');
      if (chart) clearTrafficChart(chart, 'No chart data available.');
      const sources = document.getElementById('traffic-sources-container');
      if (sources) sources.innerHTML = '<p class="text-slate-500 text-sm">No traffic data available.</p>';
    }

    async function loadAnalytics(range: string = '30') {
      try {
        // Set UI to loading state
        document.getElementById('metric-visitors')!.innerHTML = '<span class="animate-pulse text-slate-300">...</span>';
        document.getElementById('metric-new')!.innerHTML = '<span class="animate-pulse text-slate-300">...</span>';
        document.getElementById('metric-bounce')!.innerHTML = '<span class="animate-pulse text-slate-300">...</span>';
        document.getElementById('metric-session')!.innerHTML = '<span class="animate-pulse text-slate-300">...</span>';
        
        const functions = getFunctions(app);
        const getAnalyticsData = httpsCallable(functions, 'getAnalyticsData');
        const result = await getAnalyticsData({ range });
        const data = result.data as any;

        if (data.ok === false) {
          // The function reports a genuine failure rather than substituting
          // sample numbers, so surface it instead of showing a plausible chart.
          showAnalyticsUnavailable(
            `Live Google Analytics data is unavailable: ${data.message || 'the query failed'}. No figures are shown because none were returned.`
          );
          return;
        }

        const errorBanner = document.getElementById('analytics-error');
        if (errorBanner) errorBanner.classList.add('hidden');

        // Real data is on screen: restore the badge in case an earlier
        // failed load hid it.
        const chartTag = document.getElementById('chart-total-tag');
        if (chartTag) chartTag.classList.remove('hidden');

        if (data.totals) {
          document.getElementById('metric-visitors')!.innerText = data.totals.activeUsers;
          document.getElementById('metric-new')!.innerText = data.totals.newUsers;
          document.getElementById('metric-bounce')!.innerText = data.totals.bounceRate;
          document.getElementById('metric-session')!.innerText = data.totals.avgSessionDuration;
        }

        // Render Chart
        if (data.timeSeries) {
          const chartContainer = document.getElementById('traffic-chart-container');
          if (chartContainer) renderTrafficChart(chartContainer, data.timeSeries);
        }

        // Render Top Pages
        if (data.topPages) {
          const tbody = document.getElementById('top-pages-body');
          if (tbody) {
            tbody.innerHTML = data.topPages.map((page: any) => `
              <tr>
                <td class="px-6 py-3 font-medium text-slate-800">${escapeHtml(page.path)}</td>
                <td class="px-6 py-3 text-right font-bold text-slate-600">${page.views}</td>
              </tr>
            `).join('');
          }
        }

        // Render Demographics - Cities
        if (data.topCities) {
          const locList = document.getElementById('demographic-locations');
          if (locList) {
            locList.innerHTML = data.topCities.map((loc: any) => `
              <li class="flex justify-between items-center py-1 border-b border-slate-50 last:border-0">
                <span class="text-slate-700 truncate font-medium" title="${escapeHtml(loc.city)}">${escapeHtml(loc.city)}</span>
                <span class="text-xs font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-800">${loc.users} users</span>
              </li>
            `).join('');
          }
        }

        // Render Demographics - Languages
        if (data.languages) {
          const langList = document.getElementById('demographic-languages');
          if (langList) {
            langList.innerHTML = data.languages.map((lang: any) => `
              <div class="w-full flex justify-between items-center px-4 py-2.5 bg-slate-50/80 rounded-lg border border-slate-100">
                <span class="text-slate-700 font-semibold text-xs uppercase tracking-wider">${escapeHtml(lang.language)}</span>
                <span class="font-bold text-sm text-brand-primary">${lang.users} Users</span>
              </div>
            `).join('');
          }
        }

        // Render Traffic Sources with guaranteed inline color styling
        if (data.trafficSources) {
          const container = document.getElementById('traffic-sources-container');
          if (container) {
            const total = data.trafficSources.reduce((sum: number, src: any) => sum + src.users, 0);
            
            if (total === 0) {
              container.innerHTML = '<p class="text-slate-500 text-sm">No traffic data available for this range.</p>';
            } else {
              container.innerHTML = data.trafficSources.map((src: any) => {
                const percent = Math.max(1, Math.round((src.users / total) * 100));
                const config = channelConfig[src.channel] || {
                  color: '#64748b',
                  icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />'
                };
                
                return `
                  <div>
                    <div class="flex justify-between items-center text-sm mb-1.5">
                      <span class="font-medium text-slate-700 flex items-center gap-2">
                        <svg class="w-4 h-4" style="color: ${config.color};" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          ${config.icon}
                        </svg> 
                        <span>${escapeHtml(src.channel)}</span>
                        <span class="text-xs text-slate-400">(${src.users})</span>
                      </span>
                      <span class="text-xs font-bold text-slate-700">${percent}%</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                      <div class="h-2.5 rounded-full transition-all duration-700 ease-out" style="width: ${percent}%; background-color: ${config.color};"></div>
                    </div>
                  </div>
                `;
              }).join('');
            }
          }
        }
      } catch (error) {
        // The callable itself failed (offline, App Check rejection, ...), so
        // blank every card and surface the reason instead of leaving three
        // of them pulsing forever.
        console.error('Error fetching analytics:', error);
        showAnalyticsUnavailable(
          `Could not reach the analytics service: ${error instanceof Error ? error.message : String(error)}`
        );
      }
    }

    // Event Listeners for Date Range Buttons
    const buttons = document.querySelectorAll('.date-range-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLButtonElement;
        const range = target.getAttribute('data-range') || '30';
        
        // Update active styling
        buttons.forEach(b => {
          b.classList.remove('bg-slate-100', 'text-slate-900');
          b.classList.add('text-slate-600', 'hover:text-slate-900');
        });
        target.classList.remove('text-slate-600', 'hover:text-slate-900');
        target.classList.add('bg-slate-100', 'text-slate-900');

        // Fetch new data
        loadAnalytics(range);
      });
    });

    // Call after slight delay to ensure auth is ready
    setTimeout(() => loadAnalytics('30'), 500);
  </script>
</AdminLayout>
