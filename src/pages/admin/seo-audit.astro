---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="SEO Audit | Admin">
  <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-heading">Site-Wide SEO Audit</h1>
      <p class="text-sm text-slate-500 mt-1">Autonomous site-wide crawler and AI health analysis.</p>
    </div>
    
    <div class="flex items-center gap-3 w-full md:w-auto">
      <button id="run-audit-btn" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 transition-colors flex items-center gap-2 whitespace-nowrap">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Run Full Scan
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="audit-loading" class="hidden py-12 text-center">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-200 border-t-brand-primary mb-4"></div>
    <p class="text-slate-600 font-medium">Crawling site and running AI analysis...</p>
    <p class="text-xs text-slate-400 mt-1">This may take up to 2-3 minutes. Do not close this page.</p>
  </div>
  
  <!-- Empty State -->
  <div id="audit-empty" class="hidden py-12 text-center bg-white rounded-xl border border-slate-200 shadow-sm">
    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <h3 class="text-lg font-bold text-slate-900">No Audits Found</h3>
    <p class="text-sm text-slate-500 mt-1 mb-6">Run a full scan to generate your first site-wide SEO report.</p>
    <button onclick="document.getElementById('run-audit-btn').click()" class="cursor-pointer px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg shadow-sm hover:bg-opacity-90 inline-flex items-center gap-2">
      Start First Scan
    </button>
  </div>

  <div id="audit-results" class="hidden">
    <div class="flex flex-col lg:flex-row gap-6 mb-8">
      <!-- Global Score -->
      <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm flex-1">
        <div class="flex flex-col sm:flex-row items-center gap-8 h-full">
          <!-- Circular Score -->
          <div class="relative w-36 h-36 flex-shrink-0">
            <svg class="w-36 h-36 -rotate-90" viewBox="0 0 144 144">
              <circle cx="72" cy="72" r="60" fill="none" stroke="#e2e8f0" stroke-width="12" />
              <circle id="score-ring" cx="72" cy="72" r="60" fill="none" stroke="#10b981" stroke-width="12" stroke-dasharray="377" stroke-dashoffset="377" stroke-linecap="round" class="transition-all duration-1000 ease-out" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="score-text" class="text-3xl font-bold text-slate-900">0%</span>
              <span id="score-label" class="text-sm font-medium text-emerald-600">POOR</span>
            </div>
          </div>
          <div class="flex-1 text-center sm:text-left">
            <h3 class="text-lg font-bold text-slate-900 mb-1">Global SEO Health</h3>
            <p class="text-sm text-slate-500 mb-3">Aggregated score based on <span id="pages-scanned-count" class="font-bold text-slate-700">0</span> pages scanned.</p>
            <p class="text-xs text-slate-400">Last scan: <span id="last-scan-date">Never</span></p>
          </div>
        </div>
      </div>

      <!-- AI Summary -->
      <div class="bg-gradient-to-r from-brand-dark to-slate-800 rounded-xl p-8 shadow-sm text-white flex-[2]">
        <div class="flex items-center gap-3 mb-4">
          <svg class="w-6 h-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          <h3 class="text-lg font-bold">AI Executive Summary</h3>
        </div>
        <p id="ai-summary-text" class="text-sm text-slate-300 leading-relaxed">Loading summary...</p>
      </div>
    </div>

    <!-- Actionable Items -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <h3 class="font-bold text-slate-900">Priority Action Items</h3>
        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Impact & Tasks</span>
      </div>
      <div id="action-items-list" class="divide-y divide-slate-100">
        <!-- Rendered via JS -->
      </div>
    </div>
  </div>

  <script>
    import { app } from '../../lib/firebase';
    import { getFunctions, httpsCallable } from 'firebase/functions';
    import { getFirestore, collection, query, orderBy, limit, getDocs, addDoc, serverTimestamp } from 'firebase/firestore';

    const db = getFirestore(app);

    // Initial Load: Fetch latest scan
    async function loadLatestAudit() {
      try {
        const q = query(collection(db, 'seoAudits'), orderBy('scannedAt', 'desc'), limit(1));
        const snap = await getDocs(q);
        
        if (snap.empty) {
          document.getElementById('audit-empty')?.classList.remove('hidden');
          return;
        }

        const data = snap.docs[0].data();
        renderAuditData(data);
      } catch (e) {
        console.error("Failed to load audit:", e);
      }
    }

    function renderAuditData(data: any) {
      document.getElementById('audit-empty')?.classList.add('hidden');
      document.getElementById('audit-results')?.classList.remove('hidden');

      // Render Score
      const score = data.globalScore || 0;
      document.getElementById('score-text')!.innerText = `${score}%`;
      document.getElementById('pages-scanned-count')!.innerText = data.pagesScanned || 0;
      
      const dateStr = data.scannedAt ? new Date(data.scannedAt.toDate()).toLocaleString() : 'Just now';
      document.getElementById('last-scan-date')!.innerText = dateStr;
      
      const ring = document.getElementById('score-ring');
      const offset = 377 - (377 * score) / 100;
      setTimeout(() => {
        if (ring) {
          ring.style.strokeDashoffset = offset.toString();
          ring.setAttribute('stroke', score >= 80 ? '#10b981' : score >= 50 ? '#f59e0b' : '#ef4444');
        }
      }, 100);

      const label = document.getElementById('score-label')!;
      label.innerText = score >= 80 ? 'GOOD' : score >= 50 ? 'FAIR' : 'POOR';
      label.className = `text-sm font-medium ${score >= 80 ? 'text-emerald-600' : score >= 50 ? 'text-amber-600' : 'text-red-600'}`;

      // Render AI Summary
      document.getElementById('ai-summary-text')!.innerText = data.summary || 'No summary available.';

      // Render Action Items
      const actionList = document.getElementById('action-items-list')!;
      if (data.actionableItems && data.actionableItems.length > 0) {
        actionList.innerHTML = data.actionableItems.map((item: any) => {
          const isHigh = item.priority === 'High';
          const isMedium = item.priority === 'Medium';
          const priorityColor = isHigh ? 'bg-red-50 text-red-700 border-red-200' : (isMedium ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-slate-50 text-slate-700 border-slate-200');
          const dotColor = isHigh ? 'bg-red-500' : (isMedium ? 'bg-amber-500' : 'bg-slate-500');

          return `
            <div class="px-6 py-5 flex items-start gap-4 hover:bg-slate-50 transition-colors">
              <div class="mt-1 flex-shrink-0">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-bold border ${priorityColor} uppercase tracking-wide">
                  <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                  ${item.priority}
                </span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-slate-900 mb-1">${item.task}</p>
                <p class="text-sm text-slate-600">${item.impact}</p>
              </div>
            </div>
          `;
        }).join('');
      } else {
        actionList.innerHTML = '<div class="px-6 py-8 text-center text-slate-500 text-sm">No action items found! Your site is perfectly optimized.</div>';
      }
    }

    // Load on mount
    loadLatestAudit();

    // Trigger Scan
    document.getElementById('run-audit-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('run-audit-btn') as HTMLButtonElement;
      const loading = document.getElementById('audit-loading');
      const results = document.getElementById('audit-results');
      const empty = document.getElementById('audit-empty');

      btn.disabled = true;
      btn.innerHTML = 'Scanning...';
      loading?.classList.remove('hidden');
      results?.classList.add('hidden');
      empty?.classList.add('hidden');

      try {
        const functions = getFunctions(app);
        const runSiteWideAudit = httpsCallable(functions, 'runSiteWideAudit');
        
        const response = await runSiteWideAudit();
        const data = response.data as any;

        // Manually format the date since it comes back as an ISO string from callable
        data.scannedAt = { toDate: () => new Date(data.scannedAt) };
        renderAuditData(data);
        
        // Add real notification for the admin panel
        try {
          await addDoc(collection(db, 'notifications'), {
            title: 'SEO Audit Completed',
            message: `Site-wide scan finished with a health score of ${data.globalScore || 0}% across ${data.pagesScanned || 0} pages.`,
            type: 'seo',
            read: false,
            link: '/admin/seo-audit',
            createdAt: serverTimestamp()
          });
        } catch (ne) {
          console.warn('Failed to write audit notification:', ne);
        }

        loading?.classList.add('hidden');
        results?.classList.remove('hidden');

      } catch (error: any) {
        console.error(error);
        alert(`Audit failed: ${error.message}`);
        loading?.classList.add('hidden');
        // reload latest to restore state
        loadLatestAudit();
      } finally {
        btn.disabled = false;
        btn.innerHTML = `
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          Run Full Scan
        `;
      }
    });
  </script>
</AdminLayout>
