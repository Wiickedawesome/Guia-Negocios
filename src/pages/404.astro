---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Página no encontrada | Guia Negocios" description="La página que está buscando no existe." noindex>
  <!-- altPath is required here. Header falls back to currentPath.replace('/es','/en')
       and this page is built as /404, which contains no '/es' to replace, so the
       language toggle would otherwise point at /404/ and dead-end. -->
  <Header slot="header" altPath="/en/" />

  <div class="min-h-[70vh] flex items-center justify-center bg-slate-50 px-4 py-20">
    <div class="max-w-md w-full text-center">
      <div class="w-20 h-20 rounded-2xl bg-brand-primary/10 text-brand-primary flex items-center justify-center font-extrabold text-3xl mx-auto mb-6">
        404
      </div>
      <h1 id="nf-title" class="text-3xl font-bold font-heading text-slate-900 mb-3">Página No Encontrada</h1>
      <p id="nf-message" class="text-slate-600 mb-8 leading-relaxed">
        Lo sentimos, la página que intenta acceder no existe, ha sido movida o está en proceso de publicación.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a id="nf-home" href="/" class="px-6 py-3 bg-brand-primary text-white font-medium rounded-xl hover:bg-opacity-95 transition-all shadow-sm">
          Ir al Inicio
        </a>
        <a id="nf-blog" href="/es/blog" class="px-6 py-3 bg-white border border-slate-200 text-slate-700 font-medium rounded-xl hover:bg-slate-50 transition-all shadow-xs">
          Ver Nuestro Blog
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script is:inline>
    // Firebase Hosting serves this single file for every unmatched URL in both
    // languages, so the copy is authored in Spanish (the default locale) and
    // switched to English when the visitor arrived on an /en/ path.
    //
    // The previous version of this page redirected /es|en/blog|<slug> into the
    // client view shell. That is deliberately GONE: firebase.json rewrites
    // those paths to the validateSlugRewrite function, which returns a real 404
    // for unknown slugs. A redirect here would turn that 404 into a 200 shell
    // and re-create the soft-404s the function exists to prevent.
    (function () {
      if (!window.location.pathname.startsWith('/en')) return;

      document.documentElement.lang = 'en';
      document.title = 'Page Not Found | Guia Negocios';

      var setText = function (id, text) {
        var el = document.getElementById(id);
        if (el) el.textContent = text;
      };

      setText('nf-title', 'Page Not Found');
      setText(
        'nf-message',
        'Sorry, the page you are looking for does not exist, has been moved, or is not published yet.'
      );
      setText('nf-home', 'Go Home');
      setText('nf-blog', 'View Our Blog');

      var home = document.getElementById('nf-home');
      var blog = document.getElementById('nf-blog');
      if (home) home.setAttribute('href', '/en/');
      if (blog) blog.setAttribute('href', '/en/blog');

      // The header is built once in Spanish, so its language switcher points at
      // the English home. A visitor who arrived on an /en/ URL needs the
      // opposite, so flip both the desktop and mobile switchers back to Spanish.
      var toggles = document.querySelectorAll('a[aria-label="Switch to English"]');
      for (var i = 0; i < toggles.length; i++) {
        toggles[i].setAttribute('href', '/');
        toggles[i].setAttribute('aria-label', 'Switch to Spanish');
        toggles[i].textContent = 'ES';
      }

      // Same problem for the navigation itself: it is rendered in Spanish, so on
      // an /en/ URL every nav link would send the visitor back into the Spanish
      // site. Rewrite both the label and the target for each of the five items,
      // in the desktop nav and the mobile panel alike.
      var navMap = {
        'Inicio': { text: 'Home', href: '/en' },
        'Servicios': { text: 'Services', href: '/en/services' },
        'Sobre Nosotros': { text: 'About', href: '/en/about' },
        'Contacto': { text: 'Contact', href: '/en/contact' },
        'Blog': { text: 'Blog', href: '/en/blog' }
      };

      var navLinks = document.querySelectorAll('header nav a, #mobile-menu a');
      for (var n = 0; n < navLinks.length; n++) {
        var entry = navMap[navLinks[n].textContent.trim()];
        if (!entry) continue;
        navLinks[n].textContent = entry.text;
        navLinks[n].setAttribute('href', entry.href);
      }
    })();
  </script>
</BaseLayout>
