---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqCategories = [
  {
    id: "formation",
    name: "Registro de Negocios y LLC",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
    items: [
      {
        question: "¿Qué incluye la asistencia para la configuración de LLC y EIN?",
        answer: "Le guiamos paso a paso a través de la disponibilidad de nombres, registro formal de LLC en la Secretaría de Estado de Tennessee, solicitud de Número de Identificación de Empleador (EIN) del IRS, redacción de Acuerdo Operativo (Operating Agreement) personalizado y lista de verificación para cuentas bancarias comerciales."
      },
      {
        question: "¿Cuánto tiempo toma el proceso de registro del negocio en Tennessee?",
        answer: "La aprobación de una LLC en el estado de Tennessee generalmente toma entre 2 y 5 días hábiles en línea. La asignación del EIN para residentes suele ser inmediata al presentar la solicitud en línea, mientras que para no residentes con pasaporte/ITIN suele tardar de 1 a 4 semanas dependiendo del IRS."
      },
      {
        question: "¿Puedo abrir un negocio en Tennessee sin Número de Seguro Social (SSN)?",
        answer: "Sí. Los ciudadanos extranjeros y no residentes pueden registrar legalmente una LLC en Tennessee y obtener un EIN ante el IRS utilizando su ITIN o pasaporte vigente mediante el Formulario SS-4."
      },
      {
        question: "¿Es necesario tener un Acuerdo Operativo (Operating Agreement)?",
        answer: "Aunque el estado de Tennessee no exige registrar el acuerdo operativo en sus oficinas públicas, los bancos comerciales, procesadores de pago y tribunales lo exigen para abrir cuentas a nombre del negocio, proteger su patrimonio personal y firmar contratos comerciales."
      },
      {
        question: "¿Qué licencias comerciales se necesitan en Knoxville y el Condado de Knox?",
        answer: "Dependiendo de su actividad comercial e ingresos estimados, requerirá una licencia de impuestos comerciales del Condado de Knox (estándar o de actividad mínima), registro en la Ciudad de Knoxville y, en ciertos rubros, permisos especiales de contratista o salud. Le asesoramos en cada trámite."
      }
    ]
  },
  {
    id: "branding-web",
    name: "Marca, Marketing y Sitios Web",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    items: [
      {
        question: "¿Qué incluye el paquete de Marca y Marketing?",
        answer: "Incluye la creación y entrega de su logotipo vectorial, paleta de colores oficial, reglas tipográficas, optimización de perfil de Google Business, configuración de páginas profesionales en Facebook e Instagram, WhatsApp Business con respuestas automáticas y plantillas editables en Canva."
      },
      {
        question: "¿Cuánto tiempo toma construir un sitio web profesional?",
        answer: "Un sitio web estándar de 4 a 6 páginas toma entre 2 y 3 semanas desde la recepción del material y la sesión inicial de estrategia hasta el lanzamiento oficial con dominio conectado y formularios probados."
      },
      {
        question: "¿El sitio web estará optimizado para celulares y Google (SEO)?",
        answer: "Sí. Cada sitio web que desarrollamos es 100% responsivo para teléfonos inteligentes, carga a alta velocidad, cuenta con etiquetas meta descriptivas, jerarquía semántica y es conectado directamente a Google Search Console y Google Maps."
      },
      {
        question: "¿Podré hacer cambios en mi página web después del lanzamiento?",
        answer: "Sí. Configuramos herramientas accesibles o puede contar con nuestro soporte a la carta para actualizaciones de textos, fotos, nuevos servicios o ajustes según lo requiera su empresa."
      }
    ]
  },
  {
    id: "operations",
    name: "Operaciones y Asistencia Virtual",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    items: [
      {
        question: "¿Qué son los Sistemas de Operación y Crecimiento?",
        answer: "Son herramientas y flujos para organizar el día a día: embudos de recepción de clientes, agenda automática de citas, cotizaciones profesionales, facturación electrónica, seguimiento de cobros y control básico de ingresos y gastos."
      },
      {
        question: "¿Cómo funciona la alianza de Asistencia Virtual con CreedaVA?",
        answer: "A través de nuestra alianza oficial con CreedaVA, usted cuenta con Asistentes Virtuales bilingües altamente capacitados que gestionan su bandeja de entrada, responden llamadas de clientes, programan citas y actualizan su sistema CRM en inglés y español."
      },
      {
        question: "¿Ofrecen servicios de traducción y notario público bilingüe en Knoxville?",
        answer: "Sí. Proveemos traducción práctica de contratos y cartas comerciales, además de servicio de Notario Público bilingüe a domicilio en Knoxville y el este de Tennessee."
      }
    ]
  },
  {
    id: "process",
    name: "Paquetes y Cómo Comenzar",
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    items: [
      {
        question: "¿Puedo comenzar con un servicio y actualizar a un paquete completo más adelante?",
        answer: "¡Por supuesto! Muchos clientes comienzan con el registro de su LLC y EIN, y luego actualizan al Paquete Completo de Lanzamiento a medida que su negocio crece. Acreditamos los pagos de servicios previos hacia su paquete mayor."
      },
      {
        question: "¿Ofrecen soporte 100% bilingüe en español e inglés?",
        answer: "Sí. Toda nuestra asesoría, redacción de documentos, llamadas estratégicas y materiales se entregan de forma fluida y clara tanto en español como en inglés."
      },
      {
        question: "¿Cómo puedo comenzar a trabajar con GUIA NEGOCIOS?",
        answer: "Es muy fácil. Complete nuestro formulario de contacto en línea, llámenos al (865) 202-7112 o escríbanos a info@guianegocios.net para agendar su consulta inicial."
      }
    ]
  }
];

// Flatten for JSON-LD Schema
const allFaqItems = faqCategories.flatMap(c => c.items);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout 
  title="Preguntas Frecuentes | GUIA NEGOCIOS" 
  description="Encuentre respuestas a preguntas frecuentes sobre registro de LLC, trámites de EIN, diseño web, marcas y consultoría bilingüe en Knoxville, TN."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="py-20 lg:py-28 bg-brand-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-slate-900 to-brand-dark opacity-95"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-6">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold text-white tracking-tight leading-tight">
        Preguntas Frecuentes
      </h1>
      <p class="text-slate-300 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
        Todo lo que necesita saber para registrar su empresa, crear su marca, lanzar su sitio web y escalar sus operaciones en el este de Tennessee.
      </p>

      <!-- Instant Search Box -->
      <div class="max-w-xl mx-auto pt-4">
        <div class="relative">
          <input 
            type="text" 
            id="faq-search" 
            aria-label="Buscar preguntas frecuentes"
            placeholder="Buscar preguntas (ej. LLC, EIN, página web, impuestos, requisitos)..."
            class="w-full px-5 py-4 pl-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-accent focus:bg-white/15 transition-all text-base shadow-lg"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ CATEGORIES SECTION -->
  <section class="py-16 lg:py-24 bg-slate-50 min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3" id="category-filters">
        <button class="filter-btn active px-4 py-2 rounded-full text-sm font-semibold transition-all bg-brand-dark text-white shadow-sm" aria-pressed="true" data-category="all">
          Todas ({allFaqItems.length})
        </button>
        {faqCategories.map(cat => (
          <button class="filter-btn px-4 py-2 rounded-full text-sm font-semibold transition-all bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 shadow-sm" aria-pressed="false" data-category={cat.id}>
            {cat.name} ({cat.items.length})
          </button>
        ))}
      </div>

      <!-- FAQ Groups -->
      <div class="space-y-12" id="faq-container">
        {faqCategories.map(cat => (
          <div class="faq-category-group space-y-6" data-category-id={cat.id}>
            <div class="flex items-center gap-3 border-b border-slate-200 pb-3">
              <div class="p-2 rounded-xl bg-brand-primary/10 text-brand-primary">
                <Fragment set:html={cat.icon} />
              </div>
              <h2 class="text-2xl font-heading font-bold text-brand-dark">
                {cat.name}
              </h2>
            </div>

            <div class="space-y-4">
              {cat.items.map((item, idx) => (
                <details class="faq-item group bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow transition-all duration-200" open={cat.id === "formation" && idx === 0}>
                  <summary class="flex items-center justify-between cursor-pointer list-none select-none gap-4">
                    <h3 class="text-lg font-heading font-semibold text-brand-dark group-open:text-brand-primary transition-colors leading-snug">
                      {item.question}
                    </h3>
                    <span class="w-8 h-8 rounded-full bg-slate-50 border border-slate-200 flex-shrink-0 flex items-center justify-center text-slate-600 group-open:rotate-45 group-open:bg-brand-primary group-open:text-white transition-all text-xl font-light">
                      +
                    </span>
                  </summary>
                  <div class="pt-4 text-slate-600 text-base leading-relaxed border-t border-slate-100 mt-4">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- No Results Found State -->
      <div id="no-results" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
        <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <h3 class="text-xl font-heading font-bold text-brand-dark mb-2">No se encontraron preguntas</h3>
        <p class="text-slate-600 text-sm max-w-md mx-auto mb-6">
          ¿Tiene alguna duda específica que no encuentre aquí? Contáctenos y nuestro equipo bilingüe le responderá con gusto.
        </p>
        <a href={`/${lang}/contact`} class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold py-3 px-6 rounded-full hover:bg-brand-primary/90 transition-all text-sm shadow-sm">
          Hacer una Consulta
        </a>
      </div>

    </div>
  </section>

  <!-- STILL HAVE QUESTIONS CTA -->
  <section class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="inline-block px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider">
        Atención Personalizada
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-brand-dark leading-tight">
        ¿Aún Tiene Preguntas Sobre Su Negocio?
      </h2>
      <p class="text-slate-600 text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
        Cada negocio es único. Reserve una consulta personalizada con nuestros asesores bilingües para evaluar sus metas comerciales.
      </p>
      <div class="pt-4 flex flex-wrap justify-center gap-4">
        <a href={`/${lang}/contact`} class="inline-flex items-center justify-center bg-brand-dark text-white font-bold py-4 px-8 rounded-full hover:bg-slate-800 transition-colors text-base shadow-md">
          Reservar Consulta
        </a>
        <a href={`/${lang}/services`} class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-brand-dark font-semibold py-4 px-8 rounded-full transition-colors text-base">
          Ver Paquetes
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Interactive Search and Filtering
  const searchInput = document.getElementById('faq-search') as HTMLInputElement;
  const categoryButtons = document.querySelectorAll('.filter-btn');
  const categoryGroups = document.querySelectorAll('.faq-category-group');
  const faqItems = document.querySelectorAll('.faq-item');
  const noResults = document.getElementById('no-results');

  let activeCategory = 'all';

  function filterFaqs() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let visibleCount = 0;

    categoryGroups.forEach(group => {
      const groupId = group.getAttribute('data-category-id');
      const matchesCategory = activeCategory === 'all' || activeCategory === groupId;

      let groupHasVisibleItems = false;
      const groupItems = group.querySelectorAll('.faq-item');

      groupItems.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        const matchesSearch = text.includes(query);

        if (matchesCategory && matchesSearch) {
          (item as HTMLElement).style.display = '';
          groupHasVisibleItems = true;
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (groupHasVisibleItems) {
        (group as HTMLElement).style.display = '';
      } else {
        (group as HTMLElement).style.display = 'none';
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', filterFaqs);

  categoryButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach(b => {
        const isSelected = b === btn;
        b.classList.toggle('active', isSelected);
        b.classList.toggle('bg-brand-dark', isSelected);
        b.classList.toggle('text-white', isSelected);
        b.classList.toggle('bg-white', !isSelected);
        b.classList.toggle('text-slate-700', !isSelected);
        b.setAttribute('aria-pressed', String(isSelected));
      });

      activeCategory = btn.getAttribute('data-category') || 'all';
      filterFaqs();
    });
  });
</script>
