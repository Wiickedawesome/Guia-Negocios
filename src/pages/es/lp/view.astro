---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
---

<BaseLayout title="Página | Guia Negocios" description="Servicios empresariales para emprendedores hispanos.">
  <Header slot="header" />

  <!-- Loading State -->
  <div id="lp-loading-state" class="min-h-[60vh] flex flex-col items-center justify-center p-8 text-center bg-slate-50">
    <div class="w-12 h-12 border-4 border-brand-primary/20 border-t-brand-primary rounded-full animate-spin mb-4"></div>
    <p class="text-slate-600 font-medium text-lg">Cargando página...</p>
  </div>

  <!-- Error / Not Found State -->
  <div id="lp-not-found-state" class="hidden min-h-[60vh] flex flex-col items-center justify-center p-8 text-center max-w-lg mx-auto bg-slate-50">
    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-4 text-2xl font-bold">404</div>
    <h2 class="text-2xl font-bold text-slate-900 font-heading mb-2">Página no encontrada</h2>
    <p class="text-slate-600 mb-6">La página que está buscando no existe o aún no ha sido publicada.</p>
    <a href="/es/services" class="px-6 py-2.5 bg-brand-primary text-white font-medium rounded-lg hover:bg-opacity-95 transition-colors">
      ← Ver Nuestros Servicios
    </a>
  </div>

  <!-- Live Dynamic Landing Page Content -->
  <main id="lp-live-container" class="hidden min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div id="lp-content-body" class="max-w-6xl mx-auto space-y-6"></div>
  </main>

  <Footer slot="footer" />

  <script>
    import { db } from '../../../lib/firebase';
    import { collection, query, where, getDocs, doc, getDoc } from 'firebase/firestore';

    async function loadDynamicLandingPage() {
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      let slug = pathParts[pathParts.length - 1];
      if (slug === 'view' && pathParts.length > 2) {
        slug = pathParts[pathParts.length - 2];
      }
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('slug')) {
        slug = urlParams.get('slug')!;
      }

      if (!slug) {
        showNotFound();
        return;
      }

      try {
        const lpRef = collection(db, 'landingPages');
        let lpData: any = null;

        // Try direct docId: es_slug
        const docSnap = await getDoc(doc(db, 'landingPages', `es_${slug}`));
        if (docSnap.exists()) {
          lpData = docSnap.data();
        } else {
          // Query by slug field
          const q = query(lpRef, where('slug', '==', slug));
          const snap = await getDocs(q);
          if (!snap.empty) {
            lpData = snap.docs[0].data();
          }
        }

        if (!lpData) {
          showNotFound();
          return;
        }

        document.title = `${lpData.title || 'Guia Negocios'} | GUIA NEGOCIOS`;
        
        const contentBody = document.getElementById('lp-content-body')!;
        contentBody.innerHTML = lpData.content || '';

        document.getElementById('lp-loading-state')?.classList.add('hidden');
        document.getElementById('lp-live-container')?.classList.remove('hidden');

      } catch (err) {
        console.error("Error loading dynamic landing page:", err);
        showNotFound();
      }
    }

    function showNotFound() {
      document.getElementById('lp-loading-state')?.classList.add('hidden');
      document.getElementById('lp-not-found-state')?.classList.remove('hidden');
    }

    document.addEventListener('DOMContentLoaded', loadDynamicLandingPage);
  </script>
</BaseLayout>
