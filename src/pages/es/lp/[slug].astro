---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAdminDb } from '../../../utils/admin-db';
import { stripEditorAttributes } from '../../../utils/sanitize-landing-html';
import { db } from '../../../lib/firebase';
import { collection, getDocs, query, where } from 'firebase/firestore';

export async function getStaticPaths() {
  // Build runs in Node, where the client SDK cannot obtain an App Check token,
  // so the Admin SDK is preferred. The client SDK is the fallback for
  // environments that only supply an App Check debug token.
  // Prefer the Admin SDK (no App Check token needed); fall back to the client
  // SDK, which works when APP_CHECK_DEBUG_TOKEN is configured (as CI does).
  let docs: any[] | null = null;

  try {
    const adminDb = getAdminDb();
    if (adminDb) {
      const snapshot = await adminDb.collection('landingPages').where('lang', '==', 'es').get();
      docs = snapshot.docs;
    }
  } catch (adminErr: any) {
    console.warn(`[lp] Admin SDK read failed, falling back to client SDK: ${adminErr?.message || adminErr}`);
  }

  if (docs === null) {
    try {
      const snapshot = await getDocs(query(collection(db, 'landingPages'), where('lang', '==', 'es')));
      docs = snapshot.docs;
    } catch (err: any) {
      // Both paths failed. Emitting only the empty fallback would silently
      // delete every landing page URL from the deployed site, so fail instead.
      throw new Error(`Could not load ES landing pages at build time: ${err?.message || err}`);
    }
  }

  // Slugs that also exist in English, so the language switcher and the
  // hreflang alternates only ever point at a page that is actually built.
  // Failure keeps the set empty, which falls back safely.
  let enSlugs = new Set<string>();
  try {
    const adminDb = getAdminDb();
    const enSnap = adminDb
      ? await adminDb.collection('landingPages').where('lang', '==', 'en').get()
      : await getDocs(query(collection(db, 'landingPages'), where('lang', '==', 'en')));
    enSlugs = new Set(
      enSnap.docs.map((d: any) => d.data()?.slug).filter((s: any) => typeof s === 'string')
    );
  } catch (enErr: any) {
    console.warn(`[lp] EN twin check failed; the language switch will fall back: ${enErr?.message || enErr}`);
  }

  const pages = docs
    .map((doc: any) => doc.data())
    .filter((lp: any) => typeof lp?.slug === 'string' && lp.slug.trim().length > 0);

  if (pages.length === 0) {
    return [{ params: { slug: 'empty' }, props: { lp: null, hasEnTwin: false } }];
  }

  return pages.map((lp: any) => ({
    params: { slug: lp.slug },
    props: { lp, hasEnTwin: enSlugs.has(lp.slug) },
  }));
}

const { slug } = Astro.params;
const { lp, hasEnTwin } = Astro.props;

if (!lp) {
  return Astro.redirect('/es/404');
}
---

<BaseLayout title={`${lp.title} | GUIA NEGOCIOS`} description={lp.metaDesc || ''} ogImage={lp.ogImage || ''} noAlternate={!hasEnTwin}>
  <Header slot="header" altPath={hasEnTwin ? `/en/lp/${slug}/` : '/en/contact/'} />
  
  <div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="landing-page-content max-w-6xl mx-auto space-y-6" set:html={stripEditorAttributes(lp.content)} />
  </div>

  <script>
    // Landing-page forms live in raw HTML stored in Firestore, so lead capture
    // is attached here instead of in the markup. See src/scripts/lp-lead-form.ts.
    import { initLandingPageLeadForms } from '../../../scripts/lp-lead-form';
    initLandingPageLeadForms();
  </script>

  <Footer slot="footer" />
</BaseLayout>
