---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { db } from '../../../lib/firebase';
import { collection, getDocs, query, where } from 'firebase/firestore';

export async function getStaticPaths() {
  try {
    const snapshot = await getDocs(query(collection(db, 'landingPages'), where('lang', '==', 'es')));
    
    if (snapshot.empty) {
      return [{ params: { slug: 'empty' }, props: { lp: null } }];
    }

    return snapshot.docs.map(doc => {
      const data = doc.data();
      return {
        params: { slug: data.slug },
        props: { lp: data }
      };
    });
  } catch (err) {
    console.warn("Could not load ES landing pages at build time:", err);
    return [{ params: { slug: 'empty' }, props: { lp: null } }];
  }
}

const { slug } = Astro.params;
const { lp } = Astro.props;

if (!lp) {
  // Fallback for empty DB
  return Astro.redirect('/es/404');
}
---

<BaseLayout title={`${lp.title} | GUIA NEGOCIOS`} description={lp.metaDesc || ''}>
  <Header slot="header" />
  
  <main class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="landing-page-content max-w-6xl mx-auto space-y-6" set:html={lp.content} />
  </main>

  <Footer slot="footer" />
</BaseLayout>
