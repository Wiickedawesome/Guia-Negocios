---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import knoxvilleImg from '../../assets/images/Knoxvillehorizontal.webp';
import favImg from '../../assets/images/GuiaNegociosFAV.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`Quiénes Somos | Guia Negocios — Knoxville TN`} description="Conozca la misión, visión, valores y el proceso de consultoría empresarial de Guia Negocios en Knoxville, TN." ogImage="/images/og/og-about.png">
  <Header slot="header" />
  
  <!-- SECTION 1: Hero -->
  <section class="pt-16 pb-14 lg:pt-20 lg:pb-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Sobre Nosotros</span>
      <h1 class="mt-6 max-w-4xl text-4xl sm:text-5xl lg:text-6xl font-heading text-brand-dark font-semibold leading-[1.05] tracking-tight">
        Ayudamos a Emprendedores y Pequeñas Empresas a Lanzar, Organizarse y Escalar
      </h1>
      <p class="mt-8 max-w-2xl text-slate-600 text-base lg:text-lg leading-relaxed">
        Guia Negocios brinda consultoría de negocios bilingüe práctica en Knoxville y el Este de Tennessee, guiándolo paso a paso desde la idea inicial hasta el éxito comercial.
      </p>
    </div>
  </section>

  <!-- SECTION 2: Knoxville Banner -->
  <section class="bg-slate-200">
    <Image src={knoxvilleImg} alt="Knoxville, Tennessee" widths={[800, 1600, 2000]} sizes="100vw" class="w-full h-[240px] sm:h-[380px] lg:h-[460px] object-cover object-center" loading="eager" fetchpriority="high" decoding="async" />
  </section>

  <!-- SECTION 3: Quiénes Somos -->
  <section class="py-16 lg:py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary mb-10">Quiénes Somos</span>
      <div class="grid grid-cols-1 md:grid-cols-2 md:divide-x md:divide-slate-200 gap-y-10 md:gap-y-0">
        <div class="space-y-4 md:pr-10 lg:pr-14">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark">
            Enfocados en los Objetivos
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Nuestra misión es ayudar a los pequeños empresarios y dueños de negocios en el este de Tennessee a lanzar, organizar y crecer con un apoyo bilingüe que se sienta claro, práctico y personal. Guiamos a los clientes desde la idea hasta el lanzamiento, desde el lanzamiento hasta la visibilidad, y desde la visibilidad hasta operaciones diarias más sólidas.
          </p>
        </div>
        <div class="space-y-4 md:pl-10 lg:pl-14">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark">
            Orientación Práctica
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            No solo explicamos los pasos, caminamos con usted. Le ayudamos a organizar documentos, crear sitios web profesionales, configurar la contabilidad, dar formato a plantillas de facturas y establecer sistemas operativos que realmente pueda ejecutar con confianza.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: Nuestra Misión & Nuestra Visión -->
  <section class="py-16 lg:py-20 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 md:divide-x md:divide-white/20 gap-y-12 md:gap-y-0">
        <div class="space-y-4 md:pr-10 lg:pr-14">
          <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-accent">Nuestra Misión</span>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-semibold">
            Inspirar, Innovar y Empoderar
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Cada emprendedor cuenta con el talento, la disciplina y la ambición para construir empresas prósperas. Eliminamos las barreras del idioma y la complejidad burocrática para que pueda lanzarse con absoluta claridad y confianza.
          </p>
        </div>
        <div class="space-y-4 md:pl-10 lg:pl-14">
          <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-accent">Nuestra Visión</span>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-semibold">
            Enfocados en el Éxito de la Comunidad
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Visualizamos una comunidad empresarial sólida e interconectada en Knoxville donde cada emprendedor tenga acceso inmediato a la formalización profesional de negocios, marketing confiable y herramientas operativas prácticas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: Benefits of Working With Us -->
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
        <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Por qué Elegirnos</span>
        <h2 class="text-3xl sm:text-4xl font-heading text-brand-dark font-semibold">
          Los Beneficios de Trabajar Con Nosotros
        </h2>
        <p class="text-slate-600 text-base">
          Por qué los dueños de negocios de habla hispana confían en Guia Negocios para manejar el lanzamiento de sus negocios.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 md:divide-x md:divide-slate-200 gap-y-12 md:gap-y-0">

        <div class="space-y-6 md:px-8 md:first:pl-0 md:last:pr-0">
          <div class="flex items-center gap-3 text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m0 2.25c0 3.864-1.92 7.27-4.876 9.35" /></svg>
            <span aria-hidden="true" class="h-px flex-1 bg-slate-200"></span>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-2">Apoyo 100% Bilingüe</h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              Cada paso explicado en español e inglés claro para que nunca se quede adivinando qué significa un formulario o contrato.
            </p>
          </div>
        </div>

        <div class="space-y-6 md:px-8 md:first:pl-0 md:last:pr-0">
          <div class="flex items-center gap-3 text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766l5.214-1.564a.89.89 0 00.603-1.096l-.888-2.665a.89.89 0 00-1.096-.603l-5.214 1.564a2.653 2.653 0 00-1.564 1.208l-1.564 5.214a.89.89 0 00.603 1.096l2.665.888a.89.89 0 001.096-.603z" /></svg>
            <span aria-hidden="true" class="h-px flex-1 bg-slate-200"></span>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-2">Implementación Práctica</h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              No solo damos consejos, construimos su sitio, diseñamos logos, configuramos herramientas de reserva y damos formato a plantillas de facturas.
            </p>
          </div>
        </div>

        <div class="space-y-6 md:px-8 md:first:pl-0 md:last:pr-0">
          <div class="flex items-center gap-3 text-brand-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
            <span aria-hidden="true" class="h-px flex-1 bg-slate-200"></span>
          </div>
          <div>
            <h3 class="text-xl font-heading text-brand-dark font-semibold mb-2">Raíces Locales en Knoxville</h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              Arraigados en el condado de Knox y el este de Tennessee, brindamos servicios de notario público bilingüe directo y conexiones de recursos de la comunidad local.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Legal Disclaimer Banner -->
  <section class="py-12 bg-slate-100 border-t border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs text-slate-500 italic leading-relaxed">
        "Guia Negocios proporciona educación comercial general y apoyo de consultoría. No somos abogados, contadores ni asesores financieros con licencia. Para obtener asesoramiento legal, fiscal o financiero, consulte a un profesional con licencia."
      </p>
    </div>
  </section>

  <!-- SECTION 6: Let's Talk CTA -->
  <section class="py-24 lg:py-32 bg-slate-100 border-t border-slate-200 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-12 relative z-10">
      <div class="max-w-2xl space-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-semibold leading-tight text-brand-dark">
          ¡Hablemos sobre sus Metas de Negocio!
        </h2>
        <p class="text-lg text-slate-600 max-w-xl">
          Siempre estamos abiertos a discutir su proyecto de negocio, mejorar su presencia en línea y organizar sus operaciones.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a href={`/${lang}/contact`} class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold py-4 px-8 rounded-full hover:bg-brand-primary/90 transition-all text-lg gap-2">
            Programe una Llamada
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
      <div class="w-full lg:w-auto flex-shrink-0 flex justify-center">
        <Image src={favImg} alt="Guia Negocios Logo" class="w-full max-w-xs md:max-w-sm mx-auto drop-shadow-xl" loading="lazy" />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
