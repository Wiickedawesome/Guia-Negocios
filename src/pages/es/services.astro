  <!-- Custom Service Banner (original layout, dark band background) -->
  <section class="py-14 bg-brand-dark">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 text-brand-accent text-xs font-bold uppercase tracking-wider">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            Trabajos Personalizados y Peticiones Especiales
          </div>
          <h3 class="text-2xl font-heading text-white font-semibold">
            ¿No ve el servicio específico que necesita?
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Proporcionamos consultoría empresarial personalizada, asistencia de documentos a medida, apoyo bilingüe y soluciones digitales a medida para pequeñas empresas. Contáctenos hoy para discutir su proyecto específico.
          </p>
        </div>
        <div class="flex-shrink-0 w-full md:w-auto">
          <a href={`/${lang}/contact`} class="block w-full md:w-auto text-center bg-brand-accent hover:bg-yellow-300 text-brand-dark font-bold py-3.5 px-6 rounded-full transition-colors text-base">
            Solicitar Servicio Personalizado
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: FAQ Accordion (Figma Node 86:77 style) -->
  <FaqAccordion
    title={t('services.faqTitle')}
    contactText={t('services.faqContactText')}
    contactUrl={`/${lang}/contact`}
    viewMoreText={t('services.faqViewAll')}
    viewMoreUrl={`/${lang}/faq`}
    items={faqItems}
  />

  <!-- SECTION 5: Full-Width Call to Action -->
  <section class="py-24 lg:py-32 bg-slate-100 border-t border-slate-200 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-12 relative z-10">
      <div class="max-w-2xl space-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-semibold leading-tight text-brand-dark">
          ¿Emocionado por trabajar juntos en su próximo proyecto?
        </h2>
        <p class="text-lg text-slate-600 max-w-xl">
          ¿Listo para convertir su idea de negocio en realidad? Deje que nuestros expertos bilingües le guíen en cada paso de su viaje empresarial.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a href={`/${lang}/contact`} class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold py-4 px-8 rounded-full hover:bg-brand-primary/90 transition-all text-lg gap-2">
            Póngase en contacto
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href={`/${lang}/services`} class="inline-flex items-center justify-center bg-white border border-slate-300 text-brand-dark font-medium py-4 px-8 rounded-full hover:bg-slate-50 transition-colors text-lg">
            Saber más
          </a>
        </div>
      </div>
      <div class="w-full lg:w-auto flex-shrink-0 flex justify-center">
        <Image src={favImg} alt="Ilustración de llamada a la acción" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 400px" class="w-full max-w-xs md:max-w-sm mx-auto drop-shadow-xl" loading="lazy" />
      </div>
    </div>
  </section>

  <LegalDisclaimer />

  <Footer slot="footer" />
</BaseLayout>
