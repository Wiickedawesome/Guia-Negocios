            <div class="group flex items-start gap-3 py-4 px-4 -mx-4 border-b border-slate-100 last:border-0 last:pb-0 transition-colors duration-300 hover:bg-brand-primary">
              <div class="flex-shrink-0 pt-0.5 text-brand-primary/70 transition-colors duration-300 group-hover:text-brand-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div class="space-y-1">
                <h4 class="text-base font-heading font-semibold text-brand-dark leading-snug transition-colors duration-300 group-hover:text-white">Orientación Financiera</h4>
