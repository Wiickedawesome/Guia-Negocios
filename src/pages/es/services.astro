---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import launchHeroImg from '../../assets/images/LaunchHERO-Resized.webp';
import favImg from '../../assets/images/GuiaNegociosFAV.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// FAQ data matching business consulting questions
const faqItems = [
  {
    number: "01",
    question: "¿Qué incluye la asistencia para la configuración de LLC y EIN?",
    answer: "Le guiamos paso a paso a través de la disponibilidad de nombres para el registro de LLC en Tennessee, instrucciones de presentación, soporte para la solicitud de EIN del IRS, una plantilla de acuerdo operativo y una lista de verificación para cuentas bancarias comerciales."
  },
  {
    number: "02",
    question: "¿Cuánto tiempo toma el proceso de configuración del negocio?",
    answer: "Los servicios iniciales típicamente toman de 3 a 10 días hábiles. Los paquetes base toman de 1 a 3 semanas, Branding y Marketing de 2 a 4 semanas, y los Paquetes Completos de Lanzamiento toman de 4 a 10 semanas dependiendo de la preparación del cliente."
  },
  {
    number: "03",
    question: "¿Ofrecen soporte bilingüe completo en español e inglés?",
    answer: "¡Sí! Todas nuestras sesiones de consultoría, documentación, listas de verificación, plantillas y comunicaciones son completamente bilingües en inglés y español para que pueda tomar decisiones cómodamente."
  },
  {
    number: "04",
    question: "¿Puedo comenzar con un servicio y actualizar a un paquete más adelante?",
    answer: "Absolutamente. Muchos clientes comienzan con un Servicio Inicial o Paquete Base único y avanzan hacia Branding, Configuración de Sitio Web o soporte continuo de CreedaVA a medida que su negocio crece."
  },
  {
    number: "05",
    question: "¿Cómo funcionan los términos de pago para los paquetes?",
    answer: "El trabajo comienza después de una llamada inicial de descubrimiento, un acuerdo de servicio firmado y un depósito. Los proyectos generalmente requieren un depósito del 50% con los hitos restantes o el saldo final al finalizar."
  }
];
---

<BaseLayout title={`${t('services.title')} | ${t('site.title')}`} description={t('services.metaDescription')}>
  <Header slot="header" />
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  })} />
  
  <!-- Redesigned Image-Free Services Hero Section -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-brand-dark font-extrabold leading-tight">
        Paquetes Bilingües de Lanzamiento y Crecimiento
      </h1>
      <p class="text-slate-600 text-lg lg:text-xl leading-relaxed max-w-3xl mx-auto">
        Apoyo práctico en inglés y español para llevar su negocio desde el concepto hasta el lanzamiento oficial, visibilidad en el mercado y operaciones escalables.
      </p>
      
      <!-- Feature Highlights Bar -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs font-bold text-slate-700">
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl shadow-sm">
          <span class="text-brand-primary font-bold">✓</span> Apoyo 100% Bilingüe
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl shadow-sm">
          <span class="text-brand-primary font-bold">✓</span> Ejecución Práctica
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 px-4 py-2.5 rounded-2xl shadow-sm">
          <span class="text-brand-primary font-bold">✓</span> Enfoque Local en Knoxville TN
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: Core Launch Packages (Figma 4-Card Layout & Expanded PDF Deliverables) -->
  <section class="py-20 bg-white">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-sm font-medium tracking-wide mb-2">Tiers 01 – 04</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading text-brand-dark leading-tight">
          {t('services.coreHeading')}
        </h2>
        <p class="text-slate-600 text-lg">
          Paquetes esenciales diseñados para registrar, estructurar y lanzar su negocio con confianza.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8 items-stretch pt-4">
        
        <!-- Tier 1: Starter Services -->
        <div class="bg-white border border-slate-200/80 rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-600 text-xs font-semibold tracking-wide mb-3">Tier 01</span>
              <h3 class="text-2xl font-heading text-brand-dark font-bold leading-snug min-h-[3.5rem] flex items-end">{t('services.tier1.name')}</h3>
              <div class="pt-4 pb-3 border-b border-slate-100">
                <div class="text-3xl xl:text-4xl font-extrabold text-brand-primary tracking-tight">{t('services.tier1.price')}</div>
                <div class="text-xs font-medium text-slate-400 mt-1">{t('services.tier1.range')}</div>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier1.description')}</p>
            <ul class="space-y-4 text-sm text-slate-700 pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Guía de estructura empresarial (LLC vs. Sole Prop vs. S-Corp)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Registro de LLC en TN y asistencia con solicitud de EIN del IRS</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Plantilla de Acuerdo Operativo y lista de verificación bancaria</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Plan de negocio básico de 1 página y resumen de precios</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Configuración básica de contabilidad (ingresos, gastos, impuestos)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">+</span>
                <span class="text-slate-600 text-sm leading-relaxed font-medium">... y mucho más</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-dark hover:bg-slate-800 text-white font-semibold py-4 px-6 rounded-2xl transition-all text-base shadow-sm hover:shadow">
              Empezar
            </a>
          </div>
        </div>

        <!-- Tier 2: Foundation Package -->
        <div class="bg-white border border-slate-200/80 rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-600 text-xs font-semibold tracking-wide mb-3">Tier 02</span>
              <h3 class="text-2xl font-heading text-brand-dark font-bold leading-snug min-h-[3.5rem] flex items-end">{t('services.tier2.name')}</h3>
              <div class="pt-4 pb-3 border-b border-slate-100">
                <div class="text-3xl xl:text-4xl font-extrabold text-brand-primary tracking-tight">{t('services.tier2.price')}</div>
                <div class="text-xs font-medium text-slate-400 mt-1">Base Administrativa Completa</div>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier2.description')}</p>
            <ul class="space-y-4 text-sm text-slate-700 pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Hoja de ruta de estructura empresarial y configuración de entidad</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Lista de verificación de cumplimiento (licencias, reportes anuales, seguros)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Configuración completa de contabilidad (categorías, impuestos, retiros de dueños)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Sesión de estrategia de precios 1 a 1</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">+</span>
                <span class="text-slate-600 text-sm leading-relaxed font-medium">... y mucho más</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-dark hover:bg-slate-800 text-white font-semibold py-4 px-6 rounded-2xl transition-all text-base shadow-sm hover:shadow">
              Empezar
            </a>
          </div>
        </div>

        <!-- Tier 3: Brand & Marketing Setup (FEATURED CARD) -->
        <div class="bg-brand-dark rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-2xl text-white relative border-2 border-brand-accent transform lg:-translate-y-3 lg:scale-[1.02] transition-all duration-300">
          <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-brand-accent text-brand-dark text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-md">
            Más Popular
          </span>
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-brand-accent text-xs font-semibold tracking-wide mb-3">Tier 03</span>
              <h3 class="text-2xl font-heading text-white font-bold leading-snug min-h-[3.5rem] flex items-end">{t('services.tier3.name')}</h3>
              <div class="pt-4 pb-3 border-b border-white/10">
                <div class="text-3xl xl:text-4xl font-extrabold text-brand-accent tracking-tight">{t('services.tier3.price')}</div>
                <div class="text-xs font-medium text-slate-300 mt-1">Sistema de Marketing y Marca</div>
              </div>
            </div>
            <p class="text-slate-200 text-sm leading-relaxed opacity-90">{t('services.tier3.description')}</p>
            <ul class="space-y-4 text-sm text-white pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Guía de logo, paleta de colores y Kit de Marca sencillo</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Optimización de Facebook, Instagram y Google Business</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Configuración de WhatsApp Business (catálogo, saludo, respuestas rápidas)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">✓</span>
                <span class="text-slate-100 text-sm leading-relaxed">Plantillas de Canva y calendario de contenido inicial</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-accent text-brand-dark flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5 shadow-sm">+</span>
                <span class="text-slate-100 text-sm leading-relaxed font-medium">... y mucho más</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-accent hover:bg-yellow-300 text-brand-dark font-bold py-4 px-6 rounded-2xl shadow-md text-base transition-all">
              Empezar
            </a>
          </div>
        </div>

        <!-- Tier 4: Website Setup -->
        <div class="bg-white border border-slate-200/80 rounded-[2.5rem] p-8 xl:p-9 flex flex-col justify-between shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300">
          <div class="space-y-6 flex-1 flex flex-col">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-slate-100 border border-slate-200/60 text-slate-600 text-xs font-semibold tracking-wide mb-3">Tier 04</span>
              <h3 class="text-2xl font-heading text-brand-dark font-bold leading-snug min-h-[3.5rem] flex items-end">{t('services.tier4.name')}</h3>
              <div class="pt-4 pb-3 border-b border-slate-100">
                <div class="text-3xl xl:text-4xl font-extrabold text-brand-primary tracking-tight">{t('services.tier4.price')}</div>
                <div class="text-xs font-medium text-slate-400 mt-1">Presencia Digital</div>
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{t('services.tier4.description')}</p>
            <ul class="space-y-4 text-sm text-slate-700 pt-2 flex-1">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Selección de plataforma y planificación de estrategia digital</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Construcción de sitio web profesional personalizado de múltiples páginas</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">Formulario de contacto, solicitud de presupuesto e integración de WhatsApp</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">✓</span>
                <span class="text-slate-600 text-sm leading-relaxed">SEO local y conexión a Google Search Console</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex-shrink-0 flex items-center justify-center text-xs font-bold mt-0.5">+</span>
                <span class="text-slate-600 text-sm leading-relaxed font-medium">... y mucho más</span>
              </li>
            </ul>
          </div>
          <div class="pt-8 mt-auto">
            <a href={`/${lang}/contact`} class="block w-full text-center bg-brand-dark hover:bg-slate-800 text-white font-semibold py-4 px-6 rounded-2xl transition-all text-base shadow-sm hover:shadow">
              Empezar
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SECTION 2: Advanced Growth & Launch Bundles (Onyx Content Cards Layout) -->
  <section class="py-20 lg:py-28 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200/60 border border-slate-300 text-slate-700 text-sm font-medium tracking-wide mb-2">Tiers 05 – 07</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading text-brand-dark leading-tight">
          {t('services.advancedHeading')}
        </h2>
        <p class="text-lg text-slate-600">
          Paquetes de implementación integrales diseñados para escalar sus operaciones, lanzar su marca y brindar apoyo continuo.
        </p>
      </div>

      <!-- Onyx Main Featured Content Card (Tier 06) -->
      <div class="bg-white border border-slate-200 rounded-3xl p-8 lg:p-12 shadow-lg mb-12 hover:shadow-xl transition-all duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
          <div class="lg:col-span-6 overflow-hidden rounded-2xl bg-slate-100 border border-slate-200 relative lg:h-full min-h-[400px]">
            <Image src={launchHeroImg} alt="Complete Business Launch Bundle" class="w-full h-full object-cover lg:absolute lg:inset-0" loading="lazy" decoding="async" />
          </div>
          <div class="lg:col-span-6 space-y-6 self-center py-6">
            <div class="inline-flex items-center gap-2 bg-brand-accent/30 text-brand-dark px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-dark" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              {t('services.tier6.badge')}
            </div>
            <h3 class="text-3xl sm:text-4xl font-heading text-brand-dark font-semibold leading-tight">
              {t('services.tier6.name')}
            </h3>
            <div class="text-3xl font-bold text-brand-primary">
              {t('services.tier6.price')}
            </div>
            <p class="text-slate-600 leading-relaxed text-base">
              {t('services.tier6.description')}
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-700 pt-2">
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Toda la Configuración Básica
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Kit de Marca y Marketing
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Sitio Web Profesional
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Operaciones y Facturación
              </li>
              <li class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-brand-primary text-white flex-shrink-0 flex items-center justify-center text-xs font-bold">✓</span> Plantillas y Guiones
