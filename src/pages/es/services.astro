            <div class="group flex items-start gap-3 py-4 px-4 -mx-4 border-b border-slate-100 last:border-0 last:pb-0 transition-colors duration-300 hover:bg-brand-primary">
              <div class="flex-shrink-0 pt-0.5 text-brand-primary/70 transition-colors duration-300 group-hover:text-brand-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.125 2.25h-4.5c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125v-9M10.125 2.25h.375a9 9 0 019 9v.375M10.125 2.25A3.375 3.375 0 0113.5 5.625v1.5c0 .621.504 1.125 1.125 1.125h1.5a3.375 3.375 0 013.375 3.375M9 15l2.25 2.25L15 12" /></svg>
