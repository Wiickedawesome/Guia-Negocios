---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getBlogPosts, formatDate } from '../../utils/blog';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getBlogPosts('es');
---

<BaseLayout title={`${t('blog.title')} | ${t('site.title')}`} description={t('site.description')} ogImage="/images/og/og-blog.png">
  <Header slot="header" />
  
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-brand-dark font-semibold mb-4">
        {t('blog.title')}
      </h1>
      <p class="text-lg lg:text-xl text-slate-600 max-w-3xl mx-auto">
        Consejos, sugerencias y noticias comerciales para empresarios en el este de Tennessee.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/${lang}/blog/${post.slug}`} class="group flex flex-col bg-white border border-slate-200 rounded-3xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class="w-full h-48 relative overflow-hidden">
              <img src={post.featuredImage} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              {post.tags.length > 0 && (
                <div class="absolute top-4 left-4">
                  <span class="text-xs bg-white text-brand-primary px-3 py-1 rounded-full font-bold shadow-sm uppercase tracking-wider">
                    {post.tags[0]}
                  </span>
                </div>
              )}
            </div>
            
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3 font-medium">
                <time>{formatDate(post.date, 'es')}</time>
                <span>•</span>
                <span>{post.readTime} MIN LECTURA</span>
              </div>
              
              <h2 class="text-xl font-heading text-brand-dark mb-3 group-hover:text-brand-primary transition-colors leading-snug">
                {post.title}
              </h2>
              
              <p class="text-slate-600 mb-6 leading-relaxed flex-1 text-sm line-clamp-3">
                {post.excerpt}
              </p>
              
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100">
                <div class="flex items-center gap-2">
                  <img src={post.authorAvatar} alt={post.author} class="w-6 h-6 rounded-full object-cover" loading="lazy" decoding="async" />
                  <span class="text-xs font-bold text-slate-700">{post.author}</span>
                </div>
                <span class="text-brand-primary font-bold text-sm flex items-center gap-1 group-hover:underline">
                  {t('blog.readMore')} <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
