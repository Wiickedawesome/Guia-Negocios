---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getBlogPosts, formatDate } from '../../utils/blog';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getBlogPosts('es');
---

<BaseLayout title={`${t('blog.title')} | ${t('site.title')}`} description="Guías empresariales completas, estrategias fiscales, registro de LLC y asesoría de licencias para empresarios hispanos en Tennessee." ogImage="/images/og/og-blog.png">
  <Header slot="header" />
  
  <!-- Hero Section with Rich Educational Intro -->
  <section class="py-16 lg:py-20 bg-gradient-to-b from-slate-50 to-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-4 inline-block">
        Centro de Conocimiento y Artículos
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-brand-dark font-extrabold mb-4 leading-tight">
        Guías y Recursos Estratégicos para Negocios en Tennessee
      </h1>
      <p class="text-lg lg:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Análisis experto, requisitos legales, cumplimiento con el IRS y asesoría práctica para fundar y hacer crecer su empresa en Knoxville y el este de Tennessee.
      </p>
    </div>
  </section>

  <!-- Published Articles Grid with Modern Search Bar on the Right -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-4 border-b border-slate-100">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 font-heading">Últimos Artículos Publicados</h2>
          <p class="text-sm text-slate-500">Explore nuestras guías más recientes y novedades regulatorias.</p>
        </div>

        <!-- Simple Modern Search Bar on the Right -->
        <div class="relative w-full sm:w-72 md:w-80 shrink-0">
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            id="blog-search-input" 
            type="text" 
            placeholder="Buscar artículos..." 
            class="w-full bg-slate-50 hover:bg-slate-100/80 focus:bg-white border border-slate-200 rounded-full pl-10 pr-9 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary transition-all shadow-xs" 
            autocomplete="off"
          />
          <button id="search-clear-btn" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-0.5" title="Limpiar">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <div id="blog-articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article 
            class="blog-card group flex flex-col bg-white border border-slate-200 rounded-3xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
            data-title={post.title.toLowerCase()}
            data-excerpt={post.excerpt.toLowerCase()}
            data-tags={post.tags.join(',').toLowerCase()}
          >
            <a href={`/${lang}/blog/${post.slug}`} class="block w-full h-48 relative overflow-hidden">
              <img src={post.featuredImage} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              {post.tags.length > 0 && (
                <div class="absolute top-4 left-4">
                  <span class="text-xs bg-white text-brand-primary px-3 py-1 rounded-full font-bold shadow-sm uppercase tracking-wider">
                    {post.tags[0]}
                  </span>
                </div>
              )}
            </a>
            
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3 font-medium">
                <time>{formatDate(post.date, 'es')}</time>
                <span>•</span>
                <span>{post.readTime} MIN LECTURA</span>
              </div>
              
              <h3 class="text-xl font-heading text-brand-dark mb-3 group-hover:text-brand-primary transition-colors leading-snug font-bold">
                <a href={`/${lang}/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>
              
              <p class="text-slate-600 mb-6 leading-relaxed flex-1 text-sm line-clamp-3">
                {post.excerpt}
              </p>
              
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100">
                <div class="flex items-center gap-2">
                  <img src={post.authorAvatar} alt={post.author} class="w-6 h-6 rounded-full object-cover" loading="lazy" decoding="async" />
                  <span class="text-xs font-bold text-slate-700">{post.author}</span>
                </div>
                <a href={`/${lang}/blog/${post.slug}`} class="text-brand-primary font-bold text-sm flex items-center gap-1 group-hover:underline">
                  {t('blog.readMore')} <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-articles-found" class="hidden py-16 text-center max-w-md mx-auto">
        <p class="text-base font-medium text-slate-600 mb-3">No se encontraron artículos que coincidan con la búsqueda.</p>
        <button type="button" id="clear-search-empty-btn" class="text-sm font-bold text-brand-primary hover:underline cursor-pointer">
          Limpiar búsqueda
        </button>
      </div>
    </div>
  </section>

  <!-- Client-side Instant Search -->
  <script>
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement;
    const noResults = document.getElementById('no-articles-found');
    const emptyClearBtn = document.getElementById('clear-search-empty-btn');
    const grid = document.getElementById('blog-articles-grid');

    function applyFilter() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.blog-card') as NodeListOf<HTMLElement>;
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const excerpt = card.getAttribute('data-excerpt') || '';
        const tags = card.getAttribute('data-tags') || '';
        const matches = !q || title.includes(q) || excerpt.includes(q) || tags.includes(q);

        if (matches) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (clearBtn) {
        if (q) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }

      if (noResults && grid) {
        if (visibleCount === 0) {
          grid.classList.add('hidden');
          noResults.classList.remove('hidden');
        } else {
          grid.classList.remove('hidden');
          noResults.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', applyFilter);

    function clearSearch() {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
      }
      applyFilter();
    }

    clearBtn?.addEventListener('click', clearSearch);
    emptyClearBtn?.addEventListener('click', clearSearch);
  </script>

  <!-- Editorial Advisory Callout -->
  <section class="py-14 bg-brand-dark text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold">¿Necesita Asesoría Personalizada para su Negocio?</h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Nuestros consultores bilingües le guían en la creación de su LLC, licencias comerciales, contabilidad con ITIN y expansión en Tennessee.
      </p>
      <div class="pt-2">
        <a href="/es/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-primary hover:bg-emerald-900 text-white font-bold rounded-xl shadow-sm transition-colors text-sm">
          <span>Solicitar Consulta Gratuita</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

