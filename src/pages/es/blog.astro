---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getBlogPosts, formatDate } from '../../utils/blog';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getBlogPosts('es');
---

<BaseLayout title={`${t('blog.title')} | ${t('site.title')}`} description="Guías empresariales completas, estrategias fiscales, registro de LLC y asesoría de licencias para empresarios hispanos en Tennessee." ogImage="/images/og/og-blog.png">
  <Header slot="header" />
  
  <!-- Hero Section with Rich Educational Intro -->
  <section class="py-16 lg:py-20 bg-gradient-to-b from-slate-50 to-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-4 inline-block">
        Centro de Conocimiento y Artículos
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-brand-dark font-extrabold mb-4 leading-tight">
        Guías y Recursos Estratégicos para Negocios en Tennessee
      </h1>
      <p class="text-lg lg:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Análisis experto, requisitos legales, cumplimiento con el IRS y asesoría práctica para fundar y hacer crecer su empresa en Knoxville y el este de Tennessee.
      </p>
    </div>
  </section>

  <!-- Topical Pillar Highlights -->
  <section class="py-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-brand-primary flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1">Registro de LLC</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Trámites ante la Secretaría de Estado de TN, obtención de EIN y redacción de acuerdos operativos.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1">Impuestos y Contabilidad</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Declaraciones fiscales ante el IRS, contabilidad mensual, uso de ITIN y deducciones legales.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1">Licencias y Permisos</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Licencias de contratista general, registros del condado de Knox y pólizas de seguro comercial.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-base mb-1">Crecimiento y Operaciones</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Contratos en inglés/español, facturación formal y estrategias de captación de clientes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Published Articles Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-100">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 font-heading">Últimos Artículos Publicados</h2>
          <p class="text-sm text-slate-500">Explore nuestras guías más recientes y novedades regulatorias.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/${lang}/blog/${post.slug}`} class="group flex flex-col bg-white border border-slate-200 rounded-3xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class="w-full h-48 relative overflow-hidden">
              <img src={post.featuredImage} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
              {post.tags.length > 0 && (
                <div class="absolute top-4 left-4">
                  <span class="text-xs bg-white text-brand-primary px-3 py-1 rounded-full font-bold shadow-sm uppercase tracking-wider">
                    {post.tags[0]}
                  </span>
                </div>
              )}
            </div>
            
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3 font-medium">
                <time>{formatDate(post.date, 'es')}</time>
                <span>•</span>
                <span>{post.readTime} MIN LECTURA</span>
              </div>
              
              <h3 class="text-xl font-heading text-brand-dark mb-3 group-hover:text-brand-primary transition-colors leading-snug font-bold">
                {post.title}
              </h3>
              
              <p class="text-slate-600 mb-6 leading-relaxed flex-1 text-sm line-clamp-3">
                {post.excerpt}
              </p>
              
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100">
                <div class="flex items-center gap-2">
                  <img src={post.authorAvatar} alt={post.author} class="w-6 h-6 rounded-full object-cover" loading="lazy" decoding="async" />
                  <span class="text-xs font-bold text-slate-700">{post.author}</span>
                </div>
                <span class="text-brand-primary font-bold text-sm flex items-center gap-1 group-hover:underline">
                  {t('blog.readMore')} <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Advisory Callout -->
  <section class="py-14 bg-brand-dark text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold">¿Necesita Asesoría Personalizada para su Negocio?</h2>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Nuestros consultores bilingües le guían en la creación de su LLC, licencias comerciales, contabilidad con ITIN y expansión en Tennessee.
      </p>
      <div class="pt-2">
        <a href="/es/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-primary hover:bg-emerald-900 text-white font-bold rounded-xl shadow-sm transition-colors text-sm">
          <span>Solicitar Consulta Gratuita</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

