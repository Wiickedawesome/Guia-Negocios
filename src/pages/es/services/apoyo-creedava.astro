---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import LegalDisclaimer from '../../../components/LegalDisclaimer.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title="Guía de Apoyo Continuo con CreedaVA | Guia Negocios" description="Una guía detallada sobre cómo CreedaVA provee Asistentes Virtuales bilingües dedicados para atención al cliente, manejo de correo, CRM y tareas administrativas tras el lanzamiento." altPath="/en/services/creedava-support">
  <Header slot="header" altPath="/en/services/creedava-support" />
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Apoyo Continuo de Asistente Virtual Bilingüe con CreedaVA",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Guia Negocios",
      "url": "https://guianegocios.net",
      "telephone": "+1-865-202-7112",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Knoxville",
        "addressRegion": "TN",
        "addressCountry": "US"
      }
    },
    "serviceType": "Asistente Virtual Bilingüe Operativo y Administrativo",
    "areaServed": "Knoxville, Condado de Knox, Este de Tennessee",
    "description": "Servicios dedicados de asistentes virtuales bilingües para atención al cliente, filtrado de buzón de entrada, facturación y gestión de CRM."
  })} />
  
  <!-- Service Package Hero Header -->
  <section class="py-16 lg:py-24 bg-brand-dark text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-wider text-slate-400">
        <a href={`/${lang}/services`} class="text-slate-300 hover:text-white transition-colors">← Volver a Todos los Servicios</a>
      </div>
      <span class="block text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-accent">
        Alianza Oficial Nivel 07
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-semibold leading-[1.05] tracking-tight text-white">
        Apoyo Continuo con CreedaVA
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed font-sans">
        Delegue la atención a clientes diaria, gestión de correo, actualizaciones de CRM y logística administrativa a Asistentes Virtuales dedicados y profesionalmente bilingües a través de nuestro socio oficial <strong class="text-white">CreedaVA</strong>.
      </p>
      
      <div class="pt-6 flex flex-wrap items-center gap-6 text-sm text-slate-300 border-t border-slate-800/80">
        <div>
          <span class="text-xs uppercase tracking-wider text-slate-400 block">Portal Oficial</span>
          <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="text-base font-bold text-white hover:underline">creedava.com ↗</a>
        </div>
        <div class="ml-auto">
          <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="inline-block bg-brand-accent text-brand-dark font-extrabold py-3.5 px-8 rounded-full hover:bg-yellow-300 transition-colors text-base">
            Visitar CreedaVA.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Article Content Body -->
  <article class="bg-white text-slate-800">

    <!-- Pull statement: full-bleed band -->
    <section class="bg-slate-50 border-b border-slate-200 py-16 lg:py-20">
      <div class="px-4 sm:px-6 lg:px-8 space-y-8">
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">La Ventaja de Delegar Tareas para el Dueño de Negocio</p>
        <p class="max-w-none text-2xl sm:text-3xl lg:text-4xl xl:text-5xl 2xl:text-6xl font-heading font-semibold leading-[1.1] tracking-tight text-brand-dark">
          Como dueño de negocio, sus horas de mayor valor deben dedicarse a atender clientes clave, cerrar presupuestos importantes y liderar el crecimiento, no a responder correos de rutina, contestar llamadas repetitivas o perseguir facturas vencidas. A través de nuestra alianza oficial con <strong>CreedaVA</strong>, obtiene un Asistente Virtual dedicado y profesionalmente bilingüe (español e inglés) que gestiona su operación diaria.
        </p>
      </div>
    </section>

    <!-- Numbered chapters -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">

      <!-- Section 1: The Transition from Launch to Operations -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Parte 01</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            1. La Transición Fluida: Del Lanzamiento a la Operación Diaria
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          Cuando lanza su negocio a través de Guia Negocios, sus sistemas operativos, formularios de recepción de clientes y plantillas de facturación ya quedan configurados y documentados. CreedaVA se integra a estos sistemas desde el primer día, evitando pérdidas de tiempo o desorientación en el equipo.
        </p>
        </div>
      </section>

      <!-- Section 2: What CreedaVA VAs Handle Daily -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Parte 02</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            2. Responsabilidades Diarias Manejadas por su Asistente Virtual
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          Los Asistentes Virtuales de CreedaVA actúan como una extensión directa de su empresa. A continuación se presentan las tareas administrativas diarias que se delegan:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 border-t border-slate-200 pt-6">
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Manejo de Correo y Llamadas</h3>
            <p class="text-sm text-slate-600">Filtro de llamadas telefónicas, gestión del correo electrónico de la empresa, atención a mensajes en WhatsApp Business y calificación de nuevos clientes en español e inglés.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Coordinación de Agenda y Citas</h3>
            <p class="text-sm text-slate-600">Programación de citas con clientes, asignación de visitas de técnicos, gestión de calendarios y envío de confirmaciones automáticas por SMS.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Administración de CRM y Datos de Clientes</h3>
            <p class="text-sm text-slate-600">Ingreso de nuevos contactos, actualización del historial de trabajos, seguimiento al estado de presupuestos y control de datos en su software CRM.</p>
          </div>
          <div class="space-y-2">
            <h3 class="font-bold text-brand-dark text-lg">Facturación y Seguimiento de Pagos</h3>
            <p class="text-sm text-slate-600">Envío de facturas digitales inmediatamente al concluir un trabajo, procesamiento de cobros con tarjeta y seguimiento educado a facturas pendientes.</p>
          </div>
        </div>
        </div>
      </section>

      <!-- Section 3: Why Bilingual Support Matters -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12 first:border-t-0 first:pt-0">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Parte 03</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl space-y-5">
          <h2 class="text-2xl sm:text-3xl font-heading font-semibold text-brand-dark leading-tight">
            3. El Poder del Soporte Profesional Bilingüe (Español e Inglés)
          </h2>
<p class="text-slate-700 text-base leading-relaxed">
          Atender el mercado creciente de East Tennessee exige una comunicación impecable tanto en inglés para clientes comerciales como en español para propietarios, proveedores o miembros del equipo. Los Asistentes Virtuales de CreedaVA dominan ambos idiomas con fluidez profesional.
        </p>
        </div>
      </section>

      <!-- Section 4: Direct Link & Partnership Card -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 border-t border-slate-200 pt-12">
        <div class="lg:col-span-3">
          <p class="lg:sticky lg:top-28 text-[0.68rem] font-bold uppercase tracking-[0.22em] text-brand-primary">Parte 04</p>
        </div>
        <div class="lg:col-span-9 max-w-3xl">
          <div class="bg-brand-dark text-white p-8 lg:p-10 space-y-5"><div class="flex items-center justify-between flex-wrap gap-4">
            <span class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brand-primary">Sitio Oficial de nuestro Socio</span>
            <span class="text-xs text-emerald-200">creedava.com</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-heading font-bold">
            Conozca Todos los Planes de Asistencia Virtual en CreedaVA
          </h3>
          <p class="text-emerald-100 text-sm leading-relaxed max-w-2xl">
            La tarifa del retainer depende de las horas de apoyo dedicadas, los tiempos de respuesta (SLA) y los requerimientos de tareas específicas. Visite la página oficial de CreedaVA para conocer los planes detallados, testimonios y opciones de contratación.
          </p>
          <div>
            <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-emerald-400 text-[#005148] font-extrabold py-3.5 px-8 rounded-full hover:bg-emerald-300 transition-colors text-base">
              Visitar CreedaVA.com
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div></div>
        </div>
      </section>
    </div>

    <!-- Full-bleed CTA band -->
    <section class="bg-brand-dark text-white py-16 lg:py-20">
      <div class="px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row lg:items-center gap-8">
        <img src="/images/creedava-logo.svg" alt="CreedaVA" width="242" height="201" decoding="async" class="h-20 w-auto shrink-0 self-start lg:self-center bg-white p-2" />
        <div class="flex-1 space-y-3">
            <h3 class="text-2xl lg:text-4xl font-heading font-semibold leading-[1.15] tracking-tight text-white">¿Listo para Asignar su Asistente Virtual Bilingüe?</h3>
            <p class="max-w-2xl text-base text-slate-300 leading-relaxed">Contacte a Guia Negocios o directamente a CreedaVA para evaluar la carga administrativa de su empresa y seleccionar su Asistente Virtual ideal.</p>
        </div>
        <div class="flex flex-wrap gap-4 lg:justify-end shrink-0">

            <a href={`/${lang}/contact`} class="inline-block bg-brand-primary text-white font-bold py-3.5 px-8 rounded-full hover:bg-opacity-90 transition-colors text-base">
              Reservar Consulta
            </a>
            <a href="https://creedava.com" target="_blank" rel="noopener noreferrer" class="inline-block border border-white text-white font-bold py-3.5 px-8 rounded-full hover:bg-white/10 transition-colors text-base">
              CreedaVA.com
            </a>
        </div>
      </div>
    </section>

  </article>

  <LegalDisclaimer />

  <Footer slot="footer" />
</BaseLayout>
