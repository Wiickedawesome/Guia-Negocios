---
interface FaqItem {
  number: string;
  question: string;
  answer: string;
}

interface Props {
  title: string;
  contactText: string;
  contactUrl: string;
  viewMoreText?: string;
  viewMoreUrl?: string;
  items: FaqItem[];
}

const { title, contactText, contactUrl, viewMoreText, viewMoreUrl, items } = Astro.props;
---

<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Left Column: Heading & Contact Link -->
      <div class="lg:col-span-5 space-y-6">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading text-brand-dark leading-tight">
          {title}
        </h2>
        <div class="space-y-3 pt-2">
          {viewMoreUrl && viewMoreText && (
            <div>
              <a href={viewMoreUrl} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 hover:bg-brand-primary hover:text-white text-brand-dark font-semibold text-sm transition-all shadow-sm">
                <span>{viewMoreText}</span>
                <span>→</span>
              </a>
            </div>
          )}
          <div>
            <a href={contactUrl} class="inline-flex items-center text-brand-primary font-medium hover:underline text-base gap-2">
              {contactText} <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Accordion Items -->
      <div class="lg:col-span-7 space-y-6">
        {items.map((item, index) => (
          <details class="group border-b border-slate-200 pb-6 transition-all duration-200" open={index === 0}>
            <summary class="flex items-center justify-between cursor-pointer list-none select-none py-2 gap-4">
              <div class="flex items-center gap-6">
                <span class="text-brand-primary font-heading font-semibold text-xl sm:text-2xl min-w-[32px]">
                  {item.number}
                </span>
                <h3 class="text-lg sm:text-xl font-heading text-brand-dark font-medium leading-snug">
                  {item.question}
                </h3>
              </div>
              <span class="text-brand-dark transition-transform duration-200 group-open:rotate-45 text-2xl font-light">
                +
              </span>
            </summary>
            <div class="pl-14 pt-4 pr-4 text-slate-600 text-base leading-relaxed">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
