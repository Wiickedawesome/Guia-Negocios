---
import { getActiveAeoSchemas } from '../utils/seo-schemas';

// AEO FAQ schemas are keyword-targeted, so they are only relevant on pages
// whose content matches the keyword topic. Injecting the identical FAQPage on
// every page is a duplicate-content spam signal for Google and AI engines.
// ⛔ DO NOT DEDUPE THESE SCHEMAS BY KEYWORD. This has been attempted TWICE and
// both times it silently deleted content. The generator stores each keyword
// under two documents - a space-form id and a hyphen-form id - which looks like
// duplication, but they are NOT copies: verified 2026-09-24, all 5 pairs carry
// DIFFERENT questions (32 unique across the 10 docs). Collapsing to 5 documents
// dropped 14 unique questions from the homepage.
const path = Astro.url.pathname.toLowerCase().replace(/\/+$/, '') || '/';
const isHomePage = path === '/' || path === '/en';

const aeoSchemas = isHomePage
  ? await getActiveAeoSchemas()
  : (await getActiveAeoSchemas()).filter((schema) => {
      const slug = (schema?.keyword || '').toLowerCase().replace(/\s+/g, '-');
      if (!slug) return false;
      const pageTokens = path.replace(/^\/(en|es)/, '').split('/').filter(Boolean).join('-');
      return slug.includes(pageTokens) || pageTokens.includes(slug);
    });
---
{aeoSchemas.map((schema) => (
  <script type="application/ld+json" set:html={schema.schemaStr} />
))}
