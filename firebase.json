{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  },
  "hosting": {
    "site": "guianegocios-prod",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|woff2|ttf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/es/blog/**",
        "function": "validateSlugRewrite"
      },
      {
        "source": "/en/blog/**",
        "function": "validateSlugRewrite"
      },
      {
        "source": "/es/lp/**",
        "function": "validateSlugRewrite"
      },
      {
        "source": "/en/lp/**",
        "function": "validateSlugRewrite"
      },
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap-index.xml"
      }
    ],
    "redirects": [
      {
        "source": "/admin",
        "destination": "/admin/login/",
        "type": 301
      },
      {
        "source": "/admin/",
        "destination": "/admin/login/",
        "type": 301
      },
      {
        "source": "/es",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/es/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about{,/*}",
        "destination": "/es/about/",
        "type": 301
      },
      {
        "source": "/services{,/*}",
        "destination": "/es/services/",
        "type": 301
      },
      {
        "source": "/contact{,/*}",
        "destination": "/es/contact/",
        "type": 301
      },
      {
        "source": "/faq{,/*}",
        "destination": "/es/faq/",
        "type": 301
      },
      {
        "source": "/blog{,/*}",
        "destination": "/es/blog/",
        "type": 301
      },
      {
        "source": "/en/services/paquete-lanzamiento-completo",
        "destination": "/en/services/complete-launch-bundle/",
        "type": 301
      },
      {
        "source": "/en/services/apoyo-creedava",
        "destination": "/en/services/creedava-support/",
        "type": 301
      },
      {
        "source": "/en/services/operaciones-crecimiento",
        "destination": "/en/services/operations-growth/",
        "type": 301
      },
      {
        "source": "/es/services/complete-launch-bundle",
        "destination": "/es/services/paquete-lanzamiento-completo/",
        "type": 301
      },
      {
        "source": "/es/services/operations-growth",
        "destination": "/es/services/operaciones-crecimiento/",
        "type": 301
      },
      {
        "source": "/es/services/creedava-support",
        "destination": "/es/services/apoyo-creedava/",
        "type": 301
      },
      {
        "source": "/en/blog/how-to-build-business-credit",
        "destination": "/en/blog/how-to-build-business-credit-united-states/",
        "type": 301
      },
      {
        "source": "/es/services/llc-para-extranjeros-sin-ssn{,/**}",
        "destination": "/es/blog/como-abrir-llc-estados-unidos-sin-ssn/",
        "type": 301
      },
      {
        "source": "/es/services/eitc-itin-creditos-impuestos{,/**}",
        "destination": "/es/blog/itin-creditos-impuestos-negocios/",
        "type": 301
      },
      {
        "source": "/es/services/contabilidad-para-restaurantes{,/**}",
        "destination": "/es/blog/contabilidad-para-restaurantes-guia-completa/",
        "type": 301
      },
      {
        "source": "/es/services/licencia-comercial-knoxville{,/**}",
        "destination": "/es/blog/licencia-comercial-knoxville-guia-paso-a-paso/",
        "type": 301
      },
      {
        "source": "/es/services/cuenta-bancaria-para-negocio{,/**}",
        "destination": "/es/blog/cuenta-bancaria-para-negocio-guia-practica/",
        "type": 301
      },
      {
        "source": "/en/services/llc-para-extranjeros-sin-ssn{,/**}",
        "destination": "/en/blog/how-to-open-llc-in-us-without-ssn/",
        "type": 301
      },
      {
        "source": "/en/services/eitc-itin-creditos-impuestos{,/**}",
        "destination": "/en/blog/itin-tax-credits-business-owners/",
        "type": 301
      },
      {
        "source": "/en/services/contabilidad-para-restaurantes{,/**}",
        "destination": "/en/blog/restaurant-accounting-complete-guide/",
        "type": 301
      },
      {
        "source": "/en/services/licencia-comercial-knoxville{,/**}",
        "destination": "/en/blog/knoxville-business-license-step-by-step-guide/",
        "type": 301
      },
      {
        "source": "/en/services/cuenta-bancaria-para-negocio{,/**}",
        "destination": "/en/blog/business-bank-account-practical-guide/",
        "type": 301
      }
    ]
  }
}
