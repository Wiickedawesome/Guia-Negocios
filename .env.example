# ---------------------------------------------------------------------------
# Guia Negocios — environment variables
# ---------------------------------------------------------------------------
# Firebase web config and the reCAPTCHA site key are NOT environment variables
# in this project: they are public identifiers hardcoded in src/lib/firebase.ts
# (Firebase security is enforced by Firestore rules and App Check, not by
# hiding those values).
#
# Do NOT add PUBLIC_-prefixed secrets here. Astro inlines every PUBLIC_* value
# into the client bundle, shipping it to every visitor. API keys (Gemini /
# Pexels / Unsplash / GA4 / GSC) are managed in the admin settings page and
# stored in Firestore settings/admin.

# Build-time only: App Check debug token so SSG/CI builds can read Firestore.
# Register it in Firebase console → App Check → Manage debug tokens.
APP_CHECK_DEBUG_TOKEN=

# Build-time Firestore credentials. First match wins — see src/utils/admin-db.ts:
#   1. FIREBASE_SERVICE_ACCOUNT_KEY       (raw or base64-encoded service account JSON)
#   2. FIREBASE_SERVICE_ACCOUNT_KEY_JSON  (same value, alternate name)
#   3. GOOGLE_APPLICATION_CREDENTIALS     (path to a service account JSON file)
#   4. serviceAccountKey.json             (repo root, gitignored — local only)
#   5. Application Default Credentials    (gcloud auth application-default login)
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Functions (functions/.env):
#   GEMINI_API_KEY   — optional fallback for the direct Gemini REST path
#   VERTEX_LOCATION  — defaults to "global" (Gemini 3.x is served globally)
GEMINI_API_KEY=
VERTEX_LOCATION=
